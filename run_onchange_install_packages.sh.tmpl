#!/usr/bin/env bash
set -euo pipefail

# Sudo helper
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null; then
        SUDO="sudo"
        # Cache sudo credentials upfront so the user only types password once
        sudo -v
        # Keep-alive: refresh sudo timestamp in background until this script exits
        while true; do sudo -n true; sleep 30; kill -0 "$$" || exit; done 2>/dev/null &
    else
        echo "Error: This script requires root privileges or sudo." >&2
        exit 1
    fi
fi


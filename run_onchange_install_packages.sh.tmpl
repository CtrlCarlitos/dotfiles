    if command -v npm &>/dev/null; then
        info "Installing Codex CLI..."
        command -v codex &>/dev/null || npm install -g @openai/codex || warn "Codex CLI install failed - continuing"
    else
        warn "npm not found - skipping Codex CLI"
    fi

    # Superpowers for Codex CLI: deliberately NOT automated. Confirmed
    # live via an isolated Docker test that the third-party `codex-plugin`
    # npm helper (the only scriptable option) doesn't just prompt
    # interactively - it expects a plugins/<name>/ marketplace layout
    # that obra/superpowers doesn't use (it ships a root-level
    # .codex-plugin/plugin.json manifest instead), so it fails outright
    # regardless of flags. Codex's real install path for this plugin is
    # its native in-app `/plugins` search UI - genuinely GUI/session-only,
    # no config file or CLI command reaches it from outside a session.
{{- else }}
    info "Codex CLI disabled in config"
{{- end }}

{{- if $antigravity_cli }}
    # Antigravity CLI (agy) - Homebrew cask (v1.1.22, confirmed current
    # on formulae.brew.sh, matching the exact version Chocolatey ships on
    # Windows). Google retired standalone Gemini Code Assist for
    # individuals in favor of the Antigravity suite (see
    # docs/tool-parity.md) - this repo no longer installs Gemini CLI, agy
    # replaces it here.
    command -v agy &>/dev/null || net_timeout 600 brew install --cask antigravity-cli || warn "Antigravity CLI install failed or timed out - continuing"

    # Superpowers plugin for Antigravity CLI (agy). `agy plugin install
    # <url>` is the officially-documented mechanism (obra/superpowers'
    # own README.md Antigravity section, confirmed against the locally-
    # installed copy's docs) - NOT hand-copying skill files into a
    # guessed plugin directory: Superpowers' own contributor docs
    # (docs/porting-to-a-new-harness.md) explicitly call that fragile/
    # unsupported ("Everything arrives through the install mechanism -
    # not by editing the user's config"). This also sidesteps needing to
    # hardcode Antigravity's actual plugin storage path here (confirmed
    # live: `~/.gemini/config/plugins/<name>/` - antigravity.google's own
    # docs claim `~/.gemini/antigravity-cli/plugins/<name>/` instead,
    # which is simply wrong as of agy 1.1.22) - agy itself resolves this,
    # not us, so it stays correct even if/when that path changes again.
    if command -v agy &>/dev/null; then
        info "Installing Superpowers plugin for Antigravity..."
        agy plugin install https://github.com/obra/superpowers 2>/dev/null || warn "Superpowers plugin install for Antigravity failed - continuing"
    fi
{{- else }}
    info "Antigravity CLI disabled in config"
{{- end }}

{{- if or $claude_cli $antigravity_cli $agent_toolkit $opencode_cli }}
    # Curated third-party skills (Matt Pocock's 11 + mp-code-review +
    # Anthropic's frontend-design) for Claude Code / OpenCode / Antigravity,
    # via the `skills` CLI - see install_agent_skills above. Cross-cutting
    # pass (spec §2 wiring rule): fires when ANY of its target groups
    # (claude_cli / antigravity_cli / agent_toolkit / opencode_cli) is
    # enabled - the CLIs it writes to may have arrived from any of those
    # gates, and the pass is idempotent either way. npx presence is checked
    # inside the function.
    install_agent_skills
{{- end }}

    # agent-guardrails binary + plane desired state - see install_agent_guardrails above.
    install_agent_guardrails

    # Mac Desktop Apps (Cask) - hosts only, see the top-of-file $isHost comment
{{- if and $dev_desktop $isHost }}
    info "Installing Mac Desktop Apps..."
    # filezilla intentionally omitted: confirmed removed from homebrew-cask
    # entirely (adware concerns, not a naming/renaming issue like Antigravity) -
    # "Warning: No available formula with the name 'filezilla'" was being
    # silently swallowed by the trailing `|| true` below. No cask exists either,
    # so there's no brew-based fix. Standardized on Termius as the SFTP/SSH
    # client across all 3 platforms instead of mixing tools.
    # handy (https://handy.computer, Speech-to-Text): Whisper/Parakeet model
    # selection is GUI-only, no CLI flag or config file to pre-seed one. For
    # Spanish + English both, pick a Whisper model post-install (Parakeet is
    # English-only) - Large for best accuracy, Turbo for much faster with a
    # small accuracy trade-off (most noticeable on non-English audio).
    # geany: cross-platform replacement for Notepad++ (Windows-only, no real
    # Mac/Linux port) - fills the same "lightweight quick-edit GUI editor" role.
    # Installed one-by-one (like the Linux apt loop and the Windows choco loop)
    # so a single unavailable/pulled cask surfaces a warning instead of being
    # swallowed silently by a trailing `|| true` (see the filezilla note above).
    for cask in google-chrome visual-studio-code obs docker meld flameshot vlc rectangle raycast qbittorrent ghostscript handy termius geany codexbar; do
        brew install "$cask" || warn "Skipping '$cask' (brew install failed)."
    done

    # ScreenRec (Manual Install - No Homebrew Cask)
    if [[ ! -d "/Applications/ScreenRec.app" ]]; then
        info "Installing ScreenRec..."
        local arch
        arch=$(uname -m)
        local dmg_url
        if [[ "$arch" == "arm64" ]]; then
            dmg_url="https://screenrec.com/download/ScreenRec_webinstall_apple_silicon.dmg"
        else
            dmg_url="https://screenrec.com/download/ScreenRec_webinstall_apple_intel.dmg"
        fi
        
        info "Downloading ScreenRec for macOS ($arch)..."
        net_timeout 300 curl -fsSL -o /tmp/ScreenRec.dmg "$dmg_url" || {
            warn "Failed to download ScreenRec (or timed out)"
        }

        if [[ -f "/tmp/ScreenRec.dmg" ]]; then
             # Mount and install
             hdiutil attach /tmp/ScreenRec.dmg -quiet
             # Note: Volume name might differ, checking mount
             if [[ -d "/Volumes/ScreenRec" ]]; then
                 cp -R "/Volumes/ScreenRec/ScreenRec.app" /Applications/ || warn "Failed to copy ScreenRec.app"
                 hdiutil detach "/Volumes/ScreenRec" -quiet
                 success "ScreenRec installed to /Applications"
             else
                 warn "Could not find mounted ScreenRec volume"
                 hdiutil detach "$(hdiutil info | grep ScreenRec | cut -f1)" -quiet || true
             fi
             rm -f /tmp/ScreenRec.dmg
        fi
    fi
{{- end }}
}

#-------------------------------------------------------------------------------
# AI desktop apps (spec §2: pure installs, zero wiring - superpowers, the
# curated-skills pass and guardrail planes key off the CLI groups only, per
# the spec's placement rule; nothing in these functions configures anything).
#
# History: the Google Antigravity Desktop App was removed 2026-09-11 (VS Code
# + the agy CLI covered that workflow; the old Linux apt repo and the
# "Antigravity IDE" dmg pin went with it) and is reinstated 2026-09-13 as
# Antigravity 2.0 under the antigravity_desktop group, from the new
# antigravity-hub storage channel with the version pinned inside
# install_antigravity_desktop (scripts/update-versions.sh re-checks that pin).
# OpenCode Desktop joined as its own opencode_desktop group the same day -
# the desktop half of the OpenCode vendor pair (the CLI half is opencode_cli).
#-------------------------------------------------------------------------------

# Claude Desktop - official Homebrew cask on macOS (spec §2: Win choco `claude`
# carries it there; Linux has no official build - info line, no-op, by spec).
install_claude_desktop() {
    case "$(uname -s)" in
        Darwin)
            if [[ -d "/Applications/Claude.app" ]]; then
                info "Claude Desktop already installed (/Applications/Claude.app)"
                return 0
            fi
            info "Installing Claude Desktop (brew cask claude)..."
            net_timeout 600 brew install --cask claude || warn "Claude Desktop install failed or timed out - continuing"
            ;;
        Linux)
            info "claude_desktop: no official Linux build - skipping"
            ;;
        *)
            warn "claude_desktop: unsupported OS $(uname -s) - skipping"
            ;;
    esac
}

# ChatGPT Desktop - official Homebrew cask on macOS (spec §2: Win winget-msstore
# carries it there; Linux has no official build - info line, no-op, by spec).
install_chatgpt_desktop() {
    case "$(uname -s)" in
        Darwin)
            if [[ -d "/Applications/ChatGPT.app" ]]; then
                info "ChatGPT Desktop already installed (/Applications/ChatGPT.app)"
                return 0
            fi
            info "Installing ChatGPT Desktop (brew cask chatgpt)..."
            net_timeout 600 brew install --cask chatgpt || warn "ChatGPT Desktop install failed or timed out - continuing"
            ;;
        Linux)
            info "chatgpt_desktop: no official Linux build - skipping"
            ;;
        *)
            warn "chatgpt_desktop: unsupported OS $(uname -s) - skipping"
            ;;
    esac
}

# Antigravity 2.0 (the hub-channel desktop app - distinct from the agy CLI in
# antigravity_cli). macOS: pinned dmg + hdiutil + runtime volume/.app discovery
# (same pattern the legacy install_antigravity() used after Google's
# "Antigravity"->"Antigravity IDE" rename broke hardcoded volume names: never
# trust a guessed bundle name, discover it mounted). Linux: pinned tar.gz
# extracted under ~/.local/share - no packaging, no launcher integration yet;
# the extraction layout is logged verbatim below so the CI verify (and docs)
# can be designed from real first-run evidence.
install_antigravity_desktop() {
    # Antigravity 2.0 hub release pin - single source of truth for both the
    # macOS dmg and the Linux tar.gz below. scripts/update-versions.sh scrapes
    # antigravity.google/download and re-checks both asset URLs before
    # rewriting this line (Windows floats via choco, no pin needed there).
    ANTIGRAVITY_HUB_VERSION="2.13.0-6362815968182272"
    local ag_base="https://storage.googleapis.com/antigravity-public/antigravity-hub/${ANTIGRAVITY_HUB_VERSION}"

    case "$(uname -s)" in
        Darwin)
            # 2.0 hub channel ships a plain "Antigravity.app" - unlike the
            # legacy IDE guard, no dual pre-/post-rename name check needed.
            if [[ -d "/Applications/Antigravity.app" ]]; then
                info "Antigravity 2.0 already installed (/Applications/Antigravity.app)"
                return 0
            fi
            local ag_arch
            case "$(uname -m)" in
                arm64) ag_arch="darwin-arm" ;;
                x86_64) ag_arch="darwin-x64" ;;
                *) warn "antigravity_desktop: unsupported macOS arch $(uname -m) - skipping"; return 0 ;;
            esac
            info "Downloading Antigravity 2.0 for macOS ($ag_arch)..."
            if ! net_timeout 600 curl -fsSL -o /tmp/Antigravity.dmg "${ag_base}/${ag_arch}/Antigravity.dmg"; then
                warn "Antigravity 2.0 dmg download failed or timed out - skipping"
                rm -f /tmp/Antigravity.dmg
                return 0
            fi
            # Mount and install. Runtime volume/.app discovery, not hardcoded
            # names - the legacy lesson: Google renamed the bundle mid-channel
            # and `cp /Volumes/Antigravity/Antigravity.app` broke live.
            local mount_output volume_path
            # Attach guarded: an unguarded failure would abort the whole
            # remaining run under `set -euo pipefail` (warn-and-continue
            # contract instead). grep's no-match exit is neutralized with
            # `|| true` INSIDE the substitution so an empty result reaches
            # the -z guard below instead of tripping pipefail first.
            mount_output=$(hdiutil attach /tmp/Antigravity.dmg -nobrowse) \
                || { warn "Failed to mount Antigravity 2.0 DMG"; rm -f /tmp/Antigravity.dmg; return 0; }
            volume_path=$(echo "$mount_output" | grep -Eo '/Volumes/.*$' | tail -1 || true)
            if [[ -z "$volume_path" ]]; then
                warn "Could not determine mounted volume path for Antigravity 2.0 DMG"
            else
                local app_path
                app_path=$(find "$volume_path" -maxdepth 1 -name "*.app" -print -quit)
                if [[ -n "$app_path" ]]; then
                    # Success line only on a confirmed copy - a failed cp
                    # must not read as "installed" in the log.
                    if cp -R "$app_path" /Applications/; then
                        success "Antigravity 2.0 installed to /Applications"
                    else
                        warn "Failed to copy $(basename "$app_path") to /Applications"
                    fi
                else
                    warn "No .app bundle found in mounted Antigravity 2.0 volume at $volume_path"
                fi
                hdiutil detach "$volume_path" -quiet || warn "Failed to detach Antigravity 2.0 volume at $volume_path"
            fi
            rm -f /tmp/Antigravity.dmg
            ;;
        Linux)
            # Tarball install under ~/.local/share (the 2.0 hub channel ships
            # no .deb/.AppImage). Idempotent guard: the install dir itself.
            local ag_dir="$HOME/.local/share/antigravity-2.0"
            if [[ -d "$ag_dir" ]]; then
                info "Antigravity 2.0 already installed at $ag_dir - skipping"
                return 0
            fi
            local ag_arch
            case "$(uname -m)" in
                x86_64|amd64) ag_arch="linux-x64" ;;
                aarch64|arm64) ag_arch="linux-arm" ;;
                *) warn "antigravity_desktop: unsupported Linux arch $(uname -m) - skipping"; return 0 ;;
            esac
            info "Downloading Antigravity 2.0 for Linux ($ag_arch)..."
            local ag_tmp
            ag_tmp="$(mktemp -d)"
            if ! net_timeout 600 curl -fLo "$ag_tmp/Antigravity.tar.gz" "${ag_base}/${ag_arch}/Antigravity.tar.gz"; then
                warn "Antigravity 2.0 tar.gz download failed or timed out - skipping"
                rm -rf "$ag_tmp"
                return 0
            fi
            mkdir -p "$ag_dir"
            if ! tar -xzf "$ag_tmp/Antigravity.tar.gz" -C "$ag_dir"; then
                warn "Antigravity 2.0 extraction failed - skipping"
                rm -rf "$ag_dir" "$ag_tmp"
                return 0
            fi
            rm -rf "$ag_tmp"

            # Make discovered executables runnable: tar normally preserves
            # modes, but storage-served tarballs can arrive flattened. `file`
            # identifies binaries/scripts by CONTENT (ELF / "executable" /
            # "script" in its output), so nothing gets +x by name-guessing.
            if command -v file &>/dev/null; then
                while IFS= read -r -d '' ag_f; do
                    if file "$ag_f" | grep -qE 'ELF|executable|script'; then
                        chmod +x "$ag_f" || true
                    fi
                done < <(find "$ag_dir" -type f -print0)
            else
                # No file(1) (unexpected on apt/brew systems): fall back to
                # +x on everything so a flattened tarball still yields
                # runnable binaries; data files stay openable regardless.
                find "$ag_dir" -type f -exec chmod +x {} +
            fi

            # Log the extracted layout VERBATIM (unverified until the first
            # real install): the CI verify step and docs are designed from
            # this output - do not reformat it.
            info "Antigravity 2.0 extracted to $ag_dir - layout (find $ag_dir -maxdepth 2):"
            find "$ag_dir" -maxdepth 2

            # PATH note: the tarball's launcher layout is unknown until the
            # first real extraction (see the log above) - if it ships a CLI,
            # its directory under $ag_dir must be added to PATH manually
            # until docs/package-groups.md records the exact path.
            info "If Antigravity 2.0 ships a CLI launcher, add its directory under $ag_dir to PATH (see layout above)."
            success "Antigravity 2.0 installed to $ag_dir"
            ;;
        *)
            warn "antigravity_desktop: unsupported OS $(uname -s) - skipping"
            ;;
    esac
}

# OpenCode Desktop (opencode_desktop group - the OpenCode vendor pair's
# desktop side, distinct from the OpenCode CLI in opencode_cli). macOS:
# official Homebrew cask; the bundle lands as "OpenCode.app" (verified against
# formulae.brew.sh's opencode-desktop cask artifacts, 2026-09-13). Linux:
# official GitHub-release .deb. An arm64 .deb exists upstream too, but this
# follows the repo's amd64 .deb precedent (Chrome/Termius/dust) until an
# arm64 Linux target actually exists.
install_opencode_desktop() {
    case "$(uname -s)" in
        Darwin)
            if [[ -d "/Applications/OpenCode.app" ]]; then
                info "OpenCode Desktop already installed (/Applications/OpenCode.app)"
                return 0
            fi
            info "Installing OpenCode Desktop (brew cask opencode-desktop)..."
            net_timeout 600 brew install --cask opencode-desktop || warn "OpenCode Desktop install failed or timed out - continuing"
            ;;
        Linux)
            # Idempotence guard on the package + binary (same shape as
            # Docker Desktop/Termius): skip if either reports present, so a
            # .deb without a PATH binary can't trigger a ~120MB re-download
            # on every apply.
            if dpkg -s opencode-desktop &>/dev/null || command -v opencode-desktop &>/dev/null; then
                info "OpenCode Desktop already installed"
                return 0
            fi
            info "Installing OpenCode Desktop (.deb from GitHub releases)..."
            # ~120MB download - net_timeout per the network-step contract
            # (docs/tool-parity.md). "latest/download" floats with upstream;
            # no pin to maintain (Windows floats via choco the same way).
            if net_timeout 600 curl -fLo /tmp/opencode-desktop-linux-amd64.deb \
                "https://github.com/anomalyco/opencode/releases/latest/download/opencode-desktop-linux-amd64.deb"; then
                $SUDO apt install -y /tmp/opencode-desktop-linux-amd64.deb || warn "OpenCode Desktop install failed"
            else
                warn "OpenCode Desktop download failed or timed out - skipping"
            fi
            rm -f /tmp/opencode-desktop-linux-amd64.deb
            ;;
        *)
            warn "opencode_desktop: unsupported OS $(uname -s) - skipping"
            ;;
    esac
}

setup_shell() {
    local target_shell
    target_shell="$(which zsh 2>/dev/null || true)"
    if [[ -x "$target_shell" ]]; then
        # Ensure USER is set
        local current_user="${USER:-$(id -un)}"
        local current_shell=""
        
        if command -v getent &>/dev/null; then
            # Handle getent failure gracefully (avoid pipefail exit)
            current_shell=$(getent passwd "$current_user" 2>/dev/null | cut -d: -f7 || true)
        elif [[ "$(uname -s)" == "Darwin" ]]; then
            current_shell=$(dscl . -read /Users/"$current_user" UserShell 2>/dev/null | awk '{print $2}' || true)
        fi

        if [[ -n "$current_shell" && "$current_shell" != "$target_shell" ]]; then
            info "Changing shell to $target_shell for $current_user..."
            
            # Ensure target shell is in /etc/shells
            if ! grep -q "^$target_shell$" /etc/shells; then
                info "Adding $target_shell to /etc/shells..."
                echo "$target_shell" | $SUDO tee -a /etc/shells >/dev/null
            fi

            if command -v chsh &>/dev/null; then
                # Try chsh, but don't fail script if password auth is required/fails
                $SUDO chsh -s "$target_shell" "$current_user" || {
                    warn "chsh failed (password required?). Attempting usermod fallback..."
                    if command -v usermod &>/dev/null; then
                        $SUDO usermod -s "$target_shell" "$current_user" || warn "usermod fallback failed."
                    fi
                }
            else
                warn "chsh not found, checking for usermod..."
                if command -v usermod &>/dev/null; then
                    $SUDO usermod -s "$target_shell" "$current_user" || warn "usermod fallback failed."
                else
                    warn "neither chsh nor usermod found, skipping shell change."
                fi
            fi
            warn "Default shell changed to zsh - it takes effect on your next login. For this terminal now: exec zsh"
        fi
    fi
}

main() {
{{- if $serverOnly }}
{{- if eq .chezmoi.os "darwin" }}
    info "Remote Login is built in to macOS; enable it manually in System Settings. See docs/remote-access.md."
{{- else }}
    if command -v apt &>/dev/null; then
        info "Installing OpenSSH Server prerequisites..."
        $SUDO apt install -y openssh-server || warn "OpenSSH Server prerequisite install failed - continuing"
    else
        warn "OpenSSH Server prerequisite install requires apt; install it manually."
    fi
    info "SSH service activation and access configuration remain manual. See docs/remote-access.md."
{{- end }}
    success "Package installation complete!"
{{- else }}
{{- if $isWsl }}
    # Docker Desktop's WSL Integration has to be turned on from the Windows
    # side (Docker Desktop > Settings > Resources > WSL Integration) before
    # `docker` works in WSL at all - this repo deliberately never installs a
    # Docker engine/CLI inside WSL itself (see install_linux_desktop's
    # $isHost gate below and docs/tool-parity.md's Container row), and
    # nothing running inside WSL can flip that toggle on its own. Checked
    # here, first thing, before any package installs run - checking only at
    # the very end (the original approach) meant discovering this only after
    # the whole install had already finished, too late for a heads-up to be
    # useful. `timeout` guards against `docker version` hanging if the CLI
    # exists but can't reach a daemon, rather than being missing outright.
    if ! (command -v docker &>/dev/null && timeout 5 docker version &>/dev/null); then
        warn "Docker is not reachable from this WSL distro."
        warn "  Docker Desktop's WSL Integration is off (or Docker Desktop for Windows isn't installed/running yet):"
        warn "  1. Open Docker Desktop on Windows"
        warn "  2. Settings > Resources > WSL Integration"
        warn "  3. Toggle ON for this distro"
        warn "  4. Restart this WSL terminal, then re-run this installer"
        if [[ -t 0 ]] && [[ -z "${CI:-}" ]]; then
            read -r -p "Continue installing without Docker working in this WSL distro? [y/N]: " docker_continue
            if [[ ! "$docker_continue" =~ ^[Yy]$ ]]; then
                error "Stopping - enable WSL Integration above, then re-run this installer."
                exit 1
            fi
        else
            warn "Non-interactive run - continuing without Docker (nothing here installs Docker inside WSL by design, so there's nothing this run itself could do differently)."
        fi
    else
        success "Docker is reachable via Docker Desktop's WSL integration."
    fi
{{- end }}

    local pkg_manager
    pkg_manager=$(detect_package_manager)
    info "Detected Package Manager: $pkg_manager"

    case "$pkg_manager" in
        apt)  install_apt ;;
        brew) install_brew ;;
        *)    warn "Skipping package installation (unsupported manager: $pkg_manager)" ;;
    esac

    # AI desktop apps (hosts only - the config template host-gates the
    # desktop groups too, spec §3; dispatched here, after install_apt/
    # install_brew, so brew is guaranteed present for the macOS casks)
{{- if and $claude_desktop $isHost }}
    install_claude_desktop
{{- else }}
    info "Claude Desktop disabled (WSL/Devcontainer/config)"
{{- end }}
{{- if and $chatgpt_desktop $isHost }}
    install_chatgpt_desktop
{{- else }}
    info "ChatGPT Desktop disabled (WSL/Devcontainer/config)"
{{- end }}
{{- if and $antigravity_desktop $isHost }}
    install_antigravity_desktop
{{- else }}
    info "Antigravity Desktop disabled (WSL/Devcontainer/config)"
{{- end }}
{{- if and $opencode_desktop $isHost }}
    install_opencode_desktop
{{- else }}
    info "OpenCode Desktop disabled (WSL/Devcontainer/config)"
{{- end }}

    # Ensure zsh is default
    setup_shell

    success "Package installation complete!"
{{- if and $dev_desktop $isHost }}
    echo ""
    info "[Post-Install] Launch Docker Desktop once from your applications menu to accept the"
    info "  EULA and start the engine, then confirm it works with:  docker ps"
{{- end }}
{{- if $remote_access }}
    echo ""
{{- if $isWsl }}
    info "[Post-Install] Tailscale remains on Windows; no WSL Tailscale install was performed."
{{- else }}
    info "[Post-Install] Sign in to Tailscale manually to connect this machine."
{{- end }}
    info "  Login and any cloudflared service activation are manual. See docs/remote-access.md."
{{- end }}
{{- if $remote_access_server }}
    info "[Post-Install] SSH service activation and access configuration are manual. See docs/remote-access.md."
{{- end }}
{{- end }}
}

main
{{ end -}}

#===============================================================================
# CHEZMOI RUN_ONCHANGE: Install Packages (Linux/macOS)
# This script runs whenever its content changes (hash-based).
# Version: 1.0.0 (change this to force re-run)
#===============================================================================

#-------------------------------------------------------------------------------
# Colors
#-------------------------------------------------------------------------------
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()    { printf "${BLUE}▸${NC} %s\n" "$1"; }
success() { printf "${GREEN}✓${NC} %s\n" "$1"; }
warn()    { printf "${YELLOW}⚠${NC} %s\n" "$1"; }
error()   { printf "${RED}✗${NC} %s\n" "$1" >&2; }

#-------------------------------------------------------------------------------
# net_timeout <seconds> <cmd...> - wall-clock guard for network install steps.
#
# A stalled download or `curl | sh` installer (no built-in timeout) otherwise
# freezes this whole `set -e` run indefinitely - confirmed live: Ollama's
# ~1.5GB bundle stalled mid-transfer for 15+ min with nothing else able to
# proceed. Wrap the fetch so a dead connection is killed and the caller's
# `|| warn` can carry on. Pipelines: `net_timeout N bash -c '... | sh'`.
#
# Uses coreutils `timeout` (always present on Linux) or `gtimeout` (macOS -
# `coreutils` is first in the brew core list so it lands before the guarded
# steps); if neither exists the command runs unguarded rather than failing.
# Resolved per-call, not cached, so a `gtimeout` installed partway through a
# macOS run is picked up by later steps. `-k 10` follows SIGTERM with SIGKILL
# after 10s for processes that ignore the first signal. Exit 124 = timed out.
#-------------------------------------------------------------------------------
net_timeout() {
    local secs="$1"; shift
    local bin=""
    if command -v timeout &>/dev/null; then bin="timeout"
    elif command -v gtimeout &>/dev/null; then bin="gtimeout"
    fi
    if [ -n "$bin" ]; then
        "$bin" -k 10 "$secs" "$@"
    else
        "$@"
    fi
}

#-------------------------------------------------------------------------------
# Detect OS and Package Manager
#-------------------------------------------------------------------------------
detect_os() {
    case "$(uname -s)" in
        Darwin) echo "macos" ;;
        Linux)  echo "linux" ;;
        *)      echo "unknown" ;;
    esac
}

detect_package_manager() {
    if command -v apt &>/dev/null; then echo "apt"
    elif command -v pacman &>/dev/null; then echo "pacman"
    elif command -v dnf &>/dev/null; then echo "dnf"
    elif command -v brew &>/dev/null; then echo "brew"
    else echo "unknown"
    fi
}

get_distro_info() {
    local id="" id_like="" codename=""
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        id="${ID:-}"
        id_like="${ID_LIKE:-}"
        codename="${VERSION_CODENAME:-${UBUNTU_CODENAME:-${DEBIAN_CODENAME:-}}}"
    fi
    if [[ -z "$codename" ]] && command -v lsb_release &>/dev/null; then
        codename=$(lsb_release -cs 2>/dev/null || true)
    fi
    printf "%s|%s|%s" "$id" "$id_like" "$codename"
}

install_fonts() {
    local font_dir="$HOME/.local/share/fonts"
    # Ensure wget and 7zip are available
    command -v wget &>/dev/null || $SUDO apt install -y wget
    if ! command -v 7z &>/dev/null && ! command -v 7zz &>/dev/null; then
         if [[ "$(uname -s)" == "Darwin" ]]; then
             brew install sevenzip
         else
             $SUDO apt install -y p7zip-full
         fi
    fi

    # Check for Meslo Nerd Font
    if [[ ! -f "$font_dir/MesloLGMNerdFont-Regular.ttf" ]]; then
        info "Installing Meslo Nerd Font (for Starship)..."
        mkdir -p "$font_dir"
        
        # Determine latest Nerd Fonts release
        local nf_version
        nf_version=$(curl -s --max-time 30 "https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest" | grep -Po '"tag_name": "\K.*?(?=")')

        # Download from official Nerd Fonts repo
        if ! net_timeout 300 wget -q --show-progress -O /tmp/Meslo.zip "https://github.com/ryanoasis/nerd-fonts/releases/download/${nf_version}/Meslo.zip"; then
            warn "Meslo Nerd Font download failed or timed out - skipping"
            rm -f /tmp/Meslo.zip
            return
        fi

        # Unzip with 7z/7zz
        # 7z x -o{output_dir} {archive}
        local seven_z="7z"
        if command -v 7zz &>/dev/null; then seven_z="7zz"; fi
        
        "$seven_z" x -y -o"$font_dir" /tmp/Meslo.zip
        rm /tmp/Meslo.zip

        if command -v fc-cache &>/dev/null; then
            info "Updating font cache..."
            fc-cache -f
        fi
        success "Meslo Nerd Font installed"
    fi
}

install_node() {
    if ! command -v node &>/dev/null || [[ "$(node -v | cut -d. -f1 | tr -d 'v')" -lt 24 ]]; then
        info "Installing Node.js 24.x..."
        # Ensure curl is available
        command -v curl &>/dev/null || $SUDO apt install -y curl
        # -E (preserve environment) only makes sense as a sudo flag - when
        # $SUDO is empty (already running as root, e.g. inside a container),
        # `$SUDO -E bash -` expands to a bare `-E bash -`, and the shell
        # tries to run a command literally named "-E" ("command not found").
        # Confirmed live in a real Docker container run as root: this killed
        # the entire install right here, before anything past Node.js ever
        # ran - a pre-existing bug, not something introduced this session,
        # surfaced by actually running the script instead of just reading it.
        if [[ -n "$SUDO" ]]; then
            net_timeout 180 bash -c 'curl -fsSL https://deb.nodesource.com/setup_24.x | '"$SUDO"' -E bash -' || warn "NodeSource setup script failed or timed out - 'apt install nodejs' below may fail"
        else
            net_timeout 180 bash -c 'curl -fsSL https://deb.nodesource.com/setup_24.x | bash -' || warn "NodeSource setup script failed or timed out - 'apt install nodejs' below may fail"
        fi
        $SUDO apt install -y nodejs
    fi
    # Upgrade npm to latest
    if command -v npm &>/dev/null; then
        info "Upgrading npm to latest..."
        $SUDO npm install -g npm@latest --fund=false 2>/dev/null || true
    fi
}

# Curated third-party agent skills use the skills CLI's shared destination for
# OpenCode and Codex. Antigravity receives verified copies from Claude's native target.
install_agent_skills() {
    if ! command -v npx &>/dev/null; then
        warn "npx not found - skipping curated agent skills"
        info "Curated skills: Claude Code installed=0 skipped=16 failed=0"
        info "Curated skills: OpenCode installed=0 skipped=16 failed=0"
        info "Curated skills: Antigravity installed=0 skipped=16 failed=0"
        info "Curated skills: Codex installed=0 skipped=16 failed=0"
        return
    fi
    local catalog
    catalog='{{ .chezmoi.sourceDir | replace "'" "'\"'\"'" }}/scripts/curated-agent-skills.txt'
    # --loglevel=error: npm 12's npx prints a benign "npm notice run npx /
    # npm notice run 'skills' add ..." hint to stderr on every invocation -
    # pure console noise here, suppressed like the Windows side does.
    # </dev/null on every $SK call: chezmoi run_onchange scripts inherit the
    # terminal's TTY on stdin, and a CLI that decides to prompt (or a stalled
    # fetch with no internal timeout) then blocks the whole run holding the
    # terminal - confirmed live 2026-08-30, first real run hung indefinitely
    # at the skills CLI's intro banner. With stdin at EOF the same commands
    # complete non-interactively in ~5s (verified: 8 skills + mp-code-review +
    # frontend-design). net_timeout stays as the wall-clock backstop.
    local -a SK=(npx --yes --loglevel=error skills@latest)
    # The CLI writes $HOME/.claude/skills and $HOME/.agents/skills; OpenCode
    # and Codex discover the latter.
    local -a AGENTS=(claude-code opencode codex)
    local claude_installed=0 claude_skipped=0 claude_failed=0
    local opencode_installed=0 opencode_skipped=0 opencode_failed=0
    local codex_installed=0 codex_skipped=0 codex_failed=0
    local antigravity_installed=0 antigravity_skipped=0 antigravity_failed=0

    record_cli_result() {
        local status="$1" count="$2"
        for agent in "${AGENTS[@]}"; do
            case "$status:$agent" in
                installed:claude-code) ((claude_installed += count)) ;;
                installed:opencode) ((opencode_installed += count)) ;;
                installed:codex) ((codex_installed += count)) ;;
                skipped:claude-code) ((claude_skipped += count)) ;;
                skipped:opencode) ((opencode_skipped += count)) ;;
                skipped:codex) ((codex_skipped += count)) ;;
                failed:claude-code) ((claude_failed += count)) ;;
                failed:opencode) ((opencode_failed += count)) ;;
                failed:codex) ((codex_failed += count)) ;;
            esac
        done
    }

    # Matt Pocock's engineering/productivity skills - 11 installed as-is.
    # teach + writing-for-agents live under skills/productivity/, the rest under
    # skills/engineering/; the CLI resolves by skill name, not path (grilling and
    # handoff are already productivity/ skills that resolve fine here).
    info "Installing Matt Pocock's skills (Claude Code / OpenCode / Antigravity)..."
    if net_timeout 300 "${SK[@]}" add mattpocock/skills \
        -s codebase-design domain-modeling grill-with-docs improve-codebase-architecture \
           prototype research grilling handoff teach writing-for-agents \
           resolving-merge-conflicts \
        -a "${AGENTS[@]}" -g -y --copy < /dev/null; then
        record_cli_result installed 11
    else
        record_cli_result failed 11
        warn "Matt Pocock skills install failed or timed out - continuing"
    fi

    # code-review -> mp-code-review. The `skills` CLI has no rename flag, so
    # stage a renamed copy with its `name:` frontmatter patched and install
    # that local directory. "mp-" keeps it distinct from this repo's own
    # /code-review command and Superpowers' receiving-code-review skill.
    local sk_tmp; sk_tmp="$(mktemp -d)"
    # net_timeout: same wall-clock contract as every other network fetch here
    # (docs/tool-parity.md's Network-step timeouts section includes git clones).
    if net_timeout 60 git clone --quiet --depth 1 https://github.com/mattpocock/skills "$sk_tmp/repo" 2>/dev/null; then
        local src="$sk_tmp/repo/skills/engineering/code-review"
        [[ -d "$src" ]] || src="$sk_tmp/repo/code-review"
        if [[ -d "$src" ]]; then
            mkdir -p "$sk_tmp/stage/mp-code-review"
            cp -r "$src/." "$sk_tmp/stage/mp-code-review/"
            local skf="$sk_tmp/stage/mp-code-review/SKILL.md"
            if [[ -f "$skf" ]]; then
                # portable in-place edit (GNU and BSD sed differ on -i).
                # Guarded: a bare failing `sed ... && mv` here would trip
                # set -e and abort the whole run - frontend-design, Playwright,
                # act, desktop apps and shell setup all come after this.
                sed 's/^name:[[:space:]].*/name: mp-code-review/' "$skf" > "$skf.tmp" && mv "$skf.tmp" "$skf"
                if net_timeout 120 "${SK[@]}" add "$sk_tmp/stage" -s mp-code-review -a "${AGENTS[@]}" -g -y --copy < /dev/null; then
                    record_cli_result installed 1
                else
                    record_cli_result failed 1
                    warn "mp-code-review skill install failed - continuing"
                fi
            else
                record_cli_result skipped 1
                warn "SKILL.md missing from staged code-review - upstream layout changed? Skipping mp-code-review."
            fi
        else
            record_cli_result skipped 1
            warn "code-review skill dir not found in mattpocock/skills - upstream layout changed?"
        fi
    else
        record_cli_result failed 1
        warn "mp-code-review skill source clone failed or timed out - continuing"
    fi
    rm -rf "$sk_tmp"

    # Anthropic's frontend-design skill - distinctive visual direction for new UI.
    info "Installing Anthropic's frontend-design skill..."
    if net_timeout 300 "${SK[@]}" add anthropics/skills -s frontend-design -a "${AGENTS[@]}" -g -y --copy < /dev/null; then
        record_cli_result installed 1
    else
        record_cli_result failed 1
        warn "frontend-design skill install failed or timed out - continuing"
    fi

    # find-skills (vercel-labs/skills, 3.4M installs on skills.sh) - lets an
    # agent search and install skills from skills.sh mid-session.
    info "Installing find-skills skill..."
    if net_timeout 300 "${SK[@]}" add vercel-labs/skills -s find-skills -a "${AGENTS[@]}" -g -y --copy < /dev/null; then
        record_cli_result installed 1
    else
        record_cli_result failed 1
        warn "find-skills skill install failed or timed out - continuing"
    fi

    # agent-browser (vercel-labs/agent-browser, 843.8K installs) - browser
    # automation: navigate, click, fill, scrape, screenshot.
    info "Installing agent-browser skill..."
    if net_timeout 300 "${SK[@]}" add vercel-labs/agent-browser -s agent-browser -a "${AGENTS[@]}" -g -y --copy < /dev/null; then
        record_cli_result installed 1
    else
        record_cli_result failed 1
        warn "agent-browser skill install failed or timed out - continuing"
    fi

    # skill-creator (anthropics/skills, 380K installs) - Anthropic's
    # skill-authoring lifecycle tool with benchmarks and eval viewer.
    info "Installing Anthropic's skill-creator skill..."
    if net_timeout 300 "${SK[@]}" add anthropics/skills -s skill-creator -a "${AGENTS[@]}" -g -y --copy < /dev/null; then
        record_cli_result installed 1
    else
        record_cli_result failed 1
        warn "skill-creator skill install failed or timed out - continuing"
    fi

    # (writing-great-skills removed 2026-09-14: mattpocock renamed it upstream to
    #  writing-for-agents, which is already in the batch above — the old name
    #  failed silently on every run.)

    if [[ ! -r "$catalog" ]]; then
        warn "Curated skill catalog is not readable: $catalog"
        info "Curated skills: Claude Code installed=$claude_installed skipped=$claude_skipped failed=$claude_failed"
        info "Curated skills: OpenCode installed=$opencode_installed skipped=$opencode_skipped failed=$opencode_failed"
        info "Curated skills: Antigravity installed=$antigravity_installed skipped=$antigravity_skipped failed=$antigravity_failed"
        info "Curated skills: Codex installed=$codex_installed skipped=$codex_skipped failed=$codex_failed"
        return
    fi

    local skill source target tmp backup command_dir command_file antigravity_status
    local claude_reported="$claude_installed" opencode_reported="$opencode_installed" codex_reported="$codex_installed"
    claude_installed=0
    opencode_installed=0
    codex_installed=0
    while IFS= read -r skill || [[ -n "$skill" ]]; do
        [[ -z "$skill" || "$skill" == \#* ]] && continue

        # A successful CLI exit only means its copy operation completed. Count
        # an agent installed only after its supported discovery target exists.
        if [[ -f "$HOME/.claude/skills/$skill/SKILL.md" ]]; then
            claude_installed=$((claude_installed + 1))
        elif ((claude_reported > 0)); then
            claude_failed=$((claude_failed + 1))
        fi
        if [[ -f "$HOME/.agents/skills/$skill/SKILL.md" ]]; then
            opencode_installed=$((opencode_installed + 1))
            codex_installed=$((codex_installed + 1))
        else
            if ((opencode_reported > 0)); then
                opencode_failed=$((opencode_failed + 1))
            fi
            if ((codex_reported > 0)); then
                codex_failed=$((codex_failed + 1))
            fi
        fi

        source="$HOME/.claude/skills/$skill"
        target="$HOME/.gemini/antigravity-cli/skills/$skill"
        if [[ -f "$source/SKILL.md" ]]; then
            antigravity_status=failed
            mkdir -p "$HOME/.gemini/antigravity-cli/skills"
            tmp="$(mktemp -d "$HOME/.gemini/antigravity-cli/skills/.${skill}.tmp.XXXXXX")"
            if cp -R "$source/." "$tmp/"; then
                backup="$(mktemp -d "$HOME/.gemini/antigravity-cli/skills/.${skill}.backup.XXXXXX")"
                if ! rmdir "$backup"; then
                    rm -rf "$tmp"
                    warn "Failed to prepare Antigravity skill backup: $skill"
                elif [[ -e "$target" || -L "$target" ]]; then
                    if mv "$target" "$backup"; then
                        if mv "$tmp" "$target"; then
                            rm -rf "$backup"
                            antigravity_status=installed
                        else
                            rm -rf "$tmp"
                            warn "Failed to promote curated skill for Antigravity: $skill"
                            mv "$backup" "$target" || warn "Failed to restore Antigravity skill backup: $skill"
                        fi
                    else
                        rm -rf "$tmp"
                        warn "Failed to back up existing Antigravity skill: $skill"
                    fi
                elif mv "$tmp" "$target"; then
                    antigravity_status=installed
                else
                    rm -rf "$tmp"
                    warn "Failed to promote curated skill for Antigravity: $skill"
                fi
            else
                rm -rf "$tmp"
                warn "Failed to copy curated skill for Antigravity: $skill"
            fi
        else
            antigravity_status=skipped
            warn "Claude skill missing; skipping Antigravity copy: $skill"
        fi

        case "$antigravity_status" in
            installed) ((antigravity_installed += 1)) ;;
            skipped) ((antigravity_skipped += 1)) ;;
            *) ((antigravity_failed += 1)) ;;
        esac

        command_dir="$HOME/.config/opencode/commands"
        command_file="$command_dir/$skill.md"
        source="$HOME/.agents/skills/$skill"
        if [[ -f "$source/SKILL.md" ]]; then
            mkdir -p "$command_dir"
            if [[ -f "$command_file" ]] && ! grep -Fq 'managed-by: chezmoi-curated-skills' "$command_file"; then
                warn "OpenCode command is user-managed; leaving unchanged: $command_file"
            else
                tmp="$(mktemp "$command_dir/.${skill}.tmp.XXXXXX")"
                {
                    printf '%s\n' '<!-- managed-by: chezmoi-curated-skills -->' '---'
                    printf 'description: Run the %s skill\n' "$skill"
                    printf '%s\n' '---'
                    # shellcheck disable=SC2016 # OpenCode expands this placeholder at command invocation.
                    printf 'Load the native `%s` skill with the skill tool, then follow it for: $ARGUMENTS\n' "$skill"
                } > "$tmp"
                mv "$tmp" "$command_file"
            fi
        elif [[ -f "$command_file" ]] && grep -Fq 'managed-by: chezmoi-curated-skills' "$command_file"; then
            rm -f "$command_file"
        fi
    done < "$catalog"

    info "Curated skills: Claude Code installed=$claude_installed skipped=$claude_skipped failed=$claude_failed"
    info "Curated skills: OpenCode installed=$opencode_installed skipped=$opencode_skipped failed=$opencode_failed"
    info "Curated skills: Antigravity installed=$antigravity_installed skipped=$antigravity_skipped failed=$antigravity_failed"
    info "Curated skills: Codex installed=$codex_installed skipped=$codex_skipped failed=$codex_failed"
}

# agent-guardrails release to bootstrap - single source of truth is
# .chezmoidata.yaml guardrail.version (rendered here, read via
# `chezmoi execute-template` in scripts/update_ai_tools.sh). Bumps touch
# that one line; this template must not hardcode a tag.
GUARDRAIL_VERSION="{{ .guardrail.version }}"
GUARDRAIL_REPO="CtrlCarlitos/agent-guardrails"
# Oldest release whose binary ships `guardrail update`. An installed binary
# older than this floor exits 2 ("unknown subcommand") on update, so the
# installer curl-bootstraps over it instead of self-updating.
GUARDRAIL_UPDATE_FLOOR="v0.19.2-dev"

# vMAJOR.MINOR.PATCH[-suffix] -> zero-padded comparable integer (sort -V is
# GNU-only; stock macOS ships BSD sort without it, and bash test -ge parses
# the result as decimal regardless of leading zeros).
guardrail_ver_num() {
    local v="${1#v}"; v="${v%%-*}"
    local IFS=.
    # shellcheck disable=SC2086  # intentional word-splitting: fields of $v on IFS=.
    set -- $v
    printf '%d%04d%04d' "${1:-0}" "${2:-0}" "${3:-0}"
}
# Desired enforcement state, rendered from packages.guardrail (single opt-in
# flag - see .chezmoi.toml.tmpl):
#   true  = ensure the binary at GUARDRAIL_VERSION, then enable every plane.
#   false = never download; disable every plane if a binary exists.
# The binary is never auto-removed in either state.
GUARDRAIL_ENABLED="{{ $guardrail }}"
VSCODE_SETTINGS="{{ $vscodeSettings }}"

# agent-guardrails: a single static Go binary ("guardrail") enforcing the
# shared hook policy across planes. First install bootstraps from the pinned
# GitHub release (checksum-verified); every later bump goes through
# `guardrail update <pin>` (re-verifies SHA256SUMS, replaces itself atomically).
# Plane wiring (formerly per-plane config-merge calls here) is guardrail-owned
# now: `plane enable|disable --all` regenerates each floor idempotently and
# reports planes it can't detect. Those commands print a WebAuthn approval URL
# and block until the operator responds, so their output streams straight
# through - never silence them. Any non-zero (denied/expired/timeout/no-TTY
# exit 2) fails this script so chezmoi surfaces it rather than silently
# "succeeding" (agent-guardrails contract, 2026-09).
install_agent_guardrails() {
    local ver="$GUARDRAIL_VERSION" repo="$GUARDRAIL_REPO"
    local dest="$HOME/.local/bin/guardrail"

    if [ "$GUARDRAIL_ENABLED" != "true" ]; then
        if [ -x "$dest" ]; then
            info "guardrail disabled in config - disabling planes (binary stays installed)"
            "$dest" plane disable --all
        else
            info "guardrail disabled in config - nothing to do"
        fi
        return 0
    fi

    local have=""
    if [ -x "$dest" ]; then have="$("$dest" version 2>/dev/null)"; fi
    if [ "$have" = "guardrail ${ver}" ]; then
        info "guardrail ${ver} already installed"
    elif [ -n "$have" ] && [ "$(guardrail_ver_num "${have#guardrail }")" -ge "$(guardrail_ver_num "$GUARDRAIL_UPDATE_FLOOR")" ]; then
        info "Updating guardrail to ${ver} via self-update..."
        "$dest" update "$ver"
    else
        # No binary at all, or one older than GUARDRAIL_UPDATE_FLOOR (which
        # predates `guardrail update`): verified curl bootstrap is the only
        # path that works for both.
        local os arch
        case "$(uname -s)" in
            Linux)  os="linux" ;;
            Darwin) os="darwin" ;;
            *) warn "guardrail: unsupported OS $(uname -s) - skipping"; return ;;
        esac
        case "$(uname -m)" in
            x86_64|amd64) arch="amd64" ;;
            aarch64|arm64) arch="arm64" ;;
            *) warn "guardrail: unsupported arch $(uname -m) - skipping"; return ;;
        esac
        local asset="guardrail_${os}_${arch}"
        local base="https://github.com/${repo}/releases/download/${ver}"
        local tmp; tmp="$(mktemp -d)"

        info "Installing guardrail ${ver} (${asset})..."
        if ! net_timeout 180 curl -fLo "$tmp/$asset" "${base}/${asset}"; then
            warn "guardrail: download failed or timed out - skipping"; rm -rf "$tmp"; return
        fi
        if ! net_timeout 60 curl -fLo "$tmp/SHA256SUMS" "${base}/SHA256SUMS"; then
            warn "guardrail: SHA256SUMS download failed - skipping (won't install unverified)"; rm -rf "$tmp"; return
        fi
        # stock macOS ships `shasum`, not `sha256sum` — without this the pipeline
        # returns 127, the install is skipped, and the Mac is left with NO guard
        # under a message that misattributes it to a checksum mismatch.
        local SHA_CMD
        if command -v sha256sum &>/dev/null; then SHA_CMD="sha256sum"
        elif command -v gsha256sum &>/dev/null; then SHA_CMD="gsha256sum"
        elif command -v shasum &>/dev/null; then SHA_CMD="shasum -a 256"
        else warn "guardrail: no SHA-256 tool found - cannot verify, skipping install"; rm -rf "$tmp"; return; fi
        if ! ( cd "$tmp" && grep " ${asset}\$" SHA256SUMS | $SHA_CMD -c - ); then
            warn "guardrail: CHECKSUM MISMATCH for ${asset} - not installing"; rm -rf "$tmp"; return
        fi
        mkdir -p "$HOME/.local/bin"
        install -m 0755 "$tmp/$asset" "$dest" || { warn "guardrail: install to $dest failed - skipping"; rm -rf "$tmp"; return; }
        rm -rf "$tmp"
        info "guardrail installed to $dest"
    fi

    if [ ! -x "$dest" ] || [ "$("$dest" version 2>/dev/null)" != "guardrail ${ver}" ]; then
        warn "guardrail: installed binary did not report guardrail ${ver} - skipping plane lifecycle"
        return
    fi
    info "guardrail version verified: $("$dest" version)"

    info "Enabling guardrail planes (approval URL prints here if WebAuthn is required)..."
    "$dest" plane enable --all

    # agy has no SessionStart surface, so antigravity MCP-config drift has no
    # "someone ran it" moment - gate its coverage here instead (exit 1 fails
    # the run; bare call, set -e enforces it).
    # `doctor --coverage antigravity` already prints the full doctor summary
    # plus the coverage diff - a second plain `doctor` call doubled the output
    # on every update. Enrollment guidance is guardrail's own UX now: the
    # approval flow names its fix when no authenticator is enrolled.
    "$dest" doctor --coverage antigravity
}

install_linux_desktop() {
    info "Installing Linux Desktop Apps..."

    # Ensure gpg is available (needed for repo keys)
    command -v gpg &>/dev/null || $SUDO apt install -y gpg

    # 1. Google Chrome
    if ! command -v google-chrome &>/dev/null; then
        info "Installing Google Chrome..."
        if net_timeout 300 wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb; then
            $SUDO apt install -y /tmp/chrome.deb || warn "Chrome install failed"
        else
            warn "Chrome download failed or timed out - skipping"
        fi
        rm -f /tmp/chrome.deb
    fi

    # 2. VS Code (Official Repo - MSFT)
    if ! command -v code &>/dev/null; then
        info "Installing VS Code..."
        net_timeout 60 wget -qO- https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > packages.microsoft.gpg
        $SUDO install -D -o root -g root -m 644 packages.microsoft.gpg /etc/apt/keyrings/packages.microsoft.gpg
        $SUDO sh -c 'echo "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list'
        rm packages.microsoft.gpg
        $SUDO apt update
        $SUDO apt install -y code
    fi

    # 3. Docker Desktop (Official .deb + Repo)
    # Replaces server-focused Docker Engine with Desktop version for GUI environments
    if ! dpkg -s docker-desktop &>/dev/null && ! command -v docker-desktop &>/dev/null; then
        info "Installing Docker Desktop..."

        # A. Setup Docker Repository (Required for 'docker-ce-cli' dependency)
        local distro_info distro_id distro_like distro_codename repo_base
        distro_info=$(get_distro_info)
        distro_id="${distro_info%%|*}"
        distro_like="${distro_info#*|}"
        distro_like="${distro_like%%|*}"
        distro_codename="${distro_info##*|}"

        case "$distro_id" in
            ubuntu) repo_base="https://download.docker.com/linux/ubuntu" ;;
            debian) repo_base="https://download.docker.com/linux/debian" ;;
            linuxmint)
                repo_base="https://download.docker.com/linux/ubuntu"
                # Use upstream Ubuntu codename for Mint (e.g. zena -> noble)
                if [[ -f /etc/os-release ]]; then
                    distro_codename=$(grep UBUNTU_CODENAME /etc/os-release | cut -d= -f2 | tr -d '"')
                fi
                ;;
            *) if [[ "$distro_like" == *debian* ]]; then repo_base="https://download.docker.com/linux/debian"; fi ;;
        esac

        if [[ -n "$repo_base" && -n "$distro_codename" ]]; then
            # Add Docker's official GPG key:
            $SUDO apt update # Refresh to ensure we can get prereqs
            $SUDO apt install -y ca-certificates curl
            $SUDO install -m 0755 -d /etc/apt/keyrings
            $SUDO curl -fsSL --max-time 60 "$repo_base/gpg" -o /etc/apt/keyrings/docker.asc
            $SUDO chmod a+r /etc/apt/keyrings/docker.asc

            # Add the repository to Apt sources:
            echo \
              "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] $repo_base \
              $distro_codename stable" | \
              $SUDO tee /etc/apt/sources.list.d/docker.list > /dev/null
            
            $SUDO apt update # Update indices to include docker repo
        else
            warn "Could not determine Docker repo for $distro_id (codename=$distro_codename). dependency 'docker-ce-cli' might fail."
        fi
        
        # B. Download and Install Docker Desktop .deb
        # Generic URL for latest stable amd64
        # Verified to work for Ubuntu, Debian, and Linux Mint
        local docker_deb_url="https://desktop.docker.com/linux/main/amd64/docker-desktop-amd64.deb"
        local docker_deb="/tmp/docker-desktop-amd64.deb"
        
        # Ensure curl is available
        command -v curl &>/dev/null || $SUDO apt install -y curl

        info "Downloading Docker Desktop..."
        # ~600MB .deb - the largest single download in this script.
        net_timeout 900 curl -fL -o "$docker_deb" "$docker_deb_url" || {
             warn "Failed to download Docker Desktop (or timed out)"
             rm -f "$docker_deb"
             return
        }
        
        info "Installing Docker Desktop package..."
        # apt install ./file.deb resolves dependencies automatically (including pulling docker-ce-cli from the repo we just added)
        $SUDO apt install -y "$docker_deb" || warn "Docker Desktop install failed"
        rm -f "$docker_deb"
    fi

    # Docker Desktop's VM backend needs /dev/kvm access via the "kvm" group -
    # confirmed against Docker's own install docs (docs.docker.com/desktop/setup/
    # install/linux/): `sudo usermod -aG kvm $USER`, not the "docker" group.
    # Desktop's CLI talks to a per-user socket (~/.docker/desktop/docker.sock,
    # the "desktop-linux" context) instead of the traditional group-owned
    # /var/run/docker.sock, so the classic "add user to docker group" advice
    # doesn't apply here at all - this was genuinely missing before, confirmed
    # via a full repo grep for "kvm"/"docker group" turning up nothing.
    # Checked unconditionally (not just inside the "just installed" branch
    # above) in case Docker Desktop was already present from before this fix
    # existed and never got this.
    if getent group kvm &>/dev/null; then
        if ! id -nG "$USER" | grep -qw kvm; then
            info "Adding $USER to the 'kvm' group (required for Docker Desktop's VM backend)..."
            if $SUDO usermod -aG kvm "$USER"; then
                warn "Added to 'kvm' group - Docker Desktop won't work until you log out and back in (or reboot). A new terminal or 'exec \$SHELL' will NOT pick this up: group membership is loaded at login (via initgroups()), not re-read per command, and Docker Desktop is a GUI app launched from your desktop session - not from whatever shell ran this script."
            else
                warn "Failed to add $USER to 'kvm' group - Docker Desktop's VM backend will not start until this is done manually: sudo usermod -aG kvm \$USER (then log out/in)"
            fi
        fi
    else
        warn "'kvm' group not found - Docker Desktop needs KVM virtualization support. Check 'ls -al /dev/kvm' and 'lsmod | grep kvm'; see https://docs.docker.com/desktop/setup/install/linux/ for prerequisites."
    fi

    # Utilities
    # geany: cross-platform replacement for Notepad++ (Windows-only, no real
    # Mac/Linux port) - fills the same "lightweight quick-edit GUI editor"
    # role. In Ubuntu's default apt repos, no extra setup needed.
    # Installed individually so one package that's unavailable on this release
    # doesn't take the whole `apt install` (and, under `set -e`, the run) down.
    for pkg in meld flameshot vlc p7zip-full obs-studio qbittorrent ghostscript geany; do
        $SUDO apt install -y "$pkg" || warn "Skipping '$pkg' (not installable on this release)."
    done

    # Termius (SSH/SFTP client - replaces FileZilla everywhere as of this
    # commit; FileZilla itself is fine on Linux/Windows, but its Homebrew
    # cask was pulled entirely on macOS, adware concerns - standardizing on
    # one tool across all 3 platforms rather than mixing). Static "latest"
    # .deb URL, same pattern as the Chrome download above - no repo/GPG key
    # needed, no version to track.
    if ! dpkg -s termius &>/dev/null && ! command -v termius &>/dev/null; then
        info "Installing Termius..."
        if net_timeout 300 wget -q -O /tmp/termius.deb https://download.termius.com/linux/Termius.deb; then
            $SUDO apt install -y /tmp/termius.deb || warn "Termius install failed"
        else
            warn "Termius download failed or timed out - skipping"
        fi
        rm -f /tmp/termius.deb
    fi

    # 4. ScreenRec (Official Repo - modern keyring)
    if ! command -v screenrec &>/dev/null; then
        info "Installing ScreenRec..."
        $SUDO mkdir -p /etc/apt/keyrings
        curl -fsSL --max-time 60 https://screenrec.com/download/pub.asc | $SUDO gpg --dearmor --yes -o /etc/apt/keyrings/screenrec.gpg
        echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/screenrec.gpg] https://screenrec.com/download/ubuntu stable main" | $SUDO tee /etc/apt/sources.list.d/screenrec.list > /dev/null
        $SUDO apt update || true
        # screenrec's .deb still hard-depends on libgdk-pixbuf2.0-0, which was renamed to
        # libgdk-pixbuf-2.0-0 on Ubuntu 24.04+ (Linux Lite 7). Don't let it abort the run,
        # and tear the repo back down on failure so future `apt update`s stay clean.
        if ! $SUDO apt install -y screenrec; then
            warn "ScreenRec install failed (stale libgdk-pixbuf2.0-0 dependency on Ubuntu 24.04+); removing its apt source."
            $SUDO rm -f /etc/apt/sources.list.d/screenrec.list /etc/apt/keyrings/screenrec.gpg
            $SUDO apt update || true
        fi
    fi

    # 5. Handy (Speech-to-Text, https://handy.computer) - not in any apt repo,
    # only distributed as GitHub release assets. No static "latest" .deb URL
    # like Chrome's, so resolve the current tag via the API first (same
    # pattern as the Meslo Nerd Font download in install_fonts() above).
    # Model selection (Whisper vs Parakeet, which size) is GUI-only - no CLI
    # flag or config file exists to pre-select one, so this only installs
    # the app. For Spanish + English both: pick a Whisper model in-app
    # (Parakeet is English-only, so it's off the table) - Large for the best
    # accuracy in both languages, or Turbo for a much faster model with a
    # small accuracy trade-off (most noticeable on non-English audio).
    if ! dpkg -s handy &>/dev/null; then
        info "Installing Handy (Speech-to-Text)..."
        local handy_version
        handy_version=$(curl -s --max-time 30 "https://api.github.com/repos/cjpais/Handy/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        if [[ -n "$handy_version" ]]; then
            if net_timeout 300 wget -q -O /tmp/handy.deb "https://github.com/cjpais/Handy/releases/download/v${handy_version}/Handy_${handy_version}_amd64.deb"; then
                $SUDO apt install -y /tmp/handy.deb || warn "Handy install failed"
            else
                warn "Handy download failed or timed out - skipping"
            fi
            rm -f /tmp/handy.deb
        else
            warn "Could not determine latest Handy version - skipping"
        fi
    fi

}

install_apt() {
{{- if or $core $modern_cli $fonts $agent_toolkit $opencode_cli $opencode_desktop $claude_cli $claude_desktop $chatgpt_cli $chatgpt_desktop $antigravity_cli $antigravity_desktop $dev_desktop $remote_access $guardrail }}
    info "Updating apt..."
    $SUDO apt update -y || true
    info "Upgrading installed packages..."
    $SUDO apt upgrade -y || true
{{- else }}
    info "No package categories enabled - skipping apt update/upgrade."
{{- end }}

{{- if $core }}
    info "Installing core packages..."
    $SUDO apt install -y git curl wget jq fzf zsh tmux ripgrep htop p7zip-full bc tree build-essential cmake openssh-client ca-certificates python3 python3-venv ffmpeg zstd

    # GitHub CLI - via the official apt repo rather than the distro-packaged
    # version, which lags upstream and is missing on Ubuntu 22.04 (jammy) since
    # it only entered the universe pocket at 23.04. This is GitHub's own
    # documented install snippet, works identically across every supported
    # Ubuntu/Debian release.
    if ! command -v gh &>/dev/null; then
        info "Installing GitHub CLI..."
        {
            $SUDO mkdir -p -m 755 /etc/apt/keyrings
            out=$(mktemp)
            net_timeout 60 wget -nv -O "$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg
            $SUDO tee /etc/apt/keyrings/githubcli-archive-keyring.gpg < "$out" > /dev/null
            $SUDO chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
            rm -f "$out"
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | $SUDO tee /etc/apt/sources.list.d/github-cli.list > /dev/null
            $SUDO apt update
            $SUDO apt install -y gh
        } || warn "GitHub CLI install failed - continuing"
    fi

    # Node.js 24.x
    install_node

    # Neovim
    if ! command -v nvim &>/dev/null; then
        info "Installing Neovim..."
        $SUDO apt install -y neovim || {
            net_timeout 180 curl -fLO https://github.com/neovim/neovim/releases/latest/download/nvim-linux64.tar.gz \
                && $SUDO tar -C /opt -xzf nvim-linux64.tar.gz \
                && $SUDO ln -sf /opt/nvim-linux64/bin/nvim /usr/local/bin/nvim
            rm -f nvim-linux64.tar.gz
        }
    fi
{{- else }}
    info "Core packages disabled in config"
{{- end }}

{{- if $remote_access }}
{{- if $isWsl }}
    info "Tailscale remains on Windows; WSL uses the Windows host's tailnet connection."
{{- else }}
    if ! command -v tailscale &>/dev/null; then
        info "Installing Tailscale..."
        net_timeout 180 bash -c 'curl -fsSL https://tailscale.com/install.sh | sh' \
            || warn "Tailscale install failed or timed out - continuing"
    fi
{{- end }}
    if command -v cloudflared &>/dev/null; then
        info "cloudflared already installed. Skipping."
    elif command -v apt-get &>/dev/null; then
        info "Installing cloudflared..."
        $SUDO mkdir -p --mode=0755 /usr/share/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | $SUDO tee /usr/share/keyrings/cloudflare-main.gpg >/dev/null
        echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" | $SUDO tee /etc/apt/sources.list.d/cloudflared.list
        $SUDO apt-get update -qq && $SUDO apt-get install -y cloudflared
    else
        warn "cloudflared: apt not found - manual install from https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/"
    fi
{{- end }}

{{- if $remote_access_server }}
    info "Installing OpenSSH Server prerequisites..."
    $SUDO apt install -y openssh-server || warn "OpenSSH Server prerequisite install failed - continuing"
    info "SSH service activation and access configuration remain manual. See docs/remote-access.md."
{{- end }}

{{- if $modern_cli }}
    # Modern CLI tools
    $SUDO apt install -y bat fd-find || true

    # CI and .pre-commit-config.yaml both lint shell with shellcheck; without it
    # locally a fresh machine only finds template errors in CI.
    # shfmt: built on mvdan.cc/sh, the same parser internal/engine/tokenize.go
    # uses - handy for seeing how the engine actually reads a command.
    $SUDO apt install -y shellcheck || warn "shellcheck install failed - continuing"
    if ! command -v shfmt &>/dev/null; then
        local shfmt_machine shfmt_arch="" shfmt_sha256=""
        shfmt_machine="$(uname -m)"
        case "$shfmt_machine" in
            x86_64|amd64)
                shfmt_arch="amd64"
                shfmt_sha256="27b3c6f9d9592fc5b4856c341d1ff2c88856709b9e76469313642a1d7b558fe0"
                ;;
            aarch64|arm64)
                shfmt_arch="arm64"
                shfmt_sha256="27e1f69b0d57c584bcbf5c882b4c4f78ffcf945d0efef45c1fbfc6692213c7c3"
                ;;
            *) warn "shfmt: unsupported architecture ${shfmt_machine} - skipping" ;;
        esac

        if [[ -n "$shfmt_arch" ]]; then
            local -a shfmt_sha_cmd=()
            if command -v sha256sum &>/dev/null; then shfmt_sha_cmd=(sha256sum)
            elif command -v gsha256sum &>/dev/null; then shfmt_sha_cmd=(gsha256sum)
            elif command -v shasum &>/dev/null; then shfmt_sha_cmd=(shasum -a 256)
            else warn "shfmt: no SHA-256 tool found - cannot verify, skipping install"; fi

            if (( ${#shfmt_sha_cmd[@]} > 0 )); then
                local shfmt_tmp shfmt_url
                shfmt_url="https://github.com/mvdan/sh/releases/download/v3.8.0/shfmt_v3.8.0_linux_${shfmt_arch}"
                if shfmt_tmp="$(mktemp)"; then
                    info "Installing shfmt..."
                    if ! net_timeout 120 curl -fLo "$shfmt_tmp" "$shfmt_url"; then
                        warn "shfmt download failed or timed out - continuing"
                    elif ! printf '%s  %s\n' "$shfmt_sha256" "$shfmt_tmp" | "${shfmt_sha_cmd[@]}" -c -; then
                        warn "shfmt checksum verification failed - not installing"
                    elif ! $SUDO install "$shfmt_tmp" /usr/local/bin/shfmt; then
                        warn "shfmt install failed - continuing"
                    fi
                    rm -f "$shfmt_tmp"
                else
                    warn "shfmt: could not create temporary file - skipping install"
                fi
            fi
        fi
    fi
    
    # Symlink batcat -> bat (Ubuntu/Debian)
    if command -v batcat &>/dev/null && ! command -v bat &>/dev/null; then
        info "Symlinking batcat -> bat..."
        mkdir -p "$HOME/.local/bin"
        ln -s "$(which batcat)" "$HOME/.local/bin/bat"
    fi

    # Symlink fdfind -> fd (Ubuntu/Debian's fd-find package installs as fdfind, same
    # naming-conflict reason as batcat above - confirmed missing live: fd was the
    # only tool out of the whole modern-tools list not found on PATH after a real
    # apt-based install in CI).
    if command -v fdfind &>/dev/null && ! command -v fd &>/dev/null; then
        info "Symlinking fdfind -> fd..."
        mkdir -p "$HOME/.local/bin"
        ln -s "$(which fdfind)" "$HOME/.local/bin/fd"
    fi

    # Zoxide (smarter cd)
    if ! command -v zoxide &>/dev/null; then
        info "Installing zoxide..."
        $SUDO apt install -y zoxide \
            || net_timeout 120 bash -c 'curl -sS https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash' \
            || warn "zoxide install failed or timed out - continuing"
    fi

    # Starship (prompt)
    if ! command -v starship &>/dev/null; then
        info "Installing Starship..."
        net_timeout 120 bash -c 'curl -sS https://starship.rs/install.sh | sh -s -- -y' 2>&1 | tail -1 || warn "Starship installer failed or timed out - continuing"
    fi

    # Direnv
    $SUDO apt install -y direnv || true

    # Lazygit
    if ! command -v lazygit &>/dev/null; then
        info "Installing lazygit..."
        LAZYGIT_VERSION=$(curl -s --max-time 30 "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        if net_timeout 180 curl -fLo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"; then
            tar xf lazygit.tar.gz lazygit && $SUDO install lazygit /usr/local/bin
        else
            warn "lazygit download failed or timed out - continuing"
        fi
        rm -f lazygit lazygit.tar.gz
    fi

    # Gum (Bubble Gum for shell scripts)
    if ! command -v gum &>/dev/null; then
        info "Installing gum..."
        $SUDO mkdir -p /etc/apt/keyrings
        curl -fsSL --max-time 60 https://repo.charm.sh/apt/gpg.key | $SUDO gpg --dearmor -o /etc/apt/keyrings/charm.gpg
        echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | $SUDO tee /etc/apt/sources.list.d/charm.list
        $SUDO apt update && $SUDO apt install -y gum
    fi

    # eza
    if ! command -v eza &>/dev/null; then
        info "Installing eza..."
        $SUDO apt install -y gpg
        $SUDO mkdir -p /etc/apt/keyrings
        # Ensure wget
        command -v wget &>/dev/null || $SUDO apt install -y wget
        net_timeout 60 wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | $SUDO gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
        echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | $SUDO tee /etc/apt/sources.list.d/gierens.list
        $SUDO apt update || true
        $SUDO apt install -y eza
    fi

    # git-delta (not in apt repos, download from GitHub)
    if ! command -v delta &>/dev/null; then
        info "Installing git-delta..."
        local delta_version
        delta_version=$(curl -s --max-time 30 "https://api.github.com/repos/dandavison/delta/releases/latest" | grep -Po '"tag_name": "\K[^"]*')
        local delta_deb="/tmp/git-delta_${delta_version}_amd64.deb"
        # Ensure wget
        command -v wget &>/dev/null || $SUDO apt install -y wget
        net_timeout 180 wget -q --show-progress -O "$delta_deb" \
            "https://github.com/dandavison/delta/releases/download/${delta_version}/git-delta_${delta_version}_amd64.deb" || {
            warn "Failed to download git-delta v${delta_version} (or timed out)"
        }
        if [[ -f "$delta_deb" ]]; then
            $SUDO dpkg -i "$delta_deb" || $SUDO apt install -f -y
            rm -f "$delta_deb"
        fi
    fi

    # duf (df replacement) - in the apt archive since Ubuntu 22.04 (jammy)
    $SUDO apt install -y duf || true

    # tealdeer (tldr) - not in apt until Ubuntu 23.04 (lunar), so download the
    # official static binary directly for full compatibility with older/other
    # distros (confirmed via the GitHub releases API, no .deb published).
    if ! command -v tldr &>/dev/null; then
        info "Installing tealdeer (tldr)..."
        # shellcheck disable=SC2015  # A && B || { fallback } is the intended shape here
        net_timeout 120 curl -fLo /tmp/tldr "https://github.com/dbrgn/tealdeer/releases/latest/download/tealdeer-linux-x86_64-musl" \
            && $SUDO install /tmp/tldr /usr/local/bin/tldr \
            && rm -f /tmp/tldr \
            || warn "Failed to install tealdeer (or timed out)"
    fi

    # dust (du replacement) - not in apt until Ubuntu 25.04 (plucky), so
    # download the GitHub-published .deb directly, same pattern as git-delta.
    if ! command -v dust &>/dev/null; then
        info "Installing dust..."
        local dust_version
        dust_version=$(curl -s --max-time 30 "https://api.github.com/repos/bootandy/dust/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        local dust_deb="/tmp/du-dust_${dust_version}-1_amd64.deb"
        net_timeout 180 wget -q -O "$dust_deb" \
            "https://github.com/bootandy/dust/releases/download/v${dust_version}/du-dust_${dust_version}-1_amd64.deb" || {
            warn "Failed to download dust v${dust_version} (or timed out)"
        }
        if [[ -f "$dust_deb" ]]; then
            $SUDO dpkg -i "$dust_deb" || $SUDO apt install -f -y
            rm -f "$dust_deb"
        fi
    fi

    # procs (ps replacement) - not in apt until Ubuntu 25.04 (plucky) either,
    # and only ships as a .zip (no .deb), so extract the binary directly.
    if ! command -v procs &>/dev/null; then
        info "Installing procs..."
        local procs_version
        procs_version=$(curl -s --max-time 30 "https://api.github.com/repos/dalance/procs/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
        # shellcheck disable=SC2015  # A && B || { fallback } is the intended shape here
        net_timeout 180 curl -fLo /tmp/procs.zip \
            "https://github.com/dalance/procs/releases/download/v${procs_version}/procs-v${procs_version}-x86_64-linux.zip" \
            && $SUDO apt install -y unzip \
            && unzip -o /tmp/procs.zip -d /tmp/procs-extract \
            && $SUDO install /tmp/procs-extract/procs /usr/local/bin/procs \
            && rm -rf /tmp/procs.zip /tmp/procs-extract \
            || warn "Failed to install procs"
    fi
{{- else }}
    info "Modern CLI tools disabled in config"
{{- end }}

{{- if $fonts }}
    # Fonts - MesloLGS NF is great for Starship too
    install_fonts

    # VS Code global defaults (terminal + editor) - gated by the
    # `vscode_settings` config key (hasKey pattern: default true, set
    # `vscode_settings = false` in chezmoi.toml to opt out; no prompt, so no
    # CI-seeding burden - see check_workflow_config_keys for that outage
    # class). Semantics identical to the .ps1 twin: FORCED font keys,
    # UPSERT-if-absent defaults, MERGE-only sub-keys for excludes.
    configure_vscode_font() {
        command -v python3 &>/dev/null || { warn "vscode: python3 required to edit settings.json - skipping"; return; }
        local settings
        case "$(uname -s)" in
            Linux)  settings="$HOME/.config/Code/User/settings.json" ;;
            Darwin) settings="$HOME/Library/Application Support/Code/User/settings.json" ;;
            *) return ;;
        esac
        mkdir -p "$(dirname "$settings")"

        # Curated GLOBAL defaults for human coding - deliberately stack-
        # agnostic (no formatters/linters/interpreters: those are per-project
        # concerns, and irrelevant to AI agents anyway). Semantics:
        #   FORCED  - font keys, re-asserted every run (consistency mandate:
        #             MesloLGS NF everywhere, matching the fonts group)
        #   UPSERT  - every other key only when ABSENT (user values win;
        #             project .vscode/settings.json still layers on top)
        #   MERGE   - object keys (files.exclude/search.exclude) gain only
        #             missing sub-keys
        python3 - "$settings" <<'PYEOF' || warn "vscode: could not update settings.json - leaving it untouched"
import json, os, re, sys

FORCED = {
    "editor.fontFamily": "MesloLGS Nerd Font Mono",
    "terminal.integrated.fontFamily": "MesloLGS Nerd Font Mono",
}
DEFAULTS = {
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500,
    "files.eol": "\n",
    "files.insertFinalNewline": True,
    "files.trimFinalNewlines": True,
    "files.trimTrailingWhitespace": True,
    "explorer.compactFolders": False,
    "editor.minimap.enabled": False,
    "editor.wordWrap": "on",
    "editor.formatOnSave": True,
    "diffEditor.ignoreTrimWhitespace": False,
    "diffEditor.wordWrap": "on",
    "workbench.startupEditor": "none",
    "terminal.integrated.scrollback": 30000,
    "terminal.integrated.shellIntegration.enabled": True,
    "cSpell.language": "en,es",
}
JUNK = ["**/__pycache__/**", "**/.venv/**", "**/venv/**",
        "**/node_modules/**", "**/*.pyc"]
MERGES = {"files.exclude": JUNK, "search.exclude": JUNK}

path = sys.argv[1]
text = ""
if os.path.exists(path):
    text = open(path, encoding="utf-8-sig").read()

# JSONC -> JSON: strip // and /* */ comments (never inside strings) and
# trailing commas (never inside strings), then strict-parse so malformed
# files still fail loudly instead of being clobbered.
out, i, n, in_str = [], 0, len(text), False
while i < n:
    c = text[i]
    if in_str:
        out.append(c)
        if c == "\\" and i + 1 < n:
            out.append(text[i + 1]); i += 1
        elif c == '"':
            in_str = False
        i += 1; continue
    if c == '"':
        in_str = True; out.append(c); i += 1; continue
    if c == "/" and i + 1 < n and text[i + 1] == "/":
        while i < n and text[i] != "\n": i += 1
        continue
    if c == "/" and i + 1 < n and text[i + 1] == "*":
        i += 2
        while i < n - 1 and not (text[i] == "*" and text[i + 1] == "/"): i += 1
        i += 2; continue
    out.append(c); i += 1
clean = re.sub(r",(\s*[}\]])", r"\1", "".join(out))

data = json.loads(clean) if clean.strip() else {}
changed = []
for k, v in FORCED.items():
    if data.get(k) != v:
        data[k] = v; changed.append(k + " (forced)")
for k, v in DEFAULTS.items():
    if k not in data:
        data[k] = v; changed.append(k)
for k, subs in MERGES.items():
    cur = data.setdefault(k, {})
    for s in subs:
        if s not in cur:
            cur[s] = True; changed.append(k + "." + s)

if not changed:
    print("  VS Code settings already at defaults (%s)" % path)
else:
    if os.path.exists(path):
        import shutil; shutil.copy2(path, path + ".bak")
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
    print("  VS Code settings: %d change(s), backup at .bak (%s)" % (len(changed), path))
PYEOF
    }
    if [ "$VSCODE_SETTINGS" = "true" ]; then
        command -v code &>/dev/null && configure_vscode_font
    else
        info "VS Code settings defaults disabled in config"
    fi
{{- else }}
    info "Fonts disabled in config"
{{- end }}

{{- if $agent_toolkit }}
    # Agent toolkit (spec §2: the cross-vendor agent layer - Serena, Graft,
    # act, Playwright Chromium. Codex moved to chatgpt_cli, Claude Code to
    # claude_cli, agy to antigravity_cli, OpenCode to opencode_cli: vendor
    # products live in vendor groups per the spec's placement rule).
    install_node

    # Ollama - needs zstd (added to core's apt list above) to extract its release
    # archive; confirmed live on WSL that without it the installer fails outright
    # with "This version requires zstd for extraction" and ollama ends up
    # genuinely NOT installed, not a harmless post-install nag like the macOS
    # case below. Keeping the || warn regardless (not || true): Ollama's own
    # installer can still exit non-zero after a successful install for reasons
    # unrelated to whether ollama itself actually landed (confirmed on macOS: it
    # tries to auto-launch the GUI app post-install, which fails outright with no
    # desktop session - e.g. headless CI). Under this script's `set -euo
    # pipefail`, letting that propagate would silently abort every remaining
    # install in this whole run, not just this one - but if you see this warning,
    # verify `command -v ollama` afterward rather than assuming it's benign.
    if ! command -v ollama &>/dev/null; then
        info "Installing Ollama..."
        # ~1.5GB bundle (GPU libs); its installer's curl has no timeout of its
        # own - confirmed live stalling 15+ min. `rm -f` the binary on failure
        # so a half-extracted install isn't seen as "installed" next run.
        net_timeout 1200 bash -c 'curl -fsSL https://ollama.com/install.sh | sh' \
            || { warn "Ollama install failed or timed out - continuing"; $SUDO rm -f /usr/local/bin/ollama; }
    fi

    if command -v npm &>/dev/null; then
        info "Installing agent toolkit (Playwright)..."
        NPM_BIN="$(which npm)"

        # Check if npm is user-managed (e.g. nvm, homebrew) to avoid sudo permission issues
        # If path starts with /usr, valid to use sudo. Otherwise (home dir), drop sudo.
        local npm_sudo="$SUDO"
        if [[ "$NPM_BIN" != /usr* ]]; then
            warn "Detected user-managed npm at $NPM_BIN. Dropping sudo."
            npm_sudo=""
        fi

        # Playwright Chromium - headless browser for coding-agent browser
        # automation. Deliberately here, not under dev_desktop: that's
        # gated host-only ($isHost) and never runs on WSL/containers, exactly
        # where coding agents most often run. install-deps needs root for
        # system packages; the actual browser binary download must NOT run as
        # root (playwright warns/refuses, and the cache would end up owned by
        # the wrong user) - kept as two separate steps for that reason.
        NPX_BIN="$(which npx)"
        info "Installing Playwright Chromium (headless browser for agent automation)..."
        # timeout-wrapped: confirmed live on WSL that `sudo ... npx playwright
        # install-deps` can hang indefinitely (state T, no further output) well
        # after apt-get's actual work is done - dpkg --audit showed everything
        # fully configured (ii) at the time, so this isn't a debconf prompt, it's
        # something in the sudo(use_pty)/npx/node wrapper chain never releasing
        # the pty. net_timeout wraps coreutils `timeout` (always on Linux) /
        # `gtimeout` (macOS only with coreutils brewed), running unguarded if
        # neither is present - so it's safe to reuse in the brew/macOS block too.
        net_timeout 300 $npm_sudo "$NPX_BIN" --yes playwright install-deps chromium || warn "Playwright system deps install failed or timed out - continuing"
        net_timeout 600 "$NPX_BIN" --yes playwright install chromium || warn "Playwright Chromium download failed or timed out - continuing"

        info "Installing agent-browser..."
        net_timeout 300 $npm_sudo "$NPM_BIN" install -g --allow-scripts=agent-browser agent-browser || warn "agent-browser install failed or timed out - continuing"
        AGENT_BROWSER_BIN="$("$NPM_BIN" prefix -g)/bin/agent-browser"
        if [[ -x "$AGENT_BROWSER_BIN" ]]; then
            # Playwright Chromium is already available above; agent-browser
            # discovers it before downloading another browser.
            net_timeout 600 "$AGENT_BROWSER_BIN" install || warn "agent-browser browser setup failed or timed out - continuing"
            net_timeout 60 "$AGENT_BROWSER_BIN" doctor --json || warn "agent-browser verification failed - continuing"
        else
            warn "agent-browser command was not installed - skipping browser setup"
        fi
    fi

    # Serena (oraios/serena) - MCP semantic code toolkit (LSP-backed find/
    # references/rename/replace-symbol). uv-managed: uv ships its own CPython
    # 3.13, so no system Python prerequisite. Register per-client: native
    # `serena setup` for claude-code/codex; JSON/TOML/manual for the rest.
    if ! command -v uv &>/dev/null; then
        info "Installing uv (Astral)..."
        net_timeout 180 bash -c 'curl -LsSf https://astral.sh/uv/install.sh | sh' \
            || warn "uv install failed or timed out - skipping Serena"
    fi
    if command -v uv &>/dev/null; then
        if ! command -v serena &>/dev/null; then
            info "Installing Serena via uv..."
            net_timeout 600 uv tool install -p 3.13 serena-agent \
                || warn "Serena install failed - skipping"
        fi
        if command -v serena &>/dev/null; then
            net_timeout 120 serena init || warn "serena init failed - continuing"
            if command -v claude &>/dev/null && ! claude mcp get serena &>/dev/null; then
                net_timeout 60 serena setup claude-code || warn "serena setup claude-code failed - continuing"
            fi
            # shellcheck disable=SC2015  # A && B || warn is the intended shape here (warn also when codex absent - benign skip)
            command -v codex &>/dev/null && net_timeout 60 serena setup codex || warn "serena setup codex failed - continuing"
        fi
    fi

    # opencode: global config mcp key (merge, never clobber the plugin key)
    if command -v opencode &>/dev/null && command -v serena &>/dev/null; then
        OC_GLOBAL="$HOME/.config/opencode/opencode.json"
        mkdir -p "$(dirname "$OC_GLOBAL")"
        if [ ! -f "$OC_GLOBAL" ] || ! grep -q '"serena"' "$OC_GLOBAL" 2>/dev/null; then
            info "Registering Serena MCP in opencode..."
            python3 - "$OC_GLOBAL" <<'PYEOF' 2>/dev/null || warn "opencode MCP registration failed - continuing"
import json, os, sys
p = sys.argv[1]
cfg = {}
if os.path.exists(p):
    with open(p) as f:
        cfg = json.load(f)
cfg.setdefault("mcp", {})["serena"] = {
    "type": "local",
    "command": ["serena", "start-mcp-server", "--context", "ide-assistant"],
    "enabled": True,
}
with open(p, "w") as f:
    json.dump(cfg, f, indent=2)
PYEOF
        fi
    fi
    # agy: first-class MCP management (verified: agy mcp add/list)
    if command -v agy &>/dev/null && command -v serena &>/dev/null; then
        if ! agy mcp list 2>/dev/null | grep -q serena; then
            info "Registering Serena MCP in agy..."
            net_timeout 60 agy mcp add serena serena start-mcp-server --context ide-assistant \
                || warn "agy MCP registration failed - continuing"
        fi
    fi

    # Graft (trailhq/Graft) - codebase context graph. Global CLI here;
    # per-repo activation is `graft init` (documented in
    # docs/agent-context-tools.md). Telemetry off per repo decision.
    # $SUDO on the install: apt-Node's global prefix is system-owned (plain
    # npm -g fails EACCES); brew-Node's prefix is user-writable (no sudo).
    # --allow-scripts: npm 12 blocks install scripts by default, which
    # silently skips graft's tree-sitter parser native builds - the binary
    # then crashes with "No native build was found" (node-gyp-build). The
    # allowlist is the exact list npm's own warning prints for this graft
    # version; if a graft update changes its parser set, npm's error output
    # prints the new list to paste here.
    if command -v npm &>/dev/null; then
        if ! command -v graft &>/dev/null; then
            info "Installing Graft (npm -g)..."
            net_timeout 300 $SUDO npm install -g --allow-scripts=@nanonets/graft,tree-sitter,tree-sitter-go,tree-sitter-java,tree-sitter-kotlin,tree-sitter-php,tree-sitter-python,@davisvaughan/tree-sitter-r,tree-sitter-swift,tree-sitter-typescript,tree-sitter-cli,tree-sitter-javascript @nanonets/graft \
                || warn "Graft install failed - skipping"
        fi
        # shellcheck disable=SC2015  # A && B || true is the intended shape here (graft absent = nothing to do)
        command -v graft &>/dev/null && net_timeout 60 graft telemetry disable \
            || true
    else
        warn "npm not found - skipping Graft"
    fi

    # act (nektosact.com) - runs GitHub Actions workflows locally via Docker.
    # No apt package exists; uses the official install script. Note: act runs
    # every job inside a real Docker container, and this repo's isDevcontainer
    # check treats any container as one (see .chezmoi.toml.tmpl) - so
    # $interactive can never be true under act, meaning it can validate
    # template/script syntax and the devcontainer code path, but can't
    # exercise the core/agent_toolkit/etc section content. Confirmed this
    # session testing a Superpowers install fix - had to fall back to
    # isolated `docker run` tests for that instead.
    # On WSL specifically: installing the binary here is harmless either way,
    # but it only actually works if Docker Desktop's WSL integration is
    # enabled for this distro (Settings > Resources > WSL Integration on the
    # Windows host) - the same existing assumption this repo already relies
    # on for Docker generally on WSL (see docs/tool-parity.md's Container row).
    if ! command -v act &>/dev/null; then
        info "Installing act (local GitHub Actions runner)..."
        net_timeout 180 bash -c 'curl -fsSL https://raw.githubusercontent.com/nektos/act/master/install.sh | '"$SUDO"' bash -s -- -b /usr/local/bin' || warn "act install failed or timed out"
    fi
{{- else }}
    info "Agent toolkit disabled in config"
{{- end }}

{{- if $opencode_cli }}
    # OpenCode CLI (opencode_cli group - the OpenCode vendor pair's CLI side,
    # split out of agent_toolkit per the spec's placement rule). Native
    # installer + superpowers-for-OpenCode wiring; guardrail's opencode plane
    # stays presence-gated in the guardrail section, and the Serena MCP
    # registration into opencode.json stays with Serena in agent_toolkit
    # (same precedent as `serena setup claude-code`).
    # The --version re-check matters: a legacy npm-global opencode-ai shim can
    # sit on PATH with a dead binary inside (its postinstall never fetched the
    # platform binary - confirmed live 2026-08-31: "opencode-ai's postinstall
    # script was not run"), and `command -v` alone treats that as installed
    # and never fixes it. The npm rm removes the shim so it can't shadow the
    # native binary the installer just laid down (~/.opencode/bin or ~/bin,
    # depending on what exists).
    if ! command -v opencode &>/dev/null || ! opencode --version &>/dev/null; then
         info "Installing OpenCode..."
         net_timeout 600 bash -c 'curl -fsSL https://opencode.ai/install | bash' || warn "OpenCode installer failed or timed out - continuing"
         npm rm -g opencode-ai &>/dev/null || true
    fi

    # Superpowers skills for OpenCode (separate mechanism from Claude
    # Code's plugin marketplace, which lives in the claude_cli section
    # now - OpenCode reads its own opencode.json config). jq merges into
    # the plugin array without clobbering any other settings already in
    # the file.
    if command -v opencode &>/dev/null; then
        info "Configuring Superpowers for OpenCode..."
        command -v jq &>/dev/null || $SUDO apt install -y jq
        local oc_config_dir="$HOME/.config/opencode"
        local oc_config="$oc_config_dir/opencode.json"
        local oc_plugin_spec="superpowers@git+https://github.com/obra/superpowers.git"
        mkdir -p "$oc_config_dir"
        if [[ ! -f "$oc_config" ]]; then
            echo "{\"plugin\": [\"$oc_plugin_spec\"]}" > "$oc_config"
        elif command -v jq &>/dev/null && ! grep -q "obra/superpowers" "$oc_config"; then
            jq --arg spec "$oc_plugin_spec" '.plugin = ((.plugin // []) + [$spec] | unique)' "$oc_config" > "$oc_config.tmp" && mv "$oc_config.tmp" "$oc_config"
        fi
    fi
{{- else }}
    info "OpenCode CLI disabled in config"
{{- end }}

{{- if $claude_cli }}
    # Claude Code (Native Installer - Recommended). Deliberately NOT nested
    # under an npm-presence check (its former home inside the old ai_tools
    # npm block): the native installer is curl|sh and needs no Node - so
    # claude_cli now works standalone even with core/agent_toolkit off.
    if ! command -v claude &>/dev/null; then
         info "Installing Claude Code (Native)..."
         net_timeout 300 bash -c 'curl -fsSL https://claude.ai/install.sh | bash' || warn "Claude Code installer failed or timed out - continuing"
    fi

    configure_claude_attribution() {
        local settings_dir="$HOME/.claude"
        local settings="$settings_dir/settings.json"
        local temporary
        local mode

        if ! command -v jq &>/dev/null; then
            $SUDO apt install -y jq || {
                warn "jq is required to configure Claude Code attribution - skipping"
                return
            }
        fi
        if ! command -v jq &>/dev/null; then
            warn "jq is required to configure Claude Code attribution - skipping"
            return
        fi

        mkdir -p "$settings_dir"
        if ! temporary="$(mktemp "$settings_dir/.settings.json.XXXXXX")"; then
            warn "Could not create temporary Claude Code settings"
            return
        fi

        if [[ -s "$settings" ]]; then
            if ! jq '.attribution = ((.attribution // {}) + {commit: "", pr: "", sessionUrl: false})' "$settings" > "$temporary"; then
                rm -f "$temporary"
                warn "Could not parse Claude Code settings - leaving them untouched"
                return
            fi
            if [[ "$(uname -s)" == Darwin ]]; then
                mode="$(stat -f '%Lp' "$settings")"
            else
                mode="$(stat -c '%a' "$settings")"
            fi
            if ! chmod "$mode" "$temporary"; then
                rm -f "$temporary"
                warn "Could not preserve Claude Code settings permissions"
                return
            fi
        else
            if ! jq -n '{attribution: {commit: "", pr: "", sessionUrl: false}}' > "$temporary"; then
                rm -f "$temporary"
                warn "Could not create Claude Code settings"
                return
            fi
            chmod 600 "$temporary"
        fi
        if ! mv -f "$temporary" "$settings"; then
            rm -f "$temporary"
            warn "Could not replace Claude Code settings"
        fi
    }

    # Superpowers skills plugin for Claude Code (global - active in every
    # session once installed, via Claude Code's own plugin marketplace
    # mechanism, not npm). Re-running add/install is safe if already present.
    if command -v claude &>/dev/null; then
        configure_claude_attribution
        info "Installing Superpowers plugin for Claude Code..."
        claude plugin marketplace add obra/superpowers-marketplace 2>/dev/null || true
        claude plugin install superpowers@superpowers-marketplace 2>/dev/null || warn "Superpowers plugin install failed - continuing"
    fi
{{- else }}
    info "Claude Code disabled in config"
{{- end }}

{{- if $chatgpt_cli }}
    # Codex CLI (@openai/codex via npm). Spec §2: zero wiring by design -
    # superpowers/skills/guardrail have no codex surface (the guardrail and
    # skills passes stay presence-gated on their own CLIs; only this npm
    # install lives here).
    install_node
    if command -v npm &>/dev/null; then
        info "Installing Codex CLI..."
        NPM_BIN="$(which npm)"

        # Check if npm is user-managed (e.g. nvm, homebrew) to avoid sudo permission issues
        # If path starts with /usr, valid to use sudo. Otherwise (home dir), drop sudo.
        local npm_sudo="$SUDO"
        if [[ "$NPM_BIN" != /usr* ]]; then
            warn "Detected user-managed npm at $NPM_BIN. Dropping sudo."
            npm_sudo=""
        fi

        command -v codex &>/dev/null || $npm_sudo "$NPM_BIN" install -g @openai/codex || warn "Codex CLI install failed - continuing"
    else
        warn "npm not found - skipping Codex CLI"
    fi

    # Superpowers for Codex CLI: deliberately NOT automated. Confirmed
    # live via an isolated Docker test that the third-party `codex-plugin`
    # npm helper (the only scriptable option) doesn't just prompt
    # interactively - it expects a plugins/<name>/ marketplace layout
    # that obra/superpowers doesn't use (it ships a root-level
    # .codex-plugin/plugin.json manifest instead), so it fails outright
    # regardless of flags. Codex's real install path for this plugin is
    # its native in-app `/plugins` search UI - genuinely GUI/session-only,
    # no config file or CLI command reaches it from outside a session.
{{- else }}
    info "Codex CLI disabled in config"
{{- end }}

{{- if $antigravity_cli }}
    # Antigravity CLI (agy) - official install script, no apt package.
    # Google retired standalone Gemini Code Assist for individuals in
    # favor of the Antigravity suite (see docs/tool-parity.md) - this
    # repo no longer installs Gemini CLI, agy replaces it here. Like
    # Claude Code above, the install.sh is self-contained: no Node/npm
    # prerequisite, so this section works standalone.
    if ! command -v agy &>/dev/null; then
         info "Installing Antigravity CLI (agy)..."
         net_timeout 300 bash -c 'curl -fsSL https://antigravity.google/cli/install.sh | bash' || warn "Antigravity CLI installer failed or timed out - continuing"
    fi

    # Superpowers plugin for Antigravity CLI (agy). `agy plugin install
    # <url>` is the officially-documented mechanism (obra/superpowers'
    # own README.md Antigravity section, confirmed against the locally-
    # installed copy's docs) - NOT hand-copying skill files into a
    # guessed plugin directory: Superpowers' own contributor docs
    # (docs/porting-to-a-new-harness.md) explicitly call that fragile/
    # unsupported ("Everything arrives through the install mechanism -
    # not by editing the user's config"). This also sidesteps needing to
    # hardcode Antigravity's actual plugin storage path here (confirmed
    # live: `~/.gemini/config/plugins/<name>/` - antigravity.google's own
    # docs claim `~/.gemini/antigravity-cli/plugins/<name>/` instead,
    # which is simply wrong as of agy 1.1.22) - agy itself resolves this,
    # not us, so it stays correct even if/when that path changes again.
    if command -v agy &>/dev/null; then
        info "Installing Superpowers plugin for Antigravity..."
        agy plugin install https://github.com/obra/superpowers 2>/dev/null || warn "Superpowers plugin install for Antigravity failed - continuing"
    fi
{{- else }}
    info "Antigravity CLI disabled in config"
{{- end }}

{{- if or $claude_cli $antigravity_cli $agent_toolkit $opencode_cli }}
    # Curated third-party skills (Matt Pocock's 11 + mp-code-review +
    # Anthropic's frontend-design) for Claude Code / OpenCode / Antigravity,
    # via the `skills` CLI - see install_agent_skills above. Cross-cutting
    # pass (spec §2 wiring rule): fires when ANY of its target groups
    # (claude_cli / antigravity_cli / agent_toolkit / opencode_cli) is
    # enabled - the CLIs it writes to may have arrived from any of those
    # gates, and the pass is idempotent either way. npx presence is checked
    # inside the function.
    install_agent_skills
{{- end }}

    # agent-guardrails binary + plane desired state - see install_agent_guardrails above.
    install_agent_guardrails

    # Desktop Apps (hosts only - see the top-of-file $isHost comment; $DISPLAY
    # is a second runtime check for genuine headless Linux hosts, not the
    # primary WSL/devcontainer guard anymore)
{{- if and $dev_desktop $isHost }}
    if [[ -n "${DISPLAY:-}" ]]; then
        install_linux_desktop
    fi
{{- else }}
    info "Desktop apps disabled (WSL/Devcontainer/config)"
{{- end }}
}

install_brew() {
    info "Installing packages with Brew..."
    
    if ! command -v brew &>/dev/null; then
        info "Homebrew not found. Installing..."
        # Fetch and run as two guarded steps so a stalled download is covered
        # too, while keeping Homebrew's documented `bash -c "$(...)"` exec form.
        # net_timeout falls back to unguarded when no timeout/gtimeout exists
        # (the usual case on a fresh Mac), so this can't make matters worse.
        # shellcheck disable=SC2015  # A && B || { fallback } is the intended shape here
        _brew_installer=$(net_timeout 120 curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh) \
            && net_timeout 900 env NONINTERACTIVE=1 /bin/bash -c "$_brew_installer" || {
            error "Failed to install Homebrew (or timed out)"
            exit 1
        }
        
        # Add brew to path for this session
        if [[ -d "/opt/homebrew/bin" ]]; then
             eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [[ -d "/home/linuxbrew/.linuxbrew/bin" ]]; then
             eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        fi
    fi

{{- if $core }}
    # Core packages. coreutils first: it provides `gtimeout`, which net_timeout
    # needs to guard the download-heavy steps further down (modern tools, the
    # agent toolkit, ScreenRec's dmg, Antigravity 2.0's dmg) - macOS has no
    # `timeout` in the base OS.
    brew install coreutils gcc git curl wget jq fzf zsh tmux neovim ripgrep htop tree node@24 python3 cmake ffmpeg sevenzip gh
    brew link --overwrite node@24 || true
{{- else }}
    info "Core packages disabled in config"
{{- end }}

{{- if $modern_cli }}
    # Modern CLI tools
    brew install bat eza fd git-delta zoxide starship direnv lazygit gum tealdeer dust duf procs || true
    brew install shellcheck shfmt || warn "shellcheck/shfmt install failed - continuing"
{{- end }}

{{- if $fonts }}
    # Fonts - MesloLGS NF is a great Nerd Font for Starship
    brew install --cask font-meslo-lg-nerd-font || true
{{- end }}

{{- if $remote_access }}
    brew install --cask tailscale-app || warn "tailscale-app install failed - continuing"
    brew install cloudflared || warn "cloudflared install failed - continuing"
{{- end }}

{{- if $remote_access_server }}
    info "Remote Login is built in to macOS; enable it manually in System Settings. See docs/remote-access.md."
{{- end }}

{{- if $agent_toolkit }}
    # Agent toolkit (spec §2: the cross-vendor agent layer - Serena, Graft,
    # act, Playwright Chromium. Codex moved to chatgpt_cli, Claude Code to
    # claude_cli, agy to antigravity_cli, OpenCode to opencode_cli - vendor
    # products live in vendor groups per the spec's placement rule).

    # Ollama
    if ! command -v ollama &>/dev/null; then
        info "Installing Ollama..."
        # Confirmed live: Ollama's official macOS installer exits non-zero after
        # ollama itself is genuinely installed, because it also tries to
        # auto-launch the Ollama.app GUI post-install, which fails outright with
        # no desktop session (e.g. headless CI: "Unable to find application named
        # 'Ollama'"). Under this script's `set -euo pipefail`, letting that
        # propagate silently aborts every remaining install in this whole run -
        # confirmed live too: nothing after this point ran at all. net_timeout
        # also guards the ~1.5GB download from stalling the run (no-op on a Mac
        # without coreutils' gtimeout).
        net_timeout 1200 bash -c 'curl -fsSL https://ollama.com/install.sh | sh' || warn "Ollama installer failed, timed out, or (often harmless) could not auto-launch its GUI - continuing"
    fi

    if command -v npm &>/dev/null; then
        info "Installing agent toolkit (Playwright)..."

        # Playwright Chromium - headless browser for coding-agent browser
        # automation. Deliberately here, not under dev_desktop: that's
        # gated host-only ($isHost) and never runs on WSL/containers, exactly
        # where coding agents most often run. No install-deps step on macOS -
        # that concept is apt-specific and unsupported/unneeded here.
        info "Installing Playwright Chromium (headless browser for agent automation)..."
        net_timeout 600 npx --yes playwright install chromium || warn "Playwright Chromium install failed or timed out - continuing"
    fi

    # Serena (oraios/serena) - MCP semantic code toolkit (LSP-backed find/
    # references/rename/replace-symbol). uv-managed: uv ships its own CPython
    # 3.13, so no system Python prerequisite. Register per-client: native
    # `serena setup` for claude-code/codex; JSON/TOML/manual for the rest.
    if ! command -v uv &>/dev/null; then
        info "Installing uv (Astral)..."
        net_timeout 180 bash -c 'curl -LsSf https://astral.sh/uv/install.sh | sh' \
            || warn "uv install failed or timed out - skipping Serena"
    fi
    if command -v uv &>/dev/null; then
        if ! command -v serena &>/dev/null; then
            info "Installing Serena via uv..."
            net_timeout 600 uv tool install -p 3.13 serena-agent \
                || warn "Serena install failed - skipping"
        fi
        if command -v serena &>/dev/null; then
            net_timeout 120 serena init || warn "serena init failed - continuing"
            if command -v claude &>/dev/null && ! claude mcp get serena &>/dev/null; then
                net_timeout 60 serena setup claude-code || warn "serena setup claude-code failed - continuing"
            fi
            # shellcheck disable=SC2015  # A && B || warn is the intended shape here (warn also when codex absent - benign skip)
            command -v codex &>/dev/null && net_timeout 60 serena setup codex || warn "serena setup codex failed - continuing"
        fi
    fi

    # opencode: global config mcp key (merge, never clobber the plugin key)
    if command -v opencode &>/dev/null && command -v serena &>/dev/null; then
        OC_GLOBAL="$HOME/.config/opencode/opencode.json"
        mkdir -p "$(dirname "$OC_GLOBAL")"
        if [ ! -f "$OC_GLOBAL" ] || ! grep -q '"serena"' "$OC_GLOBAL" 2>/dev/null; then
            info "Registering Serena MCP in opencode..."
            python3 - "$OC_GLOBAL" <<'PYEOF' 2>/dev/null || warn "opencode MCP registration failed - continuing"
import json, os, sys
p = sys.argv[1]
cfg = {}
if os.path.exists(p):
    with open(p) as f:
        cfg = json.load(f)
cfg.setdefault("mcp", {})["serena"] = {
    "type": "local",
    "command": ["serena", "start-mcp-server", "--context", "ide-assistant"],
    "enabled": True,
}
with open(p, "w") as f:
    json.dump(cfg, f, indent=2)
PYEOF
        fi
    fi
    # agy: first-class MCP management (verified: agy mcp add/list)
    if command -v agy &>/dev/null && command -v serena &>/dev/null; then
        if ! agy mcp list 2>/dev/null | grep -q serena; then
            info "Registering Serena MCP in agy..."
            net_timeout 60 agy mcp add serena serena start-mcp-server --context ide-assistant \
                || warn "agy MCP registration failed - continuing"
        fi
    fi

    # Graft (trailhq/Graft) - codebase context graph. Global CLI here;
    # per-repo activation is `graft init` (documented in
    # docs/agent-context-tools.md). Telemetry off per repo decision.
    # --allow-scripts: npm 12 blocks install scripts by default, which
    # silently skips graft's tree-sitter parser native builds - the binary
    # then crashes with "No native build was found" (node-gyp-build). The
    # allowlist is the exact list npm's own warning prints for this graft
    # version; if a graft update changes its parser set, npm's error output
    # prints the new list to paste here. (No $SUDO here, unlike the apt
    # branch: brew-Node's global prefix is user-writable.)
    if command -v npm &>/dev/null; then
        if ! command -v graft &>/dev/null; then
            info "Installing Graft (npm -g)..."
            net_timeout 300 npm install -g --allow-scripts=@nanonets/graft,tree-sitter,tree-sitter-go,tree-sitter-java,tree-sitter-kotlin,tree-sitter-php,tree-sitter-python,@davisvaughan/tree-sitter-r,tree-sitter-swift,tree-sitter-typescript,tree-sitter-cli,tree-sitter-javascript @nanonets/graft \
                || warn "Graft install failed - skipping"
        fi
        # shellcheck disable=SC2015  # A && B || true is the intended shape here (graft absent = nothing to do)
        command -v graft &>/dev/null && net_timeout 60 graft telemetry disable \
            || true
    else
        warn "npm not found - skipping Graft"
    fi

    # act (nektosact.com) - runs GitHub Actions workflows locally via Docker.
    # Confirmed current on Homebrew (formula, not cask). Note: act runs every
    # job inside a real Docker container, and this repo's isDevcontainer
    # check treats any container as one (see .chezmoi.toml.tmpl) - so
    # $interactive can never be true under act, meaning it can validate
    # template/script syntax and the devcontainer code path, but can't
    # exercise the core/agent_toolkit/etc section content. Confirmed this
    # session testing a Superpowers install fix - had to fall back to
    # isolated `docker run` tests for that instead.
    command -v act &>/dev/null || brew install act || warn "act install failed"
{{- else }}
    info "Agent toolkit disabled in config"
{{- end }}

{{- if $opencode_cli }}
    # OpenCode CLI (opencode_cli group - the OpenCode vendor pair's CLI side,
    # split out of agent_toolkit per the spec's placement rule). Native
    # installer + superpowers-for-OpenCode wiring; guardrail's opencode plane
    # stays presence-gated in the guardrail section, and the Serena MCP
    # registration into opencode.json stays with Serena in agent_toolkit
    # (same precedent as `serena setup claude-code`). No Node prerequisite:
    # the native installer is curl|sh, so this section works standalone even
    # with core/agent_toolkit off (the sh twin of claude_cli's arrangement).
    # --version re-check + legacy npm shim removal: a dead npm-global
    # opencode-ai on PATH otherwise counts as "installed" forever.
    if ! command -v opencode &>/dev/null || ! opencode --version &>/dev/null; then
         info "Installing OpenCode..."
         net_timeout 600 bash -c 'curl -fsSL https://opencode.ai/install | bash' || warn "OpenCode installer failed or timed out - continuing"
         npm rm -g opencode-ai &>/dev/null || true
    fi

    # Superpowers skills for OpenCode (separate mechanism from Claude
    # Code's plugin marketplace, which lives in the claude_cli section
    # now - OpenCode reads its own opencode.json config). jq merges into
    # the plugin array without clobbering any other settings already in
    # the file.
    if command -v opencode &>/dev/null; then
        info "Configuring Superpowers for OpenCode..."
        command -v jq &>/dev/null || brew install jq
        local oc_config_dir="$HOME/.config/opencode"
        local oc_config="$oc_config_dir/opencode.json"
        local oc_plugin_spec="superpowers@git+https://github.com/obra/superpowers.git"
        mkdir -p "$oc_config_dir"
        if [[ ! -f "$oc_config" ]]; then
            echo "{\"plugin\": [\"$oc_plugin_spec\"]}" > "$oc_config"
        elif command -v jq &>/dev/null && ! grep -q "obra/superpowers" "$oc_config"; then
            jq --arg spec "$oc_plugin_spec" '.plugin = ((.plugin // []) + [$spec] | unique)' "$oc_config" > "$oc_config.tmp" && mv "$oc_config.tmp" "$oc_config"
        fi
    fi
{{- else }}
    info "OpenCode CLI disabled in config"
{{- end }}

{{- if $claude_cli }}
    # Claude Code (Native Installer - Recommended). Not nested under an
    # npm-presence check (its former home inside the old ai_tools npm
    # block): the native installer is curl|sh and needs no Node - so
    # claude_cli now works standalone even with core/agent_toolkit off.
    if ! command -v claude &>/dev/null; then
         info "Installing Claude Code (Native)..."
         net_timeout 300 bash -c 'curl -fsSL https://claude.ai/install.sh | bash' || warn "Claude Code installer failed or timed out - continuing"
    fi

    # Superpowers skills plugin for Claude Code (global - active in every
    # session once installed, via Claude Code's own plugin marketplace
    # mechanism, not npm). Re-running add/install is safe if already present.
    if command -v claude &>/dev/null; then
        info "Installing Superpowers plugin for Claude Code..."
        claude plugin marketplace add obra/superpowers-marketplace 2>/dev/null || true
        claude plugin install superpowers@superpowers-marketplace 2>/dev/null || warn "Superpowers plugin install failed - continuing"
    fi
{{- else }}
    info "Claude Code disabled in config"
{{- end }}

{{- if $chatgpt_cli }}
    # Codex CLI (@openai/codex via npm). Spec §2: zero wiring by design -
    # superpowers/skills/guardrail have no codex surface (the guardrail and
    # skills passes stay presence-gated on their own CLIs; only this npm

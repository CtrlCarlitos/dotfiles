# gum (charmbracelet) - not published to Chocolatey; install from the latest GitHub release
function Install-Gum {
    $gumExe = "$env:LOCALAPPDATA\Programs\gum\gum.exe"
    if (Test-Path $gumExe) { return }
    Write-Host "  Installing gum..." -ForegroundColor Yellow
    try {
        $release = Invoke-RestMethod -Uri "https://api.github.com/repos/charmbracelet/gum/releases/latest" -UseBasicParsing -TimeoutSec 30
        $asset = $release.assets | Where-Object { $_.name -like "gum_*_Windows_x86_64.zip" } | Select-Object -First 1
        if (-not $asset) {
            Write-Host "  Warning: Could not find a gum Windows release asset." -ForegroundColor Red
            return
        }
        $gumDir = Split-Path $gumExe -Parent
        New-Item -ItemType Directory -Force -Path $gumDir | Out-Null
        $zipPath = "$env:TEMP\gum.zip"
        $extractDir = "$env:TEMP\gum-extract"
        Invoke-WebRequest -Uri $asset.browser_download_url -OutFile $zipPath -UseBasicParsing -TimeoutSec 180
        Expand-Archive -Path $zipPath -DestinationPath $extractDir -Force
        $extractedExe = Get-ChildItem $extractDir -Recurse -Filter "gum.exe" | Select-Object -First 1
        if (-not $extractedExe) {
            Write-Host "  Warning: gum.exe not found inside downloaded archive." -ForegroundColor Red
            return
        }
        Copy-Item $extractedExe.FullName $gumExe -Force
        Remove-Item $zipPath, $extractDir -Recurse -Force -ErrorAction SilentlyContinue

        # Persist gum's directory on the User PATH (session PATH is refreshed elsewhere in this script)
        $userPath = [System.Environment]::GetEnvironmentVariable("Path", "User")
        if ($userPath -notlike "*$gumDir*") {
            [System.Environment]::SetEnvironmentVariable("Path", "$userPath;$gumDir", "User")
        }
        Write-Host "  gum installed!" -ForegroundColor Green
    } catch {
        Write-Host "  Warning: Failed to install gum - $_" -ForegroundColor Red
    }
}
Install-Gum
{{- end }}


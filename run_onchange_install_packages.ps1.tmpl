{{- if $agent_toolkit }}
Install-MobileDev
{{- else }}
Write-Host "Warning: mobile_dev requires agent_toolkit (Serena/Playwright) - not installed; enable agent_toolkit and re-run" -ForegroundColor Yellow
{{- end }}
{{- end }}
# Graft was dropped from the dotfiles (2026-10-09): remove it where an earlier run installed it.
# Every run and whatever the groups say (it was installed under agent_toolkit, which may since
# have been turned off); quiet when there is nothing to do (Invoke-GraftRetirement,

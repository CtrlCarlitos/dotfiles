# The catalog's npm globals (field `npm`: markdownlint-cli2), each only when it is missing;
# `dot upgrade` keeps them current. Same names on every OS.
function Install-NpmCatalogTool {
    param([string[]]$Package)
    if (@($Package).Count -eq 0) { return }
    Install-Node
    if (-not (Get-Command npm -ErrorAction SilentlyContinue)) {
        Write-Host "  npm not found - skipping $($Package -join ', ')" -ForegroundColor Red
        return
    }
    # Native stderr throws under Stop on Windows PowerShell 5.1; probe under Continue.
    $ErrorActionPreference = 'Continue'
    foreach ($npmTool in $Package) {
        npm ls -g --depth=0 $npmTool 2>$null | Out-Null
        if ($LASTEXITCODE -eq 0) { continue }
        Write-Host "  Installing $npmTool (npm)..." -ForegroundColor Yellow
        npm install -g $npmTool --loglevel=error --no-progress --fetch-timeout=120000 --fetch-retries=2 2>$null
        if ($LASTEXITCODE -ne 0) { Write-Host "  Warning: $npmTool install failed - continuing" -ForegroundColor Red }
    }
}

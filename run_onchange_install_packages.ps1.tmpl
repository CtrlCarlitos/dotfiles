Invoke-GraftRetirement

Add-DotTimingMark -Name 'OpenCode'
{{- if $opencode_cli }}
# choco abandons lib-bkp\opencode whenever an upgrade ran while an opencode
# session held the binary open (access denied x3 retries, then left behind -
# confirmed live twice on 2026-09-20). Harmless but confuses later upgrades;
# clear it whenever no opencode process is alive.
if ($env:ChocolateyInstall -and (Test-Path (Join-Path $env:ChocolateyInstall 'lib-bkp\opencode'))) {
    if (-not (Get-Process opencode -ErrorAction SilentlyContinue)) {
        Remove-Item (Join-Path $env:ChocolateyInstall 'lib-bkp\opencode') -Recurse -Force -ErrorAction SilentlyContinue
        Write-Host "  Cleared choco lib-bkp\opencode leftover" -ForegroundColor Green
    }
}
# OpenCode CLI (opencode_cli group - the OpenCode vendor pair's CLI side,
# split out of agent_toolkit per the spec's placement rule). choco install +
# superpowers-for-OpenCode wiring; guardrail's opencode plane wiring is
# done by the agent-guardrails installer, and the Serena MCP registration
# into opencode.json stays with Serena in agent_toolkit.

# OpenCode: winget's SST.opencode, installed by the catalog's winget pass above (Chocolatey's
#    opencode package only where winget is missing). NOT npm: opencode-ai's npm package only fetches
#    its real platform binary in a postinstall script, and any install
#    where that didn't run (npm 12 script handling, --ignore-scripts,
#    partial installs) leaves bin/opencode.exe an invalid exe - every
#    launch then dies with "not a valid application for this OS platform"
#    from the %APPDATA%\npm\opencode.ps1 shim (confirmed live 2026-08-31
#    on a machine this repo had npm-installed it on). The --version
#    re-check matters because Get-Command alone is fooled by that shim
#    (the shim exists, the binary inside it is dead), and the npm rm is
#    required or the leftover shim keeps shadowing choco's binary - the
#    PowerShell profile prepends %APPDATA%\npm to PATH ahead of the real binary.
# winget installs it as a portable package: its command link lands in WinGet\Links, which a
# first portable install adds to the user PATH - this session only sees it after a re-read.
$wingetLinks = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links'
if ((Test-Path $wingetLinks) -and (($env:Path -split ';') -notcontains $wingetLinks)) { $env:Path = "$wingetLinks;" + $env:Path }
$ocWorks = $false
if (Get-Command opencode -ErrorAction SilentlyContinue) {
    try { opencode --version 2>&1 | Out-Null; $ocWorks = ($LASTEXITCODE -eq 0) } catch { $ocWorks = $false }
}
if (-not $ocWorks) {
    # Get-Command guard + try/catch, not a bare call: choco can legitimately
    # be absent here (non-admin run where Chocolatey itself was skipped -
    # see the degraded-mode warning at the top of this script), and under
    # $ErrorActionPreference=Stop a bare `choco ...` would then throw
    # CommandNotFoundException and silently kill everything after this
    # point (Superpowers, skills, Playwright, Antigravity, desktop apps).
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        # The winget pass above installs SST.opencode; reaching here means it failed (its warning
        # is printed there) or the binary does not run.
        Write-Host "  Warning: OpenCode (winget SST.opencode) is not working - see the winget install above, or run: winget install --id SST.opencode --exact" -ForegroundColor Red
    } elseif (Get-Command choco -ErrorAction SilentlyContinue) {
        Write-Host "  Installing OpenCode (choco - winget is not available)..." -ForegroundColor Yellow
        try {
            choco install opencode -y --no-progress | Out-Null
            if ($LASTEXITCODE -ne 0) {
                Write-Host "  Warning: Failed to install OpenCode (choco exit code $LASTEXITCODE)" -ForegroundColor Red
            }
        } catch {
            Write-Host "  Warning: Failed to install OpenCode - $_" -ForegroundColor Red
        }
    } else {
        Write-Host "  Warning: choco not found - cannot install OpenCode (needs Chocolatey; re-run elevated so it gets installed)" -ForegroundColor Red
    }
    Invoke-Quietly -Description "Failed to remove legacy npm opencode-ai shim" -Action { npm rm -g opencode-ai --loglevel=error --no-progress 2>$null }
    # Make choco's shim resolvable by the OpenCode-gated steps below. Prefer
    # prepending choco's bin over the full Machine+User rebuild: %APPDATA%\npm
    # (where the npm/npx shims live) can be session-only - the PowerShell
    # profile prepends it at runtime - and a full rebuild would drop it from
    # this session, silently skipping every later npm/npx step.
    $chocoBin = if ($env:ChocolateyInstall) { Join-Path $env:ChocolateyInstall "bin" } else { "C:\ProgramData\chocolatey\bin" }
    if (Test-Path $chocoBin) {
        $env:Path = "$chocoBin;" + $env:Path
    } else {
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
}

# Superpowers skills for OpenCode (separate mechanism from Claude
# Code's plugin marketplace, which lives in the claude_cli section
# below - OpenCode reads its own opencode.json config). Uses the
# Windows-specific workaround from
#    obra/superpowers' own install docs: the standard git+https plugin
#    spec has documented upstream OpenCode/Windows issues (Bun not
#    finding git.exe, cache-path bugs), so install via `npm --prefix`
#    instead and point opencode.json at the resulting local package.
# Install-Node first: the --prefix install needs npm, independent of the
# choco'd CLI above (same standalone-with-core-off shape as claude_cli).
Install-Node
if (Get-Command npm -ErrorAction SilentlyContinue) {
    if (Get-Command opencode -ErrorAction SilentlyContinue) {
        Write-Host "  Configuring Superpowers for OpenCode..." -ForegroundColor Yellow
        $ocConfigDir = "$env:USERPROFILE\.config\opencode"
        $ocConfig = "$ocConfigDir\opencode.json"
        $ocPluginSpec = "~/.config/opencode/node_modules/superpowers"
        New-Item -ItemType Directory -Force -Path $ocConfigDir | Out-Null
        # --allow-git=all: npm 12+ blocks git-URL dependencies by default
        # (EALLOWGIT) - confirmed live on this exact command, breaking the
        # whole install.ps1 run under set -e-equivalent error handling.
        Invoke-Quietly -Description "Failed to install Superpowers for OpenCode" -Action { npm install "superpowers@git+https://github.com/obra/superpowers.git" --prefix "$ocConfigDir" --allow-git=all --loglevel=error --no-progress --fund=false --audit=false 2>$null | Out-Null }

        # Both writes below must be BOM-less UTF-8: PS 5.1's
        # `Set-Content -Encoding utf8` prepends a BOM, and guardrail's
        # config merge (Go) refuses to merge into BOM'd JSON - confirmed live:
        # "invalid character (the BOM's first byte) looking for beginning of value" failed
        # every Windows CI run's opencode wiring while the BOM-less Linux
        # side merged fine. Same WriteAllLines idiom as the mp-code-review
        # patcher below.
        # Read as bytes + strip any BOM before parsing: this file is written
        # by several tools in the same install (Serena's registration runs
        # earlier and uses PowerShell's own writers), and a BOM'd or empty
        # file made the old bare `Get-Content | ConvertFrom-Json` throw -
        # the catch then skipped wiring superpowers entirely on fresh
        # installs (confirmed live: "Could not parse existing opencode.json"
        # on a fresh Windows box, plugin key never landed). Unparseable
        # non-empty content still warns with the reason and leaves the file
        # alone - never clobber a config we can't read.
        $ocRaw = if (Test-Path $ocConfig) { [IO.File]::ReadAllBytes($ocConfig) } else { $null }
        $ocText = if ($ocRaw) { [Text.UTF8Encoding]::new($false).GetString($ocRaw).TrimStart([char]0xFEFF) } else { '' }
        if ([string]::IsNullOrWhiteSpace($ocText)) {
            $ocNew = @{ plugin = @($ocPluginSpec) } | ConvertTo-Json
            [System.IO.File]::WriteAllLines($ocConfig, $ocNew, (New-Object System.Text.UTF8Encoding($false)))
        } else {
            try {
                $ocJson = $ocText | ConvertFrom-Json -ErrorAction Stop
                if (-not $ocJson.plugin) {
                    $ocJson | Add-Member -MemberType NoteProperty -Name plugin -Value @($ocPluginSpec) -Force
                } elseif ($ocJson.plugin -notcontains $ocPluginSpec) {
                    $ocJson.plugin = @($ocJson.plugin) + $ocPluginSpec
                }
                $ocMerged = $ocJson | ConvertTo-Json -Depth 10
                [System.IO.File]::WriteAllLines($ocConfig, $ocMerged, (New-Object System.Text.UTF8Encoding($false)))
            } catch {
                Write-Host "  Could not parse existing opencode.json ($_) - leaving it untouched" -ForegroundColor Yellow
            }
        }
    }
}
{{- end }}

Add-DotTimingMark -Name 'Claude Code'
{{- if $claude_cli }}
# Claude Code (Native Installer - Recommended). Deliberately NOT nested under
# an npm-presence check (its former home, the old ai_tools npm block): the
# native installer is `irm | iex` and needs no Node - so claude_cli works
# standalone even with core/agent_toolkit off.
if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host "  Installing Claude Code (Native)..." -ForegroundColor Yellow
    # Official Native Install - URL single-sourced from .chezmoidata.yaml
    # versions.claude_install_ps1 (#125), the same key update_ai_tools.ps1
    # reads at runtime, so install and update can never diverge.
    Invoke-WithTimeout -Description "Claude Code install" -Seconds 300 -Action { & powershell -NoProfile -c "`$ProgressPreference = 'SilentlyContinue'; irm {{ .versions.claude_install_ps1 }} | iex" }
}

function Set-ClaudeAttribution {
    # SupportsShouldProcess (PSUseShouldProcessForStateChangingFunctions): the
    # settings.json rewrite honors -WhatIf/-Confirm. Default behavior unchanged.
    [CmdletBinding(SupportsShouldProcess)]
    param()
    $settingsDir = Join-Path $env:USERPROFILE '.claude'
    $settings = Join-Path $settingsDir 'settings.json'
    if (-not $PSCmdlet.ShouldProcess($settings, 'write attribution keys')) { return }
    try {
        New-Item -ItemType Directory -Force -Path $settingsDir | Out-Null
        if (Test-Path $settings) {
            $contents = Get-Content -Raw -LiteralPath $settings
            $claudeSettings = if ([string]::IsNullOrWhiteSpace($contents)) {
                [pscustomobject]@{}
            } else {
                $contents | ConvertFrom-Json -ErrorAction Stop
            }
        } else {
            $claudeSettings = [pscustomobject]@{}
        }
        # StrictMode-safe access: this script runs under Set-StrictMode
        # -Version Latest, where READING a missing property on a
        # PSCustomObject throws ("The property 'attribution' cannot be found
        # on this object" - confirmed live on a fresh Windows box whose
        # settings.json came from `claude plugin install` with no
        # attribution key, killing the whole attribution step). Probe
        # PSObject.Properties instead of dotting into the name.
        $attrProp = $claudeSettings.PSObject.Properties['attribution']
        if ($null -eq $attrProp -or $null -eq $attrProp.Value -or $attrProp.Value -isnot [pscustomobject]) {
            # absent, null, or a non-object shape (string/array from another
            # writer) - (re)create it as an object
            $claudeSettings | Add-Member -MemberType NoteProperty -Name attribution -Value ([pscustomobject]@{}) -Force
        }
        $attribution = $claudeSettings.PSObject.Properties['attribution'].Value
        $attribution | Add-Member -MemberType NoteProperty -Name commit -Value '' -Force
        $attribution | Add-Member -MemberType NoteProperty -Name pr -Value '' -Force
        $attribution | Add-Member -MemberType NoteProperty -Name sessionUrl -Value $false -Force
        # Direct BOM-less WriteAllText, same idiom as every other JSON
        # writer in this repo. The previous temp+File.Replace dance threw
        # "The path is not of a legal form" on a real machine (confirmed
        # live, Windows/.NET Framework) - a branch CI never exercises
        # because fresh CI runners always take the create path. The
        # atomicity Replace bought is not worth a .NET Framework quirk
        # nobody can reproduce in CI.
        $merged = $claudeSettings | ConvertTo-Json -Depth 100
        [System.IO.File]::WriteAllText($settings, $merged, (New-Object System.Text.UTF8Encoding($false)))
    } catch {
        # Reason included: on a fresh install this fired with a bare message
        # and no way to tell a BOM'd file from an Add-Member failure (e.g.
        # attribution present but not an object). The file is left untouched
        # either way - never clobber settings we can't read.
        Write-Host "  Warning: Could not update Claude Code settings ($_) - leaving them untouched" -ForegroundColor Yellow
    }
}

# Superpowers skills plugin for Claude Code (global - active in every
# session once installed, via Claude Code's own plugin marketplace
# mechanism, not npm). Re-running add/install is safe if already present.
if (Get-Command claude -ErrorAction SilentlyContinue) {
    Set-ClaudeAttribution
    Write-Host "  Installing Superpowers plugin for Claude Code..." -ForegroundColor Yellow
    Invoke-Quietly -Description "Failed to add Superpowers marketplace for Claude Code" -Action { claude plugin marketplace add obra/superpowers-marketplace 2>$null }
    Invoke-Quietly -Description "Failed to install Superpowers plugin for Claude Code" -Action { claude plugin install superpowers@superpowers-marketplace 2>$null }
}
{{- end }}

Add-DotTimingMark -Name 'Codex'
{{- if $chatgpt_cli }}
# Codex CLI (the npm package named in .chezmoidata/agents.yaml). The
# curated-skills pass below gates on this group too (chatgpt_cli sits in its
# cross-cutting gate, matching the .sh twin); superpowers' plugin for Codex is
# the one piece with no codex wiring (see the block below); guardrail's
# plane wiring is done by the agent-guardrails installer.
Install-Node
if (Get-Command npm -ErrorAction SilentlyContinue) {
    # Global NPM packages are usually added to PATH during Node.js install
    # (--fetch-timeout/--fetch-retries cap a stalled registry fetch)
    # Missing, or present but unable to start (npm skipped its platform binary, published minutes
    # after the main package - see Update-CodexNpm in scripts/lib/ps-common.ps1): install.
    # try/catch: under Stop, a failing native's stderr can throw in Windows PowerShell 5.1.
    $codexRuns = $false
    if (Get-Command codex -ErrorAction SilentlyContinue) {
        try { codex --version *> $null; $codexRuns = ($LASTEXITCODE -eq 0) } catch { $codexRuns = $false }
    }
    if ($codexRuns) {
        # Same wording as the agent-browser skip above: "Installing Codex CLI..." used to print on
        # every run, including the ones that installed nothing.
        Write-Host "  Codex CLI is installed - skipping the npm install (dot upgrade updates it)." -ForegroundColor Yellow
    } else {
         Write-Host "Installing Codex CLI..." -ForegroundColor Cyan
         # npm's "added 1 package, and changed 1 package" summary is shown only on failure.
         Invoke-Quietly -Description "Failed to install Codex CLI" -Action {
             $codexNpmOut = @(npm install -g {{ .agents.npm.codex }} --loglevel=error --no-progress --fetch-timeout=120000 --fetch-retries=2 2>&1 | ForEach-Object { "$_" })
             if ($LASTEXITCODE -ne 0) { $codexNpmOut | ForEach-Object { Write-Host "  $_" }; throw "npm exited $LASTEXITCODE" }
         }
    }
    # Upgrades are `dot upgrade`'s sole domain (dot CLI spec,
    # 2026-09-20): presence-only here by design - install-if-missing.
}

# Superpowers for Codex CLI: the pre-configured Codex plugin marketplace carries
# superpowers, and `codex plugin add` installs it scriptably (obra/superpowers
# README, Codex CLI section - the third-party `codex-plugin` npm helper this
# repo once rejected is not involved). Re-running add on an installed plugin is
# a refresh, so this is idempotent like the Claude Code Superpowers step above.
# The marketplace name comes from codex itself - see
# Get-CodexSuperpowersMarketplace in scripts/lib/ps-skills.ps1 for why
# hardcoding it was wrong. Refresh PATH first: the codex shim may have arrived
# in this same run (Install-Node above).
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
if (Get-Command codex -ErrorAction SilentlyContinue) {
    Write-Host "  Installing Superpowers plugin for Codex..." -ForegroundColor Yellow
    $cxMarket = Get-CodexSuperpowersMarketplace
    if (-not $cxMarket) {
        Write-Host "  No Codex marketplace lists a superpowers plugin - skipping" -ForegroundColor Yellow
    } else {
        # Silent on success ("Added plugin ... Installed plugin root: ..." on every run); a failure warns.
        Invoke-Quietly -Description "Failed to install Superpowers for Codex" -Action { $null = codex plugin add "superpowers@$cxMarket" 2>&1; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
    }
    # MCP registration for Codex lives HERE, not in the serena section above
    # (see that section's note): codex only exists from this point on a
    # fresh/reinstall machine. Idempotent: serena's own setup tool rewrites
    # its entry.
    $null = Invoke-WithTimeout -Description "serena setup codex" -Seconds 60 -NoStream -Action { serena setup codex 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
}
{{- end }}

Add-DotTimingMark -Name 'Antigravity'
{{- if $antigravity_cli }}
# Superpowers plugin for Antigravity CLI (agy). Google Gemini Code
#    Assist for individuals (which the standalone Gemini CLI used) was
#    retired in favor of the Antigravity suite - see docs/tool-parity.md -
#    so this repo no longer installs Gemini CLI; Antigravity CLI is its
#    replacement in the agent lineup. The agy binary itself rides the choco
#    $packages loop above (antigravity-cli), under this same gate.
#    `agy plugin install <url>` is the officially-documented mechanism
#    (obra/superpowers' own README.md Antigravity section, confirmed
#    against the locally-installed copy's docs) - NOT hand-copying skill
#    files into a guessed plugin directory. Superpowers' own contributor
#    docs (docs/porting-to-a-new-harness.md) explicitly call manual
#    file-copying fragile/unsupported: "Everything arrives through the
#    install mechanism - not by editing the user's config." This also
#    sidesteps needing to hardcode Antigravity's actual plugin storage
#    path here (confirmed live: `~/.gemini/config/plugins/<name>/` -
#    antigravity.google's own docs claim `~/.gemini/antigravity-cli/
#    plugins/<name>/` instead, which is simply wrong as of agy 1.1.22) -
#    agy itself resolves this, not us, so it stays correct even if/when
#    that path changes again.
# Refresh PATH in case Chocolatey just installed agy in this same run
# (its shim may not be a package this session has seen yet, mirroring
# Install-Node's same refresh above).
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
if (Get-Command agy -ErrorAction SilentlyContinue) {
    Write-Host "  Installing Superpowers plugin for Antigravity..." -ForegroundColor Yellow
    # Its seven-line "Cloning plugin... [ok] superpowers" block is shown only on failure.
    Invoke-Quietly -Description "Failed to install Superpowers for Antigravity" -Action {
        $agyOut = @(agy plugin install https://github.com/obra/superpowers 2>&1 | ForEach-Object { "$_" })
        if ($LASTEXITCODE -ne 0) { $agyOut | ForEach-Object { Write-Host "  $_" }; throw "agy exited $LASTEXITCODE" }
    }
}
{{- end }}

Add-DotTimingMark -Name 'agent skills'
{{- if or $claude_cli $antigravity_cli $agent_toolkit $opencode_cli $chatgpt_cli }}
# Curated third-party agent skills via the `skills` CLI (vercel-labs/skills):
# Matt Pocock's 12 + mp-code-review + Anthropic's frontend-design, installed
# for Claude Code, OpenCode, and Codex in one pass. The CLI writes
# $env:USERPROFILE\.claude\skills, $env:USERPROFILE\.config\opencode\skills,
# and $env:USERPROFILE\.codex\skills; the verified Claude copy is then fanned
# out to Antigravity. --copy = real dirs, not symlinks.
#
# Cross-cutting pass (spec section 2 wiring rule): fires when ANY of its target
# groups (claude_cli / antigravity_cli / agent_toolkit / opencode_cli /
# chatgpt_cli) is
# enabled - the CLIs it writes to may have arrived from any of those gates,
# and the pass is idempotent either way. Gated on npx.
#
# Every npx/git call runs through Invoke-WithTimeout, for three reasons:
# 1. Wall-clock guard - these are unbounded network fetches, same contract
#    as every other network step in this script (docs/tool-parity.md's
#    Network-step timeouts section promises this for npx and git clones).
# 2. The job's fresh session runs with default ErrorActionPreference, so
#    stderr can never be promoted to a terminating error here - the PS 5.1
#    trap that killed the first real deploy of this block (npm 12's npx
#    prints a benign "npm notice run npx / npm notice run 'skills' add ..."
#    to STDERR on every invocation, exit 0, verified live on npm 12.0.2;
#    under EAP=Stop the old `2>&1` redirect promoted the first stderr line
#    into a terminating error that aborted all three installs at birth).
#    --loglevel=error is still passed to keep the notices from existing.
# 3. The job's detached stdin makes an interactive prompt impossible - the
#    same block hung a real WSL run holding the terminal (chezmoi inherits
#    the console's stdin); the bash side gets the same guarantee via
#    `< /dev/null`.
# The trailing exit-code throw keeps real failures visible: a non-zero
# exit marks the job Failed, which Invoke-WithTimeout reports as a warning
# (stderr alone wouldn't, in the job's default EAP).
# NOTE: jobs do NOT inherit this session's variables - these scriptblocks
# are deliberately self-contained (literal args + $env:TEMP only).
function Write-CuratedSkillsSkippedSummary {
    # Rendered from scripts/curated-agent-skills.txt's line count - never a
    # literal, which drifted every time the catalog gained a skill.
    $curatedSkillTotal = {{ $curatedTotal }}
    foreach ($agent in 'Claude Code', 'OpenCode', 'Antigravity', 'Codex') {
        Write-Host "  Curated skills: $agent installed=0 skipped=$curatedSkillTotal failed=0"
    }
}

if (Get-Command npx -ErrorAction SilentlyContinue) {
    $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
    # Skills dropped upstream are removed here (scripts/retired-agent-skills.txt).
    # every source's upstream HEAD in one parallel round (Get-SkillsRemoteHead answers from it)
    Read-SkillsUpstreamHead -Repo @('mattpocock/skills', 'anthropics/skills', 'vercel-labs/skills', 'vercel-labs/agent-browser', 'CtrlCarlitos/skills', 'Leonxlnx/taste-skill')
    Invoke-RetiredSkillsCleanup -ListPath (Join-Path '{{ .chezmoi.sourceDir | replace "'" "''" }}' 'scripts\retired-agent-skills.txt')
    Invoke-SkillsSource -Label "Matt Pocock skills" -Repo 'mattpocock/skills' -Skills @('codebase-design', 'domain-modeling', 'grill-with-docs', 'improve-codebase-architecture', 'prototype', 'research', 'grilling', 'handoff', 'teach', 'writing-for-agents', 'pr', 'retro') -Agents $skAgents -Install {
        Write-Host "  Installing Matt Pocock's skills (skills CLI)..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "Matt Pocock skills install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add mattpocock/skills -s codebase-design domain-modeling grill-with-docs improve-codebase-architecture prototype research grilling handoff teach writing-for-agents pr retro -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # code-review -> mp-code-review: no rename flag in the CLI, so stage a
    # renamed copy with its name: frontmatter patched and install that dir.
    # "mp-" keeps it distinct from this repo's own /code-review command.
    if (Test-SkillsUpToDate -Repo 'mattpocock/skills' -Skills @('mp-code-review') -Agents $skAgents) {
        Write-Host "  mp-code-review: up to date"
    } else {
        $skRepo  = "$env:TEMP\mp-skills-repo"
        $skStage = "$env:TEMP\mp-skills-stage"
        Remove-Item $skRepo, $skStage -Recurse -Force -ErrorAction SilentlyContinue
        # --quiet: git's "Cloning into..." is on stderr even on success and
        # would pollute the job's output; timeout-wrapped like every other clone.
        Invoke-WithTimeout -Description "mattpocock/skills clone" -Seconds 60 -Action {
            git clone --quiet --depth 1 https://github.com/mattpocock/skills "$env:TEMP\mp-skills-repo" 2>$null
            if ($LASTEXITCODE -ne 0) { throw "git clone exited with code $LASTEXITCODE" }
        }
        $cr = Join-Path $skRepo "skills\engineering\code-review"
        if (-not (Test-Path $cr)) { $cr = Join-Path $skRepo "code-review" }
        if (Test-Path $cr) {
            New-Item -ItemType Directory -Force -Path "$skStage\mp-code-review" | Out-Null
            Copy-Item "$cr\*" -Destination "$skStage\mp-code-review" -Recurse -Force
            $skf = "$skStage\mp-code-review\SKILL.md"
            if (Test-Path $skf) {
                $patched = (Get-Content $skf) -replace '^name:\s.*$', 'name: mp-code-review'
                [System.IO.File]::WriteAllLines($skf, $patched, (New-Object System.Text.UTF8Encoding($false)))
            }
            $mpInstalled = @(Invoke-WithTimeout -Description "mp-code-review skill install" -Seconds 120 -NoStream -Action {
                $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
                npx --yes --loglevel=error skills@latest add "$env:TEMP\mp-skills-stage" -s mp-code-review -a $skAgents -g -y --copy 2>&1 | Out-Null
                if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
                '__SKILLS_OK__'
            }) -contains '__SKILLS_OK__'
            if ($mpInstalled) { Save-SkillsSource; Write-Host "  mp-code-review: installed" }
        } else {
            Write-Host "  Warning: code-review skill not found in mattpocock/skills - upstream layout changed?" -ForegroundColor Yellow
        }
        Remove-Item $skRepo, $skStage -Recurse -Force -ErrorAction SilentlyContinue
    }

    Invoke-SkillsSource -Label "frontend-design skill" -Repo 'anthropics/skills' -Skills @('frontend-design') -Agents $skAgents -Install {
        Write-Host "  Installing Anthropic's frontend-design skill..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "frontend-design skill install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add anthropics/skills -s frontend-design -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # find-skills (vercel-labs/skills, 3.4M installs on skills.sh) - lets an
    # agent search and install skills from skills.sh mid-session.
    Invoke-SkillsSource -Label "find-skills skill" -Repo 'vercel-labs/skills' -Skills @('find-skills') -Agents $skAgents -Install {
        Write-Host "  Installing find-skills skill..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "find-skills skill install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add vercel-labs/skills -s find-skills -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # agent-browser (vercel-labs/agent-browser, 843.8K installs) - browser
    # automation: navigate, click, fill, scrape, screenshot.
    Invoke-SkillsSource -Label "agent-browser skill" -Repo 'vercel-labs/agent-browser' -Skills @('agent-browser') -Agents $skAgents -Install {
        Write-Host "  Installing agent-browser skill..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "agent-browser skill install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add vercel-labs/agent-browser -s agent-browser -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # skill-creator (CtrlCarlitos/skills) - our drop-in fork of Anthropic's skill-creator with Windows fixes (pipe reader, UTF-8 file I/O, --project-root); pinned upstream commit + patch queue in that repo, drop when anthropics/skills#1827 lands.
    # Upstream was: (anthropics/skills, 380K installs) - Anthropic's
    # skill-authoring lifecycle tool with benchmarks and eval viewer.
    Invoke-SkillsSource -Label "skill-creator skill" -Repo 'CtrlCarlitos/skills' -Skills @('skill-creator') -Agents $skAgents -Install {
        Write-Host "  Installing Anthropic's skill-creator skill..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "skill-creator skill install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add CtrlCarlitos/skills -s skill-creator -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # taste skills (Leonxlnx/taste-skill, MIT): design-taste-frontend (new-page
    # visual direction behind tunable dials + anti-slop checklist) and
    # redesign-existing-projects (audit + targeted fixes for existing UI).
    # Chosen 2026-09-24 for function, not popularity; presets, image-gen,
    # GPT/Stitch variants and v1 left out (docs/skills-install-strategy.md).
    Invoke-SkillsSource -Label "taste skills" -Repo 'Leonxlnx/taste-skill' -Skills @('design-taste-frontend', 'redesign-existing-projects') -Agents $skAgents -Install {
        Write-Host "  Installing taste skills (design-taste-frontend, redesign-existing-projects)..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "taste skills install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add Leonxlnx/taste-skill -s design-taste-frontend redesign-existing-projects -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # code-search (CtrlCarlitos/skills, MIT): our own search-escalation skill.
    # Probes once per session which tools can see the code (a repo graph when
    # one is built, serena LSP, rg, grep), routes each question down that
    # ladder, and stops re-asking a semantic tool after one empty result.
    # Added 2026-09-24 after graft's (since removed) "graph first for ANY
    # task" block cost every session in this repo two empty queries (the graph
    # covers one Lua file here) - docs/skills-install-strategy.md.
    Invoke-SkillsSource -Label "code-search skill" -Repo 'CtrlCarlitos/skills' -Skills @('code-search') -Agents $skAgents -Install {
        Write-Host "  Installing code-search skill..." -ForegroundColor Yellow
        @(Invoke-WithTimeout -Description "code-search skill install" -Seconds 300 -NoStream -Action {
            $skAgents = @({{ includeTemplate "ps-list" .agents.skills.agents }})
            npx --yes --loglevel=error skills@latest add CtrlCarlitos/skills -s code-search -a $skAgents -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            '__SKILLS_OK__'
        }) -contains '__SKILLS_OK__'
    }

    # (writing-great-skills removed 2026-09-14: mattpocock renamed it upstream to
    #  writing-for-agents, which is already in the batch above - the old name
    #  failed silently on every run.)

    Invoke-SkillsStatePrune

    $catalog = Join-Path '{{ .chezmoi.sourceDir | replace "'" "''" }}' 'scripts\curated-agent-skills.txt'
    if (-not (Test-Path -LiteralPath $catalog -PathType Leaf)) {
        Write-Host "  Warning: curated skill catalog is unavailable: $catalog" -ForegroundColor Yellow
        Write-CuratedSkillsSkippedSummary
    } else {
        $skills = Get-Content $catalog | Where-Object { $_ -and -not $_.StartsWith('#') }
        $markerPattern = '(?m)^<!-- managed-by: chezmoi-curated-skills -->\r?$'
        $agentTargets = @{
            'Claude Code' = "$env:USERPROFILE\.claude\skills"
            'OpenCode' = "$env:USERPROFILE\.agents\skills"
            'Antigravity' = "$env:USERPROFILE\.gemini\antigravity-cli\skills"
            'Codex' = "$env:USERPROFILE\.agents\skills"
        }
        $skillSummary = @{}
        foreach ($agent in $agentTargets.Keys) {
            $skillSummary[$agent] = @{ installed = 0; skipped = 0; failed = 0 }
        }
        foreach ($skill in $skills) {
            $source = "$env:USERPROFILE\.claude\skills\$skill"
            $targetRoot = "$env:USERPROFILE\.gemini\antigravity-cli\skills"
            $target = Join-Path $targetRoot $skill
            if (Test-Path -LiteralPath (Join-Path $source 'SKILL.md') -PathType Leaf) {
                $antigravityStatus = 'failed'
                New-Item -ItemType Directory -Force -Path $targetRoot | Out-Null
                $temporary = Join-Path $targetRoot ".${skill}.tmp.$([guid]::NewGuid().ToString('N'))"
                $backup = Join-Path $targetRoot ".${skill}.backup.$([guid]::NewGuid().ToString('N'))"
                New-Item -ItemType Directory -Force -Path $temporary | Out-Null
                try {
                    Get-ChildItem -Force -LiteralPath $source | Copy-Item -Destination $temporary -Recurse -Force -ErrorAction Stop
                    if (Test-Path -LiteralPath $target) {
                        Move-Item -LiteralPath $target -Destination $backup -ErrorAction Stop
                        try {
                            Move-Item -LiteralPath $temporary -Destination $target -ErrorAction Stop
                            Remove-Item -LiteralPath $backup -Recurse -Force -ErrorAction SilentlyContinue
                            $antigravityStatus = 'installed'
                        } catch {
                            Remove-Item -LiteralPath $temporary -Recurse -Force -ErrorAction SilentlyContinue
                            Move-Item -LiteralPath $backup -Destination $target -ErrorAction SilentlyContinue
                            Write-Host "  Warning: failed to promote curated skill for Antigravity: $skill" -ForegroundColor Yellow
                        }
                    } else {
                        Move-Item -LiteralPath $temporary -Destination $target -ErrorAction Stop
                        $antigravityStatus = 'installed'
                    }
                } catch {
                    Remove-Item -LiteralPath $temporary -Recurse -Force -ErrorAction SilentlyContinue
                    Write-Host "  Warning: failed to copy curated skill for Antigravity: $skill" -ForegroundColor Yellow
                }
            } else {
                $antigravityStatus = 'skipped'
                Write-Host "  Warning: Claude skill missing; skipping Antigravity copy: $skill" -ForegroundColor Yellow
            }

            $commandRoot = "$env:USERPROFILE\.config\opencode\commands"
            $commandFile = Join-Path $commandRoot "$skill.md"
            $source = "$env:USERPROFILE\.agents\skills\$skill"
            if (Test-Path -LiteralPath (Join-Path $source 'SKILL.md') -PathType Leaf) {
                New-Item -ItemType Directory -Force -Path $commandRoot | Out-Null
                if ((Test-Path -LiteralPath $commandFile -PathType Leaf) -and -not ((Get-Content -Raw -LiteralPath $commandFile) -match $markerPattern)) {
                    Write-Host "  Warning: OpenCode command is user-managed; leaving unchanged: $commandFile" -ForegroundColor Yellow
                } else {
                    $command = "<!-- managed-by: chezmoi-curated-skills -->`r`n---`r`ndescription: Run the $skill skill`r`n---`r`nLoad the native ``$skill`` skill with the skill tool, then follow it for: `$ARGUMENTS`r`n"
                    [System.IO.File]::WriteAllText($commandFile, $command, (New-Object System.Text.UTF8Encoding($false)))
                }
            } elseif ((Test-Path -LiteralPath $commandFile -PathType Leaf) -and ((Get-Content -Raw -LiteralPath $commandFile) -match $markerPattern)) {
                Remove-Item -LiteralPath $commandFile -Force
            }

            foreach ($agent in $agentTargets.Keys) {
                if ($agent -eq 'Antigravity') {
                    $skillSummary[$agent][$antigravityStatus]++
                } elseif ($agent -eq 'Codex' -and $skAgents -notcontains 'codex') {
                    # Codex shares OpenCode's target dir; when this operation does
                    # not select Codex, its summary stays at zero rather than
                    # claiming the shared dir's contents as its own result.
                } else {
                    $skillFile = Join-Path (Join-Path $agentTargets[$agent] $skill) 'SKILL.md'
                    if (Test-Path -LiteralPath $skillFile -PathType Leaf) {
                        $skillSummary[$agent].installed++
                    } else {
                        $skillSummary[$agent].failed++
                    }
                }
            }
        }
        foreach ($agent in 'Claude Code', 'OpenCode', 'Antigravity', 'Codex') {
            Write-Host "  Curated skills: $agent installed=$($skillSummary[$agent].installed) skipped=$($skillSummary[$agent].skipped) failed=$($skillSummary[$agent].failed)"
        }
    }
} else {
    Write-CuratedSkillsSkippedSummary
}
{{- end }}

# guardrail-section: begin
# agent-guardrails: installation lives in agent-guardrails (its install.ps1,
# ADR-0029 there) - binary download + checksum, Mark-of-the-Web unblock,
# user-PATH persistence, the Defender exclusion for guardrail.exe
# (#132/#146; when not elevated it prints the exact exclusion command
# itself), self-update of an older binary, and `guardrail setup` (plane
# wiring, coverage). This section only fetches the pinned release's
# install.ps1 + SHA256SUMS, verifies the installer against SHA256SUMS, and
# runs it FROM THE TEMP FILE with -File (never piped into the session):
#   packages.guardrail true  -> install.ps1 -Version <pin> -State enabled
#   packages.guardrail false -> install.ps1 -Version <pin> -State disabled,
#                               only when guardrail.exe is already installed
#                               (never a download just to disable; nothing
#                               is removed).
# Setup runs unattended: with no operator enrolled it
# bootstraps and exits 0; with an enrolled operator and no terminal it exits
# 3 with the remedy on stderr, and the end-of-apply
# Invoke-GuardrailNextStep (end of this script) carries the remedy.
# Exit-code contract (verified against the released binary; the pin itself
# lives in .chezmoidata.yaml guardrail.version) -
# control flow uses exit codes only, never the installer's wording:
#   0  success                                               -> continue
#   1  download/checksum/install/verify or genuine setup
#      failure                                               -> FAIL the run
#   3  operator action pending (not enrolled, no interactive
#      terminal, approval daemon not running, request
#      denied/expired)                                       -> warn, continue
#      the binary is installed and current and the existing wiring keeps
#      enforcing, so failing the whole run buys nothing
#   2  usage/unsupported platform                            -> FAIL the run
#      (unambiguous since setup learns to run unattended: it exits 3, never 2)
# Windows twin of install_agent_guardrails in the sh installer. Pin rendered
# from .chezmoidata.yaml guardrail.version (single source of truth - same key
# the sh template and the manual updaters use).
$guardrailVersion = "{{ .guardrail.version }}"
$guardrailRepo    = "CtrlCarlitos/agent-guardrails"
$guardrailExe     = "$env:USERPROFILE\.local\bin\guardrail.exe"
function Invoke-GuardrailInstaller {
    param([Parameter(Mandatory)][string]$State)
    # Replacing a RUNNING guardrail.exe is guardrail's own job, and the installer run below
    # does it right: with a binary already installed it runs the binary's own update
    # command, which changes nothing when the tag already matches, renames a running image aside
    # itself (Windows allows renaming an in-use executable, not overwriting it) and keeps
    # the previous binary for `guardrail rollback`. This function used to move guardrail.exe
    # aside first. The upstream installer then found no binary, took its fresh-download
    # path and fetched the SAME release again every run, which also reset guardrail's
    # evidence window ("hook registered but NEVER OBSERVED FIRING" after each dot up) and
    # skipped the rollback copy. Leave the installed binary alone.
    $grBin = Join-Path $HOME ".local\bin\guardrail.exe"
    # Unique per run (like agent-guardrails' own install.ps1), so a stale or
    # concurrent run's files can never be picked up; every path below removes it.
    $guardrailTmp = Join-Path $env:TEMP ("guardrail-installer-" + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Force -Path $guardrailTmp | Out-Null
    # Handoff to the job via $env: - jobs inherit environment variables but
    # NOT session variables (see the NOTE on the skills scriptblocks above),
    # so this keeps one source of truth for repo/version without $using:.
    $env:GUARDRAIL_BASE = "https://github.com/$guardrailRepo/releases/download/$guardrailVersion"
    $env:GUARDRAIL_TMP  = $guardrailTmp
    Invoke-WithTimeout -Description "guardrail installer download" -Seconds 60 -Action {
        # TLS 1.2 first, inside the job: it is a fresh process, so a
        # SecurityProtocol set in this session would not reach it, and PS 5.1
        # defaults can still refuse GitHub's TLS.
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri "$env:GUARDRAIL_BASE/install.ps1" -OutFile "$env:GUARDRAIL_TMP\install.ps1" -UseBasicParsing
        Invoke-WebRequest -Uri "$env:GUARDRAIL_BASE/SHA256SUMS" -OutFile "$env:GUARDRAIL_TMP\SHA256SUMS" -UseBasicParsing
    }
    # Download job done - reclaim the handoff vars so they can't leak into
    # later installer sections or the installer's own child processes.
    Remove-Item Env:\GUARDRAIL_BASE, Env:\GUARDRAIL_TMP -ErrorAction SilentlyContinue
    if (-not (Test-Path "$guardrailTmp\install.ps1") -or -not (Test-Path "$guardrailTmp\SHA256SUMS")) {
        Write-Host "  Warning: guardrail installer download failed - skipping" -ForegroundColor Red
        Remove-Item $guardrailTmp -Recurse -Force -ErrorAction SilentlyContinue
        return
    }
    # Anchor like the sh twin's `grep " install.sh$"`: file name at end of
    # line, so a longer name can't shadow it; \s*$ also tolerates a trailing
    # CR. No line (partial download) leaves $want empty and fail-closes.
    # try/catch: under the script's EAP=Stop, a Select-String/Get-FileHash
    # failure (unreadable file, bad path) would otherwise become terminating
    # instead of the CHECKSUM MISMATCH warning-not-fatal contract below.
    $want = ""
    $got = ""
    try {
        $m = Select-String -Path "$guardrailTmp\SHA256SUMS" -Pattern " install\.ps1\s*$" | Select-Object -First 1
        if ($m) { $want = ($m.Line.Trim() -split '\s+')[0] }
        $got = (Get-FileHash -Algorithm SHA256 "$guardrailTmp\install.ps1").Hash
    } catch { Write-Verbose "guardrail checksum read failed: $($_.Exception.Message)" }
    if (-not $want -or ($got.ToLower() -ne $want.ToLower())) {
        Write-Host "  Warning: guardrail installer CHECKSUM MISMATCH - not running it" -ForegroundColor Red
        Remove-Item $guardrailTmp -Recurse -Force -ErrorAction SilentlyContinue
        return
    }
    Write-Host "  Running agent-guardrails installer $guardrailVersion (-State $State); its output streams below..." -ForegroundColor Yellow
    # Invoke-GuardrailInstallerProcess (not Invoke-WithTimeout, not a native-command pipeline):
    # the installer's output must stream - never captured or silenced - so anything it prints
    # (including a live WebAuthn URL or its plain approval prompt) stays visible in the run
    # output AS IT IS WRITTEN. `& powershell ... | Tee-Object | Select-GuardrailConsoleLine` used
    # to do this, but PowerShell's own native-command pipeline capture is RECORD-oriented (same
    # class of bug as the sh twin's old awk filter): it withholds a line from Tee-Object/the
    # filter until it sees that line's newline, so the installer's approval prompt - which has
    # none, the cursor is meant to sit after it - never reached the console until the installer
    # had already exited (confirmed live 2026-10-08). Invoke-GuardrailInstallerProcess bypasses
    # that capture entirely.
    # Function-local EAP=Continue: under the script's EAP=Stop, PS 5.1 turns any native stderr
    # line into a terminating error (see the note above Invoke-Quietly); the exit code is the
    # real signal.
    $ErrorActionPreference = 'Continue'
    $code = 1
    $guardrailApplyLog = Join-Path $env:USERPROFILE ".local\state\guardrail\apply.log"
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $guardrailApplyLog) | Out-Null
    try {
        $code = Invoke-GuardrailInstallerProcess -FilePath 'powershell' -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', "$guardrailTmp\install.ps1", '-Version', $guardrailVersion, '-State', $State) -LogPath $guardrailApplyLog
    } catch {
        # The native launch itself never started (e.g. powershell.exe not
        # found) - distinct from a non-zero exit below, so throw a message
        # that says so instead of the misleading generic "exited with code 1".
        Remove-Item $guardrailTmp -Recurse -Force -ErrorAction SilentlyContinue
        throw "guardrail installer could not be started: $_"
    }
    Remove-Item $guardrailTmp -Recurse -Force -ErrorAction SilentlyContinue
    # Copies the previous scheme left beside the binary (guardrail.exe.old-<stamp>) are
    # swept; upstream's own single guardrail.exe.old slot is its to manage, not ours.
    Get-ChildItem -Path (Split-Path -Parent $grBin) -Filter "guardrail.exe.old-*" -File -ErrorAction SilentlyContinue |
        Remove-Item -Force -ErrorAction SilentlyContinue
    # Exit-code contract (see the section header above):
    # 3 = operator action pending (not enrolled, approval daemon not running,
    # request denied/expired) - warn with the remedy and continue: the binary
    # is installed and current and the existing wiring keeps enforcing, so
    # failing the run buys nothing; Invoke-GuardrailNextStep below ends the
    # run with the ACTION NEEDED block when steps are pending. Any other
    # non-zero (failed download/checksum/install/verify, genuine setup
    # failure, usage) fails this script so chezmoi surfaces it and re-runs
    # next apply - the sh twin's set -e contract. The installer's own output
    # already says why.
    if ($code -eq 3) {
        Write-Host "  Warning: agent-guardrails needs an operator action (not enrolled, no interactive terminal, approval daemon not running, or the last request was denied/expired) - the installed binary is current and keeps enforcing the current floor" -ForegroundColor Yellow
        Write-Host "    to finish the re-wiring: run 'guardrail setup' in an interactive terminal, complete the approval, then re-run chezmoi apply" -ForegroundColor Yellow
    } elseif ($code -ne 0) {
        throw "guardrail installer exited with code $code"
    }
}

# End-of-apply surface for the exit-code contract (Windows twin of
# guardrail_next_steps in the sh installer). `guardrail next` prints an
# ordered next-steps block for HUMANS on stdout when operator action is
# pending, and nothing when there is none; its exit is always 0 (2 only when
# called with arguments - i.e. always on binaries that predate the command,
# tolerated here like a no-op). The block is printed verbatim, NEVER parsed -
# control flow only checks emptiness. Called once, after ALL sections (end of
# this script), so the ACTION NEEDED remedy is the last thing a run with
# pending steps prints.
function Invoke-GuardrailNextStep {
    if (-not (Get-Command guardrail -ErrorAction SilentlyContinue)) { return }
    $prevEap = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    $guardrailApplyLog = Join-Path $env:USERPROFILE ".local\state\guardrail\apply.log"
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $guardrailApplyLog) | Out-Null
    $nextOut = ''
    try {
        # PS 5.1 under EAP=Stop promotes native stderr into a terminating
        # error even through 2>$null (see Invoke-Quietly) - drop to Continue
        # for the call. stdout AND stderr are the signal (the pending message
        # goes to stderr), both teed into the apply log; a non-zero exit
        # (old binary, no `next` subcommand) means "nothing to show", same
        # as empty output.
        $nextOut = (guardrail next 2>&1 | Tee-Object -FilePath $guardrailApplyLog -Append | Out-String)
        if ($LASTEXITCODE -ne 0) { $nextOut = '' }
    } catch {
        Write-Verbose "guardrail next failed: $($_.Exception.Message)"
        $nextOut = ''
    } finally {
        $ErrorActionPreference = $prevEap
    }
    if (-not [string]::IsNullOrWhiteSpace($nextOut)) {
        Write-Host $nextOut
        Write-Host "ACTION NEEDED: run 'guardrail setup' in an interactive terminal, approve with your passkey, then re-run chezmoi apply" -ForegroundColor Yellow
    }
}
Add-DotTimingMark -Name 'guardrail'
{{- if $guardrail }}
Invoke-GuardrailInstaller -State enabled
{{- else }}
if (Test-Path $guardrailExe) {
    Invoke-GuardrailInstaller -State disabled
} else {
    Write-Host "  guardrail disabled in config - nothing to do"
}
{{- end }}
# guardrail-section: end

# ScreenRec (Desktop App - Manual Install)
# https://screenrec.com
Add-DotTimingMark -Name 'desktop apps'
{{- if $dev_desktop }}
$screenRecExe = "$env:LOCALAPPDATA\StreamingVideoProvider\ScreenRec_app\ScreenRec.exe"
if (-not (Test-Path $screenRecExe)) {
    try {
        Write-Host "Installing ScreenRec..." -ForegroundColor Cyan
        $screenRecUrl = "https://screenrec.com/screenrec-download/ScreenRec_fullinstall.exe"
        $installerPath = "$env:TEMP\ScreenRec_fullinstall.exe"
        
        Write-Host "  Downloading installer..." -ForegroundColor Yellow
        Invoke-WebRequest -Uri $screenRecUrl -OutFile $installerPath -UseBasicParsing -TimeoutSec 300

        Write-Host "  Running installer (Silent)..." -ForegroundColor Yellow
        $srProc = Start-Process -FilePath $installerPath -ArgumentList "/S" -PassThru
        if (-not $srProc.WaitForExit(300000)) {
            # Kill throws if the process exited in the race window - nothing to do then.
            try { $srProc.Kill() } catch { Write-Verbose "ScreenRec installer already exited: $($_.Exception.Message)" }
            Write-Host "  Warning: ScreenRec installer timed out after 300s - continuing" -ForegroundColor Red
        }

        Remove-Item $installerPath -Force -ErrorAction SilentlyContinue
        
        if (Test-Path $screenRecExe) {
            Write-Host "  ScreenRec installed!" -ForegroundColor Green
        } else {
            Write-Host "  Warning: Installer completed but ScreenRec not found at expected path." -ForegroundColor Yellow
        }
    } catch {
        Write-Host "  Warning: Failed to install ScreenRec - $_" -ForegroundColor Red
    }
} else {
    Write-Host "ScreenRec already installed" -ForegroundColor Green
}
{{- end }}

# Google Chrome: winget (Google.Chrome installs the same enterprise MSI Google publishes),
# not Chocolatey (see the catalog note) - that community package pins a checksum against
# the MSI, which regularly lags Google's release cadence and fails with a checksum mismatch
# during that window. Unlike Docker Desktop, a Chocolatey Chrome copy has no data disk to
# preserve - its uninstaller removes the real install too (verified 2026-10-09) - so it is
# removed outright rather than left for a manual, data-keeping migration.
{{- if $dev_desktop }}
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "  Warning: winget not found - cannot install Google Chrome" -ForegroundColor Red
} else {
    # Captured separately so 2>$null can't be misread as a comparison (PSScriptAnalyzer).
    $chocoChromeList = ''
    if (Get-Command choco -ErrorAction SilentlyContinue) { $chocoChromeList = (choco list --limit-output --exact googlechrome 2>$null | Out-String) }
    if ($chocoChromeList -match '(?m)^googlechrome\|') {
        Write-Host "  Removing Chocolatey GoogleChrome (moving to winget)..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "Chocolatey GoogleChrome removal" -Seconds 300 -Action { choco uninstall googlechrome -y --no-progress }
    }
    $chromeList = (winget list --id Google.Chrome --exact --accept-source-agreements 2>$null | Out-String)
    if ($chromeList -match 'Google\.Chrome') {
        Write-Host "Google Chrome already installed" -ForegroundColor Green
    } else {
        try {
            Write-Host "Installing Google Chrome (winget)..." -ForegroundColor Cyan
            Invoke-WithTimeout -Description "Google Chrome install" -Seconds 600 -Action {
                winget install --id Google.Chrome --exact --source winget --silent --accept-package-agreements --accept-source-agreements 2>&1 | & ([scriptblock]::Create("$env:DOT_INSTALLER_FILTER"))
                if ($LASTEXITCODE -ne 0) { throw "winget exited with code $LASTEXITCODE" }
            }
        } catch {
            Write-Host "  Warning: Failed to install Google Chrome - $_" -ForegroundColor Red
        }
    }
}
{{- end }}

# ChatGPT Work/Codex - current Microsoft Store app via winget's msstore source.
# ChatGPT Classic is product 9NT1R1C2HH7J; do not install or remove it here.
# The new app is OpenAI.Codex (9PLM9XGG6VKS) and can coexist with Classic.
{{- if $chatgpt_desktop }}
if (Get-AppxPackage -Name "OpenAI.Codex" -ErrorAction SilentlyContinue) {
    Write-Host "ChatGPT Work/Codex already installed" -ForegroundColor Green
} elseif (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "  Warning: winget not found - cannot install ChatGPT Work/Codex" -ForegroundColor Red
} else {
    try {
        Write-Host "Installing ChatGPT Work/Codex (winget msstore)..." -ForegroundColor Cyan
        # All arguments are literals, so the job scriptblock is already
        # self-contained without the $env: handoff the choco/guardrail blocks
        # need (jobs inherit $env, not session variables - nothing
        # session-side to pass here). The exit-code throw inside marks the
        # job Failed on a real winget error; Invoke-WithTimeout surfaces that
        # as a warning and never throws itself.
        Invoke-WithTimeout -Description "ChatGPT Work/Codex install" -Seconds 300 -Action {
            winget install --id 9PLM9XGG6VKS --source msstore --silent --accept-package-agreements --accept-source-agreements 2>&1 | & ([scriptblock]::Create("$env:DOT_INSTALLER_FILTER"))
            if ($LASTEXITCODE -ne 0) { throw "winget exited with code $LASTEXITCODE" }
        }
        if (Get-AppxPackage -Name "OpenAI.Codex" -ErrorAction SilentlyContinue) {
            Write-Host "  ChatGPT Work/Codex installed!" -ForegroundColor Green
        } else {
            Write-Host "  Warning: winget reported success but OpenAI.Codex is not registered" -ForegroundColor Yellow
        }
    } catch {
        Write-Host "  Warning: Failed to install ChatGPT Work/Codex - $_" -ForegroundColor Red
    }
}
{{- end }}

# Win-CodexBar is the native Windows CodexBar implementation. WinGet's
# community manifest pins the release URL and installer SHA-256; do not fall
# back to direct downloads because upstream installers are currently unsigned.
{{- if $dev_desktop }}
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "  Warning: winget not found - cannot install Win-CodexBar" -ForegroundColor Red
} else {
    # Captured separately so the 2>$null redirection can't be misread as a
    # "2 > $null" comparison inside the -match expression (PSScriptAnalyzer).
    $codexBarList = (winget list --id Finesssee.Win-CodexBar --exact 2>$null | Out-String)
    if ($codexBarList -match 'Win-CodexBar') {
        Write-Host "Win-CodexBar already installed" -ForegroundColor Green
    } else {
        try {
            Write-Host "Installing Win-CodexBar (winget)..." -ForegroundColor Cyan
            Invoke-WithTimeout -Description "Win-CodexBar install" -Seconds 300 -Action {
                winget install --id Finesssee.Win-CodexBar --exact --source winget --accept-package-agreements --accept-source-agreements 2>&1 | & ([scriptblock]::Create("$env:DOT_INSTALLER_FILTER"))
                if ($LASTEXITCODE -ne 0) { throw "winget exited with code $LASTEXITCODE" }
            }
        } catch {
            Write-Host "  Warning: Failed to install Win-CodexBar - $_" -ForegroundColor Red
        }
    }
}
{{- end }}

# Docker Desktop: winget (Docker.DockerDesktop, Docker's own EXE installer), not Chocolatey
# (see the catalog note). A Chocolatey copy is NOT replaced here: uninstalling it can take the
# data disk (images, containers, volumes) with it, so the move is a manual, data-keeping step
# documented in docs/windows.md. `dot upgrade` upgrades the winget copy.
{{- if $dev_desktop }}
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "  Warning: winget not found - cannot install Docker Desktop" -ForegroundColor Red
} else {
    # Captured separately so 2>$null can't be misread as a comparison (PSScriptAnalyzer).
    $chocoDockerList = ''
    if (Get-Command choco -ErrorAction SilentlyContinue) { $chocoDockerList = (choco list --limit-output --exact docker-desktop 2>$null | Out-String) }
    $dockerList = (winget list --id Docker.DockerDesktop --exact --accept-source-agreements 2>$null | Out-String)
    if ($chocoDockerList -match '(?m)^docker-desktop\|') {
        Write-Host "  Docker Desktop is still Chocolatey's - winget cannot upgrade it. Move it (keeping your data): docs/windows.md, Docker Desktop through winget." -ForegroundColor Yellow
    } elseif ($dockerList -match 'Docker\.DockerDesktop') {
        Write-Host "Docker Desktop already installed" -ForegroundColor Green
    } else {
        try {
            Write-Host "Installing Docker Desktop (winget)..." -ForegroundColor Cyan
            Invoke-WithTimeout -Description "Docker Desktop install" -Seconds 900 -Action {
                winget install --id Docker.DockerDesktop --exact --source winget --silent --accept-package-agreements --accept-source-agreements 2>&1 | & ([scriptblock]::Create("$env:DOT_INSTALLER_FILTER"))
                if ($LASTEXITCODE -ne 0) { throw "winget exited with code $LASTEXITCODE" }
            }
        } catch {
            Write-Host "  Warning: Failed to install Docker Desktop - $_" -ForegroundColor Red
        }
    }
}
{{- end }}

# Optimize-VHD for `dot docker-compact`: it lives in the Hyper-V PowerShell module, a Windows
# feature (no package manager carries it). Only the module is enabled, never the Hyper-V
# platform (Docker runs on WSL 2). Windows Home has no such feature; dot docker-compact uses
# diskpart there, so a failure here is a note, not a warning.
{{- if $dev_desktop }}
if (-not (Get-Command Optimize-VHD -ErrorAction SilentlyContinue)) {
    try {
        $hvModule = Get-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V-Management-PowerShell -ErrorAction Stop
        if ($hvModule.State -ne 'Enabled') {
            Write-Host "Enabling the Hyper-V PowerShell module (Optimize-VHD, for dot docker-compact)..." -ForegroundColor Cyan
            $null = Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V-Management-PowerShell -NoRestart -ErrorAction Stop
        }
    } catch {
        Write-Host "  Hyper-V PowerShell module not available here - dot docker-compact uses diskpart instead." -ForegroundColor DarkGray
    }
}
{{- end }}

# Meld: winget, not Chocolatey (see the catalog note). A copy left by the
# old Chocolatey install blocks winget's upgrade (different installer
# technology), so remove it first; user settings survive the reinstall.
{{- if $dev_desktop }}
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "  Warning: winget not found - cannot install Meld" -ForegroundColor Red
} else {
    # Captured separately so 2>$null can't be misread as a comparison (PSScriptAnalyzer).
    $chocoMeldList = ''
    if (Get-Command choco -ErrorAction SilentlyContinue) { $chocoMeldList = (choco list --limit-output --exact meld 2>$null | Out-String) }
    if ($chocoMeldList -match '(?m)^meld\|') {
        Write-Host "  Removing Chocolatey Meld (moving to winget)..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "Chocolatey Meld removal" -Seconds 300 -Action { choco uninstall meld -y --no-progress }
    }
    $meldList = (winget list --id Meld.Meld --exact 2>$null | Out-String)
    if ($meldList -match 'Meld\.Meld') {
        Write-Host "Meld already installed" -ForegroundColor Green
    } else {
        try {
            Write-Host "Installing Meld (winget)..." -ForegroundColor Cyan
            Invoke-WithTimeout -Description "Meld install" -Seconds 300 -Action {
                winget install --id Meld.Meld --exact --source winget --accept-package-agreements --accept-source-agreements 2>&1 | & ([scriptblock]::Create("$env:DOT_INSTALLER_FILTER"))
                if ($LASTEXITCODE -ne 0) { throw "winget exited with code $LASTEXITCODE" }
            }
        } catch {
            Write-Host "  Warning: Failed to install Meld - $_" -ForegroundColor Red
        }
    }
}
{{- end }}

if ($dropDesktopShortcuts) {
    $removedShortcuts = @(Remove-NewDesktopShortcut -Before $shortcutsBefore)
    if ($removedShortcuts.Count -gt 0) {
        Write-Host "  Removed $($removedShortcuts.Count) new desktop shortcut(s) (desktop_shortcuts = false):" -ForegroundColor Yellow
        foreach ($removed in $removedShortcuts) { Write-Host "    $removed" }
    }
}
Write-DotTimingSummary -Title 'dot up'
Write-Host "Package installation complete!" -ForegroundColor Green

{{- if or $dev_desktop $remote_access }}

# Post-install notes print only what is still true on this machine (they used to print on
# every run, true or not). Each probe is a short, time-boxed native command; anything that
# cannot be confirmed - a tool missing, a command that fails or hangs - counts as "not
# OK", so the note is printed rather than hidden. tests/windows_post_install_notes_contract.sh
# executes these functions.
function Test-CommandSuccess {
    param([Parameter(Mandatory)][string]$Executable, [string[]]$Arguments = @(), [int]$TimeoutSeconds = 10)

    # A child process with a hard wait (not a job: a hung native command is killed, and
    # there is no second PowerShell to start). Output is drained so a chatty command
    # cannot fill its pipe and stall. A missing executable throws -> "not OK".
    try {
        $info = New-Object System.Diagnostics.ProcessStartInfo
        $info.FileName = $Executable
        $info.Arguments = (@($Arguments) | ForEach-Object { if ($_ -match '[\s"]') { '"' + ($_ -replace '"', '\"') + '"' } else { $_ } }) -join ' '
        $info.UseShellExecute = $false
        $info.CreateNoWindow = $true
        $info.RedirectStandardOutput = $true
        $info.RedirectStandardError = $true
        $process = [System.Diagnostics.Process]::Start($info)
        $null = $process.StandardOutput.ReadToEndAsync()
        $null = $process.StandardError.ReadToEndAsync()
        if (-not $process.WaitForExit($TimeoutSeconds * 1000)) {
            try { $process.Kill() } catch { Write-Verbose "kill failed: $($_.Exception.Message)" }
            return $false
        }
        return ($process.ExitCode -eq 0)
    }
    catch { return $false }
}
{{- end }}
{{- if $dev_desktop }}

function Test-DockerEngineUp { return (Test-CommandSuccess -Executable 'docker' -Arguments @('info')) }

# Real WSL distros in `wsl --list --quiet` order (the default distro first). That output
# is UTF-16LE with embedded NULs - PowerShell prints it garbled unless stripped (confirmed
# live) - and it includes Docker Desktop's own internal "docker-desktop" distros, which
# are not environments to develop in. @(...) because under Set-StrictMode an empty
# pipeline assigns $null, and $null.Count throws.
function Get-DockerWslDistro {
    $distros = @()
    if (Get-Command wsl -ErrorAction SilentlyContinue) {
        try {
            $distros = @((wsl --list --quiet 2>$null) | ForEach-Object { ($_ -replace "`0", "").Trim() } | Where-Object { $_ -and $_ -notin @("docker-desktop", "docker-desktop-data") })
        } catch { Write-Verbose "wsl --list probe failed: $($_.Exception.Message)" }
    }
    return $distros
}

# The distros for which Docker Desktop's WSL Integration is OFF, from Docker Desktop's own
# settings (no distro is started to find out). The default distro (first in the list) is
# covered by EnableIntegrationWithDefaultWslDistro. Unreadable settings mean "cannot tell":
# every distro is reported.
function Get-DockerWslGap {
    param([string[]]$Distros)

    $enabled = @()
    $defaultOn = $false
    try {
        $settings = Get-Content -LiteralPath (Join-Path $env:APPDATA 'Docker\settings-store.json') -Raw -ErrorAction Stop | ConvertFrom-Json
        if ($settings.PSObject.Properties['IntegratedWslDistros']) { $enabled = @($settings.IntegratedWslDistros) }
        if ($settings.PSObject.Properties['EnableIntegrationWithDefaultWslDistro']) { $defaultOn = [bool]$settings.EnableIntegrationWithDefaultWslDistro }
    }
    catch { return @($Distros) }
    $gap = @()
    for ($i = 0; $i -lt $Distros.Count; $i++) {
        if ($enabled -contains $Distros[$i]) { continue }
        if ($i -eq 0 -and $defaultOn) { continue }
        $gap += $Distros[$i]
    }
    return $gap
}

function Write-DockerPostInstallNote {
    if (-not (Test-DockerEngineUp)) {
        Write-Host ""
        Write-Host "[Post-Install] Docker Desktop is not answering. Launch it once from the Start menu to accept the EULA" -ForegroundColor Yellow
        Write-Host "  and start the engine, then confirm it works with:  docker ps" -ForegroundColor Cyan
    }
    # Docker Desktop's WSL Integration is a manual toggle in its own Settings UI on this
    # (Windows) side; nothing this installer runs inside WSL can enable it, which is why it
    # is advised for here, not just from the WSL side.
    $realDistros = @(Get-DockerWslDistro)
    if ($realDistros.Count -eq 0) {
        Write-Host ""
        Write-Host "[Post-Install] No WSL distro detected yet." -ForegroundColor Yellow
        Write-Host "  Planning to develop inside WSL? Install a distro first: wsl --install -d Ubuntu" -ForegroundColor Cyan
        Write-Host "  Then, before running this dotfiles installer inside it, enable Docker Desktop's" -ForegroundColor Cyan
        Write-Host "  WSL Integration for it: Docker Desktop > Settings > Resources > WSL Integration." -ForegroundColor Cyan
        Write-Host "  (The installer checks this itself and won't proceed silently if it's still off.)" -ForegroundColor Cyan
        return
    }
    $gap = @(Get-DockerWslGap -Distros $realDistros)
    if ($gap.Count -gt 0) {
        Write-Host ""
        Write-Host "[Post-Install] Docker Desktop's WSL Integration is off for: $($gap -join ', ')" -ForegroundColor Yellow
        Write-Host "  'docker' will not work from there until it is on: Docker Desktop >" -ForegroundColor Cyan
        Write-Host "  Settings > Resources > WSL Integration > toggle ON for the distro(s) above." -ForegroundColor Cyan
    }
}

Write-DockerPostInstallNote
{{- end }}
{{- if $remote_access }}

function Test-TailscaleConnected { return (Test-CommandSuccess -Executable 'tailscale' -Arguments @('status')) }

function Write-RemoteAccessPostInstallNote {
    if (Test-TailscaleConnected) { return }
    Write-Host ""
    Write-Host "[Post-Install] Tailscale is not connected. Sign in to Tailscale manually to connect this machine." -ForegroundColor Yellow
    Write-Host "  Login and any cloudflared service activation are manual. See docs/remote-access.md." -ForegroundColor Cyan
}

Write-RemoteAccessPostInstallNote
{{- end }}
{{- if $remote_access_server }}

function Test-SshServerRunning {
    $service = Get-Service sshd -ErrorAction SilentlyContinue
    return ($null -ne $service -and "$($service.Status)" -eq 'Running')
}

function Write-SshPostInstallNote {
    if (Test-SshServerRunning) { return }
    Write-Host "[Post-Install] The SSH server (sshd) is not running. Service activation and access configuration are manual. See docs/remote-access.md." -ForegroundColor Yellow
}

Write-SshPostInstallNote
{{- end }}

# agent-guardrails exit-code contract: once, after ALL sections, surface any
# pending operator steps (see Invoke-GuardrailNextStep above) - the ACTION
# NEEDED remedy is deliberately the last thing this run prints.
Invoke-GuardrailNextStep
{{ end -}}

{{- if $hasChocolateyPackages }}
Write-Host "Checking/Installing packages..." -ForegroundColor Cyan
# ONE batched local inventory instead of one `choco list --exact <pkg>` per
# package: each probe spawned a fresh .NET choco process (~1.5s x ~40
# packages per re-fire), and a single probe wedging pre-resolution on
# 2026-09-20 froze an entire elevated dotup for 77 minutes - probes were the
# ONE uncapped choco call in this script (only installs had Invoke-WithTimeout).
# Bare `choco list` (no name filter) resolves purely against the local lib
# (`Resolving resource ListResource for source C:\ProgramData\chocolatey\lib`
# in chocolatey.log) and `--limit-output` emits clean `id|version` lines.
# Semantics match the old per-package probe exactly, including choco's
# broken/pending-package exclusion (NotBroken filter) - that matters: a
# nupkg on disk is NOT proof choco considers the package installed
# (confirmed live: wiztree's nupkg survived an interrupted install while
# choco list correctly reported it gone).
$chocoListOutput = Invoke-WithTimeout -Description "batched choco list (local inventory)" -Seconds 120 -NoStream -Action {
    choco list --limit-output
    if ($LASTEXITCODE -ne 0) { throw "choco list exited with $LASTEXITCODE" }
}
$chocoInstalled = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
$chocoInventoryUsable = $false
if ($chocoListOutput) {
    foreach ($line in $chocoListOutput) {
        $id = ($line -split '\|')[0]
        if ($id) { [void]$chocoInstalled.Add($id.Trim()) }
    }
    $chocoInventoryUsable = $true
} else {
    # Degraded path (list timed out/failed - e.g. another choco instance
    # holds the global mutex): fall back to nupkg presence per package.
    # Imperfect by design and cheaper than wedging: broken/pending packages
    # keep their nupkg (wiztree, live) - those apps still get caught by the
    # registry fuzzy-skip below, same as today's choco-listed misses.
    Write-Host "  Warning: batched choco list unavailable - falling back to nupkg presence checks (less precise)" -ForegroundColor Yellow
    $chocoLibDir = if ($env:ChocolateyInstall) { Join-Path $env:ChocolateyInstall 'lib' } else { 'C:\ProgramData\chocolatey\lib' }
}
# If choco still manages GoogleChrome, every `choco upgrade all` keeps
# failing on checksum lag (see the direct-MSI Chrome block for why we
# install it that way instead) while Chrome self-updates via Google Update.
# Advise the one-time handover; never uninstall software from here.
if ($chocoInventoryUsable -and $chocoInstalled.Contains('GoogleChrome')) {
    Write-Host "  Note: choco still manages GoogleChrome - its upgrades will keep failing on checksum lag." -ForegroundColor Yellow
    Write-Host "    One-time handover: choco uninstall GoogleChrome -y  (Chrome itself stays; the installer's direct-MSI block owns it)" -ForegroundColor Yellow
}
# `choco list --exact` only recognizes what Chocolatey itself installed - it's
# blind to the same software installed any other way (direct installer,
# winget, MSIX, ...). Best-effort, not exhaustive: cache the Windows uninstall registry once (not
# once per package - 20+ separate registry scans would be wasteful) and
# fuzzy-match each package name against every DisplayName there (both sides
# stripped to bare alphanumerics, since choco names like "vscode.install" or
# "docker-desktop" don't literally match display names like "Microsoft Visual
# Studio Code" or "Docker Desktop" - the latter pair actually does match once
# spaces/dashes are stripped, but not every package will happen to). A miss
# here doesn't mean "definitely not installed" - it falls through to the
# same choco install attempt as before, same as if this check didn't exist.
$uninstallEntries = @(
    Get-ItemProperty "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*" -ErrorAction SilentlyContinue |
        Where-Object { ($_.PSObject.Properties.Name -contains 'DisplayName') -and $_.DisplayName } |
        ForEach-Object { [PSCustomObject]@{ Display = $_.DisplayName; Normalized = ($_.DisplayName -replace '[^a-zA-Z0-9]', '').ToLowerInvariant() } }
)
foreach ($pkg in $packages) {
    try {
        # Chocolatey CLI 2.x removed --local-only; bare `choco list` (no name
        # filter) is the local inventory. The per-package probe this replaced
        # spawned one .NET choco process per package and was the ONE uncapped
        # choco call - 2026-09-20 one wedged for 77 min, freezing the run.
        # Inventory + fallback live above the loop; semantics documented there.
        $installed = if ($chocoInventoryUsable) {
            $chocoInstalled.Contains($pkg)
        } else {
            Test-Path (Join-Path $chocoLibDir "$pkg\$pkg.nupkg")
        }
        if (-not $installed) {
            $normalizedPkg = ($pkg -replace '[^a-zA-Z0-9]', '').ToLowerInvariant()
            # PREFIX-anchored match, never bare substring: "tree" matching
            # inside "WizTree v4.32" silently skipped installing tree
            # entirely (2026-09-20, confirmed live - the two are unrelated
            # software). Prefix keeps every legitimate catch: version and
            # suffix noise trails the name ("WizTree v4.32", "qBittorrent
            # 5.x"), it never precedes it.
            $existing = $uninstallEntries | Where-Object { $normalizedPkg.Length -ge 3 -and $_.Normalized -like "$normalizedPkg*" } | Select-Object -First 1
            if ($existing) {
                Write-Host "  Skipping $pkg - '$($existing.Display)' is already installed (not via Chocolatey)" -ForegroundColor Yellow
                if (-not (Get-Variable -Name skippedNotChoco -ErrorAction SilentlyContinue)) { $skippedNotChoco = @() }
                $skippedNotChoco += $pkg
                continue
            }
            Write-Host "  Installing $pkg..." -ForegroundColor Yellow
            # Capped and streamed, never silent: a bare `choco install ...
            # | Out-Null` has no timeout and no output, which let one bad
            # installer (CutePDF's driver setup - confirmed live on the Full
            # Install runner, orphaned Ghostscript installer and all) sit
            # invisible for 22 minutes and consume the whole job. Jobs don't
            # inherit this session's scope, so the package name travels via
            # $env (same pattern as the guardrail block further down). 600s
            # because the slowest legitimate installs (git.install,
            # docker-desktop) land around 3-6 minutes - only true hangs ever
            # see the cap.
            $env:CHOCO_PKG = $pkg
            Invoke-WithTimeout -Description "install $pkg via Chocolatey" -Seconds 600 -Action {
                choco install $env:CHOCO_PKG -y --no-progress
                if ($LASTEXITCODE -ne 0) { exit 1 }
            }
            Remove-Item Env:\CHOCO_PKG -ErrorAction SilentlyContinue
        }
    } catch {
        Write-Host "  Warning: Failed to install $pkg - $_" -ForegroundColor Red
    }
}
# Advisory for anything skipped above as "installed (not via Chocolatey)":
# choco can't adopt an existing install - the opt-in migration script does
# uninstall+reinstall per app, with confirmation and per-app risk notes.
if (Get-Variable -Name skippedNotChoco -ErrorAction SilentlyContinue) {
    Write-Host ""
    Write-Host "  $($skippedNotChoco.Count) package(s) above are installed outside Chocolatey and stay unmanaged" -ForegroundColor Yellow
    Write-Host "  (choco upgrade all will never cover them). To take them over (elevated, per-app confirm):" -ForegroundColor Yellow
    # CHEZMOI_SOURCE_DIR arrives with forward slashes; normalize so the printed
    # command is one Windows path instead of C:/.../chezmoi\scripts\... (#145).
    $srcAdvisory = if ($env:CHEZMOI_SOURCE_DIR) { $env:CHEZMOI_SOURCE_DIR -replace '/', '' } else { Join-Path $env:USERPROFILE '.local\share\chezmoi' }
    $migrateScript = Join-Path $srcAdvisory 'scripts\migrate-to-choco.ps1'
    Write-Host "    pwsh -File `"$migrateScript`" -ListOnly   # see candidates + risks first" -ForegroundColor Yellow
}
{{- end }}


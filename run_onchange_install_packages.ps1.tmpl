{{- if $install_ai_tools }}
# act (nektosact.com) - runs GitHub Actions workflows locally via Docker.
# Confirmed current on Chocolatey (act-cli, v0.2.89). Note: act runs every
# job inside a real Docker container, and this repo's isDevcontainer check
# treats any container as one (see .chezmoi.toml.tmpl) - so $interactive can
# never be true under act, meaning it can validate template/script syntax
# and the devcontainer code path, but can't exercise install_core/
# install_ai_tools/etc content. Confirmed this session testing a Superpowers
# install fix - had to fall back to isolated `docker run` tests.
#
# antigravity-cli (agy) - Antigravity's terminal/headless surface, updated
# near-daily upstream and confirmed on Chocolatey. The only Antigravity
# surface this repo installs: the IDE and hub desktop apps were removed
# (VS Code + agy in a terminal cover that workflow).
$packages += @("act-cli", "antigravity-cli")
{{- end }}

Write-Host "Checking/Installing packages..." -ForegroundColor Cyan
# `choco list --exact` only recognizes what Chocolatey itself installed - it's
# blind to the same software installed any other way (direct installer,
# winget, MSIX, ...). Confirmed live this session: a real, actively-signed-in
# Tailscale install (via its own official installer) was completely invisible
# to this check, meaning `choco install tailscale` would have tried to
# install fresh on top of an active session with no warning at all. Best-
# effort, not exhaustive: cache the Windows uninstall registry once (not
# once per package - 20+ separate registry scans would be wasteful) and
# fuzzy-match each package name against every DisplayName there (both sides
# stripped to bare alphanumerics, since choco names like "vscode.install" or
# "docker-desktop" don't literally match display names like "Microsoft Visual
# Studio Code" or "Docker Desktop" - the latter pair actually does match once
# spaces/dashes are stripped, but not every package will happen to). A miss
# here doesn't mean "definitely not installed" - it falls through to the
# same choco install attempt as before, same as if this check didn't exist.
$uninstallEntries = @(
    Get-ItemProperty "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*" -ErrorAction SilentlyContinue |
        Where-Object { ($_.PSObject.Properties.Name -contains 'DisplayName') -and $_.DisplayName } |
        ForEach-Object { [PSCustomObject]@{ Display = $_.DisplayName; Normalized = ($_.DisplayName -replace '[^a-zA-Z0-9]', '').ToLowerInvariant() } }
)
foreach ($pkg in $packages) {
    try {
        # Chocolatey CLI 2.x removed --local-only; `choco list` is local-only by default now.
        $installed = choco list --exact $pkg 2>$null | Select-String "^$pkg\s"
        if (-not $installed) {
            $normalizedPkg = ($pkg -replace '[^a-zA-Z0-9]', '').ToLowerInvariant()
            $existing = $uninstallEntries | Where-Object { $normalizedPkg.Length -ge 3 -and $_.Normalized -like "*$normalizedPkg*" } | Select-Object -First 1
            if ($existing) {
                Write-Host "  Skipping $pkg - '$($existing.Display)' is already installed (not via Chocolatey)" -ForegroundColor Yellow
                continue
            }
            Write-Host "  Installing $pkg..." -ForegroundColor Yellow
            # Capped and streamed, never silent: a bare `choco install ...
            # | Out-Null` has no timeout and no output, which let one bad
            # installer (CutePDF's driver setup - confirmed live on the Full
            # Install runner, orphaned Ghostscript installer and all) sit
            # invisible for 22 minutes and consume the whole job. Jobs don't
            # inherit this session's scope, so the package name travels via
            # $env (same pattern as the guardrail block further down). 600s
            # because the slowest legitimate installs (git.install,
            # docker-desktop) land around 3-6 minutes - only true hangs ever
            # see the cap.
            $env:CHOCO_PKG = $pkg
            Invoke-WithTimeout -Description "install $pkg via Chocolatey" -Seconds 600 -Action {
                choco install $env:CHOCO_PKG -y --no-progress
                if ($LASTEXITCODE -ne 0) { exit 1 }
            }
            Remove-Item Env:\CHOCO_PKG -ErrorAction SilentlyContinue
        }
    } catch {
        Write-Host "  Warning: Failed to install $pkg - $_" -ForegroundColor Red
    }
}

{{- if $install_modern }}
# tealdeer's Chocolatey package puts its binary at tools\x64\tealdeer.exe -
# Chocolatey's shim generator only picks up .exe files directly in a
# package's tools\ root, not subfolders, so the package installs cleanly but
# `tldr` is never actually reachable on PATH. Confirmed live: the package,
# and the .exe, were both genuinely there; the command just wasn't. Copy it
# straight into Chocolatey's own bin dir (already on PATH) as tldr.exe,
# matching the command name used on Linux/macOS.
if (-not (Get-Command tldr -ErrorAction SilentlyContinue)) {
    $tealdeerExe = "$env:ChocolateyInstall\lib\tealdeer\tools\x64\tealdeer.exe"
    if (Test-Path $tealdeerExe) {
        Copy-Item $tealdeerExe "$env:ChocolateyInstall\bin\tldr.exe" -Force
        Write-Host "  Linked tldr -> tealdeer.exe" -ForegroundColor Green
    }
}
{{- end }}

{{- if $install_fonts }}
# Wire the Nerd Font into the places that actually render it. Installing the
# font isn't enough - confirmed live that a real machine had it fully
# installed (nerd-fonts-meslo via choco) but neither Windows Terminal nor VS
# Code had it selected, so icons were still broken. This patches only the
# font key in each file rather than owning the whole file (both are live,
# GUI-edited configs - Windows Terminal in particular auto-adds WSL distro
# profiles - so a full chezmoi-managed copy would fight the GUI on every
# apply). Idempotent: skips if already set correctly, e.g. by hand.
#
# Note: ConvertTo-Json reformats the entire file (different indentation than
# each app's own writer), not just the font key - functionally identical,
# cosmetically a full-file diff the first time this runs.
$desiredFont = "MesloLGS Nerd Font Mono"

$wtSettings = @(
    "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json",
    "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
) | Where-Object { Test-Path $_ } | Select-Object -First 1

if ($wtSettings) {
    try {
        $wtJson = Get-Content $wtSettings -Raw | ConvertFrom-Json
        if (-not $wtJson.profiles) { $wtJson | Add-Member -MemberType NoteProperty -Name profiles -Value ([PSCustomObject]@{}) -Force }
        if (-not $wtJson.profiles.defaults) { $wtJson.profiles | Add-Member -MemberType NoteProperty -Name defaults -Value ([PSCustomObject]@{}) -Force }
        if (-not $wtJson.profiles.defaults.font) { $wtJson.profiles.defaults | Add-Member -MemberType NoteProperty -Name font -Value ([PSCustomObject]@{}) -Force }
        if ($wtJson.profiles.defaults.font.face -ne $desiredFont) {
            Copy-Item $wtSettings "$wtSettings.bak" -Force -ErrorAction SilentlyContinue
            $wtJson.profiles.defaults.font | Add-Member -MemberType NoteProperty -Name face -Value $desiredFont -Force
            $wtJson | ConvertTo-Json -Depth 10 | Set-Content -Path $wtSettings -Encoding utf8
            Write-Host "  Set Windows Terminal default font to $desiredFont (backup: $wtSettings.bak)" -ForegroundColor Green
        }
    } catch {
        Write-Host "  Could not parse Windows Terminal settings.json - leaving it untouched" -ForegroundColor Yellow
    }
}

$vscodeSettings = "$env:APPDATA\Code\User\settings.json"
if (Test-Path $vscodeSettings) {
    try {
        $vsJson = Get-Content $vscodeSettings -Raw | ConvertFrom-Json
        $fontKey = "terminal.integrated.fontFamily"
        if ($vsJson.$fontKey -ne $desiredFont) {
            Copy-Item $vscodeSettings "$vscodeSettings.bak" -Force -ErrorAction SilentlyContinue
            $vsJson | Add-Member -MemberType NoteProperty -Name $fontKey -Value $desiredFont -Force
            $vsJson | ConvertTo-Json -Depth 10 | Set-Content -Path $vscodeSettings -Encoding utf8
            Write-Host "  Set VS Code integrated terminal font to $desiredFont (backup: $vscodeSettings.bak)" -ForegroundColor Green
        }
    } catch {
        Write-Host "  Could not parse VS Code settings.json - leaving it untouched" -ForegroundColor Yellow
    }
}
{{- end }}



{{- if $install_ai_tools }}
# AI Coding Tools

# Ollama - installer downloads a large (~700MB+) setup with no timeout of its own
if (-not (Get-Command ollama -ErrorAction SilentlyContinue)) {
    Write-Host "  Installing Ollama..." -ForegroundColor Yellow
    Invoke-WithTimeout -Description "Ollama install" -Seconds 1200 -Action { & powershell -NoProfile -c "irm https://ollama.com/install.ps1 | iex" }
}

Install-Node
if (Get-Command npm -ErrorAction SilentlyContinue) {
    Write-Host "Installing AI coding tools..." -ForegroundColor Cyan
    
    # 1. Codex (npm)
    # Global NPM packages are usually added to PATH during Node.js install
    # (--fetch-timeout/--fetch-retries cap a stalled registry fetch)
    if (-not (Get-Command codex -ErrorAction SilentlyContinue)) {
         Invoke-Quietly -Description "Failed to install Codex CLI" -Action { npm install -g @openai/codex --loglevel=error --no-progress --fetch-timeout=120000 --fetch-retries=2 2>$null }
    }

    # 2. Claude Code (Native - Recommended)
    if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
        Write-Host "  Installing Claude Code (Native)..." -ForegroundColor Yellow
        # Official Native Install
        Invoke-WithTimeout -Description "Claude Code install" -Seconds 300 -Action { & powershell -NoProfile -c "irm https://claude.ai/install.ps1 | iex" }
    }

    # 3. OpenCode (choco). NOT npm: opencode-ai's npm package only fetches
    #    its real platform binary in a postinstall script, and any install
    #    where that didn't run (npm 12 script handling, --ignore-scripts,
    #    partial installs) leaves bin/opencode.exe an invalid exe - every
    #    launch then dies with "not a valid application for this OS platform"
    #    from the %APPDATA%\npm\opencode.ps1 shim (confirmed live 2026-08-31
    #    on a machine this repo had npm-installed it on). The --version
    #    re-check matters because Get-Command alone is fooled by that shim
    #    (the shim exists, the binary inside it is dead), and the npm rm is
    #    required or the leftover shim keeps shadowing choco's binary - the
    #    PowerShell profile prepends %APPDATA%\npm to PATH ahead of choco's
    #    bin (choco is the route opencode's own README documents for Windows).
    $ocWorks = $false
    if (Get-Command opencode -ErrorAction SilentlyContinue) {
        try { opencode --version 2>&1 | Out-Null; $ocWorks = ($LASTEXITCODE -eq 0) } catch { $ocWorks = $false }
    }
    if (-not $ocWorks) {
        # Get-Command guard + try/catch, not a bare call: choco can legitimately
        # be absent here (non-admin run where Chocolatey itself was skipped -
        # see the degraded-mode warning at the top of this script), and under
        # $ErrorActionPreference=Stop a bare `choco ...` would then throw
        # CommandNotFoundException and silently kill everything after this
        # point (Superpowers, skills, Playwright, Antigravity, desktop apps).
        if (Get-Command choco -ErrorAction SilentlyContinue) {
            Write-Host "  Installing OpenCode (choco)..." -ForegroundColor Yellow
            try {
                choco install opencode -y --no-progress | Out-Null
                if ($LASTEXITCODE -ne 0) {
                    Write-Host "  Warning: Failed to install OpenCode (choco exit code $LASTEXITCODE)" -ForegroundColor Red
                }
            } catch {
                Write-Host "  Warning: Failed to install OpenCode - $_" -ForegroundColor Red
            }
        } else {
            Write-Host "  Warning: choco not found - cannot install OpenCode (needs Chocolatey; re-run elevated so it gets installed)" -ForegroundColor Red
        }
        Invoke-Quietly -Description "Failed to remove legacy npm opencode-ai shim" -Action { npm rm -g opencode-ai --loglevel=error --no-progress 2>$null }
        # Make choco's shim resolvable by the OpenCode-gated steps below. Prefer
        # prepending choco's bin over the full Machine+User rebuild: %APPDATA%\npm
        # (where the npm/npx shims live) can be session-only - the PowerShell
        # profile prepends it at runtime - and a full rebuild would drop it from
        # this session, silently skipping every later npm/npx step.
        $chocoBin = if ($env:ChocolateyInstall) { Join-Path $env:ChocolateyInstall "bin" } else { "C:\ProgramData\chocolatey\bin" }
        if (Test-Path $chocoBin) {
            $env:Path = "$chocoBin;" + $env:Path
        } else {
            $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
        }
    }

    # 4. Superpowers skills plugin for Claude Code (global - active in every
    #    session once installed, via Claude Code's own plugin marketplace
    #    mechanism, not npm). Re-running add/install is safe if already present.
    if (Get-Command claude -ErrorAction SilentlyContinue) {
        Write-Host "  Installing Superpowers plugin for Claude Code..." -ForegroundColor Yellow
        Invoke-Quietly -Description "Failed to add Superpowers marketplace for Claude Code" -Action { claude plugin marketplace add obra/superpowers-marketplace 2>$null }
        Invoke-Quietly -Description "Failed to install Superpowers plugin for Claude Code" -Action { claude plugin install superpowers@superpowers-marketplace 2>$null }
    }

    # 5. Superpowers skills for OpenCode (separate mechanism from Claude
    #    Code's plugin marketplace above - OpenCode reads its own
    #    opencode.json config). Uses the Windows-specific workaround from
    #    obra/superpowers' own install docs: the standard git+https plugin
    #    spec has documented upstream OpenCode/Windows issues (Bun not
    #    finding git.exe, cache-path bugs), so install via `npm --prefix`
    #    instead and point opencode.json at the resulting local package.
    if (Get-Command opencode -ErrorAction SilentlyContinue) {
        Write-Host "  Configuring Superpowers for OpenCode..." -ForegroundColor Yellow
        $ocConfigDir = "$env:USERPROFILE\.config\opencode"
        $ocConfig = "$ocConfigDir\opencode.json"
        $ocPluginSpec = "~/.config/opencode/node_modules/superpowers"
        New-Item -ItemType Directory -Force -Path $ocConfigDir | Out-Null
        # --allow-git=all: npm 12+ blocks git-URL dependencies by default
        # (EALLOWGIT) - confirmed live on this exact command, breaking the
        # whole install.ps1 run under set -e-equivalent error handling.
        Invoke-Quietly -Description "Failed to install Superpowers for OpenCode" -Action { npm install "superpowers@git+https://github.com/obra/superpowers.git" --prefix "$ocConfigDir" --allow-git=all --loglevel=error --no-progress 2>$null }

        # Both writes below must be BOM-less UTF-8: PS 5.1's
        # `Set-Content -Encoding utf8` prepends a BOM, and guardrail's
        # gen-config (Go) refuses to merge into BOM'd JSON - confirmed live:
        # "invalid character 'ï' looking for beginning of value" failed
        # every Windows CI run's opencode wiring while the BOM-less Linux
        # side merged fine. Same WriteAllLines idiom as the mp-code-review
        # patcher below.
        if (-not (Test-Path $ocConfig)) {
            $ocNew = @{ plugin = @($ocPluginSpec) } | ConvertTo-Json
            [System.IO.File]::WriteAllLines($ocConfig, $ocNew, (New-Object System.Text.UTF8Encoding($false)))
        } else {
            try {
                $ocJson = Get-Content $ocConfig -Raw | ConvertFrom-Json
                if (-not $ocJson.plugin) {
                    $ocJson | Add-Member -MemberType NoteProperty -Name plugin -Value @($ocPluginSpec) -Force
                } elseif ($ocJson.plugin -notcontains $ocPluginSpec) {
                    $ocJson.plugin = @($ocJson.plugin) + $ocPluginSpec
                }
                $ocMerged = $ocJson | ConvertTo-Json -Depth 10
                [System.IO.File]::WriteAllLines($ocConfig, $ocMerged, (New-Object System.Text.UTF8Encoding($false)))
            } catch {
                Write-Host "  Could not parse existing opencode.json - leaving it untouched" -ForegroundColor Yellow
            }
        }
    }

    # 6. Superpowers plugin for Antigravity CLI (agy). Google Gemini Code
    #    Assist for individuals (which the standalone Gemini CLI used) was
    #    retired in favor of the Antigravity suite - see docs/tool-parity.md -
    #    so this repo no longer installs Gemini CLI; Antigravity CLI is its
    #    replacement in the AI-tools lineup.
    #    `agy plugin install <url>` is the officially-documented mechanism
    #    (obra/superpowers' own README.md Antigravity section, confirmed
    #    against the locally-installed copy's docs) - NOT hand-copying skill
    #    files into a guessed plugin directory. Superpowers' own contributor
    #    docs (docs/porting-to-a-new-harness.md) explicitly call manual
    #    file-copying fragile/unsupported: "Everything arrives through the
    #    install mechanism - not by editing the user's config." This also
    #    sidesteps needing to hardcode Antigravity's actual plugin storage
    #    path here (confirmed live: `~/.gemini/config/plugins/<name>/` -
    #    antigravity.google's own docs claim `~/.gemini/antigravity-cli/
    #    plugins/<name>/` instead, which is simply wrong as of agy 1.1.22) -
    #    agy itself resolves this, not us, so it stays correct even if/when
    #    that path changes again.
    # Refresh PATH in case Chocolatey just installed agy in this same run
    # (its shim may not be a package this session has seen yet, mirroring
    # Install-Node's same refresh above).
    $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    if (Get-Command agy -ErrorAction SilentlyContinue) {
        Write-Host "  Installing Superpowers plugin for Antigravity..." -ForegroundColor Yellow
        Invoke-Quietly -Description "Failed to install Superpowers for Antigravity" -Action { agy plugin install https://github.com/obra/superpowers 2>$null }
    }

    # Curated third-party agent skills via the `skills` CLI (vercel-labs/skills):
    # Matt Pocock's 11 + mp-code-review + Anthropic's frontend-design, installed
    # for Claude Code / OpenCode / Antigravity in one pass. One `skills add`
    # writes ~\.agents\skills\<name>\ (OpenCode + Antigravity read it) and
    # ~\.claude\skills\<name>\ (Claude Code). --copy = real dirs, not symlinks.
    # Replaces the old per-agent hand-staging + `agy plugin install`. Gated on npx.
    #
    # Every npx/git call runs through Invoke-WithTimeout, for three reasons:
    # 1. Wall-clock guard - these are unbounded network fetches, same contract
    #    as every other network step in this script (docs/tool-parity.md's
    #    Network-step timeouts section promises this for npx and git clones).
    # 2. The job's fresh session runs with default ErrorActionPreference, so
    #    stderr can never be promoted to a terminating error here - the PS 5.1
    #    trap that killed the first real deploy of this block (npm 12's npx
    #    prints a benign "npm notice run npx / npm notice run 'skills' add ..."
    #    to STDERR on every invocation, exit 0, verified live on npm 12.0.2;
    #    under EAP=Stop the old `2>&1` redirect promoted the first stderr line
    #    into a terminating error that aborted all three installs at birth).
    #    --loglevel=error is still passed to keep the notices from existing.
    # 3. The job's detached stdin makes an interactive prompt impossible - the
    #    same block hung a real WSL run holding the terminal (chezmoi inherits
    #    the console's stdin); the bash side gets the same guarantee via
    #    `< /dev/null`.
    # The trailing exit-code throw keeps real failures visible: a non-zero
    # exit marks the job Failed, which Invoke-WithTimeout reports as a warning
    # (stderr alone wouldn't, in the job's default EAP).
    # NOTE: jobs do NOT inherit this session's variables - these scriptblocks
    # are deliberately self-contained (literal args + $env:TEMP only).
    if (Get-Command npx -ErrorAction SilentlyContinue) {
        $skAgents = @('claude-code', 'opencode', 'antigravity')
        Write-Host "  Installing Matt Pocock's skills (skills CLI)..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "Matt Pocock skills install" -Seconds 300 -Action {
            npx --yes --loglevel=error skills@latest add mattpocock/skills -s codebase-design domain-modeling grill-with-docs improve-codebase-architecture prototype research grilling handoff teach writing-for-agents resolving-merge-conflicts -a claude-code opencode antigravity -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
        }

        # code-review -> mp-code-review: no rename flag in the CLI, so stage a
        # renamed copy with its name: frontmatter patched and install that dir.
        # "mp-" keeps it distinct from this repo's own /code-review command.
        $skRepo  = "$env:TEMP\mp-skills-repo"
        $skStage = "$env:TEMP\mp-skills-stage"
        Remove-Item $skRepo, $skStage -Recurse -Force -ErrorAction SilentlyContinue
        # --quiet: git's "Cloning into..." is on stderr even on success and
        # would pollute the job's output; timeout-wrapped like every other clone.
        Invoke-WithTimeout -Description "mattpocock/skills clone" -Seconds 60 -Action {
            git clone --quiet --depth 1 https://github.com/mattpocock/skills "$env:TEMP\mp-skills-repo" 2>$null
            if ($LASTEXITCODE -ne 0) { throw "git clone exited with code $LASTEXITCODE" }
        }
        $cr = Join-Path $skRepo "skills\engineering\code-review"
        if (-not (Test-Path $cr)) { $cr = Join-Path $skRepo "code-review" }
        if (Test-Path $cr) {
            New-Item -ItemType Directory -Force -Path "$skStage\mp-code-review" | Out-Null
            Copy-Item "$cr\*" -Destination "$skStage\mp-code-review" -Recurse -Force
            $skf = "$skStage\mp-code-review\SKILL.md"
            if (Test-Path $skf) {
                $patched = (Get-Content $skf) -replace '^name:\s.*$', 'name: mp-code-review'
                [System.IO.File]::WriteAllLines($skf, $patched, (New-Object System.Text.UTF8Encoding($false)))
            }
            Invoke-WithTimeout -Description "mp-code-review skill install" -Seconds 120 -Action {
                npx --yes --loglevel=error skills@latest add "$env:TEMP\mp-skills-stage" -s mp-code-review -a claude-code opencode antigravity -g -y --copy 2>&1 | Out-Null
                if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
            }
        } else {
            Write-Host "  Warning: code-review skill not found in mattpocock/skills - upstream layout changed?" -ForegroundColor Yellow
        }
        Remove-Item $skRepo, $skStage -Recurse -Force -ErrorAction SilentlyContinue

        Write-Host "  Installing Anthropic's frontend-design skill..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "frontend-design skill install" -Seconds 300 -Action {
            npx --yes --loglevel=error skills@latest add anthropics/skills -s frontend-design -a claude-code opencode antigravity -g -y --copy 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) { throw "skills CLI exited with code $LASTEXITCODE" }
        }
    }

    # Superpowers for Codex CLI: deliberately NOT automated. Confirmed live
    # via an isolated Docker test that the third-party `codex-plugin` npm
    # helper (the only scriptable option) doesn't just prompt interactively -
    # it expects a plugins/<name>/ marketplace layout that obra/superpowers
    # doesn't use (it ships a root-level .codex-plugin/plugin.json manifest
    # instead), so it fails outright regardless of flags. Codex's real
    # install path for this plugin is its native in-app `/plugins` search UI -
    # genuinely GUI/session-only, no config file or CLI command reaches it
    # from outside a session.

    # 8. Playwright Chromium - headless browser for coding-agent browser
    #    automation. Deliberately here, not under install_desktop: that's
    #    gated host-only and never runs on WSL/containers, exactly where
    #    coding agents most often run.
    Write-Host "  Installing Playwright Chromium (headless browser for agent automation)..." -ForegroundColor Yellow
    Invoke-WithTimeout -Description "Playwright Chromium install" -Seconds 600 -Action { npx --yes playwright install chromium 2>$null }
}

# 9. Serena (oraios/serena) - MCP semantic code toolkit (LSP-backed find/
#    references/rename/replace-symbol). uv-managed: uv ships its own CPython
#    3.13, so no system Python prerequisite. Register per-client: native
#    `serena setup` for claude-code/codex; JSON/TOML/manual for the rest
#    (blocks 10-11 below). Sibling of the npm-guarded block above, NOT inside
#    it - Serena rides on uv, not npm. Windows twin of the sh installer's
#    Serena block.
if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
    Write-Host "  Installing uv (Astral)..." -ForegroundColor Yellow
    # Literal-only scriptblock (jobs don't inherit session variables - see the
    # NOTE on the skills scriptblocks above); the trailing exit-code throw
    # keeps a failed download visible as a job failure.
    Invoke-WithTimeout -Description "uv install" -Seconds 300 -Action {
        & powershell -ExecutionPolicy ByPass -Command "irm https://astral.sh/uv/install.ps1 | iex"
        if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" }
    }
}
# uv's installer persists its bin dir to User PATH - rebuild so this session sees it
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
if (Get-Command uv -ErrorAction SilentlyContinue) {
    if (-not (Get-Command serena -ErrorAction SilentlyContinue)) {
        Write-Host "  Installing Serena via uv..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "uv tool install serena-agent" -Seconds 600 -Action {
            uv tool install -p 3.13 serena-agent
            if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" }
        }
    }
    # uv tool shims land in User PATH (~\.local\bin) - rebuild again
    $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    if (Get-Command serena -ErrorAction SilentlyContinue) {
        Invoke-WithTimeout -Description "serena init" -Seconds 60 -Action { serena init 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
        if (Get-Command claude -ErrorAction SilentlyContinue) {
            Invoke-WithTimeout -Description "serena setup claude-code" -Seconds 60 -Action { serena setup claude-code 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
        }
        if (Get-Command codex -ErrorAction SilentlyContinue) {
            Invoke-WithTimeout -Description "serena setup codex" -Seconds 60 -Action { serena setup codex 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
        }
    }
}

# 10. opencode: global config mcp key (merge, never clobber the plugin key -
#     the Superpowers wiring in block 5 owns it). Raw-content '"serena"'
#     pre-check, same cheap idempotence guard as the sh side's grep, so an
#     already-registered config is never re-serialized.
if ((Get-Command opencode -ErrorAction SilentlyContinue) -and (Get-Command serena -ErrorAction SilentlyContinue)) {
    $ocConfig = "$env:USERPROFILE\.config\opencode\opencode.json"
    # Pre-check read in its own try/catch, failing OPEN: under EAP=Stop a
    # locked/unreadable opencode.json would otherwise terminate the script
    # here (WT settings read idiom); on read failure fall through to the
    # merge path, which re-reads inside its own try/catch.
    $ocNeedsMerge = $true
    if (Test-Path $ocConfig) {
        try { $ocNeedsMerge = -not ((Get-Content $ocConfig -Raw) -match '"serena"') } catch {
            Write-Host "  Warning: opencode.json unreadable - attempting merge anyway" -ForegroundColor Yellow
        }
    }
    if ($ocNeedsMerge) {
        Write-Host "  Registering Serena MCP in opencode..." -ForegroundColor Yellow
        try {
            New-Item -ItemType Directory -Force -Path (Split-Path $ocConfig) | Out-Null
            $ocJson = if (Test-Path $ocConfig) { Get-Content $ocConfig -Raw | ConvertFrom-Json } else { New-Object PSObject }
            $serenaDef = @{ type = "local"; command = @("serena", "start-mcp-server", "--context", "ide-assistant"); enabled = $true }
            if (-not $ocJson.PSObject.Properties["mcp"]) {
                $ocJson | Add-Member -MemberType NoteProperty -Name mcp -Value @{ serena = $serenaDef }
            } else {
                # mcp already holds other servers - add serena beside them
                $ocJson.mcp | Add-Member -MemberType NoteProperty -Name serena -Value $serenaDef -Force
            }
            # BOM-less UTF-8 write (PS 5.1's Set-Content -Encoding utf8 prepends
            # a BOM that Go JSON consumers reject - see block 5's note); the
            # round-trip preserves every existing key, plugin included.
            [System.IO.File]::WriteAllLines($ocConfig, ($ocJson | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding($false)))
        } catch {
            Write-Host "  Warning: opencode Serena registration failed - $_" -ForegroundColor Red
        }
    }
}

# 11. agy: first-class MCP management (verified: agy mcp add/list).
if ((Get-Command agy -ErrorAction SilentlyContinue) -and (Get-Command serena -ErrorAction SilentlyContinue)) {
    # try/catch + 2>&1 capture, not a bare call: under EAP=Stop a native
    # command's stderr is the terminating-error trap (same idiom as the
    # guardrail version check below).
    $agyMcp = ""
    try { $agyMcp = (agy mcp list 2>&1 | Out-String) } catch { $agyMcp = "" }
    if ($agyMcp -notmatch "serena") {
        Write-Host "  Registering Serena MCP in agy..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "agy mcp add serena" -Seconds 60 -Action { agy mcp add serena serena start-mcp-server --context ide-assistant 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
    }
}

# 12. Graft (trailhq/Graft) - codebase context graph. Global CLI here;
#     per-repo activation is `graft init` (documented in
#     docs/agent-context-tools.md). Telemetry off per repo decision.
#     --allow-scripts: npm 12 blocks install scripts by default, which
#     silently skips graft's tree-sitter parser native builds - the binary
#     then crashes with "No native build was found" (node-gyp-build). The
#     allowlist is the exact list npm's own warning prints for this graft
#     version; if a graft update changes its parser set, npm's error output
#     prints the new list to paste here. (Single-quoted because PS 5.1
#     splits unquoted commas into multiple native args.)
if (Get-Command npm -ErrorAction SilentlyContinue) {
    if (-not (Get-Command graft -ErrorAction SilentlyContinue)) {
        Write-Host "  Installing Graft (npm -g)..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "Graft install" -Seconds 300 -Action {
            npm install -g '--allow-scripts=@nanonets/graft,tree-sitter,tree-sitter-go,tree-sitter-java,tree-sitter-kotlin,tree-sitter-php,tree-sitter-python,@davisvaughan/tree-sitter-r,tree-sitter-swift,tree-sitter-typescript,tree-sitter-cli,tree-sitter-javascript' @nanonets/graft --loglevel=error --no-progress --fetch-timeout=120000 --fetch-retries=2 2>$null
            if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" }
        }
    }
    # Rebuild so the fresh graft shim resolves in this session (no npm/npx
    # steps follow this point, so the rebuild can't strand anything).
    $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    if (Get-Command graft -ErrorAction SilentlyContinue) {
        Invoke-Quietly -Description "Failed to disable Graft telemetry" -Action { graft telemetry disable 2>$null }
    }
} else {
    Write-Host "  Warning: npm not found - skipping Graft" -ForegroundColor Red
}
{{- end }}

{{- if $install_guardrail }}
# agent-guardrails hook-enforcement binary (guardrail.exe): pinned release
# download, checksum-verified, then wired into Claude Code by `guardrail
# gen-config claude --merge`. Windows twin of install_agent_guardrails() in
# the sh installer. Keep $guardrailVersion in sync with
# scripts/update_ai_tools.ps1.
$guardrailVersion = "v0.18.0-dev"
$guardrailRepo    = "CtrlCarlitos/agent-guardrails"
$guardrailDir     = "$env:USERPROFILE\.local\bin"
$guardrailExe     = "$guardrailDir\guardrail.exe"
$guardrailTmp     = "$env:TEMP\guardrail-dl"
$guardrailBase    = "https://github.com/$guardrailRepo/releases/download/$guardrailVersion"

$haveVer = ""
if (Get-Command guardrail -ErrorAction SilentlyContinue) {
    # try/catch, not a bare `2>$null`: under $ErrorActionPreference=Stop a
    # native command's stderr becomes a terminating error that the redirect
    # can't prevent (see the PS 5.1 note above Invoke-Quietly) - same shape
    # as the opencode --version validity check in the AI-tools section.
    try { $haveVer = (guardrail version 2>&1 | Out-String).Trim() } catch { $haveVer = "" }
}
if ($haveVer -eq "guardrail $guardrailVersion") {
    Write-Host "  guardrail $guardrailVersion already installed" -ForegroundColor Green
} else {
    Write-Host "  Installing guardrail $guardrailVersion..." -ForegroundColor Yellow
    $arch = if ($env:PROCESSOR_ARCHITECTURE -eq "ARM64") { "arm64" } else { "amd64" }
    $asset = "guardrail_windows_$arch.exe"
    Remove-Item $guardrailTmp -Recurse -Force -ErrorAction SilentlyContinue
    # Handoff to the job via $env: - jobs inherit environment variables but
    # NOT session variables (see the NOTE on the skills scriptblocks below),
    # so this keeps one source of truth for repo/version without $using:.
    $env:GUARDRAIL_BASE  = $guardrailBase
    $env:GUARDRAIL_ASSET = $asset
    $env:GUARDRAIL_TMP   = $guardrailTmp
    Invoke-WithTimeout -Description "guardrail download" -Seconds 180 -Action {
        New-Item -ItemType Directory -Force -Path "$env:GUARDRAIL_TMP" | Out-Null
        Invoke-WebRequest -Uri "$env:GUARDRAIL_BASE/$env:GUARDRAIL_ASSET" -OutFile "$env:GUARDRAIL_TMP\$env:GUARDRAIL_ASSET" -UseBasicParsing
        Invoke-WebRequest -Uri "$env:GUARDRAIL_BASE/SHA256SUMS" -OutFile "$env:GUARDRAIL_TMP\SHA256SUMS" -UseBasicParsing
    }
    # Download job done - reclaim the handoff vars so they can't leak into
    # later installer sections or any child process it spawns.
    Remove-Item Env:\GUARDRAIL_BASE, Env:\GUARDRAIL_ASSET, Env:\GUARDRAIL_TMP -ErrorAction SilentlyContinue
    if (-not (Test-Path "$guardrailTmp\$asset") -or -not (Test-Path "$guardrailTmp\SHA256SUMS")) {
        Write-Host "  Warning: guardrail download failed - skipping (won't install unverified)" -ForegroundColor Red
    } else {
        # try/catch = the repo's warning-not-fatal contract: with no catch, ANY
        # throw here (Select-String, Get-FileHash, Copy-Item on a locked exe)
        # terminates under EAP=Stop and kills the rest of the installer.
        try {
            # Anchor like the sh installer's `grep " ${asset}\$"`: asset name at
            # end-of-line, so a longer name can't shadow this one; \s*$ also
            # tolerates a trailing CR. The $m guard: Select-String coming back
            # empty (SHA256SUMS present but no asset line - e.g. partial
            # download) yields "" and fail-closes below instead of crashing.
            $m = Select-String -Path "$guardrailTmp\SHA256SUMS" -Pattern (" " + [regex]::Escape($asset) + "\s*$")
            $want = if ($m) { $m.Line.Split(" ")[0].Trim() } else { "" }
            $got  = (Get-FileHash -Algorithm SHA256 "$guardrailTmp\$asset").Hash.ToLower()
            if ($want -and ($got -eq $want.ToLower())) {
                # User-PATH persistence per Install-Gum (session PATH is refreshed elsewhere in this script)
                New-Item -ItemType Directory -Force -Path $guardrailDir | Out-Null
                Copy-Item "$guardrailTmp\$asset" $guardrailExe -Force
                Unblock-File $guardrailExe
                $userPath = [System.Environment]::GetEnvironmentVariable("Path", "User")
                if ($userPath -notlike "*$guardrailDir*") {
                    [System.Environment]::SetEnvironmentVariable("Path", "$userPath;$guardrailDir", "User")
                }
                Write-Host "  guardrail $guardrailVersion installed to $guardrailExe" -ForegroundColor Green
            } else {
                Write-Host "  Warning: guardrail CHECKSUM MISMATCH for $asset - not installing" -ForegroundColor Red
            }
        } catch {
            Write-Host "  Warning: guardrail install failed - $_" -ForegroundColor Red
        }
    }
    # Reclaim the temp dir on every path: installed, mismatched, or failed.
    Remove-Item $guardrailTmp -Recurse -Force -ErrorAction SilentlyContinue
}

# Wire into Claude Code (no-op-safe if claude is absent or already wired).
# Always re-runs gen-config: its owned-entry merge is safe to repeat (same
# contract as the sh installer). Invoke-WithTimeout, NOT Invoke-Quietly:
# gen-config prints its SUCCESS message to stderr, and in-session under
# $ErrorActionPreference=Stop that's the native-stderr terminating-error trap
# (see above Invoke-Quietly) - Invoke-Quietly would warn "failed" on every
# success. The job's default-EAP session can't be killed by it, the trailing
# exit-code throw keeps real failures visible as job failures, and 2>$null
# keeps the stderr SUCCESS line from reading like failure noise.
if ((Test-Path $guardrailExe) -and (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host "  Configuring guardrail for Claude Code..." -ForegroundColor Yellow
    $env:GUARDRAIL_EXE = $guardrailExe
    Invoke-WithTimeout -Description "guardrail gen-config claude --merge" -Seconds 60 -Action {
        # 2>&1-captured and printed only on failure: gen-config's SUCCESS
        # message goes to stderr (why it can't stream raw), but swallowing it
        # entirely also swallowed the REASON for every failure - the Windows
        # opencode BOM bug below hid behind that silence for two full-install
        # generations.
        $gwOut = & "$env:GUARDRAIL_EXE" gen-config claude --merge "$env:USERPROFILE\.claude\settings.json" --binary "$env:GUARDRAIL_EXE" 2>&1 | Out-String
        if ($LASTEXITCODE -ne 0) {
            Write-Host "    gen-config said: $($gwOut.Trim())"
            throw "gen-config exited with code $LASTEXITCODE"
        }
    }
    Remove-Item Env:\GUARDRAIL_EXE -ErrorAction SilentlyContinue
}

# Same wiring for OpenCode + Antigravity, one guarded block per plane so an
# absent tool skips only its own gen-config. Same idiom as the Claude block
# above: env-var handoff (jobs don't inherit session variables),
# Invoke-WithTimeout around the stderr-printing gen-config, $LASTEXITCODE
# throw as the real success signal, GUARDRAIL_* env cleanup after. The
# mkdirs run in-session - New-Item failures are .NET exceptions, not native
# stderr, so the EAP=Stop trap doesn't apply - and the target paths inside
# the jobs are literal $env: reads, which jobs DO inherit.
if ((Test-Path $guardrailExe) -and (Get-Command opencode -ErrorAction SilentlyContinue)) {
    Write-Host "  Configuring guardrail for OpenCode..." -ForegroundColor Yellow
    # --plugin-dir deploys the embedded hook adapter there; must exist first.
    New-Item -ItemType Directory -Force -Path "$env:USERPROFILE\.local\share\guardrail" | Out-Null
    $env:GUARDRAIL_EXE = $guardrailExe
    Invoke-WithTimeout -Description "guardrail gen-config opencode --merge" -Seconds 60 -Action {
        # Same capture-and-report-on-failure contract as the Claude block.
        # The historical failure this pattern finally surfaces instead of
        # swallowing: PS 5.1's Set-Content -Encoding utf8 wrote opencode.json
        # with a BOM, Go's JSON parser rejects BOMs ("invalid character 'ï'"),
        # and the opencode wiring silently failed every Windows run until the
        # Superpowers block above switched to BOM-less writes.
        $gwOut = & "$env:GUARDRAIL_EXE" gen-config opencode --merge "$env:USERPROFILE\.config\opencode\opencode.json" --binary "$env:GUARDRAIL_EXE" --plugin-dir "$env:USERPROFILE\.local\share\guardrail" 2>&1 | Out-String
        if ($LASTEXITCODE -ne 0) {
            Write-Host "    gen-config said: $($gwOut.Trim())"
            throw "gen-config exited with code $LASTEXITCODE"
        }
    }
    Remove-Item Env:\GUARDRAIL_EXE -ErrorAction SilentlyContinue
}

# Antigravity: global hooks.json. No declarative floor exists for this plane
# (see agent-guardrails ADR-0008) - the hook registration IS the entire
# enforcement surface, so this is the only guardrail coverage it gets.
if ((Test-Path $guardrailExe) -and (Get-Command agy -ErrorAction SilentlyContinue)) {
    Write-Host "  Configuring guardrail for Antigravity..." -ForegroundColor Yellow
    New-Item -ItemType Directory -Force -Path "$env:USERPROFILE\.gemini\config" | Out-Null
    $env:GUARDRAIL_EXE = $guardrailExe
    Invoke-WithTimeout -Description "guardrail gen-config antigravity --merge" -Seconds 60 -Action {
        # Same capture-and-report-on-failure contract as the Claude block.
        $gwOut = & "$env:GUARDRAIL_EXE" gen-config antigravity --merge "$env:USERPROFILE\.gemini\config\hooks.json" --binary "$env:GUARDRAIL_EXE" 2>&1 | Out-String
        if ($LASTEXITCODE -ne 0) {
            Write-Host "    gen-config said: $($gwOut.Trim())"
            throw "gen-config exited with code $LASTEXITCODE"
        }
    }
    Remove-Item Env:\GUARDRAIL_EXE -ErrorAction SilentlyContinue
}
{{- end }}

# ScreenRec (Desktop App - Manual Install)
# https://screenrec.com
{{- if $install_desktop }}
$screenRecExe = "$env:LOCALAPPDATA\StreamingVideoProvider\ScreenRec_app\ScreenRec.exe"
if (-not (Test-Path $screenRecExe)) {
    try {
        Write-Host "Installing ScreenRec..." -ForegroundColor Cyan
        $screenRecUrl = "https://screenrec.com/screenrec-download/ScreenRec_fullinstall.exe"
        $installerPath = "$env:TEMP\ScreenRec_fullinstall.exe"
        
        Write-Host "  Downloading installer..." -ForegroundColor Yellow
        Invoke-WebRequest -Uri $screenRecUrl -OutFile $installerPath -UseBasicParsing -TimeoutSec 300

        Write-Host "  Running installer (Silent)..." -ForegroundColor Yellow
        $srProc = Start-Process -FilePath $installerPath -ArgumentList "/S" -PassThru
        if (-not $srProc.WaitForExit(300000)) {
            try { $srProc.Kill() } catch {}
            Write-Host "  Warning: ScreenRec installer timed out after 300s - continuing" -ForegroundColor Red
        }

        Remove-Item $installerPath -Force -ErrorAction SilentlyContinue
        
        if (Test-Path $screenRecExe) {
            Write-Host "  ScreenRec installed!" -ForegroundColor Green
        } else {
            Write-Host "  Warning: Installer completed but ScreenRec not found at expected path." -ForegroundColor Yellow
        }
    } catch {
        Write-Host "  Warning: Failed to install ScreenRec - $_" -ForegroundColor Red
    }
} else {
    Write-Host "ScreenRec already installed" -ForegroundColor Green
}
{{- end }}

# Google Chrome (Desktop App - Direct MSI install)
# Chocolatey's community package pins a checksum against Google's enterprise MSI, which
# regularly lags Google's own release cadence and fails install with a checksum mismatch
# during that window. Download straight from Google instead. Chrome self-updates in the
# background afterwards (Google Update), so it doesn't need `choco upgrade all` to stay current.
{{- if $install_desktop }}
$chromeExe = "$env:ProgramFiles\Google\Chrome\Application\chrome.exe"
if (-not (Test-Path $chromeExe)) {
    try {
        Write-Host "Installing Google Chrome..." -ForegroundColor Cyan
        $chromeUrl = "https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi"
        $installerPath = "$env:TEMP\googlechromestandaloneenterprise64.msi"

        Write-Host "  Downloading installer..." -ForegroundColor Yellow
        Invoke-WebRequest -Uri $chromeUrl -OutFile $installerPath -UseBasicParsing -TimeoutSec 300

        Write-Host "  Running installer (Silent)..." -ForegroundColor Yellow
        $chromeProc = Start-Process -FilePath "msiexec.exe" -ArgumentList "/i `"$installerPath`" /quiet /norestart" -PassThru
        if (-not $chromeProc.WaitForExit(600000)) {
            try { $chromeProc.Kill() } catch {}
            Write-Host "  Warning: Chrome MSI installer timed out after 600s - continuing" -ForegroundColor Red
        }

        Remove-Item $installerPath -Force -ErrorAction SilentlyContinue

        if (Test-Path $chromeExe) {
            Write-Host "  Google Chrome installed!" -ForegroundColor Green
        } else {
            Write-Host "  Warning: Installer completed but Chrome not found at expected path." -ForegroundColor Yellow
        }
    } catch {
        Write-Host "  Warning: Failed to install Google Chrome - $_" -ForegroundColor Red
    }
} else {
    Write-Host "Google Chrome already installed" -ForegroundColor Green
}
{{- end }}


Write-Host "Package installation complete!" -ForegroundColor Green

{{- if $install_desktop }}
Write-Host ""
Write-Host "[Post-Install] Launch Docker Desktop once from the Start menu to accept the EULA" -ForegroundColor Yellow
Write-Host "  and start the engine, then confirm it works with:  docker ps" -ForegroundColor Cyan
Write-Host ""
# Tailscale needs an interactive login (browser-based device auth, or a
# private authkey this repo deliberately never bakes in - it's a shared
# template, not just one person's machines) - install can't do this step
# for you. Deliberately not installed inside WSL at all: Tailscale's own
# docs recommend against running it there (running it on both the Windows
# host and inside WSL2 at once breaks encrypted traffic outright), and it's
# not needed - WSL already gets full tailnet access automatically through
# whatever's running on the Windows host once this step is done.
Write-Host "[Post-Install] Sign in to Tailscale to connect this machine:  tailscale up" -ForegroundColor Yellow
Write-Host "  (or open the Tailscale app from the system tray and sign in there)" -ForegroundColor Cyan
# Docker Desktop was just installed here, but `docker` won't work from
# inside WSL until WSL Integration is turned on per-distro - that's a
# manual toggle in Docker Desktop's own Settings UI on this (Windows) side;
# nothing this installer runs *inside* WSL can enable it, which is why this
# has to be advised for here, not just from the WSL side. `wsl --list
# --quiet` outputs UTF-16LE with embedded null bytes - PowerShell prints it
# garbled unless stripped - confirmed live. Also filters out Docker
# Desktop's own internal "docker-desktop"/"docker-desktop-data" distros,
# which aren't real environments to develop in.
Write-Host ""
$realDistros = @()
if (Get-Command wsl -ErrorAction SilentlyContinue) {
    try {
        # @(...) wrapper is required: under Set-StrictMode -Version Latest, an
        # empty pipeline result assigns $null (not an empty array) to
        # $realDistros, and $null.Count throws PropertyNotFoundStrict below.
        # Confirmed live on this machine (no WSL distros installed).
        $realDistros = @((wsl --list --quiet 2>$null) | ForEach-Object { ($_ -replace "`0", "").Trim() } | Where-Object { $_ -and $_ -notin @("docker-desktop", "docker-desktop-data") })
    } catch { }
}
if ($realDistros.Count -eq 0) {
    Write-Host "[Post-Install] No WSL distro detected yet." -ForegroundColor Yellow
    Write-Host "  Planning to develop inside WSL? Install a distro first: wsl --install -d Ubuntu" -ForegroundColor Cyan
    Write-Host "  Then, before running this dotfiles installer inside it, enable Docker Desktop's" -ForegroundColor Cyan
    Write-Host "  WSL Integration for it: Docker Desktop > Settings > Resources > WSL Integration." -ForegroundColor Cyan
    Write-Host "  (The installer checks this itself and won't proceed silently if it's still off.)" -ForegroundColor Cyan
} else {
    Write-Host "[Post-Install] Docker Desktop needs WSL Integration enabled per-distro before 'docker' works from WSL." -ForegroundColor Yellow
    Write-Host "  Detected WSL distro(s): $($realDistros -join ', ')" -ForegroundColor Cyan
    Write-Host "  Before running this dotfiles installer inside WSL, enable it: Docker Desktop >" -ForegroundColor Cyan
    Write-Host "  Settings > Resources > WSL Integration > toggle ON for the distro(s) above." -ForegroundColor Cyan
}
{{- end }}
{{ end -}}

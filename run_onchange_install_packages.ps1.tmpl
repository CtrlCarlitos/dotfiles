# User-level global settings (operator-confirmed semantics): CREATE the file
# when missing (only when VS Code itself is installed), else merge. Curated
# defaults for HUMAN coding, stack-agnostic (no formatters/linters/interpreters
# - per-project concerns, irrelevant to AI agents). Semantics identical to the
# .sh twin:
#   FORCED - font keys (consistency mandate: MesloLGS NF everywhere)
#   UPSERT - other keys only when ABSENT (user values win; projects layer on top)
#   MERGE  - object keys (files.exclude/search.exclude) gain only missing sub-keys
# Gated by packages.vscode_settings (hasKey pattern: default true, set
# `[data.packages] vscode_settings = false` in chezmoi.toml to opt out - no prompt, so no
# CI-seeding burden, see check_workflow_config_keys for that outage class).
# Every tier below is rendered from this machine's chezmoi.toml
# [data.vscode.settings] ($vsCfg, seeded by `chezmoi init`), the one source this
# twin shares with run_onchange_install_packages.sh.tmpl (#83). Values are emitted as native PowerShell literals rather than parsed at
# runtime: this script targets Windows PowerShell 5.1 (see #Requires above),
# where ConvertFrom-Json has no -AsHashtable and returns a PSCustomObject.
$vsForced = @{
{{- range $k, $v := (get $vsCfg "forced" | default dict) }}
    '{{ $k }}' = {{ if kindIs "bool" $v }}${{ $v }}{{ else }}"{{ $v | replace "`" "``" | replace "$" "`$" | replace "\"" "`\"" | replace "\n" "`n" }}"{{ end }}
{{- end }}
}
$vsDefaults = [ordered]@{
{{- range $k, $v := (get $vsCfg "defaults" | default dict) }}
    '{{ $k }}' = {{ if kindIs "bool" $v }}${{ $v }}{{ else if kindIs "string" $v }}"{{ $v | replace "`" "``" | replace "$" "`$" | replace "\"" "`\"" | replace "\n" "`n" }}"{{ else if kindIs "slice" $v }}@({{ range $i, $e := $v }}{{ if $i }}, {{ end }}'{{ $e }}'{{ end }}){{ else }}{{ $v }}{{ end }}
{{- end }}
{{- /* Windows-only tier: the .sh twin deliberately renders none of these. */}}
{{- range $k, $v := (get $vsCfg "defaults_windows" | default dict) }}
    '{{ $k }}' = {{ if kindIs "bool" $v }}${{ $v }}{{ else }}"{{ $v | replace "`" "``" | replace "$" "`$" | replace "\"" "`\"" | replace "\n" "`n" }}"{{ end }}
{{- end }}
}
Add-DotTimingMark -Name 'VS Code'
$vsJunk = @({{ range $i, $g := (get $vsCfg "junk" | default list) }}{{ if $i }}, {{ end }}'{{ $g }}'{{ end }})
$vsJunkMap = [ordered]@{}
foreach ($s in $vsJunk) { $vsJunkMap[$s] = $true }
$vsTerminalColors = [ordered]@{
{{- range $k, $v := (get $vsCfg "terminal_colors" | default dict) }}
    '{{ $k }}' = '{{ $v }}'
{{- end }}
}
# MERGES: object key -> sub-keys (with values) added only when absent.
$vsMerges = @{ 'files.exclude' = $vsJunkMap; 'search.exclude' = $vsJunkMap; 'workbench.colorCustomizations' = $vsTerminalColors }
$vsUnset = [System.Collections.Generic.List[string]]@({{ range $i, $u := (get $vsCfg "unset" | default list) }}{{ if $i }}, {{ end }}'{{ $u }}'{{ end }})

# Machine-local settings drift, rendered from [data.vscode_overrides]. With the
# settings themselves in chezmoi.toml, editing [data.vscode.settings] is simpler;
# these still work:
#   exclude_settings - JSON array; strips any tier (excluding a font key
#                      stops its forced re-assert on this machine)
#   extra_settings   - JSON object; joins the DEFAULTS tier (upsert-if-absent;
#                      to change a baseline value: exclude it AND add an extra)
$vsExcludeSettings = @(
{{- if hasKey . "vscode_overrides" }}
{{-   if hasKey .vscode_overrides "exclude_settings" }}
{{-     range .vscode_overrides.exclude_settings }}
    '{{ . }}'
{{-     end }}
{{-   end }}
{{- end }}
)
# Literal here-string transport (single quotes in values would terminate a
# single-quoted string mid-line - same class the .sh twin guards against;
# compact JSON has no newlines, so the '@ terminator can never collide).
$vsExtraSettingsJson = @'
{{ if hasKey . "vscode_overrides" }}{{ if hasKey .vscode_overrides "extra_settings" }}{{ .vscode_overrides.extra_settings | toJson }}{{ else }}{}{{ end }}{{ else }}{}{{ end }}
'@
if ($vsExcludeSettings.Count -gt 0) {
    foreach ($k in $vsExcludeSettings) {
        $vsForced.Remove($k) ; $vsDefaults.Remove($k) ; $vsMerges.Remove($k) ; [void]$vsUnset.Remove($k)
    }
}
if ($vsExtraSettingsJson -and $vsExtraSettingsJson.Trim() -ne '{}') {
    $vsExtra = $vsExtraSettingsJson | ConvertFrom-Json
    foreach ($p in $vsExtra.PSObject.Properties) {
        $vsDefaults[$p.Name] = $p.Value
    }
}

$vscodeSettings = "$env:APPDATA\Code\User\settings.json"
$vsApply = $true
{{- if not $vscodeSettings }}
$vsApply = $false
{{- end }}
$vsCfgMissing = ${{ $vsCfgMissing }}
if (-not $vsApply) {
    Write-Host "  VS Code settings defaults disabled in config" -ForegroundColor Yellow
} elseif ($vsCfgMissing) {
    # A config written before the settings moved there has none until its next `chezmoi init`
    # (`dot up` runs init before it applies).
    $vsApply = $false
    Write-Host "  VS Code settings: not in chezmoi.toml yet - chezmoi init adds them ([data.vscode.settings]); skipped this run" -ForegroundColor Yellow
} else {
    # Extensions first (same gate): idempotent `code --install-extension`,
    # list rendered from .chezmoidata.yaml vscode.extensions (+ _windows).
    if (Get-Command code -ErrorAction SilentlyContinue) {
        Write-Host "  Checking VS Code extensions (installing only what is missing)..." -ForegroundColor Yellow
        # Machine-local drift lives in chezmoi.toml [data.vscode_overrides] -
        # deliberately a DIFFERENT key from the .chezmoidata.yaml vscode table:
        # chezmoi merges tables key by key, but an `extensions` LIST in the
        # config would replace the repo's whole list, so the merge happens here.
        #   extra_extensions    - appended to the repo baseline
        #   exclude_extensions  - filtered out: stop reinstalling on THIS
        #                          machine only (repo-side veto contract still
        #                          guards the curated list)
        $vsExts = @(
{{- $excluded := list }}
{{- $extras := list }}
{{- if hasKey . "vscode_overrides" }}
{{-   if hasKey .vscode_overrides "exclude_extensions" }}{{ $excluded = .vscode_overrides.exclude_extensions }}{{ end }}
{{-   if hasKey .vscode_overrides "extra_extensions" }}{{ $extras = .vscode_overrides.extra_extensions }}{{ end }}
{{- end }}
{{- range $e := concat $extras .vscode.extensions .vscode.extensions_windows }}
{{-   if not (has $e $excluded) }}
            '{{ $e }}'
{{-   end }}
{{- end }}
        )
        # Install only what is MISSING. The loop used to run `code --install-extension --force`
        # for every extension on every run: each call goes to the marketplace, so one slow or
        # failing response cost minutes (a live `dot up` took 4m44s with two failures), and
        # --force quietly upgraded extensions, which `dot up` must never do. One local listing
        # decides; `dot upgrade` owns updates (`code --update-extensions`).
        $vsInstalled = @()
        $previousErrorActionPreference = $ErrorActionPreference
        try {
            $ErrorActionPreference = "Continue"
            $vsInstalled = @(& code --list-extensions 2>$null | ForEach-Object { "$_".Trim().ToLowerInvariant() } | Where-Object { $_ })
        } finally {
            $ErrorActionPreference = $previousErrorActionPreference
        }
        $vsMissing = @($vsExts | Where-Object { $vsInstalled -notcontains $_.ToLowerInvariant() })
        if ($vsMissing.Count -eq 0) {
            Write-Host "  VS Code extensions: all $($vsExts.Count) present"
        }
        foreach ($ext in $vsMissing) {
            # code.cmd launches Node, whose non-fatal stderr warnings would
            # otherwise terminate this script under the global Stop policy.
            $previousErrorActionPreference = $ErrorActionPreference
            try {
                $ErrorActionPreference = "Continue"
                & code --install-extension $ext *> $null
            } finally {
                $ErrorActionPreference = $previousErrorActionPreference
            }
            if ($LASTEXITCODE -ne 0) {
                Write-Host "    failed: $ext - continuing" -ForegroundColor Red
            }
        }
    }
}
if (-not $vsApply) {
} elseif (-not (Test-Path $vscodeSettings)) {
    # File missing: create it with the full default set, but only when VS Code
    # itself is installed (never fabricate %APPDATA%\Code for a product that
    # isn't there).
    if (Get-Command code -ErrorAction SilentlyContinue) {
        New-Item -ItemType Directory -Force -Path (Split-Path $vscodeSettings) | Out-Null
        $new = [ordered]@{}
        foreach ($k in $vsForced.Keys) { $new[$k] = $vsForced[$k] }
        foreach ($k in $vsDefaults.Keys) { $new[$k] = $vsDefaults[$k] }
        foreach ($k in $vsMerges.Keys) { $new[$k] = [PSCustomObject]$vsMerges[$k] }
        (ConvertTo-SortedJson ([PSCustomObject]$new)) + "`n" | Set-Content -Path $vscodeSettings -Encoding utf8
        Write-Host "  Created VS Code user settings with global defaults" -ForegroundColor Green
    }
} else {
    try {
        $vsJson = ConvertFrom-JsonC (Get-Content $vscodeSettings -Raw)
        $vsChanged = 0
        foreach ($k in $vsForced.Keys) {
            # StrictMode-safe keyed access: dotted names must go through
            # PSObject.Properties (dotting navigates - confirmed live).
            $p = $vsJson.PSObject.Properties[$k]
            if ($null -eq $p -or $p.Value -ne $vsForced[$k]) {
                $vsJson | Add-Member -MemberType NoteProperty -Name $k -Value $vsForced[$k] -Force
                $vsChanged++
            }
        }
        foreach ($k in $vsDefaults.Keys) {
            if ($null -eq $vsJson.PSObject.Properties[$k]) {
                $vsJson | Add-Member -MemberType NoteProperty -Name $k -Value $vsDefaults[$k]
                $vsChanged++
            }
        }
        foreach ($k in $vsMerges.Keys) {
            $objProp = $vsJson.PSObject.Properties[$k]
            if ($null -eq $objProp -or $null -eq $objProp.Value) {
                $vsJson | Add-Member -MemberType NoteProperty -Name $k -Value ([pscustomobject]@{}) -Force
                $objProp = $vsJson.PSObject.Properties[$k]
            }
            foreach ($s in $vsMerges[$k].Keys) {
                if ($null -eq $objProp.Value.PSObject.Properties[$s]) {
                    $objProp.Value | Add-Member -MemberType NoteProperty -Name $s -Value $vsMerges[$k][$s]
                    $vsChanged++
                }
            }
        }
        foreach ($k in $vsUnset) {
            if ($null -ne $vsJson.PSObject.Properties[$k]) {
                $vsJson.PSObject.Properties.Remove($k)
                $vsChanged++
            }
        }
        if ($vsChanged -gt 0) {
            Copy-Item $vscodeSettings "$vscodeSettings.bak" -Force -ErrorAction SilentlyContinue
            (ConvertTo-SortedJson $vsJson) + "`n" | Set-Content -Path $vscodeSettings -Encoding utf8
            Write-Host "  VS Code settings: $vsChanged change(s) (backup: $vscodeSettings.bak)" -ForegroundColor Green
        } else {
            Write-Host "  VS Code settings already at defaults" -ForegroundColor Green
        }
    } catch {
        Write-Host "  Could not parse VS Code settings.json even as JSONC - leaving it untouched ($_)" -ForegroundColor Yellow
    }
}



Add-DotTimingMark -Name 'agent toolkit'
{{- if $agent_toolkit }}
# Agent Toolkit (spec section 2: the cross-vendor agent layer - Serena,
# act, Playwright Chromium. Codex moved to chatgpt_cli, Claude Code to
# claude_cli, agy to antigravity_cli, OpenCode to opencode_cli: vendor
# products live in vendor groups per the spec's placement rule. act joins
# the choco $packages list above under this same gate.)

# Ollama - installer downloads a large (~700MB+) setup with no timeout of its own
if (-not (Get-Command ollama -ErrorAction SilentlyContinue)) {
    Write-Host "  Installing Ollama..." -ForegroundColor Yellow
    # The upstream installer redraws its own download percentage with `\r`; captured through a
    # job each tick becomes a separate Write-Host line (confirmed live: 700+ lines). -NoStream and
    # keep only its ">>> ..." status lines, same treatment as Playwright Chromium below.
    $ollamaOut = @(Invoke-WithTimeout -Description "Ollama install" -Seconds 1200 -NoStream -Action {
        & powershell -NoProfile -c "`$ProgressPreference = 'SilentlyContinue'; irm https://ollama.com/install.ps1 | iex" 2>&1 | ForEach-Object { "$_" }
        "__exit=$LASTEXITCODE"
    })
    $ollamaExit = (@($ollamaOut | Where-Object { "$_" -match '^__exit=' }) | Select-Object -Last 1) -replace '^__exit=', ''
    if ($ollamaExit -and $ollamaExit -ne '0') {
        $ollamaOut | Where-Object { "$_" -notmatch '^__exit=' } | ForEach-Object { Write-Host "    $_" }
        Write-Host "  Warning: Ollama install failed (exit $ollamaExit) - continuing" -ForegroundColor Red
    } else {
        $ollamaOut | Where-Object { "$_" -match '^\s*>>>' } | ForEach-Object { Write-Host "    $_" }
    }
}

Install-Node
if (Get-Command npm -ErrorAction SilentlyContinue) {
    Write-Host "Installing agent toolkit (Playwright)..." -ForegroundColor Cyan

    # Playwright Chromium - headless browser for coding-agent browser
    # automation. Deliberately here, not under dev_desktop: that's
    # gated host-only and never runs on WSL/containers, exactly where
    # coding agents most often run.
    Write-Host "  Installing Playwright Chromium (headless browser for agent automation)..." -ForegroundColor Yellow
    # A new browser build printed ~30 progress-bar lines; now one line per download, and the
    # whole output only when the install fails (the last line carries its exit code).
    $pwOut = @(Invoke-WithTimeout -Description "Playwright Chromium install" -Seconds 600 -NoStream -Action { npx --yes playwright install chromium 2>&1 | ForEach-Object { "$_" }; "__exit=$LASTEXITCODE" })
    $pwExit = (@($pwOut | Where-Object { "$_" -match '^__exit=' }) | Select-Object -Last 1) -replace '^__exit=', ''
    if ($pwExit -and $pwExit -ne '0') {
        $pwOut | Where-Object { "$_" -notmatch '^__exit=' } | ForEach-Object { Write-Host "    $_" }
        Write-Host "  Warning: Playwright Chromium install failed (exit $pwExit) - continuing" -ForegroundColor Red
    } else {
        foreach ($pwLine in $pwOut) { if ("$pwLine" -match '^\s*(.+?) downloaded to ') { Write-Host "    Playwright: $($Matches[1]) downloaded" } }
    }

    # Only when missing: reinstalling agent-browser@latest on every run is an upgrade, and `dot up`
    # never upgrades (`dot upgrade` does it, and skips it when already current).
    if (Get-Command agent-browser -ErrorAction SilentlyContinue) {
        Write-Host "  agent-browser is installed - skipping the npm install (dot upgrade updates it)." -ForegroundColor Yellow
        $LASTEXITCODE = 0
    } else {
        Write-Host "  Installing agent-browser..." -ForegroundColor Yellow
        npm install -g --allow-scripts=agent-browser agent-browser --loglevel=error --no-progress 2>$null
    }
    if ($LASTEXITCODE -ne 0) {
        Write-Host "  Warning: agent-browser install failed (exit code $LASTEXITCODE) - continuing" -ForegroundColor Red
    } else {
        $agentBrowser = Join-Path (npm prefix -g) 'agent-browser.cmd'
        if (Test-Path $agentBrowser) {
            $env:AGENT_BROWSER = $agentBrowser
            # Output shown only on failure: on every run the setup printed an "Installing
            # Chrome... already installed" pair (and a Linux warning on WSL) that are not about
            # this install. Same as the sh twin.
            Invoke-WithTimeout -Description "agent-browser browser setup" -Seconds 600 -Action {
                $setupOutput = @(& $env:AGENT_BROWSER install 2>&1 | ForEach-Object { "$_" })
                if ($LASTEXITCODE -ne 0) { $setupOutput; throw "exit $LASTEXITCODE" }
            }
            # -NoStream returns the job output, so the JSON is summarised here (the job
            # cannot see this session's functions) instead of dumped as a ~3 KB blob.
            $doctorOutput = Invoke-WithTimeout -Description "agent-browser verification" -Seconds 60 -NoStream -Action {
                & $env:AGENT_BROWSER doctor --json
                if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" }
            }
            Write-AgentBrowserDoctorSummary -Output ($doctorOutput | ForEach-Object { "$_" })
            Remove-Item Env:\AGENT_BROWSER -ErrorAction SilentlyContinue
        } else {
            Write-Host "  Warning: agent-browser command was not installed - skipping browser setup" -ForegroundColor Red
        }
    }
}

# Serena (oraios/serena) - MCP semantic code toolkit (LSP-backed find/
#    references/rename/replace-symbol). uv-managed: uv ships its own CPython
#    3.13, so no system Python prerequisite. Register per-client: native
#    `serena setup` for claude-code/codex; JSON/manual merge for the rest
#    (the opencode/agy registration blocks below). Sibling of the npm-guarded
#    block above, NOT inside it - Serena rides on uv, not npm. Windows twin
#    of the sh installer's Serena block.
if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
    Write-Host "  Installing uv (Astral)..." -ForegroundColor Yellow
    # Literal-only scriptblock (jobs don't inherit session variables - see the
    # NOTE on the skills scriptblocks below); the trailing exit-code throw
    # keeps a failed download visible as a job failure.
    Invoke-WithTimeout -Description "uv install" -Seconds 300 -Action {
        & powershell -ExecutionPolicy ByPass -Command "`$ProgressPreference = 'SilentlyContinue'; irm https://astral.sh/uv/install.ps1 | iex"
        if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" }
    }
}
# uv's installer persists its bin dir to User PATH - rebuild so this session sees it
$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
if (Get-Command uv -ErrorAction SilentlyContinue) {
    if (-not (Get-Command serena -ErrorAction SilentlyContinue)) {
        Write-Host "  Installing Serena via uv..." -ForegroundColor Yellow
        Invoke-WithTimeout -Description "uv tool install serena-agent" -Seconds 600 -Action {
            uv tool install -p 3.13 serena-agent
            if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" }
        }
    }
    # Upgrades: `dot upgrade` only (defer-aware there; see codex note).
    # uv tool shims land in User PATH (~\.local\bin) - rebuild again
    $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    if (Get-Command serena -ErrorAction SilentlyContinue) {
        # -NoStream: `serena init` prints the version, the config path and a list of `serena setup
        # <client>` commands (this repo already runs them) on every run; a failure still warns.
        $null = Invoke-WithTimeout -Description "serena init" -Seconds 60 -NoStream -Action { serena init 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
        # Dashboard auto-open follows the catalog (agents.serena.open_dashboard;
        # per-machine override [data.agents.serena] open_dashboard = true in
        # chezmoi.toml). serena init regenerates the file with Serena's default
        # (true), so only this one line is re-asserted; nothing else is touched.
        # Same for the interface: empty means the platform default, which on
        # Windows is the native app with one tray icon per instance.
        $serenaCfg = "$env:USERPROFILE\.serena\serena_config.yml"
        $serenaOpen = '{{ .agents.serena.open_dashboard }}'
        $serenaIface = '{{ .agents.serena.dashboard_interface }}'
        if (Test-Path $serenaCfg) {
            try {
                $serenaLines = [IO.File]::ReadAllLines($serenaCfg)
                $serenaNew = @($serenaLines | ForEach-Object {
                    $_ -replace '^web_dashboard_open_on_launch:\s*(true|false)\s*$', "web_dashboard_open_on_launch: $serenaOpen" `
                       -replace '^web_dashboard_interface:.*$', "web_dashboard_interface: $serenaIface"
                })
                if (($serenaNew -join "`n") -ne ($serenaLines -join "`n")) {
                    [IO.File]::WriteAllLines($serenaCfg, $serenaNew, (New-Object System.Text.UTF8Encoding($false)))
                    Write-Host "  Serena dashboard: auto-open=$serenaOpen interface=$serenaIface" -ForegroundColor Green
                }
            } catch {
                Write-Host "  Warning: could not set Serena dashboard auto-open - $_" -ForegroundColor Red
            }
        }
        if (Get-Command claude -ErrorAction SilentlyContinue) {
            $claudeHasSerena = $false
            # try/catch, not bare 2>$null: under EAP=Stop a missing claude binary
            # is a terminating error the exit-code check below never sees.
            try { claude mcp get serena *> $null; $claudeHasSerena = ($LASTEXITCODE -eq 0) } catch { Write-Verbose "claude mcp get serena probe failed: $($_.Exception.Message)" }
            if (-not $claudeHasSerena) {
                Invoke-WithTimeout -Description "serena setup claude-code" -Seconds 60 -Action { serena setup claude-code 2>$null; if ($LASTEXITCODE -ne 0) { throw "exit $LASTEXITCODE" } }
            }
        }
        # Codex is registered AFTER its install below, not here: this section
        # runs first, so on a machine where codex is missing until this very
        # run the early registration skipped and codex stayed MCP-less
        # (observed live 2026-09-29, codex 0.159.0). See the codex install
        # block's MCP registration.
    }
}

# opencode: global config mcp keys (merge, never clobber the plugin key -
#     the Superpowers-for-OpenCode wiring above owns it). The registration
#     converges on the catalog (Sync-OpenCodeMcp below, #230) and writes only
#     when something differs, so a registered config is never re-serialized.
#     opencode loads MCP ONLY from this global mcp block (surveyed live
#     2026-09-20): a server missing here is missing from every session.
# MCP servers, from .chezmoidata/agents.yaml (see #83): command + args per
# server, consumed by the OpenCode registration and the Antigravity (agy) global
# mcp_config.json registration (the dotfiles-mcp plugin bundle was retired).
{{ includeTemplate "mcp-servers-ps1" .agents.mcp }}
# Registers the catalog's MCP servers in OpenCode's GLOBAL config and CONVERGES
# them (#230): a server whose binary is present (-Present) is added when absent,
# and an existing entry has only its `command` repaired to the catalog's - a
# stale `npx -y <pkg> mcp` once kept a server at a ~46 s npx cold start long
# after the catalog named the installed binary. `enabled` and every other key the user set survive, the file is
# written BOM-less only when something differs (a registered config is never
# re-serialized), and the names it changed are returned.
# Tested by executing it: tests/opencode_mcp_sync_contract.sh.
function Sync-OpenCodeMcp {
    param([string]$ConfigPath, [hashtable]$Catalog, [string[]]$Present)
    $raw = ''
    if (Test-Path -LiteralPath $ConfigPath) {
        # Own try/catch, failing OPEN: under EAP=Stop a locked/unreadable
        # opencode.json would terminate the script here.
        try { $raw = Get-Content -LiteralPath $ConfigPath -Raw } catch {
            Write-Host "  Warning: opencode.json unreadable - attempting merge anyway" -ForegroundColor Yellow
        }
    }
    $json = if ($raw) { $raw | ConvertFrom-Json } else { New-Object PSObject }
    $changed = @()
    foreach ($name in @($Present | Where-Object { $Catalog.ContainsKey($_) } | Sort-Object)) {
        $want = @($Catalog[$name].command) + @($Catalog[$name].args)
        $def = [pscustomobject]@{ type = 'local'; command = $want; enabled = $true }
        if (-not $json.PSObject.Properties['mcp']) {
            $json | Add-Member -MemberType NoteProperty -Name mcp -Value (New-Object PSObject)
        }
        $entry = $json.mcp.PSObject.Properties[$name]
        if (-not $entry -or $entry.Value -isnot [System.Management.Automation.PSCustomObject]) {
            # absent (or not an object at all): the whole definition
            $json.mcp | Add-Member -MemberType NoteProperty -Name $name -Value $def -Force
            $changed += $name
        } else {
            $have = if ($entry.Value.PSObject.Properties['command']) { @($entry.Value.command) } else { @() }
            if (($have -join [char]0) -ne ($want -join [char]0)) {
                $entry.Value | Add-Member -MemberType NoteProperty -Name command -Value $want -Force
                $changed += $name
            }
        }
    }
    if ($changed.Count -gt 0) {
        New-Item -ItemType Directory -Force -Path (Split-Path $ConfigPath) | Out-Null
        # BOM-less UTF-8 (PS 5.1's Set-Content -Encoding utf8 prepends a BOM that
        # Go JSON consumers reject); the round-trip keeps every existing key.
        [System.IO.File]::WriteAllLines($ConfigPath, ($json | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding($false)))
    }
    return $changed
}
if (Get-Command opencode -ErrorAction SilentlyContinue) {
    try {
        $ocPresent = @($mcpCatalog.Keys | Where-Object { Get-Command $mcpCatalog[$_].command -ErrorAction SilentlyContinue })
        $ocChanged = @(Sync-OpenCodeMcp -ConfigPath "$env:USERPROFILE\.config\opencode\opencode.json" -Catalog $mcpCatalog -Present $ocPresent)
        if ($ocChanged.Count -gt 0) {
            Write-Host "  Registered/updated MCP in opencode ($($ocChanged -join ', '))" -ForegroundColor Yellow
        }
    } catch {
        Write-Host "  Warning: opencode MCP registration failed - $_" -ForegroundColor Red
    }
}

# agy: MCP via the TOP-LEVEL mcp_config.json, each server with
#     forceAllToolsEager - agy marks every server's tools lazy by default,
#     and lazy tools are only reachable through the generic call_mcp_tool
#     invoker, which guardrail denies by design (dotfiles #175: serena was
#     effectively unusable in agy). forceAllToolsEager promotes
#     each server's tools to native mcp_<server>_<tool> entries that
#     guardrail's registry already classifies. A plugin bundle is not an
#     alternative: it prefixes the server name, and guardrail does not know
#     mcp_dotfiles-mcp_serena_*. Merge, never clobber: user-added servers
#     and other keys survive. Idempotent: rewriting our keys is a refresh.
#     BOM-less writes per the opencode note above (agy's Go consumer has
#     the same BOM class).
$agyGlobalMcp = "$env:USERPROFILE\.gemini\config\mcp_config.json"
$agyWantServers = @()
if (Get-Command serena -ErrorAction SilentlyContinue) { $agyWantServers += 'serena' }
if ($agyWantServers.Count -gt 0) {
    try {
        New-Item -ItemType Directory -Force -Path (Split-Path $agyGlobalMcp) | Out-Null
        $agyCfg = $null
        if ((Test-Path $agyGlobalMcp) -and ((Get-Item $agyGlobalMcp).Length -gt 0)) {
            try { $agyCfg = Get-Content $agyGlobalMcp -Raw | ConvertFrom-Json } catch {
                throw "existing agy mcp_config.json is not valid JSON - leaving it untouched"
            }
        }
        if (-not $agyCfg) { $agyCfg = New-Object PSObject }
        if (-not $agyCfg.PSObject.Properties['mcpServers']) {
            $agyCfg | Add-Member -MemberType NoteProperty -Name mcpServers -Value (New-Object PSObject)
        }
        # MCP servers, from .chezmoidata/agents.yaml (see #83): only the ones
        # whose binary is present are (re)written; everything else in the
        # file is passed through untouched.
        if ($agyWantServers -contains 'serena') {
            $serenaDef = @{ command = $mcpCatalog.serena.command; args = $mcpCatalog.serena.args; forceAllToolsEager = $true }
            if ($agyCfg.mcpServers.PSObject.Properties['serena']) { $agyCfg.mcpServers.serena = $serenaDef }
            else { $agyCfg.mcpServers | Add-Member -MemberType NoteProperty -Name serena -Value $serenaDef }
        }
        [System.IO.File]::WriteAllText($agyGlobalMcp, ($agyCfg | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding($false)))
        Write-Host "  agy MCP registered in global mcp_config.json (forceAllToolsEager): $($agyWantServers -join ', ')" -ForegroundColor Green
    } catch {
        Write-Host "  Warning: agy MCP registration failed - $_" -ForegroundColor Red
    }
}

# One-time migration: retire the dotfiles-mcp plugin bundle this repo
# wrote before #175 - plugin-prefixed server names (mcp_dotfiles-mcp_*)
# are unknown to guardrail's registry, and a second MCP source doubles
# every server the global file now declares. Only OUR dir is removed;
# other plugins (superpowers) are never touched.
$agyPluginsDir = "$env:USERPROFILE\.gemini\config\plugins\dotfiles-mcp"
if (Test-Path $agyPluginsDir) {
    try {
        Remove-Item -LiteralPath $agyPluginsDir -Recurse -Force
        Write-Host "  Retired the dotfiles-mcp plugin bundle (the global mcp_config.json is the only MCP source now)" -ForegroundColor Green
    } catch {
        Write-Host "  Warning: could not remove the dotfiles-mcp plugin bundle - $_" -ForegroundColor Red
    }
}
# Repair an absent or 0-byte global mcp_config.json to an empty mcpServers
# object: something on Windows leaves a 0-byte file behind (seen 2026-09-24),
# and guardrail's coverage gate cannot read either state (agent-guardrails#334).
# A non-empty file is never touched here, parsable or not.
if (-not (Test-Path $agyGlobalMcp) -or (Get-Item $agyGlobalMcp).Length -eq 0) {
    try {
        New-Item -ItemType Directory -Force -Path (Split-Path $agyGlobalMcp) | Out-Null
        [System.IO.File]::WriteAllText($agyGlobalMcp, ('{' + [Environment]::NewLine + '  "mcpServers": {}' + [Environment]::NewLine + '}' + [Environment]::NewLine), (New-Object System.Text.UTF8Encoding($false)))
        Write-Host "  agy global mcp_config.json was absent or empty - wrote an empty mcpServers object (guardrail coverage gate)" -ForegroundColor Green
    } catch {
        Write-Host "  Warning: could not repair agy global mcp_config.json - $_" -ForegroundColor Red
    }
}
{{- end }}

# mobile_dev install-time safety net (design doc section 3.9a): mobile_dev's
# installer assumes agent_toolkit's tools (Serena, Playwright) already exist.
# docs/package-groups.md forces agent_toolkit on wherever mobile_dev ends up selected (both the
# .chezmoi.toml.tmpl template default and the menu scripts), but a hand-edited

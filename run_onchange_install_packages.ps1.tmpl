{{- if $hasChocolateyPackages }}
# Chocolatey install check (only if packages will be installed)
# The official Chocolatey bootstrap is eval-based by design (its installer
# script must run in this session to set env vars); PSSA suppression is
# scoped to this wrapper so the rule stays live everywhere else.
function Invoke-ChocoBootstrap {
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSAvoidUsingInvokeExpression', '', Justification = 'official Chocolatey bootstrap is eval-based by design')]
    param([string]$InstallerText)
    Invoke-Expression $InstallerText
}
if (-not (Get-Command choco -ErrorAction SilentlyContinue)) {
    if ($IsAdmin) {
        Write-Host "Installing Chocolatey..." -ForegroundColor Cyan
        Set-ExecutionPolicy Bypass -Scope Process -Force
        [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072

        # Retry loop for Chocolatey download (handling 504/503 errors)
        $maxRetries = 3
        $retryCount = 0
        $downloaded = $false

        while (-not $downloaded -and $retryCount -lt $maxRetries) {
            try {
                # -TimeoutSec so a stalled fetch fails into the retry loop
                # instead of hanging the whole run (WebClient.DownloadString
                # has no timeout of its own).
                $chocoInstall = Invoke-RestMethod -Uri 'https://community.chocolatey.org/install.ps1' -UseBasicParsing -TimeoutSec 120
                Invoke-ChocoBootstrap $chocoInstall
                $downloaded = $true
            } catch {
                $retryCount++
                Write-Host "Warning: Chocolatey install failed (Attempt $retryCount/$maxRetries). Retrying in 5s..." -ForegroundColor Yellow
                Start-Sleep -Seconds 5
            }
        }
        
        if (-not $downloaded) {
            Write-Host "Error: Failed to install Chocolatey after $maxRetries attempts." -ForegroundColor Red
            exit 1
        }
    
        # Refresh PATH
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    } else {
        Write-Host "Warning: Skipping Chocolatey installation (Administrator rights required)." -ForegroundColor Yellow
        Write-Host "  Some packages may fail to install." -ForegroundColor Yellow
    }
}
{{- end }}

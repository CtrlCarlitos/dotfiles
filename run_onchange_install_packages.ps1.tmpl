# Wire the Nerd Font into the places that actually render it. Installing the
# font isn't enough - confirmed live that a real machine had it fully
# installed (nerd-fonts-meslo via choco) but neither Windows Terminal nor VS
# Code had it selected, so icons were still broken. This patches only the
# font key in each file rather than owning the whole file (both are live,
# GUI-edited configs - Windows Terminal in particular auto-adds WSL distro
# profiles - so a full chezmoi-managed copy would fight the GUI on every
# apply). Idempotent: skips if already set correctly, e.g. by hand.
#
# Note: ConvertTo-Json reformats the entire file (different indentation than
# each app's own writer), not just the font key - functionally identical,
# cosmetically a full-file diff the first time this runs.
# Same source as the VS Code TERMINAL font tier (not editor.fontFamily -
# the editor and the integrated terminal are allowed to use different faces,
# e.g. a ligature font for code vs. a Nerd Font for prompt icons), so the
# Windows Terminal default font and terminal.integrated.fontFamily cannot
# drift apart.
$desiredFont = {{ get (get $vsCfg "forced" | default dict) "terminal.integrated.fontFamily" | default "MesloLGS Nerd Font Mono" | quote }}

# ConvertFrom-JsonC: both Windows Terminal and VS Code settings.json are
# JSONC (comments and trailing commas are legal there; strict JSON parsers
# reject both - confirmed live: "Could not parse VS Code settings.json" on a
# perfectly healthy file that simply had comments). Single-pass state
# machine strips // and /* */ comments (never inside strings - URLs contain
# //) and trailing commas (never inside strings), then defers to strict
# ConvertFrom-Json for the actual parse so malformed JSON still fails loudly.
# NOTE on write-back below: ConvertTo-Json re-emits strict JSON, which DROPS
# the user's comments - the .bak backup exists for exactly this; restoring
# comments is a documented one-time manual step if the user cares.
# ConvertTo-SortedJson: deterministic serialization for settings.json -
# keys alphabetically sorted at every level (VS Code's own editor canonical
# order, and the operator's readability ask) and exactly 2-space indentation
# (ConvertTo-Json cannot sort keys, and its indentation differs between
# PS 5.1 and 7 - chezmoi may run either). Leaves (strings/numbers/bools/null)
# delegate to ConvertTo-Json -Compress for correct escaping.
function ConvertTo-SortedJson([object]$obj, [int]$depth = 0) {
    $ind = '  ' * $depth
    $ind2 = '  ' * ($depth + 1)
    if ($obj -is [System.Management.Automation.PSCustomObject]) {
        $props = @($obj.PSObject.Properties | Sort-Object Name)
        if ($props.Count -eq 0) { return '{}' }
        $parts = foreach ($p in $props) {
            "$ind2$($p.Name | ConvertTo-Json -Compress): $(ConvertTo-SortedJson $p.Value ($depth + 1))"
        }
        return "{`n" + ($parts -join ",`n") + "`n$ind}"
    }
    if ($obj -is [System.Collections.IList] -and -not ($obj -is [string])) {
        if ($obj.Count -eq 0) { return '[]' }
        $parts = foreach ($v in $obj) { "$ind2$(ConvertTo-SortedJson $v ($depth + 1))" }
        return "[`n" + ($parts -join ",`n") + "`n$ind]"
    }
    return ($obj | ConvertTo-Json -Compress)
}

function ConvertFrom-JsonC([string]$JsonCText) {
    $sb = New-Object System.Text.StringBuilder
    $i = 0; $n = $JsonCText.Length
    $inString = $false
    while ($i -lt $n) {
        $c = $JsonCText[$i]
        if ($inString) {
            [void]$sb.Append($c)
            if ($c -eq '\' -and ($i + 1) -lt $n) { [void]$sb.Append($JsonCText[$i + 1]); $i++ }
            elseif ($c -eq '"') { $inString = $false }
            $i++
            continue
        }
        if ($c -eq '"') { $inString = $true; [void]$sb.Append($c); $i++; continue }
        if ($c -eq '/' -and ($i + 1) -lt $n -and $JsonCText[$i + 1] -eq '/') {
            while ($i -lt $n -and $JsonCText[$i] -ne "`n") { $i++ }
            continue
        }
        if ($c -eq '/' -and ($i + 1) -lt $n -and $JsonCText[$i + 1] -eq '*') {
            $i += 2
            while ($i -lt ($n - 1) -and -not ($JsonCText[$i] -eq '*' -and $JsonCText[$i + 1] -eq '/')) { $i++ }
            $i += 2
            continue
        }
        [void]$sb.Append($c)
        $i++
    }
    $clean = $sb.ToString()
    # trailing commas before } or ] (outside strings is guaranteed here:
    # comment stripping above never enters strings, so a comma still inside
    # a string literal is part of the string and regex-safe)
    $clean = [regex]::Replace($clean, ',(\s*[}\]])', '$1')
    return ($clean | ConvertFrom-Json -ErrorAction Stop)
}

$wtSettings = @(
    "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json",
    "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
) | Where-Object { Test-Path $_ } | Select-Object -First 1

Add-DotTimingMark -Name 'fonts'
{{- if $fonts }}
if ($wtSettings) {
    try {
        $wtJson = ConvertFrom-JsonC (Get-Content $wtSettings -Raw)
        if (-not $wtJson.profiles) { $wtJson | Add-Member -MemberType NoteProperty -Name profiles -Value ([PSCustomObject]@{}) -Force }
        if (-not $wtJson.profiles.defaults) { $wtJson.profiles | Add-Member -MemberType NoteProperty -Name defaults -Value ([PSCustomObject]@{}) -Force }
        if (-not $wtJson.profiles.defaults.font) { $wtJson.profiles.defaults | Add-Member -MemberType NoteProperty -Name font -Value ([PSCustomObject]@{}) -Force }
        if ($wtJson.profiles.defaults.font.face -ne $desiredFont) {

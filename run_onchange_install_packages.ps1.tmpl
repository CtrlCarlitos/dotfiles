# Package names come from .chezmoidata/packages.yaml; scripts/migrate-to-choco.ps1
# reads the same catalog at runtime, so there is no second list to keep in sync.
$packages = @()

# On Windows PowerShell 5.1 (this script's target - see #Requires above),
# $ErrorActionPreference = "Stop" promotes ANY line a native command writes to
# stderr into a terminating error - `2>$null` does NOT suppress this, because
# the promotion happens before the redirection operator gets a chance to run.
# This is especially sharp for npm/npx/claude/opencode on Windows, which are
# themselves npm-generated .ps1 wrapper scripts around node.exe, not raw
# .exe files - node's own routine stderr logging (e.g. an npm consent/
# telemetry echo) then runs in-session and inherits this script's
# $ErrorActionPreference, aborting everything after it. Confirmed live: this
# silently killed an entire real install run partway through the AI-tools
# section, on a real Windows machine - fonts, Chrome, and Antigravity never
# even ran. Route every such call through this instead of a bare `2>$null`.
function Invoke-Quietly {
    param(
        [string]$Description,
        [scriptblock]$Action
    )
    try {
        & $Action
    } catch {
        Write-Host "  Warning: $Description - $_" -ForegroundColor Red
    }
}

function Install-Node {
    # The pins come from .chezmoidata.yaml versions.* (#125): the major gate
    # and the full Chocolatey package version. The major is bound to a
    # variable first: the lint strips template actions to nothing, and a bare
    # -lt with a stripped operand would not parse as a comparison.
    $nodeMajor = {{ .versions.node_major }}
    if (-not (Get-Command node -ErrorAction SilentlyContinue) -or [int]((node -v) -replace 'v','' -split '\.')[0] -lt $nodeMajor) {
        Write-Host "  Installing Node.js $nodeMajor..." -ForegroundColor Yellow
        choco install nodejs --version={{ .versions.node_choco }} -y --no-progress | Out-Null
        # Refresh env var
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
    # Upgrade npm to latest
    if (Get-Command npm -ErrorAction SilentlyContinue) {
        Write-Host "  Upgrading npm to latest..." -ForegroundColor Yellow
        Invoke-Quietly -Description "Failed to upgrade npm" -Action { npm install -g npm@latest --loglevel=error --fund=false --fetch-timeout=120000 --fetch-retries=2 2>$null }
    }
}


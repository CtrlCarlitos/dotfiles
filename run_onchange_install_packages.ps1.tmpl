{{ if eq .chezmoi.os "windows" -}}
#Requires -Version 5.1
<#
.SYNOPSIS
    Chezmoi run_onchange script for Windows package installation
.DESCRIPTION
    Installs Chocolatey packages and Oh My Posh on Windows systems.
    Runs whenever the package list changes.
    Version: 1.0.4 (Force Re-run)
    1.0.2: operator installed the VS C++ Build Tools after the initial
    install had skipped Graft for lack of them - re-run so the graft block
    sees the toolchain and installs it (dotup alone would not re-fire:
    run_onchange needs a content change, and prerequisite changes on the
    machine are invisible to the hash).
    1.0.3: hard elevation gate. A non-admin dotup "succeeded" with degraded
    warnings, chezmoi recorded the script hash, and the follow-up elevated
    dotup had nothing left to fire (confirmed live). Non-admin runs now exit
    1 BEFORE doing anything: chezmoi does not record failed scripts, so the
    next elevated dotup re-fires the installer with admin steps intact.
    1.0.4: Build Tools auto-install + JSONC. The elevation gate makes
    admin guaranteed, so the graft block now installs the VC Build Tools
    workload itself (one elevated dotup does the whole chain) instead of
    printing manual winget guidance. Windows Terminal / VS Code
    settings.json parsing moved to a JSONC-tolerant parser (comments and
    trailing commas are legal in both files; strict JSON rejected them -
    confirmed live on VS Code).
    1.0.5: batched choco inventory + hard timeout kills. A per-package
    choco-list probe wedged pre-resolution for 77 minutes
    (2026-09-20, confirmed live, ~1 core, uncapped) and froze the whole
    elevated run; Stop-Job could not kill it either (native children
    survive as orphans holding choco's global mutex). The probe loop is now
    ONE timeout-capped `choco list --limit-output` (with a nupkg-presence
    degraded fallback), and Invoke-WithTimeout hard-kills the job's
    process tree on expiry. Contract: tests/choco_probe_contract.sh.
    1.0.6: registry fuzzy-skip anchored to prefix. Substring matching let
    package `tree` match "WizTree v4.32" - unrelated software - so tree
    was silently never installed (2026-09-20, confirmed via choco
    upgrade all listing). Same contract test as 1.0.5.
    1.0.7: guardrail exit-code contract (pin bumped alongside in
    .chezmoidata.yaml). The installer is classified by exit code
    only: 0 continue, 3 warn with the remedy (operator action
    pending - unattended applies can never complete one), anything
    else fails the run - replacing wording-based matching. New
    end-of-apply Invoke-GuardrailNextStep prints the binary's
    `guardrail next` block verbatim and ends the run with an
    ACTION NEEDED when steps are pending. Contract:
    tests/guardrail_lifecycle_contract.sh.
#>

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

# Hard elevation gate - exit before ANY work. Chocolatey, capability
# installs (OpenSSH) and machine-wide winget packages all require
# Administrator; running degraded once silently burns
# the run_onchange trigger for the elevated follow-up (see 1.0.3 note).
# Pure .NET check - no module autoload, safe before the PSModulePath guard.
$__isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $__isAdmin) {
    Write-Host "This installer requires an elevated PowerShell (Administrator)." -ForegroundColor Red
    Write-Host "  Chocolatey, OpenSSH capabilities and winget machine-wide installs all need it." -ForegroundColor Red
    Write-Host "  Open a terminal as Administrator and re-run: dot up" -ForegroundColor Yellow
    Write-Host "  (Nothing was changed - the installer will re-run fully once elevated.)" -ForegroundColor Yellow
    exit 1
}

# Single-flight guard: 2026-09-20 live incident - two concurrent dotups
# (22:57 + 23:12) multiplied every choco/npm lock into a night-long outage
# (double probe storms, global-mutex blocks, orphaned upgrades). A second
# instance exits 1 BEFORE any work; chezmoi records nothing for a failed
# script, so the next dotup re-fires fully - the same contract as the
# elevation gate above. Global\ = machine-wide, across elevation levels.
# Process exit releases the mutex on every path, including hard kills.
$__dotupMutex = New-Object System.Threading.Mutex($false, 'Global\dotfiles-install')
if (-not $__dotupMutex.WaitOne(0)) {
    Write-Host "Another dotfiles installer instance is running - exiting without changes." -ForegroundColor Red
    Write-Host "  (Nothing was recorded; the next dotup re-runs fully.)" -ForegroundColor Yellow
    exit 1
}

# Cross-generation PSModulePath guard (see run_onchange_generate_identities.
# ps1.tmpl for the full story): this script's Get-FileHash lives in
# Microsoft.PowerShell.Utility, the same broken-autoload class as
# Security's Set-Acl when 5.1 inherits pwsh 7's module path. Strip the Core
# module dirs under 5.1 so in-box modules resolve.
if ($PSVersionTable.PSVersion.Major -le 5) {
    $env:PSModulePath = (($env:PSModulePath -split ';') |
        Where-Object { $_ -and ($_ -notmatch '\\PowerShell\\[67]\\') }) -join ';'
    Import-Module Microsoft.PowerShell.Security, Microsoft.PowerShell.Utility -ErrorAction SilentlyContinue
}
# Windows PowerShell 5.1 redraws the progress bar of Invoke-WebRequest and
# Expand-Archive ("Writing request stream...") for every received chunk, which
# throttles large downloads to a crawl: measured 2026-09-30, the 161 MB Chrome
# MSI ran at ~6 MB/min on a link that does ~8 MB/s. Silence it for this session.
# This does NOT reach Start-Job jobs or child powershell processes (separate
# sessions): Invoke-WithTimeout and the `irm | iex` launches below set it again.
$ProgressPreference = 'SilentlyContinue'
# Native tools (agent-browser, guardrail) print UTF-8 (check marks, em dashes);
# PowerShell decodes their output with the console's OEM code page, which
# rendered a check mark as three Windows-1252 characters in the apply log. Process-local, so nothing outside
# this run changes. try: a host without a console handle throws here.
try { [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false) } catch { Write-Verbose "console encoding unchanged: $($_.Exception.Message)" }
# The skills helpers (Invoke-SkillsSource, Write-AgentBrowserDoctorSummary, ...) are inlined
# HERE, before anything calls them: a run_onchange script runs top to bottom, and the
# include used to sit near the skills section, so the agent-browser step (far above it)
# failed with "Write-AgentBrowserDoctorSummary is not recognized" and aborted the apply.
# tests/ps_template_define_before_use_contract.sh pins the order.
{{ include "scripts/lib/ps-skills.ps1" }}
{{ include "scripts/lib/ps-desktop-shortcuts.ps1" }}
{{ include "scripts/lib/ps-timing.ps1" }}
{{ include "scripts/lib/ps-installer-output.ps1" }}
# Installer boilerplate is logged, not shown (scripts/lib/ps-installer-output.ps1).
Initialize-InstallerOutput
# [data.upgrade] desktop_shortcuts = false: the installers this run starts drop shortcuts on
# the Desktop as well (Geany, OBS, ShareX and Termius did, 2026-10-07). Snapshot now; the new
# ones go just before "Package installation complete!".
$dropDesktopShortcuts = Test-DesktopShortcutsDisabled
$shortcutsBefore = @()
if ($dropDesktopShortcuts) { $shortcutsBefore = @(Get-DesktopShortcutBaseline) }
# Wall-clock guard for network install steps (large downloads, `irm | iex`
# installers, npm/npx) that carry no timeout of their own. On the Linux side a
# stalled fetch was confirmed live to freeze the whole run for 15+ min with
# nothing able to proceed - PowerShell has the same exposure (WebClient and
# Start-Process -Wait both block indefinitely). Runs the scriptblock as a job
# and kills it past -Seconds so the caller continues. Never throws - same
# contract as Invoke-Quietly below. Jobs inherit $env (PATH) but not this
# session's functions, so pass fully self-contained commands.
function Invoke-WithTimeout {
    param(
        [Parameter(Mandatory)][string]$Description,
        [Parameter(Mandatory)][int]$Seconds,
        [Parameter(Mandatory)][scriptblock]$Action,
        # Collect job output and RETURN it instead of streaming to the host -
        # for callers that use the result (the batched choco inventory below),
        # not just the side effect. Streaming callers see zero behavior change.
        [switch]$NoStream
    )
    $jobStarted = Get-Date
    # -InitializationScript: a job is a fresh process and does not inherit the
    # session's $ProgressPreference (see the note above); without this every
    # Invoke-WebRequest inside an Action still pays the progress-bar tax.
    # The same applies to the console encoding set above (a job is a fresh process).
    $job = Start-Job -InitializationScript { $ProgressPreference = 'SilentlyContinue'; try { [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false) } catch { $null = $_ } } -ScriptBlock $Action
    $deadline = $jobStarted.AddSeconds($Seconds)
    $collected = @()
    while ($job.State -eq 'Running' -and (Get-Date) -lt $deadline) {
        $out = @(Receive-Job $job -ErrorAction SilentlyContinue)
        if (-not $NoStream) { $out | ForEach-Object { Write-Host "    $_" } }
        $collected += $out
        Start-Sleep -Milliseconds 500
    }
    $out = @(Receive-Job $job -ErrorAction SilentlyContinue)
    if (-not $NoStream) { $out | ForEach-Object { Write-Host "    $_" } }
    $collected += $out
    if ($job.State -eq 'Running') {
        # Stop-Job cannot terminate a native child mid-call. 2026-09-20,
        # confirmed live: a wedged choco probe outlived its 600s cap by 70+
        # minutes as an orphan burning ~1 core, holding Chocolatey's global
        # mutex and freezing every choco step of a concurrent run. Kill the
        # job's process TREE hard - taskkill /T reaches the native
        # grandchildren Stop-Job can't - then reap the job object. Matched by
        # parent PID + spawn window: this script only ever has one live job
        # (every call site is sequential), so the newest qualifying child IS
        # the job shell. try/catch, not bare 2>$null: taskkill's stderr would
        # otherwise hit the PS 5.1 native-stderr terminating-error trap (see
        # Invoke-Quietly below). Never throws - same contract as the rest.
        try {
            Get-CimInstance Win32_Process -Filter "Name='powershell.exe' OR Name='pwsh.exe'" |
                Where-Object { $_.ParentProcessId -eq $PID -and $_.CreationDate -ge $jobStarted.AddSeconds(-2) } |
                ForEach-Object { & taskkill /PID $_.ProcessId /T /F | Out-Null }
        } catch { Write-Verbose "timeout kill sweep failed: $($_.Exception.Message)" }
        Stop-Job $job -ErrorAction SilentlyContinue
        Write-Host "  Warning: $Description - timed out after ${Seconds}s (process tree killed), continuing" -ForegroundColor Red
    } elseif ($job.State -eq 'Failed') {
        Write-Host "  Warning: $Description - failed" -ForegroundColor Red
        $reason = $job.ChildJobs[0].JobStateInfo.Reason
        if ($reason) { Write-Host "    $reason" -ForegroundColor Red }
    }
    Remove-Job $job -Force -ErrorAction SilentlyContinue
    if ($NoStream) { return $collected }
}


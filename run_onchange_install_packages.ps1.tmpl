# WSL: no package manager owns it (catalog note on wsl2). Installed here only when missing; it
# needs a reboot to finish, so this says so instead of continuing as if it were ready.
# WSL_UTF8: wsl.exe writes UTF-16 otherwise, which PowerShell prints with a NUL between letters.
$env:WSL_UTF8 = '1'
$wslReady = $false
if (Get-Command wsl.exe -ErrorAction SilentlyContinue) {
    & wsl.exe --status *> $null
    $wslReady = ($LASTEXITCODE -eq 0)
}
if (-not $wslReady -and (Get-Command wsl.exe -ErrorAction SilentlyContinue)) {
    Write-Host "  Installing WSL (wsl --install --no-distribution)..." -ForegroundColor Yellow
    & wsl.exe --install --no-distribution
    Write-Host "  WSL installed - restart Windows to finish, then: wsl --install -d Ubuntu" -ForegroundColor Yellow
} elseif (-not $wslReady) {
    Write-Host "  Warning: wsl.exe not found - this Windows cannot install WSL from here" -ForegroundColor Red
}
Remove-Item Env:\WSL_UTF8 -ErrorAction SilentlyContinue


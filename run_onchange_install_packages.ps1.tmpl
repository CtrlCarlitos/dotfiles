{{- if or $hasChocolateyPackages $remote_access_server }}
# Check Admin Status
$IsAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

{{- if $hasChocolateyPackages }}
# Chocolatey install check (only if packages will be installed)
if (-not (Get-Command choco -ErrorAction SilentlyContinue)) {
    if ($IsAdmin) {
        Write-Host "Installing Chocolatey..." -ForegroundColor Cyan
        Set-ExecutionPolicy Bypass -Scope Process -Force
        [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
        
        # Retry loop for Chocolatey download (handling 504/503 errors)
        $maxRetries = 3
        $retryCount = 0
        $downloaded = $false
        
        while (-not $downloaded -and $retryCount -lt $maxRetries) {
            try {
                # -TimeoutSec so a stalled fetch fails into the retry loop
                # instead of hanging the whole run (WebClient.DownloadString
                # has no timeout of its own).
                $chocoInstall = Invoke-RestMethod -Uri 'https://community.chocolatey.org/install.ps1' -UseBasicParsing -TimeoutSec 120
                Invoke-Expression $chocoInstall
                $downloaded = $true
            } catch {
                $retryCount++
                Write-Host "Warning: Chocolatey install failed (Attempt $retryCount/$maxRetries). Retrying in 5s..." -ForegroundColor Yellow
                Start-Sleep -Seconds 5
            }
        }
        
        if (-not $downloaded) {
            Write-Host "Error: Failed to install Chocolatey after $maxRetries attempts." -ForegroundColor Red
            exit 1
        }
    
        # Refresh PATH
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    } else {
        Write-Host "Warning: Skipping Chocolatey installation (Administrator rights required)." -ForegroundColor Yellow
        Write-Host "  Some packages may fail to install." -ForegroundColor Yellow
    }
}
{{- end }}
{{- end }}

$packages = @()

# On Windows PowerShell 5.1 (this script's target - see #Requires above),
# $ErrorActionPreference = "Stop" promotes ANY line a native command writes to
# stderr into a terminating error - `2>$null` does NOT suppress this, because
# the promotion happens before the redirection operator gets a chance to run.
# This is especially sharp for npm/npx/claude/opencode on Windows, which are
# themselves npm-generated .ps1 wrapper scripts around node.exe, not raw
# .exe files - node's own routine stderr logging (e.g. an npm consent/
# telemetry echo) then runs in-session and inherits this script's
# $ErrorActionPreference, aborting everything after it. Confirmed live: this
# silently killed an entire real install run partway through the AI-tools
# section, on a real Windows machine - fonts, Chrome, and Antigravity never
# even ran. Route every such call through this instead of a bare `2>$null`.
function Invoke-Quietly {
    param(
        [string]$Description,
        [scriptblock]$Action
    )
    try {
        & $Action
    } catch {
        Write-Host "  Warning: $Description - $_" -ForegroundColor Red
    }
}

function Install-Node {
    if (-not (Get-Command node -ErrorAction SilentlyContinue) -or [int]((node -v) -replace 'v','' -split '\.')[0] -lt 24) {
        Write-Host "  Installing Node.js 24..." -ForegroundColor Yellow
        choco install nodejs --version=24.19.0 -y --no-progress | Out-Null
        # Refresh env var
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
    # Upgrade npm to latest
    if (Get-Command npm -ErrorAction SilentlyContinue) {
        Write-Host "  Upgrading npm to latest..." -ForegroundColor Yellow
        Invoke-Quietly -Description "Failed to upgrade npm" -Action { npm install -g npm@latest --loglevel=error --fund=false --fetch-timeout=120000 --fetch-retries=2 2>$null }
    }
}

{{- if $core }}
# Core tools
# psmux: the native Windows tmux (Rust, github.com/psmux/psmux) - official
# Chocolatey package, ships psmux/pmux/tmux commands and reads .tmux.conf, so
# it lands right where tmux sits on Linux/macOS. Right after powershell-core

# Wire the Nerd Font into the places that actually render it. Installing the
# font isn't enough - confirmed live that a real machine had it fully
# installed (nerd-fonts-meslo via choco) but neither Windows Terminal nor VS
# Code had it selected, so icons were still broken. This patches only the
# font key in each file rather than owning the whole file (both are live,
# GUI-edited configs - Windows Terminal in particular auto-adds WSL distro
# profiles - so a full chezmoi-managed copy would fight the GUI on every
# apply). Idempotent: skips if already set correctly, e.g. by hand.
#
# Note: ConvertTo-Json reformats the entire file (different indentation than
# each app's own writer), not just the font key - functionally identical,
# cosmetically a full-file diff the first time this runs.
# Same source as the VS Code font tier, so the Windows Terminal default font
# and editor.fontFamily cannot drift apart.
$desiredFont = {{ index .vscode.settings.forced "editor.fontFamily" | quote }}

# ConvertFrom-JsonC: both Windows Terminal and VS Code settings.json are
# JSONC (comments and trailing commas are legal there; strict JSON parsers
# reject both - confirmed live: "Could not parse VS Code settings.json" on a
# perfectly healthy file that simply had comments). Single-pass state
# machine strips // and /* */ comments (never inside strings - URLs contain
# //) and trailing commas (never inside strings), then defers to strict
# ConvertFrom-Json for the actual parse so malformed JSON still fails loudly.
# NOTE on write-back below: ConvertTo-Json re-emits strict JSON, which DROPS
# the user's comments - the .bak backup exists for exactly this; restoring
# comments is a documented one-time manual step if the user cares.
# ConvertTo-SortedJson: deterministic serialization for settings.json -
# keys alphabetically sorted at every level (VS Code's own editor canonical
# order, and the operator's readability ask) and exactly 2-space indentation
# (ConvertTo-Json cannot sort keys, and its indentation differs between
# PS 5.1 and 7 - chezmoi may run either). Leaves (strings/numbers/bools/null)
# delegate to ConvertTo-Json -Compress for correct escaping.
function ConvertTo-SortedJson([object]$obj, [int]$depth = 0) {
    $ind = '  ' * $depth
    $ind2 = '  ' * ($depth + 1)
    if ($obj -is [System.Management.Automation.PSCustomObject]) {
        $props = @($obj.PSObject.Properties | Sort-Object Name)
        if ($props.Count -eq 0) { return '{}' }
        $parts = foreach ($p in $props) {
            "$ind2$($p.Name | ConvertTo-Json -Compress): $(ConvertTo-SortedJson $p.Value ($depth + 1))"
        }
        return "{`n" + ($parts -join ",`n") + "`n$ind}"
    }
    if ($obj -is [System.Collections.IList] -and -not ($obj -is [string])) {
        if ($obj.Count -eq 0) { return '[]' }
        $parts = foreach ($v in $obj) { "$ind2$(ConvertTo-SortedJson $v ($depth + 1))" }
        return "[`n" + ($parts -join ",`n") + "`n$ind]"
    }
    return ($obj | ConvertTo-Json -Compress)
}

function ConvertFrom-JsonC([string]$JsonCText) {
    $sb = New-Object System.Text.StringBuilder
    $i = 0; $n = $JsonCText.Length
    $inString = $false
    while ($i -lt $n) {
        $c = $JsonCText[$i]
        if ($inString) {
            [void]$sb.Append($c)
            if ($c -eq '\' -and ($i + 1) -lt $n) { [void]$sb.Append($JsonCText[$i + 1]); $i++ }
            elseif ($c -eq '"') { $inString = $false }
            $i++
            continue
        }
        if ($c -eq '"') { $inString = $true; [void]$sb.Append($c); $i++; continue }
        if ($c -eq '/' -and ($i + 1) -lt $n -and $JsonCText[$i + 1] -eq '/') {
            while ($i -lt $n -and $JsonCText[$i] -ne "`n") { $i++ }
            continue
        }
        if ($c -eq '/' -and ($i + 1) -lt $n -and $JsonCText[$i + 1] -eq '*') {
            $i += 2
            while ($i -lt ($n - 1) -and -not ($JsonCText[$i] -eq '*' -and $JsonCText[$i + 1] -eq '/')) { $i++ }
            $i += 2
            continue
        }
        [void]$sb.Append($c)
        $i++
    }
    $clean = $sb.ToString()
    # trailing commas before } or ] (outside strings is guaranteed here:
    # comment stripping above never enters strings, so a comma still inside
    # a string literal is part of the string and regex-safe)
    $clean = [regex]::Replace($clean, ',(\s*[}\]])', '$1')
    return ($clean | ConvertFrom-Json -ErrorAction Stop)
}

$wtSettings = @(
    "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json",
    "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
) | Where-Object { Test-Path $_ } | Select-Object -First 1

{{- if $fonts }}
if ($wtSettings) {
    try {
        $wtJson = ConvertFrom-JsonC (Get-Content $wtSettings -Raw)
        if (-not $wtJson.profiles) { $wtJson | Add-Member -MemberType NoteProperty -Name profiles -Value ([PSCustomObject]@{}) -Force }
        if (-not $wtJson.profiles.defaults) { $wtJson.profiles | Add-Member -MemberType NoteProperty -Name defaults -Value ([PSCustomObject]@{}) -Force }
        if (-not $wtJson.profiles.defaults.font) { $wtJson.profiles.defaults | Add-Member -MemberType NoteProperty -Name font -Value ([PSCustomObject]@{}) -Force }
        if ($wtJson.profiles.defaults.font.face -ne $desiredFont) {
            Copy-Item $wtSettings "$wtSettings.bak" -Force -ErrorAction SilentlyContinue
            $wtJson.profiles.defaults.font | Add-Member -MemberType NoteProperty -Name face -Value $desiredFont -Force
            $wtJson | ConvertTo-Json -Depth 10 | Set-Content -Path $wtSettings -Encoding utf8
            Write-Host "  Set Windows Terminal default font to $desiredFont (backup: $wtSettings.bak)" -ForegroundColor Green
        }
    } catch {
        Write-Host "  Could not parse Windows Terminal settings.json even as JSONC - leaving it untouched ($_)" -ForegroundColor Yellow
    }
}
{{- end }}

# User-level global settings (operator-confirmed semantics): CREATE the file
# when missing (only when VS Code itself is installed), else merge. Curated
# defaults for HUMAN coding, stack-agnostic (no formatters/linters/interpreters
# - per-project concerns, irrelevant to AI agents). Semantics identical to the
# .sh twin:
#   FORCED - font keys (consistency mandate: MesloLGS NF everywhere)
#   UPSERT - other keys only when ABSENT (user values win; projects layer on top)
#   MERGE  - object keys (files.exclude/search.exclude) gain only missing sub-keys
# Gated by packages.vscode_settings (hasKey pattern: default true, set
# `[data.packages] vscode_settings = false` in chezmoi.toml to opt out - no prompt, so no
# CI-seeding burden, see check_workflow_config_keys for that outage class).
# Every tier below is rendered from .chezmoidata.yaml `vscode.settings`, the
# single source this twin shares with run_onchange_install_packages.sh.tmpl
# (#83). Values are emitted as native PowerShell literals rather than parsed at
# runtime: this script targets Windows PowerShell 5.1 (see #Requires above),
# where ConvertFrom-Json has no -AsHashtable and returns a PSCustomObject.
$vsForced = @{
{{- range $k, $v := .vscode.settings.forced }}
    '{{ $k }}' = "{{ $v | replace "`" "``" | replace "$" "`$" | replace "\"" "`\"" | replace "\n" "`n" }}"
{{- end }}
}
$vsDefaults = [ordered]@{
{{- range $k, $v := .vscode.settings.defaults }}
    '{{ $k }}' = {{ if kindIs "bool" $v }}${{ $v }}{{ else if kindIs "string" $v }}"{{ $v | replace "`" "``" | replace "$" "`$" | replace "\"" "`\"" | replace "\n" "`n" }}"{{ else if kindIs "slice" $v }}@({{ range $i, $e := $v }}{{ if $i }}, {{ end }}'{{ $e }}'{{ end }}){{ else }}{{ $v }}{{ end }}
{{- end }}
{{- /* Windows-only tier: the .sh twin deliberately renders none of these. */}}
{{- range $k, $v := .vscode.settings.defaults_windows }}
    '{{ $k }}' = {{ if kindIs "bool" $v }}${{ $v }}{{ else }}"{{ $v | replace "`" "``" | replace "$" "`$" | replace "\"" "`\"" | replace "\n" "`n" }}"{{ end }}
{{- end }}
}
$vsJunk = @({{ range $i, $g := .vscode.settings.junk }}{{ if $i }}, {{ end }}'{{ $g }}'{{ end }})
$vsJunkMap = [ordered]@{}
foreach ($s in $vsJunk) { $vsJunkMap[$s] = $true }
$vsTerminalColors = [ordered]@{
{{- range $k, $v := .vscode.settings.terminal_colors }}
    '{{ $k }}' = '{{ $v }}'
{{- end }}
}
# MERGES: object key -> sub-keys (with values) added only when absent.
$vsMerges = @{ 'files.exclude' = $vsJunkMap; 'search.exclude' = $vsJunkMap; 'workbench.colorCustomizations' = $vsTerminalColors }
$vsUnset = [System.Collections.Generic.List[string]]@({{ range $i, $u := .vscode.settings.unset }}{{ if $i }}, {{ end }}'{{ $u }}'{{ end }})

# Machine-local settings drift, rendered from [data.vscode_overrides] (see
# the extensions comment above for why not [data.vscode]):
#   exclude_settings - JSON array; strips any tier (excluding a font key
#                      stops its forced re-assert on this machine)
#   extra_settings   - JSON object; joins the DEFAULTS tier (upsert-if-absent;
#                      to change a baseline value: exclude it AND add an extra)
$vsExcludeSettings = @(
{{- if hasKey . "vscode_overrides" }}
{{-   if hasKey .vscode_overrides "exclude_settings" }}
{{-     range .vscode_overrides.exclude_settings }}
    '{{ . }}'
{{-     end }}
{{-   end }}
{{- end }}
)
# Literal here-string transport (single quotes in values would terminate a
# single-quoted string mid-line - same class the .sh twin guards against;
# compact JSON has no newlines, so the '@ terminator can never collide).
$vsExtraSettingsJson = @'
{{ if hasKey . "vscode_overrides" }}{{ if hasKey .vscode_overrides "extra_settings" }}{{ .vscode_overrides.extra_settings | toJson }}{{ else }}{}{{ end }}{{ else }}{}{{ end }}
'@
if ($vsExcludeSettings.Count -gt 0) {
    foreach ($k in $vsExcludeSettings) {
        $vsForced.Remove($k) ; $vsDefaults.Remove($k) ; $vsMerges.Remove($k) ; [void]$vsUnset.Remove($k)
    }
}
if ($vsExtraSettingsJson -and $vsExtraSettingsJson.Trim() -ne '{}') {
    $vsExtra = $vsExtraSettingsJson | ConvertFrom-Json
    foreach ($p in $vsExtra.PSObject.Properties) {
        $vsDefaults[$p.Name] = $p.Value
    }
}

$vscodeSettings = "$env:APPDATA\Code\User\settings.json"
$vsApply = $true
{{- if not $vscodeSettings }}
$vsApply = $false
{{- end }}
if (-not $vsApply) {
    Write-Host "  VS Code settings defaults disabled in config" -ForegroundColor Yellow
} else {
    # Extensions first (same gate): idempotent `code --install-extension`,
    # list rendered from .chezmoidata.yaml vscode.extensions (+ _windows).
    if (Get-Command code -ErrorAction SilentlyContinue) {
        Write-Host "  Installing VS Code extensions (global, idempotent)..." -ForegroundColor Yellow
        # Machine-local drift lives in chezmoi.toml [data.vscode_overrides] -
        # deliberately a DIFFERENT key from the .chezmoidata.yaml vscode table:
        # chezmoi does not deep-merge same-named data tables (config [data.X]
        # is wholesale-shadowed by chezmoidata X), so the merge happens here.
        #   extra_extensions    - appended to the repo baseline
        #   exclude_extensions  - filtered out: stop reinstalling on THIS
        #                          machine only (repo-side veto contract still
        #                          guards the curated list)
        $vsExts = @(
{{- $excluded := list }}
{{- $extras := list }}
{{- if hasKey . "vscode_overrides" }}
{{-   if hasKey .vscode_overrides "exclude_extensions" }}{{ $excluded = .vscode_overrides.exclude_extensions }}{{ end }}
{{-   if hasKey .vscode_overrides "extra_extensions" }}{{ $extras = .vscode_overrides.extra_extensions }}{{ end }}
{{- end }}
{{- range $e := concat $extras .vscode.extensions .vscode.extensions_windows }}
{{-   if not (has $e $excluded) }}
            '{{ $e }}'
{{-   end }}
{{- end }}
        )
        foreach ($ext in $vsExts) {
            # code.cmd launches Node, whose non-fatal stderr warnings would
            # otherwise terminate this script under the global Stop policy.
            $previousErrorActionPreference = $ErrorActionPreference
            try {
                $ErrorActionPreference = "Continue"
                & code --install-extension $ext --force *> $null
            } finally {
                $ErrorActionPreference = $previousErrorActionPreference
            }
            if ($LASTEXITCODE -ne 0) {
                Write-Host "    failed: $ext - continuing" -ForegroundColor Red
            }
        }
    }
}
if (-not $vsApply) {
} elseif (-not (Test-Path $vscodeSettings)) {
    # File missing: create it with the full default set, but only when VS Code
    # itself is installed (never fabricate %APPDATA%\Code for a product that
    # isn't there).
    if (Get-Command code -ErrorAction SilentlyContinue) {
        New-Item -ItemType Directory -Force -Path (Split-Path $vscodeSettings) | Out-Null
        $new = [ordered]@{}
        foreach ($k in $vsForced.Keys) { $new[$k] = $vsForced[$k] }
        foreach ($k in $vsDefaults.Keys) { $new[$k] = $vsDefaults[$k] }
        foreach ($k in $vsMerges.Keys) { $new[$k] = [PSCustomObject]$vsMerges[$k] }
        (ConvertTo-SortedJson ([PSCustomObject]$new)) + "`n" | Set-Content -Path $vscodeSettings -Encoding utf8
        Write-Host "  Created VS Code user settings with global defaults" -ForegroundColor Green
    }
} else {
    try {
        $vsJson = ConvertFrom-JsonC (Get-Content $vscodeSettings -Raw)
        $vsChanged = 0
        foreach ($k in $vsForced.Keys) {
            # StrictMode-safe keyed access: dotted names must go through
            # PSObject.Properties (dotting navigates - confirmed live).
            $p = $vsJson.PSObject.Properties[$k]
            if ($null -eq $p -or $p.Value -ne $vsForced[$k]) {
                $vsJson | Add-Member -MemberType NoteProperty -Name $k -Value $vsForced[$k] -Force
                $vsChanged++
            }
        }
        foreach ($k in $vsDefaults.Keys) {
            if ($null -eq $vsJson.PSObject.Properties[$k]) {
                $vsJson | Add-Member -MemberType NoteProperty -Name $k -Value $vsDefaults[$k]
                $vsChanged++
            }
        }
        foreach ($k in $vsMerges.Keys) {
            $objProp = $vsJson.PSObject.Properties[$k]
            if ($null -eq $objProp -or $null -eq $objProp.Value) {
                $vsJson | Add-Member -MemberType NoteProperty -Name $k -Value ([pscustomobject]@{}) -Force
                $objProp = $vsJson.PSObject.Properties[$k]
            }
            foreach ($s in $vsMerges[$k].Keys) {
                if ($null -eq $objProp.Value.PSObject.Properties[$s]) {
                    $objProp.Value | Add-Member -MemberType NoteProperty -Name $s -Value $vsMerges[$k][$s]
                    $vsChanged++
                }
            }
        }
        foreach ($k in $vsUnset) {
            if ($null -ne $vsJson.PSObject.Properties[$k]) {
                $vsJson.PSObject.Properties.Remove($k)
                $vsChanged++
            }
        }
        if ($vsChanged -gt 0) {
            Copy-Item $vscodeSettings "$vscodeSettings.bak" -Force -ErrorAction SilentlyContinue
            (ConvertTo-SortedJson $vsJson) + "`n" | Set-Content -Path $vscodeSettings -Encoding utf8
            Write-Host "  VS Code settings: $vsChanged change(s) (backup: $vscodeSettings.bak)" -ForegroundColor Green
        } else {
            Write-Host "  VS Code settings already at defaults" -ForegroundColor Green
        }
    } catch {
        Write-Host "  Could not parse VS Code settings.json even as JSONC - leaving it untouched ($_)" -ForegroundColor Yellow
    }
}



{{- if $agent_toolkit }}

{{- /* what the package installer has put on this machine so far (header: two passes) */ -}}
{{- $ps7guid := "{574e775e-4f2a-5b96-ac1e-a2962a402336}" -}}
{{- $pwsh7 := stat (joinPath (env "ProgramW6432" | default (env "ProgramFiles") | default `C:\Program Files`) "PowerShell" "7" "pwsh.exe") -}}
{{- $meslo := glob (joinPath (env "WINDIR" | default `C:\Windows`) "Fonts" "MesloLGSNerdFontMono-*.ttf") -}}
{{- if and (not $meslo) (env "LOCALAPPDATA") }}{{ $meslo = glob (joinPath (env "LOCALAPPDATA") "Microsoft" "Windows" "Fonts" "MesloLGSNerdFontMono-*.ttf") }}{{ end -}}
{{- if not $meslo }}
{{-   $_ := unset $want.defaults "font" }}
{{-   range $sp := $want.styled }}{{ $_ := unset $sp "font" }}{{ end }}
{{- end -}}

{{- /* SSH profiles, one per [[data.ssh_hosts]] with name + hostname */ -}}
{{- $ssh := list -}}
{{- if hasKey . "ssh_hosts" }}{{ range .ssh_hosts }}
{{-   if and (hasKey . "name") (hasKey . "hostname") }}
{{-     $h := sha256sum (printf "wt-ssh:%s" .name) }}
{{-     $p := dict "guid" (printf "{%s-%s-%s-%s-%s}" (substr 0 8 $h) (substr 8 12 $h) (substr 12 16 $h) (substr 16 20 $h) (substr 20 32 $h)) "name" (printf "SSH: %s" .name) "commandline" (printf "ssh.exe %s" .name) "startingDirectory" "%USERPROFILE%" "hidden" false "tabColor" "#CBA6F7" }}
{{-     if hasKey . "tmux" }}{{ if .tmux }}
{{-       $session := "main" }}{{ if kindIs "string" .tmux }}{{ $session = .tmux }}{{ end }}
{{-       $_ := set $p "commandline" (printf "ssh.exe -t %s \"tmux new-session -A -s %s\"" .name $session) }}
{{-     end }}{{ end }}
{{-     $os := "" }}{{ if hasKey . "os" }}{{ $os = .os }}{{ end }}
{{-     if eq $os "mac" }}{{ $_ := set $p "tabColor" "#A6E3A1" }}{{ $_ := set $p "icon" "🍎" }}
{{-     else if eq $os "linux" }}{{ $_ := set $p "tabColor" "#F38BA8" }}{{ $_ := set $p "icon" "🐧" }}{{ end }}
{{-     $ssh = append $ssh $p }}
{{-   end }}
{{- end }}{{ end -}}

{{- /* psmux profile: always created, Windows-only via the AppData/** ignore.
       Stable GUID from a fixed seed, same scheme as the SSH profiles. The
       %USERPROFILE% start is the root-cause fix for the System32 launch in the
       header comment. */ -}}
{{- $ph := sha256sum "wt-psmux" }}
{{- $psmux := dict "guid" (printf "{%s-%s-%s-%s-%s}" (substr 0 8 $ph) (substr 8 12 $ph) (substr 12 16 $ph) (substr 16 20 $ph) (substr 20 32 $ph)) "name" "psmux" "commandline" "psmux.exe" "startingDirectory" "%USERPROFILE%" "hidden" false "tabColor" "#94E2D5" }}

{{- /* globals */ -}}
{{- range $k, $v := $want.globals }}{{ $_ := set $cur $k $v }}{{ end -}}

{{- /* profiles: defaults, styled-if-present, owned psmux + SSH */ -}}
{{- if not (kindIs "map" (get $cur "profiles")) }}{{ $_ := set $cur "profiles" dict }}{{ end -}}
{{- $profiles := get $cur "profiles" -}}
{{- if not (kindIs "map" (get $profiles "defaults")) }}{{ $_ := set $profiles "defaults" dict }}{{ end -}}
{{- $defaults := get $profiles "defaults" -}}
{{- range $k, $v := $want.defaults }}{{ $_ := set $defaults $k $v }}{{ end -}}
{{- $list := list -}}
{{- if kindIs "slice" (get $profiles "list") }}{{ $list = get $profiles "list" }}{{ end -}}
{{- if $pwsh7 }}
{{-   $hasPs7 := false }}{{ range $ep := $list }}{{ if eq (lower (toString (get $ep "guid"))) $ps7guid }}{{ $hasPs7 = true }}{{ end }}{{ end }}
{{-   if not $hasPs7 }}{{ $list = append $list (dict "guid" $ps7guid "name" "PowerShell" "source" "Windows.Terminal.PowershellCore" "hidden" false) }}{{ end }}
{{- end -}}
{{- $kept := list -}}
{{- range $ep := $list }}
{{-   $name := toString (get $ep "name") }}
{{-   $cmd := toString (get $ep "commandline") }}
{{-   $stale := or (and (hasPrefix "SSH: " $name) (hasPrefix "ssh.exe " $cmd)) (and (eq $name "psmux") (eq $cmd "psmux.exe")) }}
{{-   if not $stale }}
{{-     range $sp := $want.styled }}
{{-       $byGuid := and (hasKey $sp "guid") (eq (lower (toString (get $ep "guid"))) (lower (toString (get $sp "guid")))) }}
{{-       $bySource := and (hasKey $sp "source") (eq (toString (get $ep "source")) (toString (get $sp "source"))) }}
{{-       if or $byGuid $bySource }}
{{-         range $k, $v := $sp }}{{ $_ := set $ep $k $v }}{{ end }}
{{-       end }}
{{-     end }}
{{-     $kept = append $kept $ep }}
{{-   end }}
{{- end -}}
{{- /* Order and groups (2026-10-13: the dropdown differed per machine because Terminal appends
       its generated profiles in first-seen order). Same order everywhere:
         Windows  PowerShell (7), psmux
         WSL      every distro, by name (several Ubuntu-26.04 instances with custom names sort too);
                  a legacy Windows.Terminal.Wsl profile that shares its name with a Microsoft.WSL
                  one is the store generator's orphaned twin - it stays in the list but out of the
                  menu (Terminal drew it with no chord on one machine)
         SSH      [[data.ssh_hosts]] in config order
         Windows  Windows PowerShell, Command Prompt (after the hosts, by request)
       Developer * (Visual Studio) and Azure Cloud Shell are hidden, not removed: Terminal
       regenerates them, and a hidden entry with their guid is what keeps them out. Anything else
       Terminal or the user adds follows, untouched. newTabMenu draws the four segments with
       separators; remainingProfiles keeps new ones visible.
       Ctrl+Shift+1..9 are Terminal's own position chords, deliberately: the label beside the
       profile at index i is the chord of the default action Terminal.OpenNewTabProfile<i>, and
       that lookup keeps the default chord even when a user binding takes the chord away
       (ActionMap::_PopulateCumulativeKeyMaps, 2026-10-13), so any custom mapping shows wrong
       labels. With the order fixed, position = the same profile on every machine. The entries the
       earlier version wrote (User.tab<n> actions and null unbinds of ctrl+shift+<n>) are removed
       below; the merge would keep them otherwise. */ -}}
{{- $ps7 := list }}{{ $ps5 := list }}{{ $cmd := list }}{{ $wslByName := dict }}{{ $wslLegacy := list }}{{ $rest := list -}}
{{- range $ep := $kept }}
{{-   $src := toString (get $ep "source") }}{{ $guid := lower (toString (get $ep "guid")) }}
{{-   if eq $src "Windows.Terminal.PowershellCore" }}{{ $ps7 = append $ps7 $ep }}
{{-   else if eq $guid "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}" }}{{ $ps5 = append $ps5 $ep }}
{{-   else if eq $guid "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}" }}{{ $cmd = append $cmd $ep }}
{{-   else if or (eq $src "Microsoft.WSL") (eq $src "Windows.Terminal.Wsl") }}
{{-     $name := toString (get $ep "name") }}
{{-     if hasKey $wslByName $name }}
{{- /* same name twice: Microsoft.WSL wins, the other is the legacy twin */ -}}
{{-       if eq $src "Microsoft.WSL" }}{{ $wslLegacy = append $wslLegacy (get $wslByName $name) }}{{ $_ := set $wslByName $name $ep }}{{ else }}{{ $wslLegacy = append $wslLegacy $ep }}{{ end }}
{{-     else }}{{ $_ := set $wslByName $name $ep }}{{ end }}
{{-   else }}
{{-     if or (eq $src "Windows.Terminal.VisualStudio") (eq $src "Windows.Terminal.Azure") }}{{ $_ := set $ep "hidden" true }}{{ end }}
{{-     $rest = append $rest $ep }}
{{-   end }}
{{- end -}}
{{- $wsl := list }}{{ range $k := keys $wslByName | sortAlpha }}{{ $wsl = append $wsl (get $wslByName $k) }}{{ end -}}
{{- $win := concat $ps7 (list $psmux) -}}
{{- $tail := concat $ps5 $cmd -}}
{{- $_ := set $profiles "list" (concat $win $wsl $ssh $tail $wslLegacy $rest) -}}

{{- /* newTabMenu: the four segments with a separator between non-empty neighbours */ -}}
{{- $menu := list }}
{{- range $ep := $win }}{{ $menu = append $menu (dict "type" "profile" "profile" (get $ep "guid")) }}{{ end }}
{{- if $wsl }}{{ $menu = append $menu (dict "type" "separator") }}{{ range $ep := $wsl }}{{ $menu = append $menu (dict "type" "profile" "profile" (get $ep "guid")) }}{{ end }}{{ end }}
{{- if $ssh }}{{ $menu = append $menu (dict "type" "separator") }}{{ range $ep := $ssh }}{{ $menu = append $menu (dict "type" "profile" "profile" (get $ep "guid")) }}{{ end }}{{ end }}
{{- if $tail }}{{ $menu = append $menu (dict "type" "separator") }}{{ range $ep := $tail }}{{ $menu = append $menu (dict "type" "profile" "profile" (get $ep "guid")) }}{{ end }}{{ end }}
{{- $menu = append $menu (dict "type" "remainingProfiles") }}
{{- $_ := set $cur "newTabMenu" $menu -}}

{{- /* retire the earlier version's chord entries: User.tab<n> actions and their keybindings, and
       the null unbinds of ctrl+shift+<n> it wrote for empty slots */ -}}
{{- if kindIs "slice" (get $cur "actions") }}
{{-   $acts := list }}{{ range $e := get $cur "actions" }}{{ if not (regexMatch "^User\\.tab[1-9]$" (toString (get $e "id"))) }}{{ $acts = append $acts $e }}{{ end }}{{ end }}
{{-   $_ := set $cur "actions" $acts }}
{{- end }}
{{- if kindIs "slice" (get $cur "keybindings") }}
{{-   $kbs := list }}{{ range $e := get $cur "keybindings" }}
{{-     $eid := toString (get $e "id") }}{{ $ekeys := lower (toString (get $e "keys")) }}
{{-     $ours := or (regexMatch "^User\\.tab[1-9]$" $eid) (and (not (get $e "id")) (regexMatch "^ctrl\\+shift\\+[1-9]$" $ekeys)) }}
{{-     if not $ours }}{{ $kbs = append $kbs $e }}{{ end }}
{{-   end }}
{{-   $_ := set $cur "keybindings" $kbs }}
{{- end }}

{{- /* schemes + themes by name */ -}}
{{- range $section := list "schemes" "themes" }}
{{-   $mine := get $want $section }}
{{-   $out := list }}
{{-   if kindIs "slice" (get $cur $section) }}{{ range $e := get $cur $section }}
{{-     $clash := false }}{{ range $m := $mine }}{{ if eq (toString (get $e "name")) $m.name }}{{ $clash = true }}{{ end }}{{ end }}
{{-     if not $clash }}{{ $out = append $out $e }}{{ end }}
{{-   end }}{{ end }}
{{-   $_ := set $cur $section (concat $out $mine) }}
{{- end -}}

{{- /* actions by id; keybindings by id OR keys (one chord, one owner) */ -}}
{{- $out := list -}}
{{- if kindIs "slice" (get $cur "actions") }}{{ range $e := get $cur "actions" }}
{{-   $clash := false }}{{ range $m := $want.actions }}{{ if eq (toString (get $e "id")) $m.id }}{{ $clash = true }}{{ end }}{{ end }}
{{-   if not $clash }}{{ $out = append $out $e }}{{ end }}
{{- end }}{{ end -}}
{{- $_ := set $cur "actions" (concat $out $want.actions) -}}
{{- $out = list -}}
{{- if kindIs "slice" (get $cur "keybindings") }}{{ range $e := get $cur "keybindings" }}
{{-   $clash := false }}{{ range $m := $want.keybindings }}
{{- /* id match only for real ids: an unbind entry has "id": null */ -}}
{{-     $mid := "" }}{{ if $m.id }}{{ $mid = $m.id }}{{ end }}
{{-     if or (and $mid (eq (toString (get $e "id")) $mid)) (eq (lower (toString (get $e "keys"))) $m.keys) }}{{ $clash = true }}{{ end }}
{{-   end }}
{{-   if not $clash }}{{ $out = append $out $e }}{{ end }}
{{- end }}{{ end -}}
{{- $_ := set $cur "keybindings" (concat $out $want.keybindings) -}}

{{- toPrettyJson $cur }}

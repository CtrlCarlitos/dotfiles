    { "source": "Windows.Terminal.Wsl", "tabColor": "#FAB387",
      "colorScheme": "Catppuccin Mocha", "cursorShape": "bar",
      "font": { "face": "MesloLGS Nerd Font Mono", "size": 12 } },
    { "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}", "tabColor": "#89B4FA" },
    { "guid": "{e229d38a-dcc3-495b-af2c-6c254b71fef9}", "tabColor": "#F9E2AF",
      "colorScheme": "Catppuccin Mocha", "cursorShape": "bar",
      "font": { "face": "MesloLGS Nerd Font Mono", "size": 12 } },
    { "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}", "tabColor": "#74C7EC" },
    { "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}", "tabColor": "#7F849C" }
  ],
  "schemes": [
    {
      "name": "Catppuccin Mocha",
      "background": "#1E1E2E", "foreground": "#CDD6F4",
      "cursorColor": "#F5E0DC", "selectionBackground": "#585B70",
      "black": "#45475A", "red": "#F38BA8", "green": "#A6E3A1", "yellow": "#F9E2AF",
      "blue": "#89B4FA", "purple": "#F5C2E7", "cyan": "#94E2D5", "white": "#BAC2DE",
      "brightBlack": "#585B70", "brightRed": "#F38BA8", "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF", "brightBlue": "#89B4FA", "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5", "brightWhite": "#A6ADC8"
    }
  ],
  "themes": [
    {
      "name": "Catppuccin Mocha",
      "window": { "applicationTheme": "dark", "useMica": false },
      "tab": { "background": "#1E1E2EFF", "unfocusedBackground": "#181825FF", "showCloseButton": "hover" },
      "tabRow": { "background": "#181825FF", "unfocusedBackground": "#11111BFF" }
    }
  ],
  "actions": [
    { "command": { "action": "quakeMode" }, "id": "User.quakeMode" },
    { "command": "toggleFullscreen", "id": "User.toggleFullscreen" },
    { "command": { "action": "splitPane", "split": "right", "splitMode": "duplicate" }, "id": "User.splitRight" },
    { "command": { "action": "splitPane", "split": "down", "splitMode": "duplicate" }, "id": "User.splitDown" },
    { "command": "togglePaneZoom", "id": "User.togglePaneZoom" },
    { "command": "closePane", "id": "User.closePane" },
    { "command": { "action": "sendInput", "input": "\n" }, "id": "User.newline" },
    { "command": { "action": "moveFocus", "direction": "left" }, "id": "User.focusLeft" },
    { "command": { "action": "moveFocus", "direction": "right" }, "id": "User.focusRight" },
    { "command": { "action": "moveFocus", "direction": "up" }, "id": "User.focusUp" },
    { "command": { "action": "moveFocus", "direction": "down" }, "id": "User.focusDown" },
    { "command": { "action": "commandPalette" }, "id": "User.commandPalette" },
    { "command": "openTabRenamer", "id": "User.renameTab" },
    { "name": "Agent: Claude Code (here)", "id": "User.agentClaude",
      "command": { "action": "sendInput", "input": "claude\r" } },
    { "name": "Agent: Codex (here)", "id": "User.agentCodex",
      "command": { "action": "sendInput", "input": "codex\r" } },
    { "name": "Agent: OpenCode (here)", "id": "User.agentOpencode",
      "command": { "action": "sendInput", "input": "opencode\r" } },

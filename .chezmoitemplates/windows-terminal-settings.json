    { "id": null, "keys": "alt+enter" },
    { "id": "User.splitRight", "keys": "alt+shift+plus" },
    { "id": "User.splitDown", "keys": "alt+shift+minus" },
    { "id": "User.togglePaneZoom", "keys": "alt+shift+z" },
    { "id": "User.closePane", "keys": "ctrl+shift+w" },
    { "id": "User.newline", "keys": "ctrl+enter" },
    { "id": "User.focusLeft", "keys": "alt+left" },
    { "id": "User.focusRight", "keys": "alt+right" },
    { "id": "User.focusUp", "keys": "alt+up" },
    { "id": "User.focusDown", "keys": "alt+down" },
    { "id": "User.commandPalette", "keys": "ctrl+shift+p" },
    { "id": "User.renameTab", "keys": "ctrl+shift+r" },
    { "id": "User.agentClaude", "keys": "ctrl+alt+c" },
    { "id": "User.agentCodex", "keys": "ctrl+alt+x" },
    { "id": "User.agentOpencode", "keys": "ctrl+alt+o" },
    { "id": "User.agentAgy", "keys": "ctrl+alt+a" },
    { "id": "User.agentClaudeSplit", "keys": "ctrl+alt+shift+c" },
    { "id": "User.agentCodexSplit", "keys": "ctrl+alt+shift+x" },

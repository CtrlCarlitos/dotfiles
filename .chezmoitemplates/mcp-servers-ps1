{{- /*
  $mcpCatalog for the .ps1 installer, from .chezmoidata/agents.yaml `agents.mcp`:

    {{ includeTemplate "mcp-servers-ps1" .agents.mcp }}

  renders

    $mcpCatalog = @{
        'serena' = @{ command = 'serena'; args = @('start-mcp-server', '--context', 'claude-code'); args_agy = @('start-mcp-server', '--context', 'antigravity') }

  args_agy (optional in the catalog) is the Antigravity override; consumers for other agents read args.
    }

  Keys come out in sorted order (Go template map iteration); nothing depends
  on their order. Consumers build their own shape from command + args.
  Keys are quoted ('{{ $name }}') rather than bare - a bare PowerShell
  hashtable key must be a valid identifier, and a catalog name containing a
  hyphen (e.g. agent-device) is not one; PowerShell parses the hyphen as an
  operator and the whole script fails to parse. Confirmed live 2026-10-10
  while wiring agent-device's MCP entry.

  REMOTE entries (type: remote + url, e.g. Expo - no command/args to probe)
  are deliberately left OUT of $mcpCatalog: the Windows/OpenCode-ps1 and
  agy-ps1 remote-registration branch is out of scope for this task (SDD plan
  2026-10-10-mobile-dev-wsl-linux-macos, Task 4 covers the .sh twin's
  OpenCode/agy only) - including one here would make $srv.command error on
  a key that does not exist. Ends with -}} so the fragment emits no trailing
  newline (see pkg-names).
*/ -}}
$mcpCatalog = @{
{{- range $name, $srv := . }}
{{- if not (hasKey $srv "type") }}
    '{{ $name }}' = @{ command = '{{ $srv.command | replace "'" "''" }}'; args = @({{ includeTemplate "ps-list" $srv.args }}){{ if hasKey $srv "args_agy" }}; args_agy = @({{ includeTemplate "ps-list" $srv.args_agy }}){{ end }} }
{{- end }}
{{- end }}
}
{{- "" -}}

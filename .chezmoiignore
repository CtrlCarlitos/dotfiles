# Chezmoi Ignore File
# Files listed here will not be applied to the target directory

# Documentation (never apply). CHANGELOG.md is generated release history and
# SECURITY.md is GitHub's policy file: repo metadata, not dotfiles. (SECURITY.md
# was being copied into ~ until tests/home_scope_contract.sh gained the general
# "no plain-named file at the repo root" rule.)
README.md
LICENSE
CHANGELOG.md
SECURITY.md
docs/**

# Installers (bootstrap only)
install.sh
install.ps1

# Pre-commit config (only needed in source repo)
.pre-commit-config.yaml

# Claude Code project settings (source-repo tooling, not a dotfile to deploy).
# `.claude/*`, not `.claude/**`: ** also matches the .claude directory itself, and a
# file under an ignored directory can never be un-ignored below.
.claude/*
# ...except the one file the dotfiles DO manage in ~/.claude: the keybindings merge
# (dot_claude/modify_keybindings.json), and only where Claude Code has a config dir
# (same guard as Codex/OpenCode below: a modify_ template run on an absent target
# would create the file on a machine that never installed the tool).
{{- if stat (joinPath .chezmoi.homeDir ".claude") }}
!.claude/keybindings.json
{{- end }}

# Git worktrees (agent isolation; source-repo only, matches .gitignore)
.worktrees/**

# Graft host wiring (generated per machine by `graft init` - see .gitignore;
# nothing reads these at $HOME, they only ever mattered as repo-local files)
.mcp.json
opencode.json

# Devcontainer helper scripts (not for home directory)
devcontainer/**

# Repo tooling, never deployed to $HOME: the CI test suite, and the scripts the
# `dot` family runs. Every caller uses them at their SOURCE path - the dot
# dispatcher in both shells ($HOME/.local/share/chezmoi/scripts), the installers,
# and the docs (`$(chezmoi source-path)/scripts/...`). Nothing reads $HOME/scripts
# or $HOME/tests, so copies there were dead weight that also went stale (a home
# copy predating `dot upgrade` had no dotupgrade.ps1). Confirmed by grepping the
# whole repo for a $HOME-copy reference: there are none.
tests/**
scripts/**

# Skills-repo clones: a skills installer once cloned its upstream INTO this
# source tree under a mangled, invisible-character-prefixed name
# ("<ZWSP>mp-skills-repo"), and the irregular file types inside crashed
# `chezmoi apply` outright. The installed skills live in ~/.agents/skills -
# any clone in here is transient tooling state, never a dotfile.
*mp-skills-repo/**

# More repo-only files that were landing in $HOME. Same test as above: nothing
# reads the home copy.
#   AGENTS.md    - this repo's agent instructions (graft status + where
#                  context actually lives), like the already
#                  ignored .mcp.json/opencode.json wiring
#   graft/       - the repo's own context graph, regenerated by `graft build`
#   guardrail.toml - guardrail reads its overlay from the SOURCE repo; `guardrail
#                  doctor` run in $HOME reports "overlay: none", so the copy is dead
AGENTS.md
graft/**
guardrail.toml

# Local scratch directory (screenshots, debug logs, config snapshots - see
# .gitignore's temp/ entry). Confirmed live: `chezmoi doctor` flagged
# temp/chezmoi.toml as a suspicious entry and nothing stopped apply from
# copying this junk into $HOME.
temp/**

# Stray build/testing artifacts that don't belong in the source tree - this
# repo's real managed executables live under dot_local/bin/ (with the proper
# dot_ prefix), never a bare top-level bin/. Confirmed live: a stray chezmoi
# binary that landed here from earlier ad-hoc testing was silently being
# copied to ~/bin/ on every apply since nothing excluded it.
bin/**

# Platform-specific exclusions
{{- if ne .chezmoi.os "windows" }}
# Exclude Windows-specific files on non-Windows
Documents/**
# Windows Terminal settings + VS Code keybindings (modify_ merges under AppData)
AppData/**
.local/bin/*.ps1
# python3 shims: Windows has python.exe but no python3; every other OS has a
# real python3 that a shim would shadow.
.local/bin/python3
.local/bin/python3.cmd
# psmux config: the Windows tmux twin (dot_config/psmux/psmux.conf). No psmux
# outside Windows (ConPTY multiplexer).
.config/psmux/**
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Exclude Unix-specific files on Windows
.tmux.conf
.zshrc
.aliases.zsh
.local/bin/devprofile
.local/bin/ssh-agent-relay
.local/bin/git-agent
.local/bin/ssh-agent-key
.local/lib/ssh_agent_key.py
# The zsh/tmux externals too: no zsh or tmux runs on Windows (WSL has its own
# home), so ~/.oh-my-zsh was 15 MB and ~/.tmux 153 KB of unusable plugin trees.
.oh-my-zsh/**
.tmux/**
{{- end }}

# VS Code keybindings (agent keys; shared .chezmoitemplates/vscode-keybindings.json):
# one per-OS location, and only where VS Code's User dir already exists, so a
# headless server or a machine without VS Code never gets a stray Code config.
# WSL is excluded: VS Code there is a remote server; keys live on the Windows side.
{{- if ne .chezmoi.os "darwin" }}
Library/**
{{- else if not (stat (joinPath .chezmoi.homeDir "Library/Application Support/Code/User")) }}
Library/Application Support/Code/**
{{- end }}
{{- $codeLinux := false }}
{{- if eq .chezmoi.os "linux" }}
{{-   if not (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
{{-     if stat (joinPath .chezmoi.homeDir ".config/Code/User") }}{{ $codeLinux = true }}{{ end }}
{{-   end }}
{{- end }}
{{- if not $codeLinux }}
.config/Code/**
{{- end }}
{{- if and (eq .chezmoi.os "windows") (not (stat (joinPath .chezmoi.homeDir "AppData/Roaming/Code/User"))) }}
AppData/Roaming/Code/**
{{- end }}

# Agent config dirs (Codex / OpenCode): their modify_ templates MERGE with an
# existing install, and chezmoi runs a modify_ template with empty stdin when
# the target is absent - which CREATES the file. On a machine that never
# installed the tool, applying still manufactured a config for it. Same shape
# as the VS Code User-dir guards above: only manage these where the tool's
# config dir already exists, so a headless server never gets a stray one.
{{- if not (stat (joinPath .chezmoi.homeDir ".codex")) }}
.codex/**
{{- end }}
{{- if not (stat (joinPath .chezmoi.homeDir ".config/opencode")) }}
.config/opencode/**
{{- end }}

# Ghostty config: macOS + Linux desktop only. Windows has Windows Terminal, and
# WSL shells run inside it - a Ghostty config there would never be read.
{{- $ghostty := true }}
{{- if eq .chezmoi.os "windows" }}{{ $ghostty = false }}{{ end }}
{{- if eq .chezmoi.os "linux" }}
{{-   if contains "microsoft" (lower .chezmoi.kernel.osrelease) }}{{ $ghostty = false }}{{ end }}
{{- end }}
{{- if not $ghostty }}
.config/ghostty/**
{{- end }}

# Devcontainer detection (using environment variables)
{{- $isDevcontainer := or (env "DEVCONTAINER") (env "REMOTE_CONTAINERS") (stat "/.dockerenv") }}
{{- if $isDevcontainer }}
# Nothing is excluded in devcontainers, deliberately.
#
# This block used to list `private_dot_ssh/**` and `dot_gitconfig-*` - SOURCE
# paths, where .chezmoiignore matches TARGET paths, so they excluded nothing
# (confirmed live: `diff <(chezmoi ignored) <(DEVCONTAINER=true chezmoi ignored)`
# was empty). Correcting them to `.ssh/**` revealed why the rule was wrong in
# the first place: chezmoi manages only ~/.ssh/config there - never key
# material - and that file carries the `github-<user>` host aliases that
# .gitconfig's `insteadOf` rewrites depend on. Excluding it broke git in the
# container while protecting nothing. Keys reach a container through a
# forwarded ssh-agent socket instead; see docs/devcontainer.md.
{{- end }}


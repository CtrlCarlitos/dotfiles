{
  "remote_access": {
    "enabled": true,
    "ssh": {"enabled": true, "login_keys": []},
    "rdp": {"enabled": true},
    "services": {
      "opencode_linux": {
        "enabled": true,
        "environment": "linux",
        "port": 4098,
        "tailscale": true,
        "cloudflare": true
      }
    },
    "tunnel": {
      "id": "00000000-0000-0000-0000-000000000000",
      "ingress": {
        "ssh": {
          "hostname": "ssh.example.com",
          "service": "ssh://127.0.0.1:22"
        },
        "opencode": {
          "hostname": "opencode.example.com",
          "service": "http://127.0.0.1:4098"
        }
      }
    }
  }
}

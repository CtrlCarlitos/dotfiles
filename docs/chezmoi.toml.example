# Example Chezmoi Configuration
# ==============================================================================
# This single file contains the machine-local data consumed by the dotfiles:
# package preferences, VS Code drift, Git identities, and SSH host aliases.
# Copy it to ~/.config/chezmoi/chezmoi.toml and customize the examples below.
#
# IMPORTANT: [data.*] is template data. `chezmoi apply` consumes it; `chezmoi
# init` can regenerate it from .chezmoi.toml.tmpl, so use the documented keys.
#
# SETUP:
#   cp docs/chezmoi.toml.example ~/.config/chezmoi/chezmoi.toml
#   # Edit with your data, then:
#   chezmoi apply
# ==============================================================================


[data]

# ==============================================================================
# PACKAGE INSTALLATION PREFERENCES
# ==============================================================================
# Toggle what gets installed. Runs via `chezmoi apply`.
#
# The 16 package groups share one vocabulary across the menu
# (scripts/select-packages.*), these keys, and CI seeds. Full table, menu
# flow, presets, and the rename map from the old install_* toggles:
# docs/package-groups.md. `true` requests desired state on the next apply.
# Groups marked "Host only" are skipped in WSL and containers; every other
# group applies there too.
#
# NOTE: the menu OWNS this section — re-running scripts/select-packages.sh
# (or .ps1) rewrites it wholesale. Hand-edits here survive `chezmoi apply`
# fine; they just won't survive the next menu run.

  [data.packages]
    # core — Terminal fundamentals: git, zsh, tmux, node 24, python,
    #        neovim, ripgrep, gh, jq, fzf, 7zip...
    core = true

    # modern_cli — Modern CLI replacements: bat, eza, fd, starship, zoxide,
    #              direnv, lazygit, delta, gum, tealdeer, dust/duf/procs,
    #              shellcheck, shfmt, markdownlint-cli2 (npm), lychee,
    #              vale. See docs/tool-parity.md.
    modern_cli = true

    # fonts — Nerd Fonts: MesloLGS NF (for terminal/Starship)
    fonts = true

    # agent_toolkit — Cross-vendor agent layer: Serena, Graft, act,
    #                 Playwright Chromium.
    agent_toolkit = true

    # opencode_cli — OpenCode CLI + Superpowers + skills + guardrail
    #                wiring.
    opencode_cli = true

    # opencode_desktop — OpenCode Desktop app. Host only; installs on all
    #                    three OSs (mac brew cask / Linux GitHub .deb /
    #                    Win choco).
    opencode_desktop = false

    # claude_cli — Claude Code CLI + superpowers plugin + curated skills +
    #              guardrail claude plane
    claude_cli = true

    # claude_desktop — Claude Desktop app. Host only; Linux has no official
    #                  build (installer info-skips, not a failure).
    claude_desktop = false

    # chatgpt_cli — Codex CLI (@openai/codex npm) + the curated-skills pass
    #               for Codex.
    chatgpt_cli = false

    # chatgpt_desktop — ChatGPT Desktop app. Host only; Linux has no
    #                   official build (installer info-skips).
    chatgpt_desktop = false

    # antigravity_cli — Antigravity CLI (agy) + superpowers + curated
    #                   skills + guardrail antigravity plane
    antigravity_cli = false

    # antigravity_desktop — Antigravity 2.0 app. Host only; installs on all
    #                       three OSs (mac/Linux use pinned hub-channel URLs).
    antigravity_desktop = false

    # remote_access — Private mesh access and approved app tunneling
    #                 (Tailscale, cloudflared). No login or tunnel setup.
    remote_access = false

    # remote_access_server — Explicit SSH-server prerequisite opt-in.
    #                        Never preset; manual SSH setup required.
    remote_access_server = false

    # guardrail — Agent guardrails: runs the pinned agent-guardrails
    #             installer, which installs the binary and registers its
    #             hooks with each agent host after your passkey approval.
    #             Deliberately a separate opt-in from the agent groups.
    #             See docs/guardrail-install.md.
    guardrail = true

    # dev_desktop — Human desktop apps: Chrome, VS Code, Docker Desktop,
    #               ScreenRec, Termius, Handy... Host only: auto-skipped on
    #               WSL/containers even if true.
    dev_desktop = false

    # vscode_settings — Settings defaults + global extension management.
    #                   Default true; set false to opt out wholesale.
    # vscode_settings = false

    # Defaults above = the "standard" preset (docs/package-groups.md).

# ==============================================================================
# VS CODE SETTINGS
# ==============================================================================
# This machine's VS Code settings, by tier. `chezmoi init` (which `dot up` runs)
# writes them from .chezmoitemplates/vscode-settings.toml when this table is
# absent, and otherwise writes back what is here - so edit them here. A tier you
# delete is treated as empty. Tier semantics and the reason for each key:
# docs/vscode.md. Shortened:
# [data.vscode.settings]
#   junk  = ["**/__pycache__/**", "**/node_modules/**"]   # files.exclude + search.exclude
#   unset = ["remote.SSH.configFile"]                     # removed when present
#   [data.vscode.settings.forced]                         # re-asserted every run
#     "editor.fontFamily" = "MesloLGS Nerd Font Mono"
#   [data.vscode.settings.defaults]                       # written when absent
#     "files.autoSave" = "afterDelay"
#   [data.vscode.settings.defaults_windows]               # the same, Windows only
#     "terminal.integrated.enableWin32InputMode" = true
#   [data.vscode.settings.terminal_colors]                # merged into colorCustomizations
#     "terminal.background" = "#1E1E2E"

# ==============================================================================
# VS CODE MACHINE-LOCAL OVERRIDES
# ==============================================================================
# Use this table for extensions that vary on this machine. It is not
# [data.vscode].extensions: a list set in the config replaces the repo's whole
# list. (The settings themselves are in [data.vscode.settings] - see above.)
# exclude_settings strips any tier (including forced font keys); extra_settings
# joins the upsert tier (change a value = exclude + add). Nested objects and
# arrays are valid TOML; `chezmoi init` normalizes objects into nested tables.
# [data.vscode_overrides]
#   extra_extensions   = ["hashicorp.terraform"]
#   exclude_extensions = ["ms-python.pylint"]
#   exclude_settings   = ["terminal.integrated.fontFamily"]
#   [data.vscode_overrides.extra_settings]
#     "editor.fontSize"     = 15
#     "files.autoSaveDelay" = 1000
#     "editor.rulers"       = [80, 120]
#     "[python]"            = { "editor.tabSize" = 4 }

# ==============================================================================
# GIT IDENTITIES
# ==============================================================================
# Each account generates:
#   - ~/.gitconfig-{provider}-{username}  (identity file)
#   - SSH host alias in ~/.ssh/config
#   - URL rewrites for organizations
#
# name, email, username, provider, and dirs define identity/routing. `key` and
# `signingKey` are filenames in ~/.ssh, never key material. `agent_key_comments`
# overrides the comments ssh-agent-relay allows by (default "<email>" and
# "<email>-sign", see docs/ssh-agents.md). Repeat this array table for every
# identity; only fields shown below survive `chezmoi init`.

[[data.accounts]]
  name     = "Your Name"
  email    = "your.email@example.com"
  username = "your-username"           # GitHub/GitLab username
  provider = "github"                  # "github" or "gitlab"
  key      = "id_ed25519"              # SSH key filename in ~/.ssh/
  # signingKey = "id_ed25519_sign"     # Optional: separate key for commit signing
  # If you use separate auth/sign keys, a passphrase on both is recommended.
  # agent_key_comments = ["your.email@example.com", "your.email@example.com-sign"]
  organizations = []                   # Orgs to rewrite URLs for
  dirs          = ["projects", ".local/share/chezmoi"]  # Directories using this identity (auto-created)


# MULTI-ACCOUNT EXAMPLE (uncomment and customize):
# -----------------------------------------------------------------------------
# [[data.accounts]]
#   name = "Work Name"
#   email = "work@company.com"
#   username = "work-user"
#   provider = "github"
#   key = "id_work"
#   organizations = ["company-org"]
#   dirs = ["projects/work"]
#
# [[data.accounts]]
#   name = "OSS Identity"
#   email = "oss@protonmail.com"
#   username = "oss-user"
#   provider = "github"
#   key = "id_oss"
#   organizations = []
#   dirs = ["projects/opensource"]

# SSH host aliases - rendered into the SSH client config on apply; VS Code
# Remote-SSH picks them up natively. One block per host; keys live in ~/.ssh.
# [[data.ssh_hosts]]
#   name     = "prod-jump"            # required  Host alias
#   hostname = "10.0.0.5"             # required  IP or DNS name
#   user     = "carlitos"             # optional  login user
#   port     = 22                     # optional  default 22
#   identity = "id_personal"          # optional  key file name in ~/.ssh
#   proxy    = "bastion"              # optional  ProxyJump alias
#   comment  = "Bastion for staging"  # optional  block header (memory hook)
#   os       = "linux"                # optional  mac|linux: Windows Terminal tab color/icon
#   tmux     = true                   # optional  Terminal tab re-attaches to tmux "main" (or a name)

# ==============================================================================
# CHEZMOI BEHAVIOUR ([add] / [diff])
# ==============================================================================
# Top-level chezmoi tables (not [data]): `chezmoi init` writes these from
# .chezmoi.toml.tmpl.
[add]
  secrets = "warning"        # warn instead of erroring on secret-shaped files

# The [diff] pager exists only when modern_cli is on, for the same reason
# git's pager is gated: with modern_cli = false delta is not installed and
# `chezmoi diff` would die on the missing binary.
# [diff]
#   pager = "delta"

# ==============================================================================
# QUICK SETUP
# ==============================================================================
# 1. Generate SSH key:
#    ssh-keygen -t ed25519 -f ~/.ssh/id_<keyname> -C "email@example.com"
#
# 2. Add public key to GitHub (Settings > SSH Keys):
#    cat ~/.ssh/id_<keyname>.pub
#
# 3. Edit this file with your real data
#
# 4. Apply:
#    chezmoi apply
#
# 5. Test:
#    cd ~/projects && git config user.email

# ==============================================================================
# REMOTE ACCESS (`dot remote`)
# ==============================================================================
# Machine-local intent for `dot remote` (scripts/remote-access.sh /
# remote-access.ps1). Real values stay in ~/.config/chezmoi/chezmoi.toml and
# are never committed; provider credentials (tunnel credentials, Access
# policies, private keys) never enter this file at all. Guide:
# docs/remote-access.md. Uncomment and customize:
#
# [data.remote_access]
#   enabled = true
#
#   # Local incoming SSH: authoritative public-key names, no generation.
#   [data.remote_access.ssh]
#     enabled = true
#     login_keys = ["id_phone", "id_laptop"]
#   # Windows Remote Desktop / desktop-gated native Linux xrdp.
#   [data.remote_access.rdp]
#     enabled = true
#
#   # macOS: Remote Login (setup verifies; enabling stays a manual step) and
#   # Screen Sharing (VNC :5900 recovery path, status-check only).
#   [data.remote_access.macos]
#     screen_sharing = true
#
#   # Optional Windows-side forwarding; the distro owns its daemon and keys.
#   [data.remote_access.wsl]
#     enabled = true
#     ssh_port = 2222
#
#   # Existing ~/.ssh/<name>.pub files are required. setup/fix/keys sync revoke
#   # undeclared authorizations; an explicit [] revokes all. Keep private keys
#   # on the connecting devices. See docs/remote-access.md for migration.
#
#   # Loopback web services exposed privately. environment = where the
#   # listener lives; ports must not collide across environments.
#   [data.remote_access.services.opencode_windows]
#     enabled = true
#     environment = "windows"
#     port = 4096
#     tailscale = true
#     cloudflare = true
#
#   [data.remote_access.services.opencode_wsl]
#     enabled = true
#     environment = "wsl"
#     port = 4097
#     tailscale = true
#     cloudflare = false
#
#   # cloudflared ingress, rendered by `dot remote tunnel render` into the
#   # machine-local config.yml (terminal http_status:404 appended
#   # automatically). The tunnel id is a UUID, not a secret.
#   [data.remote_access.tunnel]
#     id = "<machine-local tunnel id>"
#
#   [data.remote_access.tunnel.ingress.ssh]
#     hostname = "<machine-local hostname>"
#     service = "ssh://127.0.0.1:22"
#
#   [data.remote_access.tunnel.ingress.wsl]
#     hostname = "<machine-local hostname>"
#     service = "ssh://127.0.0.1:2222"
#
#   [data.remote_access.tunnel.ingress.rdp]
#     hostname = "<machine-local hostname>"
#     service = "rdp://127.0.0.1:3389"
#
#   [data.remote_access.tunnel.ingress.opencode]
#     hostname = "<machine-local hostname>"
#     service = "http://127.0.0.1:4096"

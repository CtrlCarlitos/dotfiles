# Example Chezmoi Configuration
# ==============================================================================
# This single file contains all chezmoi settings: environment, packages, and
# git identities. Copy to ~/.config/chezmoi/chezmoi.toml and customize.
#
# SETUP:
#   cp docs/chezmoi.toml.example ~/.config/chezmoi/chezmoi.toml
#   # Edit with your data, then:
#   chezmoi apply
# ==============================================================================


[data]

# ==============================================================================
# PACKAGE INSTALLATION PREFERENCES
# ==============================================================================
# Toggle what gets installed. Runs via `chezmoi apply`.
#
# The 14 package groups — one vocabulary shared by the menu
# (scripts/select-packages.*), these keys, and CI seeds. Full table, menu
# flow, presets, and the rename map from the old install_* toggles:
# docs/package-groups.md.
#
# NOTE: the menu OWNS this section — re-running scripts/select-packages.sh
# (or .ps1) rewrites it wholesale. Hand-edits here survive `chezmoi apply`
# fine; they just won't survive the next menu run.

  [data.packages]
    # core — Terminal fundamentals: git, zsh, tmux, node 24, python,
    #        neovim, ripgrep, gh, jq, fzf, 7zip...
    core = true

    # modern_cli — Modern CLI replacements: bat, eza, fd, starship, zoxide,
    #              direnv, lazygit, delta, gum, tealdeer, dust/duf/procs,
    #              shellcheck, shfmt. See docs/tool-parity.md.
    modern_cli = true

    # fonts — Nerd Fonts: MesloLGS NF (for terminal/Starship)
    fonts = true

    # agent_toolkit — Cross-vendor agent layer: Serena, Graft, act,
    #                 Playwright Chromium. Not host-gated (applies on
    #                 WSL too).
    agent_toolkit = true

    # opencode_cli — OpenCode CLI + Superpowers + skills + guardrail
    #                wiring. Not host-gated (applies on WSL too).
    opencode_cli = true

    # opencode_desktop — OpenCode Desktop app. Host only; installs on all
    #                    three OSs (mac brew cask / Linux GitHub .deb /
    #                    Win choco).
    opencode_desktop = false

    # claude_cli — Claude Code CLI + superpowers plugin + curated skills +
    #              guardrail claude plane
    claude_cli = true

    # claude_desktop — Claude Desktop app. Host only; Linux has no official
    #                  build (installer info-skips, not a failure).
    claude_desktop = false

    # chatgpt_cli — Codex CLI (@openai/codex npm). Zero wiring by design.
    chatgpt_cli = false

    # chatgpt_desktop — ChatGPT Desktop app. Host only; Linux has no
    #                   official build (installer info-skips).
    chatgpt_desktop = false

    # antigravity_cli — Antigravity CLI (agy) + superpowers + curated
    #                   skills + guardrail antigravity plane
    antigravity_cli = false

    # antigravity_desktop — Antigravity 2.0 app. Host only; installs on all
    #                       three OSs (mac/Linux use pinned hub-channel URLs).
    antigravity_desktop = false

    # dev_desktop — Human desktop apps: Chrome, VS Code, Docker Desktop,
    #               ScreenRec, Termius, Handy... Host only: auto-skipped on
    #               WSL/containers even if true.
    dev_desktop = false

    # guardrail — Agent guardrails: guardrail binary + per-CLI planes.
    #             Modifies ~/.claude/settings.json etc. - deliberately a
    #             separate opt-in from the agent groups.
    #             See docs/guardrail-install.md.
    guardrail = true
    # Defaults above = the "standard" preset (docs/package-groups.md).


# ==============================================================================
# GIT IDENTITIES
# ==============================================================================
# Each account generates:
#   - ~/.gitconfig-{provider}-{username}  (identity file)
#   - SSH host alias in ~/.ssh/config
#   - URL rewrites for organizations

[[data.accounts]]
  name = "Your Name"
  email = "your.email@example.com"
  username = "your-username"           # GitHub/GitLab username
  provider = "github"                  # "github" or "gitlab"
  key = "id_ed25519"                   # SSH key filename in ~/.ssh/
  # signingKey = "id_ed25519_sign"     # Optional: separate key for commit signing
  # If you use separate auth/sign keys, a passphrase on both is recommended.
  organizations = []                   # Orgs to rewrite URLs for
  dirs = ["projects", ".local/share/chezmoi"]  # Directories using this identity (auto-created)


# MULTI-ACCOUNT EXAMPLE (uncomment and customize):
# -----------------------------------------------------------------------------
# [[data.accounts]]
#   name = "Work Name"
#   email = "work@company.com"
#   username = "work-user"
#   provider = "github"
#   key = "id_work"
#   organizations = ["company-org"]
#   dirs = ["projects/work"]
#
# [[data.accounts]]
#   name = "OSS Identity"
#   email = "oss@protonmail.com"
#   username = "oss-user"
#   provider = "github"
#   key = "id_oss"
#   organizations = []
#   dirs = ["projects/opensource"]


# ==============================================================================
# QUICK SETUP
# ==============================================================================
# 1. Generate SSH key:
#    ssh-keygen -t ed25519 -f ~/.ssh/id_<keyname> -C "email@example.com"
#
# 2. Add public key to GitHub (Settings > SSH Keys):
#    cat ~/.ssh/id_<keyname>.pub
#
# 3. Edit this file with your real data
#
# 4. Apply:
#    chezmoi apply
#
# 5. Test:
#    cd ~/projects && git config user.email

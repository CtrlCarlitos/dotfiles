{{/* Rule for this whole file, and every TOML file in the repo (docs/invariants.md #15): in every block of two or more
     consecutive `key = value` lines, the "=" signs share one column. Hand-written
     blocks pad with printf "%-*s"; toToml output goes through toml-align.
     tests/config_toml_alignment_contract.sh enforces it. */}}
{{- /* Helpers for round-tripping a machine-local table with aligned "=" columns.
     toml-value renders one scalar or list. emit-toml-table renders a table:
     scalar keys first (padded to the widest key in THIS table), then nested
     tables, then arrays of tables. Input: dict path/table/depth/aot. Keys are
     written bare, so they must be valid bare TOML keys (letters, digits, "_",
     "-"); values: strings, bools, numbers, lists. Comments are NOT emitted per
     table: they live in one block above the tables (see remote_access). */}}
{{- define "toml-value" -}}
{{- if kindIs "string" . }}{{ . | quote }}
{{- else if kindIs "slice" . }}[{{ range $i, $e := . }}{{ if $i }}, {{ end }}{{ if kindIs "string" $e }}{{ $e | quote }}{{ else }}{{ $e }}{{ end }}{{ end }}]
{{- else }}{{ . }}{{ end -}}
{{- end -}}
{{- define "emit-toml-table" -}}
{{- $path := .path -}}
{{- $depth := .depth -}}
{{- $aot := .aot -}}
{{- $hdr := repeat (int (mul $depth 2)) " " -}}
{{- $ind := repeat (int (mul (add $depth 1) 2)) " " -}}
{{- $w := 0 -}}
{{- range $k, $v := .table -}}
{{-   if and (not (kindIs "map" $v)) (or (not (kindIs "slice" $v)) (not $v) (not (kindIs "map" (index $v 0)))) -}}
{{-     $w = max $w (len $k) -}}
{{-   end -}}
{{- end -}}
{{- /* children indent one step only when this table printed a header */}}
{{- $child := ternary (add $depth 1) $depth (gt $w 0) -}}
{{- if gt $w 0 }}
{{- "\n" }}
{{- "\n" }}{{ $hdr }}{{ if $aot }}[[{{ $path }}]]{{ else }}[{{ $path }}]{{ end }}
{{- range $k, $v := .table }}
{{-   if and (not (kindIs "map" $v)) (or (not (kindIs "slice" $v)) (not $v) (not (kindIs "map" (index $v 0)))) }}
{{ $ind }}{{ printf "%-*s" (int $w) $k }} = {{ template "toml-value" $v }}
{{-   end }}
{{- end }}
{{- end }}
{{- range $k, $v := .table }}
{{-   if kindIs "map" $v }}
{{- template "emit-toml-table" (dict "path" (printf "%s.%s" $path $k) "table" $v "depth" $child "aot" false) }}
{{-   end }}
{{- end }}
{{- range $k, $v := .table }}
{{-   if and (kindIs "slice" $v) $v }}
{{-     if kindIs "map" (index $v 0) }}
{{-       range $e := $v }}
{{- template "emit-toml-table" (dict "path" (printf "%s.%s" $path $k) "table" $e "depth" $child "aot" true) }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- end -}}
{{/* Detect environment */}}
{{- $envDev := or (env "DEVCONTAINER") (env "REMOTE_CONTAINERS") | default "" -}}
{{/* "isDevcontainer" really means "any container", by design (Docker specifically -
     /.dockerenv fires for any Docker container, not just VS Code devcontainers).
     Intentionally Docker-only for now. Planned rollout order if/when other runtimes
     matter: Podman (/run/.containerenv) -> Kubernetes -> others. */}}
{{- $isDevcontainer := or (eq $envDev "true") (eq $envDev "1") (stat "/.dockerenv" | not | not) -}}
{{- $isWsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (.chezmoi.kernel.osrelease | lower) -}}
{{-     $isWsl = true -}}
{{-   end -}}
{{- end -}}

{{/* isHost = physical machine, not WSL or Devcontainer */}}
{{- $isHost := and (not $isDevcontainer) (not $isWsl) -}}

{{/* Initialize accounts - check if already configured */}}
{{- $accounts := list -}}
{{- if hasKey . "accounts" -}}
{{-   $accounts = .accounts -}}
{{- else if not $isDevcontainer -}}
{{/* First-time setup: prompt for primary account */}}
{{-   $primaryName := promptStringOnce . "primaryName" "Your name for git commits" -}}
{{-   $primaryEmail := promptStringOnce . "primaryEmail" "Your email for git commits" -}}
{{-   $primaryUsername := promptStringOnce . "primaryUsername" "Your GitHub/GitLab username" -}}
{{-   $primaryKey := promptStringOnce . "primaryKey" "SSH key name (e.g., id_personal, leave blank to skip SSH)" -}}
{{-   
      $accounts = list (dict 
        "name" $primaryName 
        "email" $primaryEmail 
        "username" $primaryUsername
        "provider" "github"
        "key" $primaryKey 
        "dirs" (list "projects/personal" ".local/share/chezmoi")
      ) 
-}}
{{- end -}}

{{/* Determine interactive mode for package prompts */}}
{{- $interactive := and (not $isDevcontainer) (not (env "CI")) -}}

[data]
  # This is the template-data namespace: installers and dotfile templates read
  # values under [data.*]. `chezmoi init` regenerates this entire file from this
  # template, so preserve only fields the sections below explicitly re-emit.
  #
  # isDevcontainer/isWsl/isHost are intentionally NOT stored here. They used to
  # be computed once at `chezmoi init` and then went stale after copying this
  # config to another environment. Templates that need them compute them live
  # on every `chezmoi apply` instead.

  # ==========================================================================
  # Package Configuration (customize in ~/.config/chezmoi/chezmoi.toml)
  # All 16 toggles are independent on Linux, macOS, and Windows. `true` means
  # desired state on the next apply. Groups marked "(host only)" are skipped in
  # WSL and containers; every other group applies there too. The
  # package-selection menu rewrites this whole table.
  #
  # These replace the old six install_* toggles with no auto-migration; the
  # complete rename map, presets, and platform matrix live in docs/package-groups.md.
  # ==========================================================================
  [data.packages]
    # core - terminal fundamentals (git, zsh, tmux, node, python, fzf, gh)
    core = {{ if $interactive }}{{ promptBoolOnce . "packages.core" "Install core (terminal fundamentals: git, zsh, tmux)?" true }}{{ else }}false{{ end }}

    # modern_cli - modern CLI replacements (bat, eza, fd, starship, zoxide, gum)
    modern_cli = {{ if $interactive }}{{ promptBoolOnce . "packages.modern_cli" "Install modern_cli (modern CLI replacements: bat, eza, starship)?" true }}{{ else }}false{{ end }}

    # fonts - Nerd Fonts (MesloLGS NF), required for Starship
    fonts = {{ if $interactive }}{{ promptBoolOnce . "packages.fonts" "Install fonts (Nerd Fonts)?" true }}{{ else }}false{{ end }}

    # agent_toolkit - cross-vendor agent layer (Serena, Graft, act, Playwright)
    agent_toolkit = {{ if $interactive }}{{ promptBoolOnce . "packages.agent_toolkit" "Install agent_toolkit (cross-vendor agent layer: Serena, Graft, act)?" true }}{{ else }}false{{ end }}

    # opencode_cli - OpenCode CLI + superpowers/skills/guardrail wiring
    opencode_cli = {{ if $interactive }}{{ promptBoolOnce . "packages.opencode_cli" "Install opencode_cli (OpenCode CLI)?" true }}{{ else }}false{{ end }}

    # opencode_desktop - OpenCode Desktop app (host only)
    opencode_desktop = {{ if and $interactive $isHost }}{{ promptBoolOnce . "packages.opencode_desktop" "Install opencode_desktop (OpenCode Desktop app)?" false }}{{ else }}false{{ end }}

    # claude_cli - Claude Code CLI + superpowers/skills/guardrail wiring
    claude_cli = {{ if $interactive }}{{ promptBoolOnce . "packages.claude_cli" "Install claude_cli (Claude Code)?" true }}{{ else }}false{{ end }}

    # claude_desktop - Claude Desktop app (host only; Linux has no build)
    claude_desktop = {{ if and $interactive $isHost }}{{ promptBoolOnce . "packages.claude_desktop" "Install claude_desktop (Claude Desktop app)?" false }}{{ else }}false{{ end }}

    # chatgpt_cli - Codex CLI (@openai/codex) + the curated-skills pass for Codex
    chatgpt_cli = {{ if $interactive }}{{ promptBoolOnce . "packages.chatgpt_cli" "Install chatgpt_cli (Codex CLI)?" false }}{{ else }}false{{ end }}

    # chatgpt_desktop - ChatGPT Desktop app (host only; Linux has no build)
    chatgpt_desktop = {{ if and $interactive $isHost }}{{ promptBoolOnce . "packages.chatgpt_desktop" "Install chatgpt_desktop (ChatGPT Desktop app)?" false }}{{ else }}false{{ end }}

    # antigravity_cli - Antigravity CLI (agy) + superpowers/skills/guardrail wiring
    antigravity_cli = {{ if $interactive }}{{ promptBoolOnce . "packages.antigravity_cli" "Install antigravity_cli (Antigravity CLI, agy)?" false }}{{ else }}false{{ end }}

    # antigravity_desktop - Antigravity 2.0 app (host only)
    antigravity_desktop = {{ if and $interactive $isHost }}{{ promptBoolOnce . "packages.antigravity_desktop" "Install antigravity_desktop (Antigravity 2.0 app)?" false }}{{ else }}false{{ end }}

    # remote_access - private mesh access and approved app tunneling; no login/config.
    remote_access = {{ if $interactive }}{{ promptBoolOnce . "packages.remote_access" "Install remote_access (Tailscale, cloudflared; no login or tunnel setup)?" false }}{{ else }}false{{ end }}

    # remote_access_server - explicit SSH-server prerequisite opt-in; never preset.
    remote_access_server = {{ if $interactive }}{{ promptBoolOnce . "packages.remote_access_server" "Install remote_access_server prerequisites (manual SSH setup required)?" false }}{{ else }}false{{ end }}

    # guardrail - agent guardrails, single desired-state flag handed to the
    # agent-guardrails installer: true = install/upgrade the binary and
    # register planes with your approval; false = disable planes if a binary
    # is already installed. The binary itself is never removed by the
    # dotfiles.
    guardrail = {{ if $interactive }}{{ promptBoolOnce . "packages.guardrail" "Install guardrail (agent guardrails)?" true }}{{ else }}false{{ end }}

    # dev_desktop - human desktop apps: Chrome, VS Code, Docker Desktop.
    # Host only: not prompted on WSL/containers, and enforced there too —
    # the package-install template gates the actual install on the same
    # $isHost check, not just this prompt, so hand-editing this to `true` on
    # WSL/in a container still won't install desktop apps there.
    dev_desktop = {{ if and $interactive $isHost }}{{ promptBoolOnce . "packages.dev_desktop" "Install dev_desktop (human desktop apps: Chrome, VS Code)?" false }}{{ else }}false{{ end }}

    # vscode_settings - settings defaults + global extension management.
    # No prompt; default true. Set false to opt out wholesale on this machine.
{{- if and (hasKey . "packages") (hasKey .packages "vscode_settings") }}
    vscode_settings = {{ .packages.vscode_settings }}
{{- else }}
    # vscode_settings = false    # opt out of settings + extension management
{{- end }}

{{/* vscode.settings: this machine's VS Code settings, by tier. Written back as the
     machine has them (an edit survives every `chezmoi init`, which `dot up` runs);
     seeded from .chezmoitemplates/vscode-settings.toml only when absent, so a change
     to the seed reaches new machines only. Both paths go through toToml, so the
     layout is the same either way (keys sorted, no comments - the rationale is in
     docs/vscode.md). The extensions stay in .chezmoidata.yaml under the same
     `vscode` key: chezmoi deep-merges the two, so the settings must not be there. */}}
{{- $vscodeSettings := dict }}
{{- if and (hasKey . "vscode") (kindIs "map" .vscode) (hasKey .vscode "settings") }}
{{-   $vscodeSettings = .vscode.settings }}
{{- else }}
{{-   $vscodeSettings = includeTemplate "vscode-settings.toml" . | fromToml }}
{{- end }}
# VS Code settings for this machine, by tier (docs/vscode.md):
#   forced = re-asserted every run; defaults / defaults_windows = written when absent;
#   junk = files.exclude + search.exclude globs; unset = keys removed;
#   terminal_colors = merged into workbench.colorCustomizations.
{{ includeTemplate "toml-align" (replace "[vscode" "[data.vscode" (toToml (dict "vscode" (dict "settings" $vscodeSettings)))) }}

{{/* vscode_overrides: machine-local extension drift from the repo baseline
     (extra_extensions / exclude_extensions). exclude_settings / extra_settings still
     work, but with the settings themselves in [data.vscode.settings] above, editing
     those is simpler. extra_settings supports scalars, arrays, and nested TOML tables
     (including language scopes like [python]); see docs/vscode.md. */}}
{{- if hasKey . "vscode_overrides" }}
# VS Code Machine-Local Overrides
# These values complement the repository baseline for this machine only.
# extra_extensions adds extensions; exclude_extensions prevents a baseline
# extension from reinstalling. exclude_settings removes a managed key; use
# extra_settings to upsert a replacement. Nested values are valid TOML and
# `chezmoi init` writes them as nested tables.
{{ includeTemplate "toml-align" (replace "[vscode_overrides" "[data.vscode_overrides" (toToml (dict "vscode_overrides" .vscode_overrides))) }}
{{- else }}
  # [data.vscode_overrides]  (machine-local drift from the repo baseline;
  # extensions; settings are edited in [data.vscode.settings] above)
  #   extra_extensions   = ["hashicorp.terraform"]              # add to baseline
  #   exclude_extensions = ["ms-python.pylint"]                 # stop reinstalling here
  #   exclude_settings   = ["terminal.integrated.fontFamily"]   # stop forcing a key
  #   [data.vscode_overrides.extra_settings]  (upsert tier; change = exclude + add)
  #     "editor.fontSize"     = 15
  #     "files.autoSaveDelay" = 1000
  #     "editor.rulers"       = [80, 120]
  #     "[python]"            = { "editor.tabSize" = 4 }
{{- end }}

{{/* upgrade: machine-local `dot upgrade` behavior. Its own table, not
     [data.packages], so the package-selection menu never rewrites it.
     Windows only: the desktop-shortcut cleanup lives in scripts/lib/ps-desktop-shortcuts.ps1
     (dot upgrade, dot up's installer, migrate-to-winget). */}}
{{- if eq .chezmoi.os "windows" }}
{{- if and (hasKey . "upgrade") (hasKey .upgrade "desktop_shortcuts") }}
  # `dot upgrade`: false = delete the desktop shortcuts that the
  # choco/winget sweeps newly create. Pre-existing shortcuts are never touched.
  [data.upgrade]
    desktop_shortcuts = {{ .upgrade.desktop_shortcuts }}
{{- else }}
  # [data.upgrade]
  #   desktop_shortcuts = false   # remove shortcuts new installers drop on the Desktop
{{- end }}
{{/* No left trim on this `if`: the newline it keeps is the one blank line that
     sets this section off from the table above (set or commented). */ -}}
{{ if and (hasKey . "devtmp") (hasKey .devtmp "path") .devtmp.path }}
  # `dot devtmp`: ONE folder for build/test output (Defender cost; #227).
  # Build output only: once excluded, nothing in it is scanned.
  [data.devtmp]
    path = {{ .devtmp.path | quote }}
{{- else }}
  # [data.devtmp]
  #   path = "C:/dev/tmp"   # build/test output only; `dot devtmp` prints the rest
{{- end }}
{{- end }}
{{ if $isDevcontainer }}
  # Devcontainer defaults - create a minimal account for git identity
[[data.accounts]]
  name          = "Devcontainer User"
  email         = "devcontainer@local"
  username      = "devcontainer"
  provider      = "github"
  key           = ""
  organizations = []
  dirs          = []
{{- else }}
# Account Configuration
# Each account generates a ~/.gitconfig-<provider>-<username> identity file
# and includeIf rules for its dirs. The matching SSH key name is just the
# filename in ~/.ssh (never a private key or passphrase).
#
# Add one [[data.accounts]] block per identity:
#   name               = "Work Name"                  # required: commit author name
#   email              = "work@company.com"           # required: commit author email
#   username           = "work-user"                  # required: GitHub/GitLab account
#   provider           = "github"                     # github (default) or gitlab
#   key                = "id_work"                    # optional: ~/.ssh key filename
#   signingKey         = "id_work_sign"               # optional: falls back to key
#   agent_key_comments = ["<email>", "<email>-sign"]  # optional: allowed key comments (default <email>, <email>-sign)
#   organizations      = ["company-org"]              # optional: URL rewrite scope
#   dirs               = ["projects/work"]            # paths using this identity
#
# `chezmoi init` regenerates this file. Only fields explicitly re-emitted
# below survive it; the gitconfig alias is derived, not a stored field.
{{- range $accounts }}

[[data.accounts]]
{{- /* "=" column: widest key actually emitted for this account */}}
{{- $w := 8 }}
{{- if hasKey . "signingKey" }}{{ $w = max $w 10 }}{{ end }}
{{- if and (not (hasKey . "signingKey")) (hasKey . "signingkey") }}{{ $w = max $w 10 }}{{ end }}
{{- if hasKey . "agent_key_comments" }}{{ $w = max $w 18 }}{{ end }}
{{- if hasKey . "organizations" }}{{ $w = max $w 13 }}{{ end }}
{{- $acct := . }}
{{- range $field := list "auth_fingerprint" "signing_fingerprint" "agent_signing_key_comment" }}{{ if hasKey $acct $field }}{{ $w = max $w (len $field) }}{{ end }}{{ end }}
  {{ printf "%-*s" (int $w) "name" }} = {{ .name | quote }}
  {{ printf "%-*s" (int $w) "email" }} = {{ .email | quote }}
  {{ printf "%-*s" (int $w) "username" }} = {{ if hasKey . "username" }}{{ .username | quote }}{{ else }}""{{ end }}
  {{ printf "%-*s" (int $w) "provider" }} = {{ if hasKey . "provider" }}{{ .provider | quote }}{{ else }}"github"{{ end }}
  {{ printf "%-*s" (int $w) "key" }} = {{ if hasKey . "key" }}{{ .key | quote }}{{ else }}""{{ end }}
{{- if hasKey . "signingKey" }}
  {{ printf "%-*s" (int $w) "signingKey" }} = {{ .signingKey | quote }}
{{- end }}
{{- if and (not (hasKey . "signingKey")) (hasKey . "signingkey") }}
  {{ printf "%-*s" (int $w) "signingkey" }} = {{ .signingkey | quote }}
{{- end }}
{{- if hasKey . "agent_key_comments" }}
{{-   if kindOf .agent_key_comments | eq "string" }}
  {{ printf "%-*s" (int $w) "agent_key_comments" }} = [{{ .agent_key_comments | quote }}]
{{-   else }}
  {{ printf "%-*s" (int $w) "agent_key_comments" }} = [{{ range $i, $c := .agent_key_comments }}{{ if $i }}, {{ end }}{{ $c | quote }}{{ end }}]
{{-   end }}
{{- end }}
{{- $account := . }}
{{- range $field := list "auth_fingerprint" "signing_fingerprint" "agent_signing_key_comment" }}
{{- if hasKey $account $field }}
  {{ printf "%-*s" (int $w) $field }} = {{ index $account $field | quote }}
{{- end }}
{{- end }}
{{- if hasKey . "organizations" }}
{{-   if kindOf .organizations | eq "string" }}
  {{ printf "%-*s" (int $w) "organizations" }} = [{{ .organizations | quote }}]
{{-   else }}
  {{ printf "%-*s" (int $w) "organizations" }} = [{{ range $i, $org := .organizations }}{{ if $i }}, {{ end }}{{ $org | quote }}{{ end }}]
{{-   end }}
{{- end }}
  {{ printf "%-*s" (int $w) "dirs" }} = [{{ if hasKey . "dirs" }}{{ range $i, $dir := .dirs }}{{ if $i }}, {{ end }}{{ $dir | quote }}{{ end }}{{ end }}]
{{- end -}}
{{- end -}}
{{/* =====================================================================
  Machine-local SSH Hosts - documented and ROUND-TRIPPED. `chezmoi init`
  regenerates this whole file, so any key this template does not re-emit is
  destroyed. Each host below is re-emitted losslessly; an unused setup gets a
  commented example. VS Code settings/overrides live above, after dev_desktop.
===================================================================== */}}

{{/* ssh_hosts: rendered into the SSH client config by
     private_dot_ssh/private_config.tmpl; VS Code Remote-SSH reads them
     natively. comment renders as the block header - your memory hook.
     WSL needs outgoing aliases too; only private key storage is Windows-only. */}}
{{- if hasKey . "ssh_hosts" -}}
# SSH Host Aliases
# Each [[data.ssh_hosts]] block becomes an SSH Host entry and is picked up by
# VS Code Remote-SSH. name and hostname are required; user, port, identity,
# proxy (ProxyJump alias), and comment (the rendered block header) are optional.
# identity is a filename in ~/.ssh; private keys and passphrases never belong here.
#
# Generated SSH config adds safe defaults after all aliases: host-key changes are
# rejected, known-host entries are hashed, agent forwarding is disabled, and
# dead sessions are detected. A future host-specific option is emitted before
# those defaults and therefore wins (OpenSSH uses the first value it finds).
#
# Complete example (copy, uncomment, and customize):
# [[data.ssh_hosts]]
#   name     = "prod-jump"            # required  Host alias
#   hostname = "10.0.0.5"             # required  IP or DNS name
#   user     = "carlitos"             # optional  login user
#   port     = 22                     # optional  default 22
#   identity = "id_personal"          # optional  key filename in ~/.ssh
#   proxy    = "bastion"              # optional  ProxyJump alias
#   comment  = "Bastion for staging"  # optional  rendered block header
#   os       = "linux"                # optional  mac|linux: Windows Terminal tab color
#   tmux     = true                   # optional  Terminal tab attaches to tmux session "main" (or a name)
{{- range .ssh_hosts }}

[[data.ssh_hosts]]
{{- /* "=" column: widest key actually emitted for this host */}}
{{- $w := 8 }}
{{- if hasKey . "identity_fingerprint" }}{{ $w = 20 }}{{ end }}
  {{ printf "%-*s" (int $w) "name" }} = {{ .name | quote }}
  {{ printf "%-*s" (int $w) "hostname" }} = {{ .hostname | quote }}
{{- if hasKey . "user" }}
  {{ printf "%-*s" (int $w) "user" }} = {{ .user | quote }}
{{- end }}
{{- if hasKey . "port" }}
  {{ printf "%-*s" (int $w) "port" }} = {{ .port }}
{{- end }}
{{- if hasKey . "identity" }}
  {{ printf "%-*s" (int $w) "identity" }} = {{ .identity | quote }}
{{- end }}
{{- if hasKey . "identity_fingerprint" }}
  {{ printf "%-*s" (int $w) "identity_fingerprint" }} = {{ .identity_fingerprint | quote }}
{{- end }}
{{- if hasKey . "proxy" }}
  {{ printf "%-*s" (int $w) "proxy" }} = {{ .proxy | quote }}
{{- end }}
{{- if hasKey . "comment" }}
  {{ printf "%-*s" (int $w) "comment" }} = {{ .comment | quote }}
{{- end }}
{{- if hasKey . "os" }}
  {{ printf "%-*s" (int $w) "os" }} = {{ .os | quote }}
{{- end }}
{{- if hasKey . "tmux" }}
  {{ printf "%-*s" (int $w) "tmux" }} = {{ if kindIs "string" .tmux }}{{ .tmux | quote }}{{ else }}{{ .tmux }}{{ end }}
{{- end }}
{{- end }}
{{- else }}
# [[data.ssh_hosts]]  (one block per host; keys live in ~/.ssh)
#   name     = "prod-jump"            # required  Host alias
#   hostname = "10.0.0.5"             # required  IP or DNS name
#   user     = "carlitos"             # optional  login user
#   port     = 22                     # optional  default 22
#   identity = "id_personal"          # optional  key file name in ~/.ssh
#   proxy    = "bastion"              # optional  ProxyJump alias
#   comment  = "Bastion for staging"  # optional  block header (memory hook)
#   os       = "linux"                # optional  mac|linux: Windows Terminal tab color
#   tmux     = true                   # optional  Terminal tab attaches to tmux session "main" (or a name)
{{- end }}

{{/* remote_access: machine-local `dot remote` intent (docs/remote-access.md),
     documented and ROUND-TRIPPED. `chezmoi init` regenerates this whole file,
     so any table not re-emitted here is destroyed. emit-toml-table writes every
     key present in ~/.config/chezmoi/chezmoi.toml, so new keys survive too.
     All comments sit in ONE block above the live tables, like the accounts and
     ssh_hosts sections; each OS owns its local incoming authorization. */}}
{{- if or (not $isWsl) (hasKey . "remote_access") }}
# ==========================================================================
# Remote Access (`dot remote`) - machine-local intent; see docs/remote-access.md
# Public-key names only: no private material, tunnel credentials or Access policies.
# ==========================================================================
# Reference (uncomment and customize in ~/.config/chezmoi/chezmoi.toml):
#
# [data.remote_access]
#   enabled = true
#
#   [data.remote_access.ssh]
#     enabled = true
#     login_keys = ["id_phone", "id_laptop"] # existing local .pub files
#   [data.remote_access.rdp]
#     enabled = true # Windows RDP or native Linux xrdp
#
#   # Optional Windows-side forwarding only. The distro owns its daemon/keys.
#   [data.remote_access.wsl]
#     enabled  = true
#     ssh_port = 2222
#
#   # login_keys is authoritative: sync/fix revokes undeclared keys.
#   # An explicit [] revokes all; missing/invalid desired keys refuse changes.
#
#   # Loopback web services exposed privately. Windows and WSL are separate
#   # backends, so each gets its own block with its own environment and port.
#   # Ports must not collide across environments (a Windows listener wins WSL2
#   # localhost forwarding on the same port): 4096 windows, 4097 wsl.
#   [data.remote_access.services.opencode_windows]
#     enabled     = true
#     environment = "windows"
#     port        = 4096
#     tailscale   = true
#     cloudflare  = false
#
#   [data.remote_access.services.opencode_wsl]
#     enabled     = true
#     environment = "wsl"
#     port        = 4097
#     tailscale   = true
#     cloudflare  = false
#
#   # cloudflared ingress, rendered by `dot remote tunnel render`:
#   [data.remote_access.tunnel]
#     id = "<machine-local tunnel id>"
#   [data.remote_access.tunnel.ingress.ssh]
#     hostname = "<machine-local hostname>"
#     service  = "ssh://127.0.0.1:22"
{{- if hasKey . "remote_access" }}
{{- template "emit-toml-table" (dict "path" "data.remote_access" "table" .remote_access "depth" 0 "aot" false) }}
{{- end }}
{{- end }}

# chezmoi add: secret scanning
# `chezmoi add` scans a file for secrets (API keys, tokens, private keys) with
# gitleaks rules before copying it into the source repo. `secrets` sets what a
# finding does:
#   "warning"  print the finding and still add the file (chezmoi's default)
#   "error"    print the finding and refuse to add the file
#   "ignore"   skip the scan
[add]
  secrets = "warning"
{{- if and (hasKey . "packages") (hasKey .packages "modern_cli") .packages.modern_cli }}

# chezmoi diff: pager
# Gated on modern_cli for the same reason dot_gitconfig gates git's pager:
# with modern_cli=false delta is not installed, and 'chezmoi diff' would
# die on the missing binary.
[diff]
  pager = "delta"
{{- end }}

# Script interpreters
# chezmoi runs each script (run_*.ps1, run_*.py, ...) with an interpreter chosen
# by its file extension. [interpreters.<ext>] sets the command, and optionally
# its arguments, for one extension. Built-in defaults include py = python3,
# rb = ruby, pl = perl and nu = nu; .ps1 is set per OS below:
#   windows: Windows PowerShell 5.1 (`powershell`) with no profile and the
#            execution policy bypassed, so this repo's unsigned scripts run.
#            Identical to chezmoi's built-in Windows default, kept explicit.
#   macOS:   `pwsh` (PowerShell 7) - there is no Windows PowerShell there.
#   linux:   no override.
#
# Example - run .py scripts with a pinned Python in UTF-8 mode:
# [interpreters.py]
#   command = "python3"
#   args    = ["-X", "utf8"]
{{ if eq .chezmoi.os "darwin" }}
[interpreters.ps1]
  command = "pwsh"
{{- end }}

{{- if eq .chezmoi.os "windows" }}
[interpreters.ps1]
  command = "powershell"
  args    = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]
{{- end }}

{{- if eq .chezmoi.os "linux" "darwin" -}}
{{- if and (hasKey . "accounts") .accounts -}}
{{- /* Same container rule as dot_gitconfig.tmpl: a devcontainer has no key
       FILES (keys arrive through the forwarded agent socket), so pinning
       `-i <path> -o IdentitiesOnly=yes` there would refuse the agent's keys,
       and ssh signing would need a .pub that isn't present either. */ -}}
{{- $envDev := or (env "DEVCONTAINER") (env "REMOTE_CONTAINERS") | default "" -}}
{{- $isDevcontainer := or (eq $envDev "true") (eq $envDev "1") (stat "/.dockerenv" | not | not) -}}
#!/usr/bin/env bash
# Generate git identity files from accounts configuration
# This script runs whenever the accounts list changes
# Hash: {{ .accounts | toJson | sha256sum }}{{ if $isDevcontainer }} (devcontainer variant){{ end }}

set -euo pipefail

echo "Generating git identity files..."

{{- /* Collect and create account directories */ -}}
{{- $allDirs := list }}
{{- range .accounts }}
{{- if hasKey . "dirs" }}
{{-   $allDirs = concat $allDirs .dirs }}
{{- end }}
{{- end }}
{{- $uniqueDirs := uniq $allDirs }}
{{- range $uniqueDirs }}
{{- if . }}
mkdir -p "$HOME/{{ . }}"
{{- end }}
{{- end }}

{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- if $username }}
{{- $alias := printf "%s-%s" $provider $username }}
{{- $signKey := "" }}
{{- if hasKey . "signingKey" }}{{ $signKey = .signingKey }}{{ end }}
{{- if and (not $signKey) (hasKey . "signingkey") }}{{ $signKey = .signingkey }}{{ end }}

# Generate ~/.gitconfig-{{ $alias }}
cat > "$HOME/.gitconfig-{{ $alias }}" << 'IDENTITY_EOF'
# Auto-generated by chezmoi from accounts configuration
# Account: {{ $alias }}

[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
{{- if and .key (not $isDevcontainer) }}
    signingkey = ~/.ssh/{{ if $signKey }}{{ $signKey }}{{ else }}{{ .key }}{{ end }}.pub

[commit]
    gpgsign = true

[gpg]
    format = ssh

[core]
    sshCommand = "ssh -i ~/.ssh/{{ .key }} -o IdentitiesOnly=yes"
{{- else if .key }}

[core]
    # Devcontainer: plain ssh, so the forwarded agent's keys are used.
    sshCommand = "ssh"
{{- end }}
IDENTITY_EOF
echo "  ✓ Created ~/.gitconfig-{{ $alias }}"
{{- if and .key $isDevcontainer }}

# Devcontainer signing: the account declares a signing key, so honor it - but a
# container has no key FILES. `ssh-keygen -Y sign` only needs the PUBLIC half
# plus the private key in an agent, so materialize the .pub from the forwarded
# agent and sign through it. With one agent per account (see
# docs/devcontainer.md) the agent holds exactly one key; otherwise match it by
# the account's email or key name. No agent key -> signing stays off, loudly.
__sign_pub="$HOME/.ssh/{{ if $signKey }}{{ $signKey }}{{ else }}{{ .key }}{{ end }}.pub"
if [ ! -s "$__sign_pub" ] && [ -n "${SSH_AUTH_SOCK:-}" ]; then
    __agent_keys="$(ssh-add -L 2>/dev/null || true)"
    if [ "$(printf '%s\n' "$__agent_keys" | grep -c 'ssh-')" = "1" ]; then
        __match="$__agent_keys"
    else
        __match="$(printf '%s\n' "$__agent_keys" | grep -F -- {{ .email | quote }} | head -1 || true)"
        [ -n "$__match" ] || __match="$(printf '%s\n' "$__agent_keys" | grep -F -- '{{ if $signKey }}{{ $signKey }}{{ else }}{{ .key }}{{ end }}' | head -1 || true)"
    fi
    if [ -n "${__match:-}" ]; then
        mkdir -p "$HOME/.ssh"
        (umask 077; printf '%s\n' "$__match" > "$__sign_pub")
        echo "  ✓ wrote $(basename "$__sign_pub") from the forwarded agent"
    fi
fi
if [ -s "$__sign_pub" ]; then
    cat >> "$HOME/.gitconfig-{{ $alias }}" << 'SIGN_EOF'

[user]
    signingkey = ~/.ssh/{{ if $signKey }}{{ $signKey }}{{ else }}{{ .key }}{{ end }}.pub

[commit]
    gpgsign = true

[gpg]
    format = ssh
SIGN_EOF
    echo "  ✓ commit signing enabled for {{ $alias }} (agent-backed)"
else
    echo "  ! {{ $alias }}: no matching key in the forwarded agent - commit signing left off" >&2
fi
unset __sign_pub __agent_keys __match
{{- end }}
{{- end }}
{{- end }}

# Generate ~/.ssh/allowed_signers (for `git log --show-signature` / `git verify-commit`
# to work locally - dot_gitconfig.tmpl points gpg.ssh.allowedSignersFile here).
#
# This repo is used across many independent machines/people, not just one person's
# own - so this deliberately does NOT centralize anyone's public keys in the git repo
# itself (a shared template repo is the wrong place for that, even though public keys
# are technically safe to commit). Everything here is generated from what's already
# local to this machine, and merged rather than rebuilt from scratch each run:
#
#   1. Whatever's already in the file is kept (so a file you copied in from another
#      machine, or hand-edited, survives every future apply).
#   2. Each configured account's dedicated signing key (falls back to the auth key if
#      no signingKey is set) - the most reliable source, straight from chezmoi.toml.
#   3. Every other *.pub under ~/.ssh not already covered - for a multi-machine setup
#      where keys are generated fresh per machine (rather than copied) instead of
#      committing anything anywhere, this is what lets a machine pick up keys for
#      identities it doesn't have configured itself. The principal (email) is
#      recovered from the key's own comment field - devprofile now writes signing
#      keys as "<email>-sign" specifically so this works; a key with an unparseable
#      comment (e.g. one made before that change, or by some other tool) is skipped
#      with a warning rather than guessed at, since allowed_signers is a trust list.
#
# Net effect: copying ~/.ssh/allowed_signers from another machine, or just copying
# its SSH keys in, both work without any extra steps - the next apply merges
# whatever's found and nothing already present is ever lost.
echo "Generating ~/.ssh/allowed_signers..."
# On a genuinely fresh machine (no SSH setup done yet at all) ~/.ssh may not
# exist yet - confirmed live, without this the final write below fails with
# "No such file or directory" and set -e aborts the whole script, silently
# skipping every step after it. Same permissions devprofile's own init uses.
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# Normalize permissions on this repo's own key files (id_* / id_*.pub) every
# apply, not just at generation time. `devprofile init` already gets this
# right locally (umask 077 + ssh-keygen's own defaults - confirmed live,
# every existing key here was already 600/644) - this matters for a key
# *copied in* from another machine instead, which routinely arrives with the
# wrong permissions (the copy itself doesn't preserve them), and which SSH
# then just silently refuses to use ("UNPROTECTED PRIVATE KEY FILE") with no
# hint that permissions are the reason.
for key in "$HOME"/.ssh/id_*; do
    [[ -f "$key" ]] || continue
    case "$key" in
        *.pub) chmod 644 "$key" ;;
        *)     chmod 600 "$key" ;;
    esac
done

# ~/.ssh/agent-identities.zsh - sourced by ~/.zshrc BEFORE oh-my-zsh loads, so
# the ssh-agent plugin reads this zstyle and loads exactly these keys into the
# agent (auth + per-account signing keys - loading only the auth key is the
# classic miss). Scope is deliberately the DECLARED accounts from chezmoi.toml,
# not a blind glob of ~/.ssh: undeclared keys a user loaded themselves are
# their business. The runtime `-f` filter drops any declared key not yet on
# disk (e.g. an account added to the config but `devprofile init` not run
# yet), so the plugin never warns about a missing identity. Regenerated only
# when .accounts changes (see the Hash line at the top).
cat > "$HOME/.ssh/agent-identities.zsh" << 'ZSH_EOF'
# Auto-generated by chezmoi (run_onchange_generate_identities). Do not edit.
_ssh_ids=()
# Leading "" keeps the list non-empty even if no account declares a key.
for _k in ""{{ range .accounts }}{{ if hasKey . "key" }}{{ if .key }} "{{ .key }}"{{ end }}{{ end }}{{ if hasKey . "signingKey" }}{{ if .signingKey }} "{{ .signingKey }}"{{ end }}{{ else if hasKey . "signingkey" }}{{ if .signingkey }} "{{ .signingkey }}"{{ end }}{{ end }}{{ end }}; do
    [[ -n "$_k" && -f "$HOME/.ssh/$_k" ]] && _ssh_ids+=("$_k")
done
(( ${#_ssh_ids[@]} )) && zstyle :omz:plugins:ssh-agent identities "${_ssh_ids[@]}"
unset _k _ssh_ids
{{- if eq .chezmoi.os "darwin" }}
# macOS: store/read passphrases from the login keychain (survives reboots).
zstyle :omz:plugins:ssh-agent ssh-add-args --apple-use-keychain
{{- end }}
ZSH_EOF
chmod 600 "$HOME/.ssh/agent-identities.zsh"
echo "  ✓ Wrote ~/.ssh/agent-identities.zsh"

# config: OpenSSH's *client* actually enforces this one (confirmed against
# real docs, corrected from an earlier wrong assumption that it didn't) -
# looser than 600 and ssh/git refuse outright with "Bad owner or permissions
# on ~/.ssh/config". private_dot_ssh/config.tmpl's chezmoi "private_" prefix
# is supposed to land this at 600 on its own, but empirically doesn't
# (confirmed 644 on real machines) - fixed explicitly here instead of
# depending on a mechanism that isn't demonstrably working.
[[ -f "$HOME/.ssh/config" ]] && chmod 600 "$HOME/.ssh/config"

# authorized_keys: not created/managed by this repo (that's SSH *server*
# setup, out of scope here) - only normalized if it already exists, same
# "fix permissions, never touch content" pattern as everything else in this
# block. sshd's StrictModes (on by default) refuses key-based login outright
# if this file - or ~/.ssh, or $HOME itself - is group/world-writable.
# $HOME's own permissions are a much bigger blast radius than anything under
# .ssh and are deliberately left alone here - that's on whoever sets up the
# SSH server to get right.
[[ -f "$HOME/.ssh/authorized_keys" ]] && chmod 600 "$HOME/.ssh/authorized_keys"

# known_hosts is deliberately NOT touched here: unlike the files above,
# OpenSSH doesn't enforce or even recommend a specific permission on it - no
# failure mode exists to fix, so normalizing it would be permission-churn
# for no functional reason.

signers_file="$HOME/.ssh/allowed_signers"
# Scratch file under one WORK dir removed on any exit path (#126): the bare
# mktemp here had no trap, so a failure between it and the final mv leaked
# the temp file into $TMPDIR on every broken run.
WORK="$(mktemp -d)"
trap '[ -n "${WORK:-}" ] && rm -rf "$WORK"' EXIT
signers_tmp="$WORK/allowed_signers.tmp"
[[ -f "$signers_file" ]] && cat "$signers_file" >> "$signers_tmp"

{{- range .accounts }}
{{- $signKey := "" }}
{{- if hasKey . "signingKey" }}{{ $signKey = .signingKey }}{{ end }}
{{- if and (not $signKey) (hasKey . "signingkey") }}{{ $signKey = .signingkey }}{{ end }}
{{- if and (not $signKey) (hasKey . "key") }}{{ $signKey = .key }}{{ end }}
{{- if $signKey }}
if [[ -f "$HOME/.ssh/{{ $signKey }}.pub" ]]; then
    # Keytype+keydata only (no comment) - matches the format the scan loop below
    # produces for the same file, so sort -u actually collapses the duplicate
    # instead of keeping two differently-formatted lines for one key.
    # The email sits in a shell variable so the CI lint, which strips every
    # template action before shellcheck runs, still sees two printf arguments.
    signer_email={{ .email | quote }}
    printf '%s namespaces="git" %s\n' "$signer_email" "$(awk '{print $1, $2}' "$HOME/.ssh/{{ $signKey }}.pub")" >> "$signers_tmp"
else
    echo "  ! Skipping {{ .email }} - {{ $signKey }}.pub not found yet" >&2
fi
{{- end }}
{{- end }}

if [[ -d "$HOME/.ssh" ]]; then
    for pub in "$HOME"/.ssh/*.pub; do
        [[ -f "$pub" ]] || continue
        comment=$(awk '{print $3}' "$pub")
        if [[ "$comment" =~ ^([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}) ]]; then
            email="${BASH_REMATCH[1]}"
            keydata=$(awk '{print $1, $2}' "$pub")
            echo "$email namespaces=\"git\" $keydata" >> "$signers_tmp"
        else
            echo "  ! Skipping $(basename "$pub") - comment isn't a recognizable email, can't determine who to trust it as" >&2
        fi
    done
fi

sort -u "$signers_tmp" > "$signers_file"
chmod 600 "$signers_file"
echo "  ✓ Wrote ~/.ssh/allowed_signers"
{{- end }}

echo "Done!"
{{- end }}

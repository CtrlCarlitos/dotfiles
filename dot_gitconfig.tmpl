#===============================================================================
# GIT CONFIGURATION
# Global settings - identity is set dynamically based on directory
# Managed by chezmoi - accounts configured via chezmoi init
#===============================================================================
{{- /* Find default identity (use first account as default) */ -}}
{{- $simpleName := "" -}}
{{- $simpleEmail := "" -}}
{{- $simpleKey := "" -}}
{{- $simpleSigningKey := "" -}}
{{- if .accounts -}}
{{-   $first := first .accounts -}}
{{-   if $first -}}
{{-     $simpleName = $first.name -}}
{{-     $simpleEmail = $first.email -}}
{{-     if hasKey $first "key" }}{{ $simpleKey = $first.key }}{{ end -}}
{{-     if hasKey $first "signingKey" }}{{ $simpleSigningKey = $first.signingKey }}{{ end -}}
{{-     if and (not $simpleSigningKey) (hasKey $first "signingkey") }}{{ $simpleSigningKey = $first.signingkey }}{{ end -}}
{{-   end -}}
{{- end }}
{{- /* Computed inline (not read from stored data) so this is always live/correct on
     every apply, never stale from a `chezmoi init` run on a different machine/
     environment type - see the [data] comment in .chezmoi.toml.tmpl. "isDevcontainer"
     really means "any container" (Docker specifically) by design - intentionally
     Docker-only for now, see .chezmoi.toml.tmpl's detection block for the planned
     rollout order if other runtimes are ever added. */ -}}
{{- $envDev := or (env "DEVCONTAINER") (env "REMOTE_CONTAINERS") | default "" -}}
{{- $isDevcontainer := or (eq $envDev "true") (eq $envDev "1") (stat "/.dockerenv" | not | not) -}}
{{- $isWsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (.chezmoi.kernel.osrelease | lower) -}}
{{-     $isWsl = true -}}
{{-   end -}}
{{- end }}
[user]
{{- if $simpleName }}
    name = {{ $simpleName | quote }}
    email = {{ $simpleEmail | quote }}
{{- if $simpleKey }}
    signingkey = ~/.ssh/{{ if $simpleSigningKey }}{{ $simpleSigningKey }}{{ else }}{{ $simpleKey }}{{ end }}.pub
{{- end }}
{{- else }}
    # No accounts configured - use 'devprofile use' to set identity per-repo
    # or add accounts to ~/.config/chezmoi/chezmoi.toml
{{- end }}
    # Prevent git from guessing identity - forces explicit configuration
    useConfigOnly = true
{{- if and $simpleName $simpleKey }}

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    # Lets `git log --show-signature` / `git verify-commit` verify signatures locally.
    # Generated by run_onchange_generate_identities.{sh,ps1}.tmpl from each account's
    # dedicated signing key - only covers commits signed after that file was generated,
    # not older commits signed under a different key.
    allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

[init]
    defaultBranch = main

[core]
    # Editor for commit messages, rebase, etc.
    # Options:
    #   code --wait        VS Code (recommended - what you know)
    #   nvim               Neovim (fast, terminal-native)
    #   vim                Vim (always available)
    autocrlf = input
{{- if or $isWsl $isDevcontainer (and (hasKey . "packages") .packages.install_desktop) (lookPath "code") }}
    # Requires VS Code in PATH (code command)
    editor = code --wait
{{- else }}
    editor = vim
{{- end }}
{{- if and (hasKey . "packages") .packages.install_modern }}
    pager = delta
{{- end }}
{{- if $simpleKey }}
    sshCommand = "ssh -i ~/.ssh/{{ $simpleKey }} -o IdentitiesOnly=yes"
{{- else }}
    sshCommand = "ssh"
{{- end }}
    whitespace = fix

[color]
    ui = auto

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true

[rebase]
    autoStash = true

[merge]
    conflictstyle = diff3

[diff]
    algorithm = histogram
    colorMoved = default

{{- if .accounts }}
#-------------------------------------------------------------------------------
# GitHub URL Shortcuts (Auto-generated from accounts)
#-------------------------------------------------------------------------------
{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- if $username }}
{{- $alias := printf "%s-%s" $provider $username }}

{{- /* Calculate Rewrite Targets: username + organizations */ -}}
{{- $targets := list }}
{{ $targets = append $targets $username }}
{{- if hasKey . "organizations" }}
{{-   $orgs := .organizations }}
{{-   if kindOf $orgs | eq "string" }}{{ $orgs = list $orgs }}{{ end }}
{{-   $targets = concat $targets $orgs }}
{{- end }}

{{- $uniqueTargets := uniq $targets }}
{{- range $uniqueTargets }}
{{-   if . }}
[url "git@{{ $alias }}:{{ . }}/"]
    insteadOf = https://github.com/{{ . }}/

{{-   end }}
{{- end }}

{{- end }}
{{- end }}
{{- end }}

#-------------------------------------------------------------------------------
# Delta (better diff viewer)
# Install: cargo install git-delta  OR  brew install git-delta
#-------------------------------------------------------------------------------
[delta]
    line-numbers = true
    navigate = true
    side-by-side = false
    syntax-theme = Dracula

#-------------------------------------------------------------------------------
# Aliases
#-------------------------------------------------------------------------------
[alias]
    # Status
    s = status -sb
    # st = status (Use gst)

    # Logging
    graph = log --oneline --graph --decorate --all
    hist = log --pretty=format:'%C(yellow)%h%Creset %ad | %s%d [%an]' --graph --date=short
    lg = log --oneline --graph -15
    lga = log --oneline --graph --all -20
    last = log -1 HEAD --stat

    # Branching
    # co = checkout (Use gco)
    cob = checkout -b
    # br = branch (Use gb)
    bra = branch -a
    brd = branch -d

    # Commits
    # ci = commit (Use gc/gcam)
    # cm = commit -m
    # ca = commit --amend
    can = commit --amend --no-edit

    # Staging
    aa = add --all
    ap = add --patch

    # Reset
    unstage = reset HEAD --
    undo = reset --soft HEAD~1

    # Stash
    sl = stash list
    sp = stash pop
    ss = stash save

    # Remote
    pu = push
    puf = push --force-with-lease
    pl = pull

    # Working with remotes
    rv = remote -v
    ra = remote add

    # Cleanup
    cleanup = !git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 git branch -d

    # Identity check
    whoami = !echo "$(git config user.name) <$(git config user.email)>"

    # Show all configured remotes with their URLs
    remotes = remote -v

{{- if .accounts }}
# ------------------------------------------------------------------------------
# Conditional Includes (Auto-generated from accounts)
# Each account's dirs list determines which directories use that identity
# ------------------------------------------------------------------------------
{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- if $username }}
{{- $alias := printf "%s-%s" $provider $username }}

{{- range .dirs }}
[includeIf "gitdir/i:{{ $.chezmoi.homeDir | replace "\\" "/" }}/{{ . }}/"]
    path = ~/.gitconfig-{{ $alias }}
{{- end }}

{{- end }}
{{- end }}
{{- end }}

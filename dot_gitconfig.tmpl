#===============================================================================
# GIT CONFIGURATION
# Global settings - identity is set dynamically based on directory
# Managed by chezmoi - accounts configured via chezmoi init
#===============================================================================
{{- /* Find default identity (use first account as default). hasKey, not bare
      truthiness: a config with [data.packages] but no accounts key (our own
      full-install CI configs, hand-rolled setups) would abort every apply at
      this dereference - the same "map has no entry" class dot_gitconfig's
      package reads hit before the 12-group migration hardened them. */ -}}
{{- $simpleName := "" -}}
{{- $simpleEmail := "" -}}
{{- $simpleKey := "" -}}
{{- $simpleSigningKey := "" -}}
{{- if and (hasKey . "accounts") .accounts -}}
{{-   $first := first .accounts -}}
{{-   if $first -}}
{{-     $simpleName = $first.name -}}
{{-     $simpleEmail = $first.email -}}
{{-     if hasKey $first "key" }}{{ $simpleKey = $first.key }}{{ end -}}
{{-     if hasKey $first "signingKey" }}{{ $simpleSigningKey = $first.signingKey }}{{ end -}}
{{-     if and (not $simpleSigningKey) (hasKey $first "signingkey") }}{{ $simpleSigningKey = $first.signingkey }}{{ end -}}
{{-   end -}}
{{- end }}
{{- /* Computed inline (not read from stored data) so this is always live/correct on
     every apply, never stale from a `chezmoi init` run on a different machine/
     environment type - see the [data] comment in .chezmoi.toml.tmpl. "isDevcontainer"
     really means "any container" (Docker specifically) by design - intentionally
     Docker-only for now, see .chezmoi.toml.tmpl's detection block for the planned
     rollout order if other runtimes are ever added. */ -}}
{{- $envDev := or (env "DEVCONTAINER") (env "REMOTE_CONTAINERS") | default "" -}}
{{- $isDevcontainer := or (eq $envDev "true") (eq $envDev "1") (stat "/.dockerenv" | not | not) -}}
{{- $isWsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (.chezmoi.kernel.osrelease | lower) -}}
{{-     $isWsl = true -}}
{{-   end -}}
{{- end }}
{{- $devDesktop := false -}}
{{- $modernCli := false -}}
{{- if hasKey . "packages" -}}
  {{- if hasKey .packages "dev_desktop" }}{{- $devDesktop = .packages.dev_desktop }}{{- end -}}
  {{- if hasKey .packages "modern_cli" }}{{- $modernCli = .packages.modern_cli }}{{- end -}}
{{- end }}
[user]
{{- if $simpleName }}
    name = {{ $simpleName | quote }}
    email = {{ $simpleEmail | quote }}
{{- if $simpleKey }}
    signingkey = ~/.ssh/{{ if $simpleSigningKey }}{{ $simpleSigningKey }}{{ else }}{{ $simpleKey }}{{ end }}.pub
{{- end }}
{{- else }}
    # No accounts configured - use 'devprofile use' to set identity per-repo
    # or add accounts to ~/.config/chezmoi/chezmoi.toml
{{- end }}
    # Prevent git from guessing identity - forces explicit configuration
    useConfigOnly = true
{{- if and $simpleName $simpleKey (not $isDevcontainer) }}

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    # Lets `git log --show-signature` / `git verify-commit` verify signatures locally.
    # Generated by run_onchange_generate_identities.{sh,ps1}.tmpl from each account's
    # dedicated signing key - only covers commits signed after that file was generated,
    # not older commits signed under a different key.
    allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

[init]
    defaultBranch = main

[core]
    # Editor for commit messages, rebase, etc.
    # Options:
    #   code --wait        VS Code (recommended - what you know)
    #   nvim               Neovim (fast, terminal-native)
    #   vim                Vim (always available)
    # Line endings: false on every machine - .gitattributes is the single
    # authority (repo ships a complete one). The previous `input` mostly
    # coexisted, but `false` removes any conversion git would do before the
    # attributes apply, so the attributes file alone decides what lands on
    # disk. See .gitattributes at the repo root.
    autocrlf = false
    # Shared hooks for every repository. commit-msg strips Claude co-author
    # trailers and then chains to the repo's own .git/hooks/commit-msg, so
    # per-repo hooks keep working. Two things to know: hooksPath replaces
    # .git/hooks, so only hooks the shared directory chains to still run
    # (today: commit-msg); and `pre-commit install` refuses while it is set.
    # In a repo that needs pre-commit: git config core.hooksPath .git/hooks
    hooksPath = ~/.config/git/hooks
{{- if or $isWsl $isDevcontainer $devDesktop (lookPath "code") }}
    # Requires VS Code in PATH (code command)
    editor = code --wait
{{- else }}
    editor = vim
{{- end }}
{{- if $modernCli }}
    pager = delta
{{- end }}
{{- if and $simpleKey (not $isDevcontainer) }}
    sshCommand = "ssh -i ~/.ssh/{{ $simpleKey }} -o IdentitiesOnly=yes"
{{- else }}
    # Devcontainers (and keyless configs) use plain ssh: a container has no key
    # FILES - keys arrive through the forwarded agent socket - and
    # `-i <path> -o IdentitiesOnly=yes` would pin a nonexistent identity and
    # refuse the agent's. ~/.ssh/config still supplies the host aliases the
    # [url] rewrites below resolve through. See docs/devcontainer.md.
    sshCommand = "ssh"
{{- end }}
{{- if eq .chezmoi.os "windows" }}
    # Deep trees (node_modules) exceed Windows' 260-char MAX_PATH otherwise.
    longpaths = true
{{- end }}

[apply]
    # Was `core.whitespace = fix`, which git silently ignores (core.whitespace
    # only takes problem names). Fixing whitespace on apply is this key.
    whitespace = fix

[color]
    ui = auto

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[fetch]
    prune = true

[rebase]
    autoStash = true
    updateRefs = true

[merge]
    # zdiff3: diff3's base section, minus lines both sides already agree on.
    # Delta (the pager) renders conflicted files in `git diff` as separate
    # ours/theirs diffs against that base - the two work together.
    conflictstyle = zdiff3

[rerere]
    # Remember conflict resolutions; replay them on the next identical conflict.
    enabled = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[help]
    autocorrect = prompt

[diff]
    algorithm = histogram
    colorMoved = default
{{- if $modernCli }}

[interactive]
    # Delta-colored hunks in `git add -p` / `git checkout -p`.
    diffFilter = delta --color-only
{{- end }}

{{- if .accounts }}
#-------------------------------------------------------------------------------
# GitHub URL Shortcuts (Auto-generated from accounts)
#-------------------------------------------------------------------------------
{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- if $username }}
{{- $alias := printf "%s-%s" $provider $username }}

{{- /* Calculate Rewrite Targets: username + organizations */ -}}
{{- $targets := list }}
{{ $targets = append $targets $username }}
{{- if hasKey . "organizations" }}
{{-   $orgs := .organizations }}
{{-   if kindOf $orgs | eq "string" }}{{ $orgs = list $orgs }}{{ end }}
{{-   $targets = concat $targets $orgs }}
{{- end }}

{{- $uniqueTargets := uniq $targets }}
{{- range $uniqueTargets }}
{{-   if . }}
[url "git@{{ $alias }}:{{ . }}/"]
    insteadOf = https://github.com/{{ . }}/

{{-   end }}
{{- end }}

{{- end }}
{{- end }}
{{- end }}

#-------------------------------------------------------------------------------
# Delta (better diff viewer)
# Install: cargo install git-delta  OR  brew install git-delta
#-------------------------------------------------------------------------------
[delta]
    line-numbers = true
    navigate = true
    side-by-side = false
    # Same palette as the terminals (Windows Terminal, VS Code, opencode).
    syntax-theme = Catppuccin Mocha

#-------------------------------------------------------------------------------
# Aliases
#-------------------------------------------------------------------------------
[alias]
    # Status
    s = status -sb
    # st = status (Use gst)

    # Logging
    graph = log --oneline --graph --decorate --all
    hist = log --pretty=format:'%C(yellow)%h%Creset %ad | %s%d [%an]' --graph --date=short
    lg = log --oneline --graph -15
    lga = log --oneline --graph --all -20
    last = log -1 HEAD --stat

    # Branching
    # co = checkout (Use gco)
    cob = checkout -b
    # br = branch (Use gb)
    bra = branch -a
    brd = branch -d

    # Commits
    # ci = commit (Use gc/gcam)
    # cm = commit -m
    # ca = commit --amend
    can = commit --amend --no-edit

    # Staging
    aa = add --all
    ap = add --patch

    # Reset
    unstage = restore --staged --
    undo = reset --soft HEAD~1

    # Stash
    sl = stash list
    sp = stash pop
    ss = stash push

    # Remote
    pu = push
    puf = push --force-with-lease
    pl = pull

    # Working with remotes
    rv = remote -v
    ra = remote add

    # Cleanup
    # Exact-name match: the old `grep -v 'main'` also spared e.g. feat/domain-*.
    cleanup = !git branch --merged | grep -vE '^[*+]|^ *(main|master)$' | xargs -n 1 git branch -d

    # Identity check
    whoami = !echo "$(git config user.name) <$(git config user.email)>"

    # Show all configured remotes with their URLs
    remotes = remote -v

{{- if .accounts }}
# ------------------------------------------------------------------------------
# Conditional Includes (Auto-generated from accounts)
# Each account's dirs list determines which directories use that identity
# ------------------------------------------------------------------------------
{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- if $username }}
{{- $alias := printf "%s-%s" $provider $username }}

{{- range .dirs }}
[includeIf "gitdir/i:{{ $.chezmoi.homeDir | replace "\\" "/" }}/{{ . }}/"]
    path = ~/.gitconfig-{{ $alias }}
{{- end }}

{{- end }}
{{- end }}
{{- end }}

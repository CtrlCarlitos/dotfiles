# Force LF for POSIX shell scripts regardless of the checking-out OS's git
# config - these run under bash/sh on Linux/macOS/WSL/CI runners, and CRLF
# line terminators break them there (e.g. "Illegal option -", ": not found").
# A Windows checkout with core.autocrlf unset/inconsistent can otherwise
# leave these as CRLF on disk with no diff shown, since autocrlf=input only
# converts on commit, not checkout - confirmed live: this exact drift broke
# a local `act` run (act copies the working tree directly rather than doing
# a fresh git clone, so it's exposed to local checkout drift real GitHub-
# hosted runners never see, since they clone fresh from the LF-stored blob).
*.sh text eol=lf
*.sh.tmpl text eol=lf

# PowerShell scripts are Windows-native and expected to have CRLF.
*.ps1 text eol=crlf
*.ps1.tmpl text eol=crlf

# Let git auto-detect everything else rather than forcing it.
* text=auto

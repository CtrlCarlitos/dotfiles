# Line-ending policy - the single repo-level authority (core.autocrlf is
# false everywhere; this file decides). Pattern shared with agent-guardrails.
#
# History: CRLF drift broke a local `act` run once (act copies the working
# tree rather than cloning fresh, so it sees checkout drift GitHub-hosted
# runners never do) - see the *.sh comment below. The repo-wide eol=lf
# default below closes the whole class: everything checks out LF except the
# Windows-native script types that explicitly say otherwise.

# Everything text: normalize to LF in the repo AND on checkout.
* text=auto eol=lf

# POSIX shell scripts - CRLF terminators break them under bash/sh
# ("Illegal option -", ": not found"). Explicit even though the default
# above already covers them: the day someone narrows the default, these
# must survive.
*.sh  text eol=lf
*.sh.tmpl text eol=lf
*.zsh text eol=lf
*.bash text eol=lf

# Windows-native scripts - CRLF on checkout (LF stays in the repo).
# PowerShell parses both endings (proven live: this repo's installers ran
# as LF and CRLF interchangeably), CRLF is convention for Windows editors.
*.ps1 text eol=crlf
*.ps1.tmpl text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries - never normalize, never diff-mangle.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

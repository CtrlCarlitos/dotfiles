# Chezmoi repository gitignore
# Files that should NOT be committed to the dotfiles repo

# Temporary/Debug files
temp/
*.log

# Local development
.vscode/
.idea/
.worktrees/

# OS files
.DS_Store
Thumbs.db

# Screenshots dropped in for debugging (not part of the dotfiles)
*.png

# Secret-shaped files - a public dotfiles repo never wants these tracked
# (SSH keys would land here as private_dot_ssh/id_* if copied in by mistake)
*.key
*.pem
*.p12
*.pfx
*.kdbx
id_rsa*
id_ed25519*
id_ecdsa*
.env
.env.*
!.env.example

# More accidental-dropping classes (temp_check.ps1 once got committed;
# tree-result.log too, before *.log existed)
temp_*
*.tmp
*.bak
*.orig
*.rej
._*

# Tooling accidents (npx/npm run from the wrong cwd)
node_modules/

# Claude Code local state - settings.json is tracked; per-machine overrides
# and session droppings are not
.claude/settings.local.json
.claude/todos/

# Local-only working notes (session research, agent planning docs) - never
# commit these; they have been swept into a commit by a broad `git add` before.
docs/research/
docs/superpowers/

# Leftovers of the removed Graft integration (2026-10-09): a source tree that
# was `graft init`-ed keeps its local graph and wiring until deleted by hand,
# and none of it may be committed (`.graft` can hold credentials, the shims bake
# one machine's paths).
/.graft/
/graft/
.claude/helpers/graft-hooks.cjs
.claude/helpers/graft-statusline.cjs
.claude/skills/graft/

# Per-machine agent host wiring (MCP server lists): generated, never shared.
/.mcp.json
/opencode.json

# Serena: share the project definition; retain machine-local state locally.
/.serena/cache/
/.serena/memories/
/.serena/project.local.yml

# Skills-repo clones: a skills installer once cloned its upstream into this
# source tree under a mangled, invisible-character-prefixed name. The
# installed skills live in ~/.agents/skills; clones in here are transient
# tooling state, never dotfiles (the chezmoi side ignores *mp-skills-repo/**).
*mp-skills-repo/

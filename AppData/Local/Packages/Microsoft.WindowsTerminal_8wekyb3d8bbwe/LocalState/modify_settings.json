{{- /* chezmoi:modify-template */ -}}
{{- /* Windows Terminal settings.json, merged on every apply. The merge itself is
       .chezmoitemplates/windows-terminal-settings.json (its header says what is forced and
       why); run_after_windows-terminal-settings.ps1.tmpl repeats it at the end of the apply,
       once the package installer has added pwsh and the font. includeTemplate, not template:
       docs/invariants.md #4. */ -}}
{{- $ctx := dict "stdin" .chezmoi.stdin -}}
{{- if hasKey . "ssh_hosts" }}{{ $_ := set $ctx "ssh_hosts" .ssh_hosts }}{{ end -}}
{{- includeTemplate "windows-terminal-settings.json" $ctx -}}

{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code settings (~/.claude/settings.json, every OS). MERGE, not own -
  the same loader as modify_tui.json (JSONC-tolerant: full-line // comments
  and trailing commas stripped before parsing; Claude's own keys preserved).

  Forces exactly one key when the machine-local secret is present:
    env.GH_TOKEN  - the bot account's GitHub token (ADR-0038, dotfiles#277
    follow-up). gh honors GH_TOKEN over hosts.yml, so every Claude Code
    session - and every process it spawns - acts as the bot account while
    the operator's own terminal keeps its gh profile: `gh auth switch` was
    rejected as the mechanism because it flips machine-global state.

  The token VALUE never lives in this repo: it comes from the machine-local
  config's [data.githubBot] table (~/.config/chezmoi/chezmoi.toml, 0600,
  never committed, preserved across `chezmoi init` by the hasKey re-emit
  block in .chezmoi.toml.tmpl). Machines without the table apply this
  template as a no-op reformat and gain no env key.

  The attribution writer (configure_claude_attribution, run_onchange
  installer) merges into this same file at runtime; both directions
  preserve foreign keys, so they compose.
*/ -}}
{{- $raw := .chezmoi.stdin | trimPrefix "\ufeff" -}}
{{- $raw = regexReplaceAll "(?m)^\\s*//.*$" $raw "" -}}
{{- $raw = regexReplaceAll ",(\\s*[}\\]])" $raw "${1}" | trim -}}
{{- $cur := dict -}}
{{- if $raw }}{{ $cur = fromJson $raw }}{{ end -}}
{{- if hasKey . "githubBot" -}}
{{-   $env := dict -}}
{{-   if hasKey $cur "env" }}{{ $env = $cur.env }}{{ end -}}
{{-   $_ := set $env "GH_TOKEN" .githubBot.token -}}
{{-   $_ := set $cur "env" $env -}}
{{- end -}}
{{- toPrettyJson $cur }}



#===============================================================================
# ZSH CONFIGURATION
#===============================================================================

# Path to Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
export DOTFILES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi"

# OpenCode TUI copy-on-select (docs/terminal.md #clipboard): upstream's flag
# reads as "disabled" when UNSET, so the default is right-click-to-copy.
# "false" turns highlight-copies-on - the same behavior as every terminal
# here. Experimental upstream flag (verified against 1.18.33); restart
# opencode after changing it.
export OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT=false

# Theme
# shellcheck disable=SC2034  # Consumed by Oh My Zsh when sourced below.
ZSH_THEME=""

#-------------------------------------------------------------------------------
# Plugins
#-------------------------------------------------------------------------------
# Silence ssh-agent plugin
zstyle :omz:plugins:ssh-agent quiet yes
# Detect if running in devcontainer
_in_devcontainer() {
  [[ "${DEVCONTAINER:-}" == "true" ]] || \
  [[ "${REMOTE_CONTAINERS:-}" == "true" ]] || \
  [[ -f /.dockerenv ]] || \
  [[ "$PWD" == *"/workspaces/"* ]]
}

# Base plugins (always loaded)
plugins=(
  alias-finder
  copyfile
  copypath
  dirhistory
  fzf
  git
  history
  zsh-autosuggestions
  zsh-completions
  zsh-history-substring-search
  zsh-syntax-highlighting
  zsh-you-should-use
  fzf-tab
)

# Host-only plugins (not loaded in devcontainers)
if ! _in_devcontainer; then
  plugins+=(
    docker
    docker-compose
    ssh
    ubuntu
  )
  # The relay owns the agent when it is installed: the OMZ ssh-agent plugin
  # would start a second agent that the relay's socket then shadows - dead
  # weight holding a copy of every key (#113). Checked by path as well,
  # because this runs before ~/.local/bin lands on PATH below.
  if ! command -v ssh-agent-relay &>/dev/null && [[ ! -x "$HOME/.local/bin/ssh-agent-relay" ]]; then
    plugins+=(ssh-agent)
  fi
fi

# ssh-agent plugin identities - MUST be set before oh-my-zsh.sh sources the
# plugin. Generated by run_onchange_generate_identities from chezmoi.toml's
# declared accounts (auth key + signing key per account); the plugin then
# starts the agent and ssh-add's exactly those. `ssh-add -l` on a host should
# list the *_sign keys too - loading only the auth key is the classic miss.
[[ -f "$HOME/.ssh/agent-identities.zsh" ]] && source "$HOME/.ssh/agent-identities.zsh"

# Oh-My-Zsh is a pinned chezmoi external (.chezmoiexternal.toml): `dot up` applies the weekly pin
# bump, so its own updater must never run. An accepted "[oh-my-zsh] Would you like to update?" once
# git-pulled over the tree chezmoi writes and stopped in a merge conflict (15 unmerged files in
# ~/.oh-my-zsh, 2026-10-12). Set before oh-my-zsh.sh runs tools/check_for_upgrade.sh.
# docs/zsh-tips.md#updating-oh-my-zsh
zstyle ':omz:update' mode disabled

# Load Oh My Zsh
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

#-------------------------------------------------------------------------------
# User Configuration
#-------------------------------------------------------------------------------

# Language
export LANG=en_US.UTF-8

# Preferred editor
if command -v nvim &> /dev/null; then
  export EDITOR='nvim'
  export VISUAL='nvim'
else
  export EDITOR='vim'
  export VISUAL='vim'
fi

#-------------------------------------------------------------------------------
# Path
#-------------------------------------------------------------------------------
typeset -U path
typeset -U fpath

# Homebrew must initialize before local tool paths so their binaries win.
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi

# Local binaries
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" "${path[@]}")
[[ -d "$HOME/bin" ]] && path=("$HOME/bin" "${path[@]}")

# Node and OpenCode global binaries
[[ -d "$HOME/.npm-global/bin" ]] && path=("$HOME/.npm-global/bin" "${path[@]}")
[[ -d "$HOME/.opencode/bin" ]] && path=("$HOME/.opencode/bin" "${path[@]}")
# Fly.io CLI: Fly's install script puts it here on Linux/WSL and updates it in place
[[ -d "$HOME/.fly/bin" ]] && path=("$HOME/.fly/bin" "${path[@]}")

# Language ecosystem binaries
[[ -x /usr/local/go/bin/go ]] && path=(/usr/local/go/bin "${path[@]}")
gopath_entries="${GOPATH:-$HOME/go}"
gopath_bin="${gopath_entries%%:*}/bin"
[[ -d "$gopath_bin" ]] && path=("$gopath_bin" "${path[@]}")
[[ -d "$HOME/.dotnet" ]] && path=("$HOME/.dotnet" "${path[@]}")
[[ -d "$HOME/.dotnet/tools" ]] && path=("$HOME/.dotnet/tools" "${path[@]}")
[[ -d "$HOME/.mix/escripts" ]] && path=("$HOME/.mix/escripts" "${path[@]}")
composer_home="${COMPOSER_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/composer}"
[[ -d "$HOME/.composer/vendor/bin" ]] && path=("$HOME/.composer/vendor/bin" "${path[@]}")
[[ -d "$composer_home/vendor/bin" ]] && path=("$composer_home/vendor/bin" "${path[@]}")

# JDK (mobile_dev's Maestro CLI + agent-device need Java 17+): JAVA_HOME and
# its bin dir, wherever a JDK landed. apt's openjdk-17-jdk wires `java` via
# update-alternatives but sets no JAVA_HOME; brew's openjdk@17 is keg-only
# (not linked into brew's shared bin), so its prefix has to be found
# explicitly. First existing candidate wins; an already-exported JAVA_HOME
# (another JDK manager, a devcontainer image) is left alone.
# Inert unless mobile_dev ran here: dot_zshrc is applied on every machine,
# and a disabled group must have no side effects. The runtime signal is the
# marker install_mobile_dev() touches at ~/.local/state/dotfiles/mobile_dev
# (not chezmoi-managed) - NOT Maestro's ~/.local/bin/maestro symlink, which
# is missing whenever Maestro was already on PATH from a manual install or
# its own download failed, while the JDK/Android SDK still installed.
if [[ -f "$HOME/.local/state/dotfiles/mobile_dev" ]]; then
  if [[ -z "${JAVA_HOME:-}" ]]; then
    for _jdk17 in /usr/lib/jvm/java-17-openjdk-amd64 /usr/lib/jvm/java-17-openjdk-arm64 \
        /opt/homebrew/opt/openjdk@17 /usr/local/opt/openjdk@17 \
        /home/linuxbrew/.linuxbrew/opt/openjdk@17 "$HOME/.linuxbrew/opt/openjdk@17"; do
      if [[ -x "$_jdk17/bin/java" ]]; then
        export JAVA_HOME="$_jdk17"
        break
      fi
    done
    unset _jdk17
  fi
  [[ -n "${JAVA_HOME:-}" ]] && path=("$JAVA_HOME/bin" "${path[@]}")
fi

# _adb_resolve_host MODE ROUTE RESOLV_FILE - prints the host the Windows ADB
# server is reachable at from WSL, or nothing. MODE is `wslinfo
# --networking-mode`'s answer, ROUTE is `ip route show default`'s output,
# RESOLV_FILE is a resolv.conf path. Pure (arguments in, host out) so
# tests/mobile_dev_install_contract.sh can execute it against fixtures.
#   mirrored: WSL2 mirrored networking shares the loopback interface
#     bidirectionally, so 127.0.0.1 reaches the Windows host directly.
#   anything else (nat, empty, no wslinfo on an older build): the default
#     route's gateway IS the Windows host's vEthernet (WSL) address. NOT
#     resolv.conf's nameserver: with DNS tunneling (on by default on current
#     WSL builds) that is 10.255.255.254, a WSL-side DNS proxy nothing else
#     listens on - observed live on a NAT-mode WSL2 machine (nameserver
#     10.255.255.254, default via 172.21.144.1). resolv.conf is only the last
#     resort for a minimal distro with no `ip` (older builds, or DNS
#     tunneling off, still point it at the host).
_adb_resolve_host() {
  local _host=""
  if [[ "$1" == mirrored ]]; then
    printf '%s\n' 127.0.0.1
    return 0
  fi
  _host="$(printf '%s\n' "$2" | awk '/^default/ { print $3; exit }')"
  [[ -z "$_host" ]] && _host="$(awk '/^nameserver/ { print $2; exit }' "$3" 2>/dev/null)"
  [[ -n "$_host" ]] && printf '%s\n' "$_host"
  return 0
}

# ADB bridge to the Windows host (mobile_dev's adb/Maestro/agent-device,
# WSL only): unlike JAVA_HOME above, this is recomputed on EVERY new shell,
# never cached - the resolved Windows host IP can change across Windows
# reboots/network reconnects. Guarded so a user's own override is never
# clobbered, and inert unless mobile_dev ran here (the same
# ~/.local/state/dotfiles/mobile_dev marker as the JDK block above). dot_zshrc is applied byte-for-byte on every
# machine (WSL, native Linux, macOS, devcontainer) - it carries no chezmoi
# template variables, so WSL is detected here the portable way
# (/proc/version), the shell-native equivalent of .chezmoi.toml.tmpl's
# $isWsl check. Best effort throughout: nothing here aborts the shell, and an
# inconclusive detection just leaves ADB_SERVER_SOCKET unset.
if [[ -z "${ADB_SERVER_SOCKET:-}" ]] && [[ -f "$HOME/.local/state/dotfiles/mobile_dev" ]] \
    && grep -qi microsoft /proc/version 2>/dev/null; then
  _adb_mode="" _adb_route=""
  command -v wslinfo &>/dev/null && _adb_mode="$(wslinfo --networking-mode 2>/dev/null)"
  if [[ "$_adb_mode" != mirrored ]] && command -v ip &>/dev/null; then
    _adb_route="$(ip route show default 2>/dev/null)"
  fi
  _adb_host="$(_adb_resolve_host "$_adb_mode" "$_adb_route" /etc/resolv.conf)"
  if [[ -n "$_adb_host" ]]; then
    export ADB_SERVER_SOCKET="tcp:$_adb_host:5037"
  else
    # Warn, never abort: an inconclusive detection must not break shell startup.
    print -u2 "zshrc: could not resolve the Windows host for ADB_SERVER_SOCKET (checked wslinfo, ip route show default and /etc/resolv.conf) - adb/Maestro/agent-device won't reach the Windows ADB server until this is set manually"
  fi
  unset _adb_mode _adb_route _adb_host
fi
unset -f _adb_resolve_host

# Android SDK (mobile_dev): ANDROID_HOME and the SDK's tool dirs, for the SDK
# the installer's install_android_sdk lays down at ~/.local/opt/android-sdk
# (the full SDK with the emulator on native Linux/macOS, platform-tools only
# under WSL). Inert unless that directory exists - its presence is the
# runtime proxy for "mobile_dev installed an SDK here" - and it never
# re-points an ANDROID_HOME you exported for an SDK of your own. The dirs are
# APPENDED, so an adb already on PATH (a distro package, your own SDK) keeps
# precedence over the SDK's copy.
_android_sdk="$HOME/.local/opt/android-sdk"
if [[ -d "$_android_sdk" ]] && [[ -z "${ANDROID_HOME:-}" || "$ANDROID_HOME" == "$_android_sdk" ]]; then
  export ANDROID_HOME="$_android_sdk"
  for _android_dir in platform-tools emulator cmdline-tools/latest/bin; do
    [[ -d "$_android_sdk/$_android_dir" ]] && path+=("$_android_sdk/$_android_dir")
  done
  unset _android_dir
fi
unset _android_sdk

# ZSH completions
[[ -d "$HOME/.zfunc" ]] && fpath=("$HOME/.zfunc" "${fpath[@]}")

#-------------------------------------------------------------------------------
# Aliases
#-------------------------------------------------------------------------------
[[ -f "$HOME/.aliases.zsh" ]] && source "$HOME/.aliases.zsh"

#-------------------------------------------------------------------------------
# History
#-------------------------------------------------------------------------------
HISTSIZE=50000
# shellcheck disable=SC2034  # Consumed by zsh's history subsystem.
SAVEHIST=50000
setopt NO_BANG_HIST           # Don't treat ! as special in commands
setopt HIST_IGNORE_ALL_DUPS   # Don't record duplicates
setopt HIST_FIND_NO_DUPS      # Don't show duplicates when searching
setopt HIST_SAVE_NO_DUPS      # Don't write duplicates
setopt SHARE_HISTORY          # Share history between terminals
setopt HIST_REDUCE_BLANKS     # Remove superfluous blanks
setopt INC_APPEND_HISTORY     # Write immediately, not when shell exits

#-------------------------------------------------------------------------------
# Key Bindings
#-------------------------------------------------------------------------------
# Use up/down arrows to search history based on what's typed
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

#-------------------------------------------------------------------------------
# ZSH Options
#-------------------------------------------------------------------------------
setopt AUTO_CD                # cd by typing directory name
setopt CORRECT                # Suggest corrections for commands
setopt NO_CASE_GLOB           # Case insensitive globbing
setopt NUMERIC_GLOB_SORT      # Sort numbers numerically

#-------------------------------------------------------------------------------
# Modern Tools Initialization
#-------------------------------------------------------------------------------

# Starship (Prompt)
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# Zoxide (Smart CD)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# Direnv (Env vars per directory)
if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

# Windows Terminal cwd reporting (OSC 9;9), WSL only: lets duplicate panes/
# tabs (Alt+Shift+D, the Ctrl+Alt+Shift+<agent> splits) open in THIS
# directory. WT_SESSION reaches WSL via WSLENV; over SSH it is unset, so a
# remote shell never reports a path Windows can't open. chpwd (not precmd):
# wslpath forks, so pay it on directory change, not on every prompt.
if [[ -n "$WT_SESSION" ]] && command -v wslpath &>/dev/null; then
    # \033\134 = ESC + backslash (string terminator), octal to keep shellcheck quiet
    _wt_report_cwd() { printf '\033]9;9;%s\033\134' "$(wslpath -w "$PWD")"; }
    autoload -Uz add-zsh-hook
    add-zsh-hook chpwd _wt_report_cwd
    _wt_report_cwd
fi

# SSH agent: on WSL the keys live in the WINDOWS agent (service, DPAPI-backed,
# survives reboots) and this distro holds none. ssh-agent-relay bridges that
# agent in and hands each account its own filtered socket, so forwarding one
# into a devcontainer cannot authenticate as another account. Backgrounded and
# idempotent: a live socket is reused, so this never delays a prompt, and a
# missing relay never blocks the shell. `ssh-agent-relay status` to inspect,
# `eval "$(ssh-agent-relay use <alias>)"` (or direnv) to switch account,
# `ssh-agent-relay stop` to tear the agents down.
if [[ -o interactive ]] && command -v ssh-agent-relay &>/dev/null; then
    (ssh-agent-relay start >/dev/null 2>&1 &) 2>/dev/null
    # The one shared state dir: the relay honours SSH_AGENT_RELAY_DIR too, so
    # writer and reader derive this path by construction, not by copy (#113).
    # The relay writes default.sock via temp+mv, so this read never sees a
    # partial line from a concurrent refresh.
    export SSH_AGENT_RELAY_DIR="${XDG_RUNTIME_DIR:-/tmp/ssh-agent-relay-$(id -u)}/ssh-agent-relay"
    _ssh_relay_default="$SSH_AGENT_RELAY_DIR/default.sock"
    if [[ -r "$_ssh_relay_default" ]]; then
        _ssh_relay_sock="$(<"$_ssh_relay_default")"
        [[ -S "$_ssh_relay_sock" ]] && export SSH_AUTH_SOCK="$_ssh_relay_sock"
        unset _ssh_relay_sock
    fi
    unset _ssh_relay_default
fi

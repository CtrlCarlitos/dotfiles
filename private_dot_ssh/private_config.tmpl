#===============================================================================
# SSH HOST ALIASES
# Required for git@github-Identity:Org/Repo syntax
# Auto-generated from chezmoi accounts configuration
#===============================================================================

# Note: IdentityFile names the key. For the git account aliases below the
# private key lives on this machine and IdentitiesOnly=yes keeps the offer
# deterministic. For the operator SSH HOSTS the .pub half is referenced
# instead (see the block comment there) - the private half stays in the
# Windows ssh-agent and is offered through the ssh-agent relay on WSL.

#-------------------------------------------------------------------------------
# Global options (must come before any Host block to apply everywhere).
# AddKeysToAgent: when ssh/git first uses a key, add it to the running agent
# so the passphrase is asked once per agent lifetime, not per connection.
# (Signing keys still need an explicit ssh-add - signing doesn't go through
# ssh - which the identity generator + shell startup handle.)
{{- if eq .chezmoi.os "darwin" }}
# UseKeychain: macOS only - load/store key passphrases in the login keychain
# so they survive reboots. Pair with `ssh-add --apple-use-keychain`.
{{- end }}
#-------------------------------------------------------------------------------
AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
UseKeychain yes
{{- end }}

{{- if and (hasKey . "accounts") .accounts }}
{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- if $username }}
{{- $alias := printf "%s-%s" $provider $username }}

{{- if .key }}
# {{ .name }}
Host {{ $alias }}
    HostName {{ $provider }}.com
    User git
    IdentityFile ~/.ssh/{{ .key }}
    IdentitiesOnly yes
{{- end }}
{{- end }}
{{- end }}
{{- else }}

# No accounts configured yet.
# Run 'chezmoi init' to set up your git identity.
{{- end }}

#===============================================================================
# OPERATOR SSH HOSTS (data-driven: [[data.ssh_hosts]] in chezmoi.toml)
#
# Machine-local and NEVER git-tracked: host aliases live in
# ~/.config/chezmoi/chezmoi.toml, this template renders them. Fields:
#   name     (required)  Host alias
#   hostname (required)  IP or DNS name
#   user     (optional)  login user
#   port     (optional)  SSH port (default 22)
#   identity (optional)  key NAME in ~/.ssh (e.g. "id_work") - its .pub half
#                        is referenced and must be copied to every machine
#                        that SSHes out from it; on Windows generate_identities
#                        normalizes the private key's ACL
#   proxy    (optional)  ProxyJump target alias (e.g. a bastion `name`)
#   comment  (optional)  free text - rendered as the block's header comment
#                        so `grep ~/.ssh/config` answers "what was this host?"
#   os       (optional)  "mac" | "linux" - not an SSH option; picks the tab
#                        color/icon of the host's Windows Terminal profile
#   tmux     (optional)  true | "<session>" - not an SSH option; that Terminal
#                        profile re-attaches to a remote tmux session
#
# Example (chezmoi.toml):
#   [[data.ssh_hosts]]
#     name     = "prod-jump"
#     hostname = "10.0.0.5"
#     user     = "carlitos"
#     identity = "id_personal"
#     comment  = "Bastion for the staging VPC - only reachable from office IP"
#===============================================================================
{{- /* WSL runs the ssh-agent relay: Windows holds the keys, and the relay's
       UPSTREAM socket carries all of them. Detected like .chezmoi.toml.tmpl
       does (kernel osrelease mentions "microsoft"); native Linux/macOS have no
       upstream, so nothing is emitted there. The path mirrors the relay's own
       (${XDG_RUNTIME_DIR:-/tmp/ssh-agent-relay-<uid>}/ssh-agent.upstream.sock):
       ssh expands ${XDG_RUNTIME_DIR} itself, %i is the local uid. */}}
{{- $wslRelay := false }}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") }}
{{-   if hasKey .chezmoi.kernel "osrelease" }}
{{-     if contains "microsoft" (.chezmoi.kernel.osrelease | lower) }}{{ $wslRelay = true }}{{ end }}
{{-   end }}
{{- end }}
{{- $upstreamAgent := "/tmp/ssh-agent-relay-%i/ssh-agent.upstream.sock" }}
{{- if env "XDG_RUNTIME_DIR" }}{{ $upstreamAgent = "${XDG_RUNTIME_DIR}/ssh-agent.upstream.sock" }}{{ end }}
{{- if hasKey . "ssh_hosts" }}

{{- range .ssh_hosts }}
{{- $name := "" }}{{- $hostname := "" }}
{{- if hasKey . "name" }}{{ $name = .name }}{{ end }}
{{- if hasKey . "hostname" }}{{ $hostname = .hostname }}{{ end }}
{{- if and $name $hostname }}

{{- if hasKey . "comment" }}
# {{ .comment }}
{{- end }}

Host {{ $name }}
    HostName {{ $hostname }}
{{- if hasKey . "user" }}
    User {{ .user }}
{{- end }}
{{- if hasKey . "port" }}
    Port {{ .port }}
{{- end }}
{{- if hasKey . "identity" }}
    # The PUBLIC half is referenced here (and deployed to every machine's
    # ~/.ssh): ssh matches it against the ssh-agent relay upstream, which
    # holds the private half on the Windows side - so the same line works
    # everywhere without duplicating private keys. IdentitiesOnly then makes
    # the offer deterministic (exactly this key, no MaxAuthTries roulette).
    IdentityFile ~/.ssh/{{ .identity }}.pub
    IdentitiesOnly yes
{{- if $wslRelay }}
    # WSL: ask the relay's UPSTREAM agent (every Windows-agent key). The default
    # SSH_AUTH_SOCK is a per-account filtered socket that holds Git keys only,
    # so the .pub match above would find nothing there.
    IdentityAgent {{ $upstreamAgent }}
{{- end }}
{{- end }}
{{- if hasKey . "proxy" }}
    ProxyJump {{ .proxy }}
{{- end }}
{{- end }}
{{- end }}
{{- else }}
# No [[data.ssh_hosts]] configured. Add hosts to ~/.config/chezmoi/chezmoi.toml
# (see docs/secrets.md) and re-run `chezmoi apply`.
{{- end }}

# Security and connection defaults. This Host * block is intentionally last:
# OpenSSH keeps the first value it finds, so a generated Host alias can opt out
# with a host-specific directive before reaching these defaults.
Host *
    StrictHostKeyChecking accept-new
    UpdateHostKeys yes
    HashKnownHosts yes
    ForwardAgent no
    ServerAliveInterval 30
    ServerAliveCountMax 3

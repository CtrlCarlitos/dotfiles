{{- $relayWsl := and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) (not (env "SSH_AGENT_RELAY_NATIVE")) }}
{{- $relayDir := env "SSH_AGENT_RELAY_DIR" }}
{{- if not $relayDir }}
{{- $runtime := env "XDG_RUNTIME_DIR" | default "/tmp/ssh-agent-relay-%i" }}
{{- $relayDir = printf "%s/ssh-agent-relay" $runtime }}
{{- end }}
#===============================================================================
# OPERATOR SSH HOSTS (data-driven: [[data.ssh_hosts]] in chezmoi.toml)
#
# Include'd by ~/.ssh/config - so `ssh`, `dot ssh`, and the Windows Terminal
# "SSH: <name>" profiles see every host exactly as before - AND pointed to
# directly by VS Code's remote.SSH.configFile, so Remote-SSH's "Connect to
# Host" list shows only these, never the github-<user> git identity aliases
# that live in ~/.ssh/config. See docs/secrets.md and docs/vscode.md.
#
# Machine-local and NEVER git-tracked: host aliases live in
# ~/.config/chezmoi/chezmoi.toml, this template renders them. Fields:
#   name     (required)  Host alias
#   hostname (required)  IP or DNS name
#   user     (optional)  login user
#   port     (optional)  SSH port (default 22)
#   identity (optional)  key NAME in ~/.ssh (e.g. "id_work") - its .pub half
#                        is used on native hosts. On WSL identity_fingerprint
#                        selects a Windows-agent key without a local file.
#   identity_fingerprint SHA256 fingerprint populated by dot ssh-fingerprints
#   proxy    (optional)  ProxyJump target alias (e.g. a bastion `name`)
#   comment  (optional)  free text - rendered as the block's header comment
#                        so `grep ~/.ssh/vscode_hosts` answers "what was this host?"
#   os       (optional)  "mac" | "linux" - not an SSH option; picks the tab
#                        color/icon of the host's Windows Terminal profile
#   tmux     (optional)  true | "<session>" - not an SSH option; that Terminal
#                        profile re-attaches to a remote tmux session
#
# Example (chezmoi.toml):
#   [[data.ssh_hosts]]
#     name     = "prod-jump"
#     hostname = "10.0.0.5"
#     user     = "carlitos"
#     identity = "id_personal"
#     comment  = "Bastion for the staging VPC - only reachable from office IP"
#===============================================================================
{{- if hasKey . "ssh_hosts" }}

{{- range .ssh_hosts }}
{{- $name := "" }}{{- $hostname := "" }}
{{- if hasKey . "name" }}{{ $name = .name }}{{ end }}
{{- if hasKey . "hostname" }}{{ $hostname = .hostname }}{{ end }}
{{- if and $name $hostname }}

{{- if hasKey . "comment" }}
# {{ .comment }}
{{- end }}

Host {{ $name }}
    HostName {{ $hostname }}
{{- if hasKey . "user" }}
    User {{ .user }}
{{- end }}
{{- if hasKey . "port" }}
    Port {{ .port }}
{{- end }}
{{- if and (hasKey . "identity") .identity }}
{{- if $relayWsl }}
    IdentityAgent {{ printf "%s/host-%s.agent" $relayDir (.identity | sha256sum | trunc 16) | quote }}
    IdentityFile none
    IdentitiesOnly no
{{- else }}
    # Native hosts match this public selector against their local agent.
    # Load the corresponding private key into that agent before connecting.
    IdentityFile ~/.ssh/{{ .identity }}.pub
    IdentitiesOnly yes
{{- end }}
{{- end }}
{{- if hasKey . "proxy" }}
    ProxyJump {{ .proxy }}
{{- end }}
{{- end }}
{{- end }}
{{- else }}
# No [[data.ssh_hosts]] configured. Add hosts to ~/.config/chezmoi/chezmoi.toml
# (see docs/secrets.md) and re-run `chezmoi apply`.
{{- end }}

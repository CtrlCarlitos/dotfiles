{{ if eq .chezmoi.os "windows" -}}
{{ if and (hasKey . "accounts") .accounts -}}
# Generate git identity files from accounts configuration
# This script runs whenever the accounts list changes
# Hash: {{ .accounts | toJson | sha256sum }}

$ErrorActionPreference = "Stop"

# Cross-generation PSModulePath guard (confirmed live: fresh Windows install
# launched from pwsh 7). chezmoi runs .ps1 scripts with Windows PowerShell
# 5.1, which inherits pwsh 7's module path, resolves the Core build of
# Microsoft.PowerShell.Security from there, and dies on Set-Acl with
# "module could not be loaded". Under 5.1, strip the Core module dirs so
# the correct in-box module resolves.
if ($PSVersionTable.PSVersion.Major -le 5) {
    $env:PSModulePath = (($env:PSModulePath -split ';') |
        Where-Object { $_ -and ($_ -notmatch '\\PowerShell\\[67]\\') }) -join ';'
    Import-Module Microsoft.PowerShell.Security -ErrorAction SilentlyContinue
}

Write-Host "Generating git identity files..." -ForegroundColor Cyan

{{- /* Collect and create account directories */ -}}
{{- $allDirs := list }}
{{- range .accounts }}
{{- if hasKey . "dirs" }}
{{-   $allDirs = concat $allDirs .dirs }}
{{- end }}
{{- end }}
{{- $uniqueDirs := uniq $allDirs }}
{{- range $uniqueDirs }}
{{- if . }}
New-Item -ItemType Directory -Force -Path (Join-Path $env:USERPROFILE "{{ . }}") | Out-Null
{{- end }}
{{- end }}

{{- range .accounts }}
{{- $username := "" }}
{{- $provider := "github" }}
{{- if hasKey . "username" }}{{ $username = .username }}{{ end }}
{{- if hasKey . "provider" }}{{ $provider = .provider }}{{ end }}
{{- $alias := printf "%s-%s" $provider $username }}
{{- $signKey := "" }}
{{- if hasKey . "signingKey" }}{{ $signKey = .signingKey }}{{ end }}
{{- if and (not $signKey) (hasKey . "signingkey") }}{{ $signKey = .signingkey }}{{ end }}
{{- if $username }}

# Generate ~/.gitconfig-{{ $alias }}
$sb = [System.Text.StringBuilder]::new()
[void]$sb.AppendLine('# Auto-generated by chezmoi from accounts configuration')
[void]$sb.AppendLine('# Account: {{ $alias }}')
[void]$sb.AppendLine('')
[void]$sb.AppendLine('[user]')
[void]$sb.AppendLine('    name = {{ .name | quote }}')
[void]$sb.AppendLine('    email = {{ .email | quote }}')
{{ if .key }}
[void]$sb.AppendLine('    signingkey = ~/.ssh/{{ if $signKey }}{{ $signKey }}{{ else }}{{ .key }}{{ end }}.pub')
[void]$sb.AppendLine('')
[void]$sb.AppendLine('[commit]')
[void]$sb.AppendLine('    gpgsign = true')
[void]$sb.AppendLine('')
[void]$sb.AppendLine('[gpg]')
[void]$sb.AppendLine('    format = ssh')
[void]$sb.AppendLine('')
[void]$sb.AppendLine('[core]')
[void]$sb.AppendLine('    sshCommand = "ssh -i ~/.ssh/{{ .key }} -o IdentitiesOnly=yes"')
{{ end }}

$identityContent = $sb.ToString()

$identityPath = Join-Path $env:USERPROFILE ".gitconfig-{{ $alias }}"
# Use System.IO.File to write UTF8 without BOM (Avoids git config issues)
$utf8NoBom = New-Object System.Text.UTF8Encoding($false)
[System.IO.File]::WriteAllText($identityPath, $identityContent, $utf8NoBom)
{{- end }}
{{- end }}

# Generate ~/.ssh/allowed_signers (for `git log --show-signature` / `git verify-commit`
# to work locally - dot_gitconfig.tmpl points gpg.ssh.allowedSignersFile here).
#
# This repo is used across many independent machines/people, not just one person's
# own - so this deliberately does NOT centralize anyone's public keys in the git repo
# itself (a shared template repo is the wrong place for that, even though public keys
# are technically safe to commit). Everything here is generated from what's already
# local to this machine, and merged rather than rebuilt from scratch each run:
#
#   1. Whatever's already in the file is kept (so a file you copied in from another
#      machine, or hand-edited, survives every future apply).
#   2. Each configured account's dedicated signing key (falls back to the auth key if
#      no signingKey is set) - the most reliable source, straight from chezmoi.toml.
#   3. Every other *.pub under ~/.ssh not already covered - for a multi-machine setup
#      where keys are generated fresh per machine (rather than copied) instead of
#      committing anything anywhere, this is what lets a machine pick up keys for
#      identities it doesn't have configured itself. The principal (email) is
#      recovered from the key's own comment field - devprofile now writes signing
#      keys as "<email>-sign" specifically so this works; a key with an unparseable
#      comment (e.g. one made before that change, or by some other tool) is skipped
#      with a warning rather than guessed at, since allowed_signers is a trust list.
#
# Net effect: copying ~/.ssh/allowed_signers from another machine, or just copying
# its SSH keys in, both work without any extra steps - the next apply merges
# whatever's found and nothing already present is ever lost.
Write-Host "Generating ~/.ssh/allowed_signers..." -ForegroundColor Cyan
# On a genuinely fresh machine (no SSH setup done yet at all) ~/.ssh may not
# exist yet - confirmed live, without this the final write below throws
# "Could not find a part of the path" and aborts the whole script, silently
# skipping every step after it. Same pattern devprofile's own init uses.
$sshDirForSigners = Join-Path $env:USERPROFILE ".ssh"
if (-not (Test-Path $sshDirForSigners)) { New-Item -ItemType Directory -Path $sshDirForSigners -Force | Out-Null }

# Normalize private-key ACLs every apply, not just at generation time.
# devprofile init already gets this right locally - this matters for a key
# *copied in* from another machine instead, which routinely arrives
# readable by "Everyone"/"Users" (a plain file copy doesn't preserve NTFS
# ownership-scoped ACLs), and which Windows OpenSSH then silently refuses
# to use ("UNPROTECTED PRIVATE KEY FILE") with no hint that's the reason.
# Scoped to this repo's own id_* naming convention, excluding *.pub (public
# keys aren't secret, no ACL needed) - never touches config/known_hosts/
# authorized_keys or anything else that happens to live in ~/.ssh.
#
# NOT `icacls /inheritance:r` + `/grant:r` - confirmed live that combination
# does NOT actually produce an owner-only file: /inheritance:r only strips
# permissions the file *inherited* from its parent folder, and /grant:r only
# touches the ACL entry for the principal you name - neither one removes an
# *explicit* grant already sitting on the file for some other principal
# (e.g. Everyone:F from a copy that carried its own ACL over). Verified with
# a deliberately-broad test file: that combination left Everyone:F in place
# untouched. Using Get-Acl/Set-Acl instead to fully replace the ACL - the
# only way to *guarantee* the end state is owner-only, matching Win32-
# OpenSSH's own requirement that a user private key be accessible to no one
# but its owner (not even SYSTEM/Administrators, per its docs).
function Set-OwnerOnlyAcl {
    # SupportsShouldProcess (PSUseShouldProcessForStateChangingFunctions): an
    # ACL rewrite honors -WhatIf/-Confirm; default behavior unchanged.
    [CmdletBinding(SupportsShouldProcess)]
    param([string]$Path)
    # Inheritance flags are only legal on directories - FileSystemAccessRule
    # throws ArgumentException ("No flags can be set") for file ACLs (caught
    # by CI's Windows Installer Test before merge). Directories get the
    # inheritable rule; files keep flags clear.
    if ((Get-Item $Path -Force).PSIsContainer) {
        $acl = New-Object System.Security.AccessControl.DirectorySecurity
        # Inheritable ("this folder, subfolders and files") - confirmed live:
        # a this-folder-only rule orphans the children. Set-Acl
        # (SetSecurityInfo) propagates parent DACL changes: stripping the old
        # inheritable ACEs left every child that relied on inheritance - the
        # *.pub files, deliberately excluded from the per-file owner-only
        # pass - with an EMPTY DACL, denying even the owner's Get-Content.
        $inherit = [System.Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [System.Security.AccessControl.InheritanceFlags]::ObjectInherit
    } else {
        $acl = New-Object System.Security.AccessControl.FileSecurity
        $inherit = [System.Security.AccessControl.InheritanceFlags]::None
    }
    $acl.SetAccessRuleProtection($true, $false)
    $prop = [System.Security.AccessControl.PropagationFlags]::None
    $rule = New-Object System.Security.AccessControl.FileSystemAccessRule($env:USERNAME, "FullControl", $inherit, $prop, "Allow")
    $acl.AddAccessRule($rule)
    if ($PSCmdlet.ShouldProcess($Path, "restrict ACL to owner-only FullControl")) {
        Set-Acl -Path $Path -AclObject $acl
    }
}

# The directory itself, not just the files in it - only creating it if
# missing (above) left a pre-existing ~/.ssh with looser permissions
# untouched, unlike bash's unconditional `chmod 700` on the equivalent
# path. Confirmed via a real, purpose-built community tool for this exact
# problem (countzero/repair_ssh_permissions) that treats the directory
# identically to a private key file - inheritance stripped, owner-only,
# not even SYSTEM/Administrators - so applying the same function here
# rather than inventing a looser rule for the directory.
Set-OwnerOnlyAcl $sshDirForSigners

Get-ChildItem -Path $sshDirForSigners -Filter "id_*" -File -ErrorAction SilentlyContinue | Where-Object { $_.Extension -ne ".pub" } | ForEach-Object {
    Set-OwnerOnlyAcl $_.FullName
}

# config: Windows OpenSSH's client enforces this too (same "Bad owner or
# permissions" refusal as Unix - confirmed against a Win32-OpenSSH GitHub
# issue specifically about this file). Only normalized if it already exists
# - this repo's private_dot_ssh/private_config.tmpl creates it, chezmoi applies that
# separately from this script.
$configPath = Join-Path $sshDirForSigners "config"
if (Test-Path $configPath) { Set-OwnerOnlyAcl $configPath }

# authorized_keys: not created/managed by this repo (that's SSH *server*
# setup, out of scope here) - only normalized if it already exists, same
# "fix permissions, never touch content" pattern as everything else here.
# sshd's StrictModes (on by default) refuses key-based login outright if
# this file - or ~/.ssh, or the home directory itself - is too permissive.
# The home directory's own permissions are a much bigger blast radius than
# anything under .ssh and are deliberately left alone here - that's on
# whoever sets up the SSH server to get right.
$authorizedKeysPath = Join-Path $sshDirForSigners "authorized_keys"
if (Test-Path $authorizedKeysPath) { Set-OwnerOnlyAcl $authorizedKeysPath }

# known_hosts is deliberately NOT touched here: unlike the files above,
# OpenSSH doesn't enforce or even recommend a specific permission on it - no
# failure mode exists to fix, so normalizing it would be permission-churn
# for no functional reason.

$signersPath = Join-Path $env:USERPROFILE ".ssh\allowed_signers"
$signerLines = @()
if (Test-Path $signersPath) {
    $signerLines += @(Get-Content $signersPath)
}

{{- range .accounts }}
{{- $signKey := "" }}
{{- if hasKey . "signingKey" }}{{ $signKey = .signingKey }}{{ end }}
{{- if and (not $signKey) (hasKey . "signingkey") }}{{ $signKey = .signingkey }}{{ end }}
{{- if and (not $signKey) (hasKey . "key") }}{{ $signKey = .key }}{{ end }}
{{- if $signKey }}
$pubKeyPath = Join-Path $env:USERPROFILE ".ssh\{{ $signKey }}.pub"
if (Test-Path $pubKeyPath) {
    # Keytype+keydata only (no comment) - matches the format the scan loop below
    # produces for the same file, so Sort-Object -Unique actually collapses the
    # duplicate instead of keeping two differently-formatted lines for one key.
    $parts = (Get-Content $pubKeyPath -Raw).Trim() -split '\s+'
    $signerLines += ('{{ .email }} namespaces="git" ' + $parts[0] + ' ' + $parts[1])
} else {
    Write-Host "  ! Skipping {{ .email }} - {{ $signKey }}.pub not found yet" -ForegroundColor Yellow
}
{{- end }}
{{- end }}

$sshDir = Join-Path $env:USERPROFILE ".ssh"
if (Test-Path $sshDir) {
    Get-ChildItem -Path $sshDir -Filter "*.pub" -ErrorAction SilentlyContinue | ForEach-Object {
        $parts = (Get-Content $_.FullName -Raw).Trim() -split '\s+'
        $comment = $parts[2]
        if ($comment -match '^([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,})') {
            $email = $Matches[1]
            $signerLines += ($email + ' namespaces="git" ' + $parts[0] + ' ' + $parts[1])
        } else {
            Write-Host "  ! Skipping $($_.Name) - comment isn't a recognizable email, can't determine who to trust it as" -ForegroundColor Yellow
        }
    }
}

$signersContent = (($signerLines | Sort-Object -Unique) -join "`n") + "`n"
$utf8NoBomSigners = New-Object System.Text.UTF8Encoding($false)
[System.IO.File]::WriteAllText($signersPath, $signersContent, $utf8NoBomSigners)
Write-Host "  Wrote ~/.ssh/allowed_signers" -ForegroundColor Green

#-------------------------------------------------------------------------------
# ssh-agent: ensure the service runs and load the declared accounts' keys.
#
# Windows' ssh-agent is a SERVICE (not per-shell). Keys added with `ssh-add`
# are persisted DPAPI-encrypted under HKCU\Software\OpenSSH\Agent\Keys and
# reloaded automatically on boot - so this load is effectively one-time.
#
# This only ADDS keys - auth key + per-account signing key, for accounts
# declared in chezmoi.toml. It never flushes the agent, so any extra key a
# user loaded themselves is left in place. The flip side: to REMOVE a key you
# must `ssh-add -d ~/.ssh/<key>` (or `ssh-add -D` for all) by hand -
# de-declaring the account or deleting the file does NOT evict it from the
# running/persisted agent. See docs/testing-windows.md.
#
# ErrorActionPreference is dropped to Continue for this block: ssh-add /
# ssh-keygen are native exes and, under "Stop", any line they write to stderr
# is promoted to a terminating error (see the note in
# run_onchange_install_packages.ps1.tmpl).
#-------------------------------------------------------------------------------
$prevEAP = $ErrorActionPreference
$ErrorActionPreference = 'Continue'
try {
    Write-Host "Configuring ssh-agent..." -ForegroundColor Cyan
    try {
        $svc = Get-Service ssh-agent -ErrorAction Stop
        if ($svc.StartType -ne 'Automatic') { Set-Service ssh-agent -StartupType Automatic -ErrorAction Stop }
        if ($svc.Status -ne 'Running')      { Start-Service ssh-agent -ErrorAction Stop }
    } catch {
        Write-Host "  ! Could not configure the ssh-agent service (first-time setup needs an elevated shell): $_" -ForegroundColor Yellow
    }

    # Newline-separated inside @( ) - no trailing-comma hazard.
    $declaredKeys = @(
{{- range .accounts }}
{{- if .key }}
        '{{ .key }}'
{{- end }}
{{- $sk := "" }}{{ if hasKey . "signingKey" }}{{ $sk = .signingKey }}{{ else if hasKey . "signingkey" }}{{ $sk = .signingkey }}{{ end }}
{{- if $sk }}
        '{{ $sk }}'
{{- end }}
{{- end }}
    ) | Where-Object { $_ } | Select-Object -Unique

    # Consumed by the PowerShell profile's startup top-up.
    $agentIdsPath  = Join-Path $env:USERPROFILE ".ssh\agent-identities.ps1"
    $agentIdsLines = @(
        '# Auto-generated by chezmoi (run_onchange_generate_identities). Do not edit.',
        '$SshAgentIdentities = @('
    ) + @($declaredKeys | ForEach-Object { "    '$_'" }) + @(')')
    [System.IO.File]::WriteAllText($agentIdsPath, (($agentIdsLines -join "`n") + "`n"), (New-Object System.Text.UTF8Encoding($false)))
    Write-Host "  Wrote ~/.ssh/agent-identities.ps1" -ForegroundColor Green

    if (Get-Command ssh-add -ErrorAction SilentlyContinue) {
        $loaded = & ssh-add -l 2>$null
        foreach ($k in $declaredKeys) {
            $kp = Join-Path $env:USERPROFILE ".ssh\$k"
            if (-not (Test-Path $kp)) {
                Write-Host "  ! Declared key not on disk yet: $k" -ForegroundColor Yellow
                continue
            }
            # Fingerprint from the .pub (never prompts); fall back to the private key.
            $fpSrc = if (Test-Path "$kp.pub") { "$kp.pub" } else { $kp }
            $fp = ((& ssh-keygen -lf $fpSrc 2>$null) -split '\s+')[1]
            if ($fp -and ($loaded -match [regex]::Escape($fp))) { continue }
            & ssh-add $kp 2>&1 | Out-Null
        }
        Write-Host "  Agent now holds:" -ForegroundColor Green
        & ssh-add -l 2>$null | ForEach-Object { Write-Host "    $_" }
    }
} finally {
    $ErrorActionPreference = $prevEAP
}

# End of script
{{ end -}}
{{ end -}}
